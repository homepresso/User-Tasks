#!/bin/sh
# usertasks-host-wrapper: the `usertasks` command of a one-line (Docker) install.
#
#   usertasks status                       version, containers, health, setup state
#   usertasks logs [-f] [--tail N] [svc]   container logs (docker compose logs)
#   usertasks backup [--out <dir>]         database dump + files + .env, in backups/
#   usertasks restore <backup|latest> [--yes]
#   usertasks upgrade [--to <version>] [--yes] [--skip-backup] [--allow-downgrade] [--build]
#                     [--edition sharepoint|core] [--licence <file>] [--bundle <offline bundle>]
#   usertasks bundle-download --edition sharepoint --licence <file> [--version <v>]
#                     [--platform linux/amd64|linux/arm64] [--out <file.tar>]   offline bundle (air-gapped)
#   usertasks config [--preset <name>] [--force]   re-run the service choices
#   usertasks setup-code                   a new first-run setup code for /setup
#   usertasks admin <args…>                usertasks-admin inside the app container
#   usertasks start | stop | restart
#   usertasks uninstall [--purge] [--yes]  stop and remove (data kept unless --purge)
#   usertasks version | help
#   usertasks cli <args…>                  the UserTasks CLI (npm @user-tasks/cli), if installed
#
# Editions (UserTasks for SharePoint Server): the installer's --edition and
# --licence, `usertasks upgrade --edition sharepoint` to switch an install
# (data kept), a licence check with usertasks.com on every download.
# Any other command is passed to the UserTasks CLI when it is installed.
# Docs: /docs/self-hosting/install and /docs/self-hosting/upgrade.
set -eu

WRAPPER_MARK="usertasks-host-wrapper"
DEFAULT_RELEASE_BASE="https://github.com/homepresso/User-Tasks/releases"
# Pinned by digest: verifies signatures where neither OpenSSL 3 nor Node.js is on the host.
VERIFY_IMAGE="node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a"
PG_CLIENT_IMAGE="postgres:17-alpine"

# ── output and prompts ──────────────────────────────────────────────────────

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then B=$(printf '\033[1m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m'); R=$(printf '\033[31m'); N=$(printf '\033[0m'); else B=""; G=""; Y=""; R=""; N=""; fi
say() { printf '%s\n' "$*"; }
step() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok() { printf '  %sok%s  %s\n' "$G" "$N" "$*"; }
warn() { printf '%swarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die() { printf '%susertasks:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

interactive() {
  [ "${USERTASKS_NONINTERACTIVE:-0}" != 1 ] || return 1
  [ -r /dev/tty ] && [ -w /dev/tty ] && (: < /dev/tty) 2>/dev/null
}

# ask <prompt> <default>: prints the answer (the default when not interactive).
ask() {
  if ! interactive; then printf '%s' "$2"; return; fi
  if [ -n "$2" ]; then printf '%s [%s]: ' "$1" "$2" > /dev/tty; else printf '%s: ' "$1" > /dev/tty; fi
  IFS= read -r _ans < /dev/tty || _ans=""
  [ -n "$_ans" ] || _ans="$2"
  printf '%s' "$_ans"
}

# ask_secret <prompt>: no echo.
ask_secret() {
  interactive || { printf ''; return; }
  printf '%s: ' "$1" > /dev/tty
  stty -echo < /dev/tty 2>/dev/null || true
  IFS= read -r _ans < /dev/tty || _ans=""
  stty echo < /dev/tty 2>/dev/null || true
  printf '\n' > /dev/tty
  printf '%s' "$_ans"
}

# confirm <prompt> <default y|n>
confirm() {
  [ "${ASSUME_YES:-0}" = 1 ] && return 0
  if ! interactive; then [ "$2" = y ]; return; fi
  _d=$( [ "$2" = y ] && echo "Y/n" || echo "y/N" )
  printf '%s [%s] ' "$1" "$_d" > /dev/tty
  IFS= read -r _ans < /dev/tty || _ans=""
  [ -n "$_ans" ] || _ans="$2"
  case "$_ans" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

# ── small helpers ───────────────────────────────────────────────────────────

have() { command -v "$1" >/dev/null 2>&1; }

rand_hex() {
  if have openssl; then openssl rand -hex "$1"; else od -An -tx1 -N "$1" /dev/urandom | tr -d ' \n'; fi
}

# XXXX-XXXX-XXXX from the setup-code alphabet (lib/setup/code.ts; 256 % 32 = 0, so unbiased).
gen_setup_code() {
  od -An -tu1 -N12 /dev/urandom | tr -s ' ' '\n' | grep -v '^$' | awk '
    BEGIN { a = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" }
    { s = s substr(a, ($1 % 32) + 1, 1) }
    END { print substr(s, 1, 4) "-" substr(s, 5, 4) "-" substr(s, 9, 4) }'
}

sha256_of() {
  if have sha256sum; then sha256sum "$1" | cut -d' ' -f1
  elif have shasum; then shasum -a 256 "$1" | cut -d' ' -f1
  else openssl dgst -sha256 -r "$1" | cut -d' ' -f1; fi
}

http_get() { # <url> <file>
  if have curl; then curl -fsSL --retry 3 --connect-timeout 20 -o "$2" "$1"
  elif have wget; then wget -q -O "$2" "$1"
  else die "curl or wget is needed to download releases"; fi
}

http_ok() { # <url>: true on a 2xx answer
  if have curl; then curl -fsS -o /dev/null --max-time 5 "$1" 2>/dev/null
  else wget -q -T 5 -O /dev/null "$1" 2>/dev/null; fi
}

port_busy() {
  if have nc; then nc -z 127.0.0.1 "$1" >/dev/null 2>&1
  elif have lsof; then lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
  elif have ss; then ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
  elif [ -r /proc/net/tcp ]; then
    # Listening sockets (state 0A) on the port, IPv4 and IPv6.
    _hex=$(printf '%04X' "$1")
    cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | awk -v p=":$_hex" '$4 == "0A" && substr($2, length($2) - 4) == p { f = 1 } END { exit !f }'
  else return 1; fi
}

now_stamp() { date -u +%Y%m%dT%H%M%SZ; }

# version_cmp a b → prints -1, 0 or 1 (numeric dotted parts; a pre-release suffix sorts first).
version_cmp() {
  awk -v a="$1" -v b="$2" 'function split_v(v, p, s) { s = v; sub(/-.*/, "", s); return split(s, p, ".") }
  BEGIN {
    na = split_v(a, pa); nb = split_v(b, pb); n = na > nb ? na : nb
    for (i = 1; i <= n; i++) { x = pa[i] + 0; y = pb[i] + 0; if (x < y) { print -1; exit } if (x > y) { print 1; exit } }
    ra = index(a, "-") > 0; rb = index(b, "-") > 0
    if (ra && !rb) { print -1; exit } if (!ra && rb) { print 1; exit }
    if (a < b) { print -1; exit } if (a > b) { print 1; exit } print 0 }'
}

valid_version() { printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'; }

# ── env files (KEY=value lines; never sourced) ──────────────────────────────

env_get() { # <key> <file>
  [ -f "$2" ] || return 0
  sed -n "s/^$1=//p" "$2" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}

env_has() { [ -f "$2" ] && grep -q "^$1=" "$2"; }

env_set() { # <key> <value> <file>: replace or append, atomically, keeping the mode
  _tmp="$3.tmp.$$"
  (umask 077; : > "$_tmp")
  if [ -f "$3" ]; then
    awk -v k="$1" -v v="$2" 'BEGIN { done = 0 } index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next } { print } END { if (!done) print k "=" v }' "$3" > "$_tmp"
  else
    printf '%s=%s\n' "$1" "$2" > "$_tmp"
  fi
  mv "$_tmp" "$3"
}

# ── install state ───────────────────────────────────────────────────────────

resolve_dir() {
  if [ -n "${USERTASKS_DIR:-}" ]; then DIR="$USERTASKS_DIR"
  else
    _self=$0
    while [ -L "$_self" ]; do
      _t=$(readlink "$_self"); case "$_t" in /*) _self="$_t" ;; *) _self="$(dirname "$_self")/$_t" ;; esac
    done
    DIR=$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd) || DIR=""
  fi
  if [ -z "$DIR" ] || [ ! -f "$DIR/state.env" ]; then die "no UserTasks install found (looked in ${DIR:-?}; set USERTASKS_DIR)"; fi
}

load_state() {
  STATE="$DIR/state.env"; ENV_FILE="$DIR/.env"
  VERSION=$(env_get USERTASKS_VERSION "$STATE")
  IMAGE=$(env_get USERTASKS_IMAGE "$STATE")
  PROJECT=$(env_get USERTASKS_PROJECT "$STATE")
  PRESET=$(env_get USERTASKS_PRESET "$STATE")
  PROFILES=$(env_get USERTASKS_COMPOSE_PROFILES "$STATE")
  EDITION=$(env_get USERTASKS_EDITION "$STATE"); EDITION_VERSION=$(env_get USERTASKS_EDITION_VERSION "$STATE")
  RELEASE_BASE=${USERTASKS_RELEASE_BASE:-$(env_get USERTASKS_RELEASE_BASE "$STATE")}
  RELEASE_BASE=${RELEASE_BASE:-$DEFAULT_RELEASE_BASE}
  REL="$DIR/releases/$VERSION"
  PORT=$(env_get APP_PORT "$ENV_FILE"); PORT=${PORT:-3000}
  APP_URL=$(env_get APP_URL "$ENV_FILE"); APP_URL=${APP_URL:-http://localhost:$PORT}
}

lock() {
  mkdir "$DIR/.lock" 2>/dev/null || die "another usertasks command is running (remove $DIR/.lock if not)"
  trap 'rmdir "$DIR/.lock" 2>/dev/null || true' EXIT INT TERM
}

# ── docker compose ──────────────────────────────────────────────────────────

# dc_for <release dir> <image> <compose args…>
dc_for() {
  _rel=$1; _img=$2; shift 2
  set -- --project-directory "$_rel" -f "$_rel/docker-compose.yml" --env-file "$ENV_FILE" "$@"
  for _p in $(printf '%s' "$PROFILES" | tr ',' ' '); do set -- --profile "$_p" "$@"; done
  USERTASKS_ENV_FILE="$ENV_FILE" USERTASKS_IMAGE="$_img" docker compose -p "$PROJECT" "$@"
}
dc() { dc_for "$REL" "$IMAGE" "$@"; }

uses_bundled_postgres() { printf ',%s,' "$PROFILES" | grep -q ',standalone,'; }

app_running() { [ -n "$(dc ps -q --status running app 2>/dev/null)" ]; }

# admin <args…>: usertasks-admin in the running app container, else a one-off one.
admin() {
  if app_running; then dc exec -T app node admin.cjs "$@"
  else dc run --rm --no-deps -T app node admin.cjs "$@"; fi
}

wait_healthy() { # <seconds>
  _deadline=$(( $(date +%s) + $1 ))
  while [ "$(date +%s)" -lt "$_deadline" ]; do
    http_ok "http://127.0.0.1:$PORT/api/config/public" && return 0
    sleep 3
  done
  return 1
}

# The app container runs <image> (resolved to an id on both sides).
running_image_is() {
  _cid=$(dc ps -q app 2>/dev/null | head -n 1); [ -n "$_cid" ] || return 1
  _want=$(docker image inspect --format '{{.Id}}' "$1" 2>/dev/null) || return 1
  [ "$(docker inspect --format '{{.Image}}' "$_cid" 2>/dev/null)" = "$_want" ]
}

ensure_image() { # <image> [allow build: 1] [version]
  if docker image inspect "$1" >/dev/null 2>&1; then ok "image $1 is present"; return 0; fi
  step "Pulling $1"
  if docker pull "$1"; then return 0; fi
  [ "${2:-0}" = 1 ] || die "could not pull $1. Check the network (and that the image is public), or re-run with --build to build it locally (about 10 GB of memory for Docker)."
  build_image_from_source "${3:-$VERSION}"
}

build_image_from_source() { # <version>: sets BUILT_IMAGE
  have git || die "building locally needs git"
  _mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
  if [ "$_mem" -lt 9500000000 ] 2>/dev/null; then
    warn "Docker has $((_mem / 1073741824)) GB of memory; the build needs about 10 GB and may be killed part-way."
    confirm "Build anyway?" n || die "not building"
  fi
  _src="$DIR/build/usertasks-$1"; rm -rf "$_src"; mkdir -p "$DIR/build"
  step "Building UserTasks $1 from source (10 to 20 minutes)"
  git clone --depth 1 --branch "v$1" "${USERTASKS_SOURCE_REPO:-https://github.com/homepresso/User-Tasks.git}" "$_src"
  BUILT_IMAGE="usertasks:$1-local"
  docker build -t "$BUILT_IMAGE" --build-arg GIT_COMMIT="$(git -C "$_src" rev-parse HEAD)" "$_src"
  rm -rf "$_src"
}

# ── releases: download and verify ──────────────────────────────────────────

openssl3() {
  for _o in openssl /opt/homebrew/opt/openssl@3/bin/openssl /usr/local/opt/openssl@3/bin/openssl; do
    if have "$_o" && "$_o" version 2>/dev/null | grep -Eq '^OpenSSL ([3-9]|[1-9][0-9])\.'; then printf '%s' "$_o"; return 0; fi
  done
  return 1
}

# verify_sig <data> <sig> <public key pem>: ed25519 over the raw bytes.
verify_sig() {
  if _o=$(openssl3); then "$_o" pkeyutl -verify -pubin -inkey "$3" -rawin -in "$1" -sigfile "$2" >/dev/null 2>&1; return; fi
  _js='const c=require("crypto"),f=require("fs");const [d,s,k]=process.argv.slice(-3);process.exit(c.verify(null,f.readFileSync(d),c.createPublicKey(f.readFileSync(k)),f.readFileSync(s))?0:1)'
  if have node && node -e 'process.exit(+process.versions.node.split(".")[0] >= 16 ? 0 : 1)' 2>/dev/null; then node -e "$_js" "$1" "$2" "$3"; return; fi
  _vd=$(mktemp -d "$DIR/.verify.XXXXXX"); cp "$1" "$_vd/d"; cp "$2" "$_vd/s"; cp "$3" "$_vd/k"
  docker run --rm --network none -v "$_vd:/v:ro" "$VERIFY_IMAGE" node -e "$_js" /v/d /v/s /v/k; _rc=$?
  rm -rf "$_vd"; return $_rc
}

latest_version() {
  _f="$DIR/.latest.json"
  http_get "$RELEASE_BASE/latest/download/release.json" "$_f" || die "could not read the latest release from $RELEASE_BASE"
  _v=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$_f" | head -n 1); rm -f "$_f"
  valid_version "$_v" || die "the latest release has no valid version"
  printf '%s' "$_v"
}

# fetch_release <version> [folder]: download (or copy from [folder], e.g. an
# offline bundle's release/), verify and unpack into releases/<version>.
fetch_release() {
  _v=$1; _src=${2:-}; _dest="$DIR/releases/$_v"
  if [ -f "$_dest/manifest.json" ] && [ -f "$_dest/.verified" ]; then ok "release $_v already downloaded and verified"; return 0; fi
  _key="$DIR/release-key.pub.pem"
  [ -s "$_key" ] || die "no release signing key in $_key: re-run the installer"
  _dl="$DIR/releases/.download-$_v"; rm -rf "$_dl"; mkdir -p "$_dl"
  _url="$RELEASE_BASE/download/v$_v"
  _bundle="usertasks-$_v.tar.gz"
  if [ -n "$_src" ]; then step "Checking UserTasks $_v from $_src"; else step "Downloading UserTasks $_v"; fi
  rel_get "$_src" "$_url" SHA256SUMS "$_dl/SHA256SUMS" || die "release v$_v not found at ${_src:-$_url}"
  rel_get "$_src" "$_url" SHA256SUMS.sig "$_dl/SHA256SUMS.sig" || die "release v$_v has no SHA256SUMS.sig"
  verify_sig "$_dl/SHA256SUMS" "$_dl/SHA256SUMS.sig" "$_key" || die "signature check FAILED for v$_v: SHA256SUMS was not signed by the UserTasks release key. Nothing was changed."
  ok "signature of SHA256SUMS"
  _want=$(awk -v f="$_bundle" '$2 == f || $2 == "*" f { print $1 }' "$_dl/SHA256SUMS")
  [ -n "$_want" ] || die "SHA256SUMS does not list $_bundle"
  rel_get "$_src" "$_url" "$_bundle" "$_dl/$_bundle" || die "could not download $_bundle"
  [ "$(sha256_of "$_dl/$_bundle")" = "$_want" ] || die "checksum mismatch for $_bundle: the download is damaged or was changed. Nothing was changed."
  ok "checksum of $_bundle"
  mkdir -p "$_dl/x"; tar -xzf "$_dl/$_bundle" -C "$_dl/x"
  [ -f "$_dl/x/usertasks-$_v/manifest.json" ] || die "$_bundle has no manifest.json"
  _mv=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$_dl/x/usertasks-$_v/manifest.json" | head -n 1)
  [ "$_mv" = "$_v" ] || die "$_bundle is version $_mv, not $_v"
  cp "$_dl/SHA256SUMS" "$_dl/SHA256SUMS.sig" "$_dl/x/usertasks-$_v/"
  : > "$_dl/x/usertasks-$_v/.verified"
  rm -rf "$_dest"; mv "$_dl/x/usertasks-$_v" "$_dest"; rm -rf "$_dl"
}

# rel_get <local folder or ""> <release url> <file> <dest>
rel_get() {
  if [ -n "$1" ]; then [ -f "$1/$3" ] && cp "$1/$3" "$4"; else http_get "$2/$3" "$4"; fi
}

manifest_get() { # <release dir> <key>
  sed -n "s/.*\"$2\": *\"\([^\"]*\)\".*/\1/p" "$1/manifest.json" | head -n 1
}

# The image a release runs: USERTASKS_IMAGE overrides; else image@digest when the manifest pins one.
release_image() {
  if [ -n "${USERTASKS_IMAGE_OVERRIDE:-}" ]; then printf '%s' "$USERTASKS_IMAGE_OVERRIDE"; return; fi
  _i=$(manifest_get "$1" image); _d=$(manifest_get "$1" imageDigest)
  if [ -n "$_d" ]; then printf '%s@%s' "$_i" "$_d"; else printf '%s' "$_i"; fi
}

# ── editions: licence-gated images (--edition sharepoint) ───────────────────
# An edition is UserTasks with a paid extension compiled in. Its image is not
# public: usertasks.com checks the licence and hands out a 30-minute,
# read-only credential for its registry front (POST <api>/<edition>/pull-token)
# together with the edition manifest (edition.json) signed by the release key.
# The image is pulled by the signed digest, checked against it and tagged
# <registry>/<repository>:<edition version>. The credential is used once
# (docker login, pull, docker logout) and never written to the install folder.

EDITION_API=${USERTASKS_EDITION_API:-https://usertasks.com/api/public/extensions}

valid_edition() { case "$1" in sharepoint) return 0 ;; *) return 1 ;; esac; }
edition_name() { case "$1" in sharepoint) printf 'UserTasks for SharePoint Server' ;; *) printf 'the %s edition' "$1" ;; esac; }

# json_field <key> <file>: a string value of a (flat) JSON object, unescaped.
json_field() {
  _jf=$(sed -nE "s/.*\"$1\": *\"(([^\"\\\\]|\\\\.)*)\".*/\\1/p" "$2" | head -n 1 | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g')
  printf '%s\n' "$_jf"
}
json_bool() { _jf=$(sed -nE "s/.*\"$1\": *(true|false).*/\\1/p" "$2" | head -n 1); printf '%s\n' "$_jf"; }

b64_encode() { # <file>: base64 on one line
  if have base64; then base64 < "$1" | tr -d '\n\r'; else openssl base64 -A < "$1"; fi
}
b64_decode() { # <in> <out>
  base64 -d < "$1" > "$2" 2>/dev/null || base64 -D < "$1" > "$2" 2>/dev/null || openssl base64 -d -A < "$1" > "$2"
}

http_post_json() { # <url> <body file> <out file>: prints the HTTP status (000: not reached)
  if have curl; then
    _hc=$(curl -sS --retry 2 --connect-timeout 20 --max-time 120 -o "$3" -w '%{http_code}' -A "usertasks-installer/sh" \
      -H 'Content-Type: application/json' --data-binary "@$2" "$1" 2>/dev/null) || true
    printf '%s' "${_hc:-000}"
  elif wget -q --content-on-error -O "$3" -U "usertasks-installer/sh" --header='Content-Type: application/json' --post-file="$2" "$1" 2>/dev/null; then printf 200
  elif [ -s "$3" ]; then printf 400
  else printf 000; fi
}

# edition_latest_core <edition>: the UserTasks version of the newest edition build (empty if unknown).
edition_latest_core() {
  _f="$DIR/.edition-latest.json"
  if http_get "$EDITION_API/$1" "$_f" 2>/dev/null; then
    _lv=$(json_field latest_core_version "$_f"); rm -f "$_f"
    if valid_version "$_lv"; then printf '%s' "$_lv"; fi
  else rm -f "$_f"; fi
  return 0
}

# edition_licence <edition> [file]: the licence to send, kept as licences/<edition>.licence.
# An explicit file wins; else the licence installed in UserTasks (usertasks-admin
# licence export, so a renewal made in Settings → Licence counts); else the kept copy.
edition_licence() {
  _keep="$DIR/licences/$1.licence"
  mkdir -p "$DIR/licences"; chmod 700 "$DIR/licences"
  if [ -n "${2:-}" ]; then
    [ -f "$2" ] || die "licence file not found: $2"
    (umask 077; cp "$2" "$_keep.tmp"); mv "$_keep.tmp" "$_keep"
  elif [ -n "${IMAGE:-}" ] && [ -n "${PROJECT:-}" ] && [ -f "$DIR/state.env" ] && (umask 077; admin licence export --ext "$(edition_extension "$1")" > "$_keep.tmp" 2>/dev/null) && grep -q '"licence_id"' "$_keep.tmp"; then
    mv "$_keep.tmp" "$_keep"
  fi
  rm -f "$_keep.tmp"
  [ -s "$_keep" ] || die "$(edition_name "$1") needs a licence: pass --licence <file> (your trial or purchased .licence file; start a trial at https://usertasks.com/sharepoint/trial)"
  printf '%s' "$_keep"
}
edition_extension() { case "$1" in sharepoint) printf 'sharepoint' ;; *) printf '%s' "$1" ;; esac; }

# edition_request <edition> <licence file> <version|latest> <purpose> <work dir> <release key>
# Sets ED_* (registry, repository, credential, versions, digest) and leaves the
# verified edition.json and edition.json.sig in <work dir>. Returns 1 with
# EDITION_ERROR set when refused (licence expired, no build, offline…).
edition_request() {
  _er_ed=$1; _er_lic=$2; _er_ver=$3; _er_w=$5; _er_key=$6
  EDITION_ERROR=""; EDITION_ERROR_CODE=""
  mkdir -p "$_er_w"; chmod 700 "$_er_w"
  { printf '{"licence":"'; b64_encode "$_er_lic"; printf '","version":"%s","purpose":"%s"}' "$_er_ver" "$4"; } > "$_er_w/request.json"
  step "Checking the licence with usertasks.com ($(edition_name "$_er_ed"))"
  _er_code=$(http_post_json "$EDITION_API/$_er_ed/pull-token" "$_er_w/request.json" "$_er_w/token.json")
  rm -f "$_er_w/request.json"
  if [ "$_er_code" != 200 ]; then
    EDITION_ERROR_CODE=$(json_field code "$_er_w/token.json" 2>/dev/null || true)
    EDITION_ERROR=$(json_field error "$_er_w/token.json" 2>/dev/null || true)
    [ "$_er_code" != 000 ] || EDITION_ERROR="could not reach $EDITION_API (check the network or proxy settings; offline hosts: usertasks bundle-download on a connected machine)"
    EDITION_ERROR=${EDITION_ERROR:-the download was refused (HTTP $_er_code)}
    rm -f "$_er_w/token.json"; return 1
  fi
  _t="$_er_w/token.json"
  ED_EDITION=$_er_ed; ED_WORK=$_er_w; ED_AT=$(date +%s)
  ED_REGISTRY=$(json_field registry "$_t"); ED_REPO=$(json_field repository "$_t")
  ED_USER=$(json_field username "$_t"); ED_PASS=$(json_field password "$_t")
  ED_VERSION=$(json_field edition_version "$_t"); ED_CORE=$(json_field core_version "$_t"); ED_DIGEST=$(json_field index_digest "$_t")
  ED_LICENCE_EXPIRES=$(json_field licence_expires_at "$_t"); ED_TRIAL=$(json_bool trial "$_t")
  json_field edition_manifest "$_t" > "$_er_w/edition.json.b64"; json_field edition_signature "$_t" > "$_er_w/edition.json.sig.b64"
  rm -f "$_t"
  if ! printf '%s' "$ED_REGISTRY" | grep -Eq '^[a-z0-9.-]+(:[0-9]+)?$' || ! printf '%s' "$ED_REPO" | grep -Eq '^[a-z0-9][a-z0-9/._-]*$' \
    || ! printf '%s' "$ED_DIGEST" | grep -Eq '^sha256:[0-9a-f]{64}$' || ! valid_version "$ED_CORE" || [ -z "$ED_PASS" ]; then
    EDITION_ERROR="usertasks.com sent an answer this installer does not understand"; return 1
  fi
  if ! b64_decode "$_er_w/edition.json.b64" "$_er_w/edition.json" || ! b64_decode "$_er_w/edition.json.sig.b64" "$_er_w/edition.json.sig"; then
    EDITION_ERROR="the edition manifest could not be read"; return 1
  fi
  rm -f "$_er_w/edition.json.b64" "$_er_w/edition.json.sig.b64"
  edition_manifest_check "$_er_w" "$_er_key" "$_er_ed" || return 1
  if [ "$(json_field edition_version "$_er_w/edition.json")" != "$ED_VERSION" ] || [ "$(json_field index_digest "$_er_w/edition.json")" != "$ED_DIGEST" ] || [ "$(json_field core_version "$_er_w/edition.json")" != "$ED_CORE" ]; then
    EDITION_ERROR="the download details do not match the signed edition manifest"; return 1
  fi
  if [ "$_er_ver" != latest ] && [ "$_er_ver" != "$ED_CORE" ] && [ "$_er_ver" != "$ED_VERSION" ]; then
    EDITION_ERROR="asked for $_er_ver but got the edition for $ED_CORE"; return 1
  fi
  ok "licence accepted$( [ "$ED_TRIAL" = true ] && printf ' (trial)' )${ED_LICENCE_EXPIRES:+, valid until $ED_LICENCE_EXPIRES}; edition $ED_VERSION"
}

# edition_manifest_check <dir> <release key> <edition>: edition.json signed by the release key, for <edition>.
edition_manifest_check() {
  if ! verify_sig "$1/edition.json" "$1/edition.json.sig" "$2"; then
    EDITION_ERROR="signature check FAILED: edition.json was not signed by the UserTasks release key"; return 1
  fi
  if [ "$(json_field kind "$1/edition.json")" != usertasks.edition ] || [ "$(json_field edition "$1/edition.json")" != "$3" ]; then
    EDITION_ERROR="edition.json is not a $(edition_name "$3") manifest"; return 1
  fi
  ok "signature of the edition manifest"
}

# edition_image_ok <image> <edition.json>: the image is one the signed manifest names
# (config digest on Docker's classic store, index / manifest digest on containerd's).
edition_image_ok() {
  _eid=$(docker image inspect --format '{{.Id}}' "$1" 2>/dev/null) || return 1
  case "$_eid" in sha256:*) grep -q "\"$_eid\"" "$2" ;; *) return 1 ;; esac
}

# edition_pull [platform]: pull ED_* by its signed digest, check it, tag it. Sets EDITION_IMAGE.
edition_pull() {
  _ep_ref="$ED_REGISTRY/$ED_REPO@$ED_DIGEST"; EDITION_IMAGE="$ED_REGISTRY/$ED_REPO:$ED_VERSION"
  if [ -z "${1:-}" ] && edition_image_ok "$EDITION_IMAGE" "$ED_WORK/edition.json"; then ok "image $EDITION_IMAGE is present and matches the signed manifest"; return 0; fi
  step "Pulling $(edition_name "$ED_EDITION") $ED_VERSION"
  if ! printf '%s' "$ED_PASS" | docker login "$ED_REGISTRY" -u "$ED_USER" --password-stdin >/dev/null 2>&1; then
    EDITION_ERROR="docker login to $ED_REGISTRY failed (the download credential may have expired: run the command again)"; return 1
  fi
  _ep_rc=0
  if [ -n "${1:-}" ]; then docker pull --platform "$1" "$_ep_ref" || _ep_rc=$?; else docker pull "$_ep_ref" || _ep_rc=$?; fi
  docker logout "$ED_REGISTRY" >/dev/null 2>&1 || true
  ED_PASS=""
  [ "$_ep_rc" = 0 ] || { EDITION_ERROR="could not pull the $(edition_name "$ED_EDITION") image from $ED_REGISTRY"; return 1; }
  edition_image_ok "$_ep_ref" "$ED_WORK/edition.json" || { EDITION_ERROR="the pulled image is not the one the signed edition manifest names: not used"; return 1; }
  docker tag "$_ep_ref" "$EDITION_IMAGE"
  ok "image verified against the signed manifest ($ED_DIGEST)"
}

# edition_fetch <edition> <licence file> <version|latest> <purpose>: request + pull for this
# install; the manifest is kept in editions/<edition version>/. Sets EDITION_IMAGE, ED_*.
edition_fetch() {
  _ef_w="$DIR/editions/.request"; rm -rf "$_ef_w"
  edition_request "$1" "$2" "$3" "$4" "$_ef_w" "$DIR/release-key.pub.pem" || return 1
  edition_keep_manifest
  edition_pull
}
edition_keep_manifest() {
  _ek="$DIR/editions/$ED_VERSION"
  if [ "$ED_WORK" != "$_ek" ]; then rm -rf "$_ek"; mkdir -p "$DIR/editions"; mv "$ED_WORK" "$_ek"; ED_WORK=$_ek; fi
}
# A request older than 25 minutes is asked again (the credential lasts 30).
edition_refresh() { # <licence file> <version> <purpose>
  if [ $(( $(date +%s) - ${ED_AT:-0} )) -gt 1500 ]; then edition_fetch "$ED_EDITION" "$1" "$2" "$3"; else edition_keep_manifest; edition_pull; fi
}

# edition_install_licence <licence file>: into UserTasks (Settings → Licence); never fatal.
edition_install_licence() {
  [ -s "${1:-}" ] || return 0
  if admin licence install /dev/stdin < "$1" >/dev/null 2>&1; then ok "licence installed in UserTasks (Settings → Licence)"
  else warn "could not install the licence automatically: add it in Settings → Licence"; fi
}

# ── offline bundles (air-gapped editions) ───────────────────────────────────
# usertasks-edition-<edition>-<edition version>-linux-<arch>.tar:
#   bundle.json            edition, versions, platform, images
#   release/               the UserTasks release: SHA256SUMS(.sig) signed by the release key,
#                          usertasks-<version>.tar.gz, install.sh, install.ps1
#   edition.json(.sig)     the edition manifest, signed by the release key
#   images.tar             docker save: the edition image + the bundled services' images
#   SHA256SUMS.bundle      checksums of all of the above (transfer integrity)
# Made by `usertasks bundle-download` on a connected machine (same licence
# check); installed with `sh install.sh --bundle <file>` (or `usertasks upgrade
# --bundle <file>`), which verifies the release and edition signatures and the
# loaded image against the signed digests.

# bundle_open <file>: unpack into releases/.bundle and check it. Sets BUNDLE_DIR and BUNDLE_* fields.
bundle_open() {
  [ -f "$1" ] || die "bundle not found: $1"
  _bo="$DIR/releases/.bundle"; rm -rf "$_bo"; mkdir -p "$_bo"
  step "Unpacking $(basename "$1")"
  tar -xf "$1" -C "$_bo" || die "could not unpack $1"
  BUNDLE_DIR=$(find "$_bo" -mindepth 2 -maxdepth 2 -name bundle.json -exec dirname {} \; | head -n 1)
  [ -n "$BUNDLE_DIR" ] || die "$1 is not a UserTasks offline bundle (no bundle.json)"
  bundle_check "$BUNDLE_DIR"
}

# bundle_check <dir>: every file listed in SHA256SUMS.bundle is there and intact.
bundle_check() {
  [ -f "$1/SHA256SUMS.bundle" ] || die "the bundle has no SHA256SUMS.bundle"
  while read -r _bs _bf; do
    case "$_bf" in ""|/*|*..*) die "SHA256SUMS.bundle lists an unexpected path: $_bf" ;; esac
    [ -f "$1/$_bf" ] || die "the bundle is missing $_bf"
    [ "$(sha256_of "$1/$_bf")" = "$_bs" ] || die "checksum mismatch for $_bf: the bundle is damaged or was changed"
  done < "$1/SHA256SUMS.bundle"
  ok "bundle checksums"
  BUNDLE_EDITION=$(json_field edition "$1/bundle.json"); BUNDLE_VERSION=$(json_field core_version "$1/bundle.json")
  BUNDLE_EDITION_VERSION=$(json_field edition_version "$1/bundle.json"); BUNDLE_IMAGE=$(json_field image "$1/bundle.json")
  valid_edition "$BUNDLE_EDITION" || die "the bundle is for an unknown edition: $BUNDLE_EDITION"
  valid_version "$BUNDLE_VERSION" || die "the bundle has no valid UserTasks version"
}

# bundle_load <dir>: edition manifest signature, docker load, image check. Sets IMAGE, ED_*.
bundle_load() {
  edition_manifest_check "$1" "$DIR/release-key.pub.pem" "$BUNDLE_EDITION" || die "$EDITION_ERROR. Nothing was installed."
  [ "$(json_field edition_version "$1/edition.json")" = "$BUNDLE_EDITION_VERSION" ] && [ "$(json_field core_version "$1/edition.json")" = "$BUNDLE_VERSION" ] \
    || die "bundle.json does not match the signed edition manifest"
  case "$BUNDLE_IMAGE" in *:"$BUNDLE_EDITION_VERSION") : ;; *) die "bundle.json names an unexpected image: $BUNDLE_IMAGE" ;; esac
  step "Loading the images (docker load)"
  docker load -i "$1/images.tar" >/dev/null || die "docker load failed"
  edition_image_ok "$BUNDLE_IMAGE" "$1/edition.json" || die "the loaded image $BUNDLE_IMAGE is not the one the signed edition manifest names. Nothing was started."
  ok "image $BUNDLE_IMAGE verified against the signed manifest"
  ED_EDITION=$BUNDLE_EDITION; ED_VERSION=$BUNDLE_EDITION_VERSION; ED_CORE=$BUNDLE_VERSION
  _bk="$DIR/editions/$ED_VERSION"; rm -rf "$_bk"; mkdir -p "$_bk"; cp "$1/edition.json" "$1/edition.json.sig" "$_bk/"; ED_WORK=$_bk
  IMAGE=$BUNDLE_IMAGE
}

# usertasks bundle-download --edition <e> --licence <file> [--version <v>] [--platform linux/amd64|linux/arm64]
#                           [--out <file.tar>] [--no-deps] [--work <folder>]
cmd_bundle_download() {
  _bd_ed=""; _bd_lic=""; _bd_ver=""; _bd_plat=""; _bd_out=""; _bd_deps=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --edition) _bd_ed=$2; shift 2 ;; --licence|--license) _bd_lic=$2; shift 2 ;; --version) _bd_ver=${2#v}; shift 2 ;;
      --platform) _bd_plat=$2; shift 2 ;; --out) _bd_out=$2; shift 2 ;; --no-deps) _bd_deps=0; shift ;; --work) shift 2 ;;
      *) die "bundle-download: unknown option $1" ;;
    esac
  done
  valid_edition "$_bd_ed" || die "bundle-download: --edition sharepoint is required"
  if [ -n "$_bd_lic" ]; then [ -f "$_bd_lic" ] || die "licence file not found: $_bd_lic"; _bd_lic=$(cd "$(dirname "$_bd_lic")" && pwd)/$(basename "$_bd_lic")
  elif [ -f "$DIR/state.env" ]; then _bd_lic=$(edition_licence "$_bd_ed")
  else die "bundle-download: --licence <file> is required"; fi
  have docker || die "bundle-download needs Docker on this (connected) machine"
  if [ -z "$_bd_plat" ]; then
    case "$(docker version --format '{{.Server.Arch}}' 2>/dev/null)" in arm64|aarch64) _bd_plat=linux/arm64 ;; *) _bd_plat=linux/amd64 ;; esac
  fi
  case "$_bd_plat" in linux/amd64|linux/arm64) : ;; *) die "--platform must be linux/amd64 or linux/arm64" ;; esac
  [ -n "$_bd_ver" ] || _bd_ver=$(edition_latest_core "$_bd_ed")
  [ -n "$_bd_ver" ] || die "could not find the newest $(edition_name "$_bd_ed") build: pass --version <x.y.z>"
  valid_version "$_bd_ver" || die "not a version: $_bd_ver"
  _bd_key="$DIR/release-key.pub.pem"; [ -s "$_bd_key" ] || die "no release signing key in $_bd_key (use the installer: curl -fsSL https://usertasks.com/install.sh | sh -s -- --bundle-download …)"

  _bd_w="$DIR/editions/.bundle-request"; rm -rf "$_bd_w"
  edition_request "$_bd_ed" "$_bd_lic" "$_bd_ver" bundle "$_bd_w" "$_bd_key" || die "$EDITION_ERROR"
  _bd_name="usertasks-edition-$_bd_ed-$ED_VERSION-$(printf '%s' "$_bd_plat" | tr '/' '-')"
  _bd_out=${_bd_out:-$PWD/$_bd_name.tar}
  _bd_stage="$DIR/editions/.bundle-stage"; rm -rf "$_bd_stage"; mkdir -p "$_bd_stage/$_bd_name/release"
  _bd_s="$_bd_stage/$_bd_name"

  # The UserTasks release, as published (signed SHA256SUMS + the files it lists).
  _bd_url="$RELEASE_BASE/download/v$ED_CORE"
  step "Downloading UserTasks $ED_CORE (release files)"
  http_get "$_bd_url/SHA256SUMS" "$_bd_s/release/SHA256SUMS" || die "release v$ED_CORE not found at $_bd_url"
  http_get "$_bd_url/SHA256SUMS.sig" "$_bd_s/release/SHA256SUMS.sig" || die "release v$ED_CORE has no SHA256SUMS.sig"
  verify_sig "$_bd_s/release/SHA256SUMS" "$_bd_s/release/SHA256SUMS.sig" "$_bd_key" || die "signature check FAILED for release v$ED_CORE"
  for _bd_f in "usertasks-$ED_CORE.tar.gz" install.sh install.ps1; do
    _bd_want=$(awk -v f="$_bd_f" '$2 == f || $2 == "*" f { print $1 }' "$_bd_s/release/SHA256SUMS")
    [ -n "$_bd_want" ] || die "SHA256SUMS does not list $_bd_f"
    http_get "$_bd_url/$_bd_f" "$_bd_s/release/$_bd_f" || die "could not download $_bd_f"
    [ "$(sha256_of "$_bd_s/release/$_bd_f")" = "$_bd_want" ] || die "checksum mismatch for $_bd_f"
  done
  ok "release $ED_CORE (signature + checksums)"

  edition_pull "$_bd_plat" || die "$EDITION_ERROR"
  _bd_imgs=$EDITION_IMAGE
  if [ "$_bd_deps" = 1 ]; then
    mkdir -p "$_bd_stage/x"; tar -xzf "$_bd_s/release/usertasks-$ED_CORE.tar.gz" -C "$_bd_stage/x"
    _bd_rel="$_bd_stage/x/usertasks-$ED_CORE"
    for _bd_i in $(USERTASKS_IMAGE="$EDITION_IMAGE" docker compose -f "$_bd_rel/docker-compose.yml" --env-file "$_bd_rel/env.template" --profile standalone config --images 2>/dev/null | sort -u); do
      [ "$_bd_i" = "$EDITION_IMAGE" ] && continue
      step "Pulling $_bd_i ($_bd_plat)"
      docker pull --platform "$_bd_plat" "$_bd_i" >/dev/null || die "could not pull $_bd_i"
      _bd_imgs="$_bd_imgs $_bd_i"
    done
    rm -rf "$_bd_stage/x"
  fi
  cp "$ED_WORK/edition.json" "$ED_WORK/edition.json.sig" "$_bd_s/"
  step "Saving the images ($(printf '%s' "$_bd_imgs" | wc -w | tr -d ' '))"
  # shellcheck disable=SC2086 # one word per image
  docker save -o "$_bd_s/images.tar" $_bd_imgs || die "docker save failed"
  {
    printf '{\n  "format": 1,\n  "kind": "usertasks.bundle",\n  "edition": "%s",\n  "edition_version": "%s",\n' "$_bd_ed" "$ED_VERSION"
    printf '  "core_version": "%s",\n  "platform": "%s",\n  "image": "%s",\n  "images": "%s",\n  "created_at": "%s"\n}\n' "$ED_CORE" "$_bd_plat" "$EDITION_IMAGE" "$_bd_imgs" "$(now_stamp)"
  } > "$_bd_s/bundle.json"
  (cd "$_bd_s" && for _bd_f in bundle.json edition.json edition.json.sig images.tar release/SHA256SUMS release/SHA256SUMS.sig "release/usertasks-$ED_CORE.tar.gz" release/install.sh release/install.ps1; do
    printf '%s  %s\n' "$(sha256_of "$_bd_f")" "$_bd_f"; done) > "$_bd_s/SHA256SUMS.bundle"
  step "Writing $_bd_out"
  tar -cf "$_bd_out.tmp" -C "$_bd_stage" "$_bd_name" && mv "$_bd_out.tmp" "$_bd_out"
  rm -rf "$_bd_stage" "$ED_WORK"
  sha256_of "$_bd_out" > "$_bd_out.sha256"
  say ""
  say "${G}${B}Offline bundle ready:${N} $_bd_out ($(du -h "$_bd_out" | cut -f1 | tr -d ' '))"
  say "  sha256:   $(cat "$_bd_out.sha256")  (also in $(basename "$_bd_out").sha256: compare it on the offline host)"
  say "  contents: $(edition_name "$_bd_ed") $ED_VERSION ($_bd_plat), UserTasks $ED_CORE release, $(printf '%s' "$_bd_imgs" | wc -w | tr -d ' ') images"
  say "On the offline host (Docker installed), with the bundle and your licence file:"
  say "  tar -xOf $(basename "$_bd_out") $_bd_name/release/install.sh > install.sh"
  say "  sh install.sh --bundle $(basename "$_bd_out") --licence <your .licence file>"
  say "Upgrades: the same with a newer bundle, then: usertasks upgrade --bundle <file>"
}

# ── service choices (the install profile) ───────────────────────────────────
# The answers become an install profile (docs/install-profile.md): images with
# `usertasks-admin install profile` validate it, check external services and
# write the settings; older images fall back to the same mapping here, which
# matches deploy/compose/standalone.env.example. Docker installs use placement
# "env": the containers (app, worker, migrate) all read the same .env.

profile_cli_available() { # <image>
  docker run --rm --network none --entrypoint node "$1" admin.cjs --help 2>/dev/null | grep -q 'usertasks-admin install presets'
}

choose_preset() {
  _cur=${1:-standalone}
  if [ -n "${USERTASKS_PRESET_CHOICE:-}" ]; then printf '%s' "$USERTASKS_PRESET_CHOICE"; return; fi
  if interactive; then
    {
      say ""
      say "${B}Which services should UserTasks use?${N}"
      say "  1) Everything in containers (recommended): PostgreSQL, file storage (MinIO), email test inbox, worker"
      say "  2) Your own PostgreSQL server; the rest in containers"
      say "  3) A Supabase project (database, sign-in, files) with the app in a container"
      say "  4) Custom: choose each service"
    } > /dev/tty
  fi
  case "$_cur" in standalone) _n=1 ;; postgres) _n=2 ;; supabase) _n=3 ;; *) _n=4 ;; esac
  case "$(ask "Choose 1-4" "$_n")" in
    1|standalone) echo standalone ;; 2|postgres) echo postgres ;; 3|supabase) echo supabase ;; 4|custom) echo custom ;;
    *) die "unknown choice" ;;
  esac
}

# ask_profile: sets PRESET, PROFILES and the A_* answers.
ask_profile() {
  PRESET=$(choose_preset "${PRESET:-standalone}")
  PROFILES=standalone; A_DB=bundled; A_DB_URL=""; A_STORAGE=minio; A_EMAIL=mailpit
  A_S3_ENDPOINT=""; A_S3_REGION=us-east-1; A_S3_KEY=""; A_S3_SECRET=""
  A_SMTP_HOST=""; A_SMTP_PORT=587; A_SMTP_USER=""; A_SMTP_PASS=""; A_FROM="UserTasks <noreply@usertasks.local>"
  A_SB_URL=""; A_SB_ANON=""; A_SB_SERVICE=""
  case "$PRESET" in
    standalone) : ;;
    postgres) ask_database_url ;;
    supabase)
      PROFILES=""; A_DB=supabase; A_STORAGE=supabase; A_EMAIL=console
      A_SB_URL=$(ask "Supabase project URL (https://<ref>.supabase.co)" "${USERTASKS_SUPABASE_URL:-}"); [ -n "$A_SB_URL" ] || die "a Supabase URL is required"
      A_SB_ANON=${USERTASKS_SUPABASE_ANON_KEY:-$(ask_secret "Supabase anon (publishable) key")}
      A_SB_SERVICE=${USERTASKS_SUPABASE_SERVICE_ROLE_KEY:-$(ask_secret "Supabase service role (secret) key")}
      if [ -z "$A_SB_ANON" ] || [ -z "$A_SB_SERVICE" ]; then die "the Supabase keys are required"; fi
      A_DB_URL=${USERTASKS_DATABASE_URL:-$(ask_secret "Database connection string (Project settings → Database; used for migrations and backups)")}
      [ -n "$A_DB_URL" ] || die "the database connection string is required (migrations and backups use it)"
      if interactive; then say "Email: set up Resend, SMTP or Microsoft 365 later in Settings → Infrastructure (until then emails go to the log)." > /dev/tty; fi
      ;;
    custom)
      case "$(ask "Database: 1) PostgreSQL in a container  2) your own PostgreSQL" 1)" in 2) ask_database_url ;; esac
      case "$(ask "Files: 1) MinIO in a container  2) your S3-compatible bucket" 1)" in
        2) A_STORAGE=s3; A_S3_ENDPOINT=$(ask "S3 endpoint (blank for AWS S3)" ""); A_S3_REGION=$(ask "S3 region" us-east-1)
           A_S3_KEY=$(ask "S3 access key id" ""); A_S3_SECRET=$(ask_secret "S3 secret access key") ;;
      esac
      case "$(ask "Email: 1) test inbox in a container (Mailpit)  2) your SMTP relay" 1)" in
        2) A_EMAIL=smtp; A_SMTP_HOST=$(ask "SMTP host" ""); A_SMTP_PORT=$(ask "SMTP port" 587); A_FROM=$(ask "From address" "UserTasks <tasks@example.com>")
           A_SMTP_USER=$(ask "SMTP user (blank for none)" ""); [ -z "$A_SMTP_USER" ] || A_SMTP_PASS=$(ask_secret "SMTP password") ;;
      esac
      if interactive; then say "Sign-in: built-in accounts. Add SSO (Entra ID, AD FS, OIDC, SAML) later in Settings → Infrastructure." > /dev/tty; fi
      ;;
  esac
}

ask_database_url() {
  A_DB=own
  A_DB_URL=${USERTASKS_DATABASE_URL:-$(ask_secret "PostgreSQL connection string (postgresql://user:password@host:5432/db)")}
  case "$A_DB_URL" in postgres://*|postgresql://*) : ;; *) die "expected a postgresql:// connection string" ;; esac
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

# The install profile (docs/install-profile.md) for the answers; secrets come from .env.
write_profile_json() {
  _pg=$(env_get POSTGRES_PASSWORD "$ENV_FILE")
  case "$A_DB" in
    bundled) _db="{ \"provider\": \"postgres\", \"hosting\": \"bundled\", \"host\": \"postgres\", \"port\": 5432, \"database\": \"usertasks\", \"user\": \"usertasks\", \"password\": $(json_str "$_pg"), \"sslmode\": \"disable\" }" ;;
    own) _db="{ \"provider\": \"postgres\", \"hosting\": \"own\", \"url\": $(json_str "$A_DB_URL") }" ;;
    supabase) _db="{ \"provider\": \"supabase\", \"url\": $(json_str "$A_DB_URL") }" ;;
  esac
  case "$A_STORAGE" in
    minio) _st="{ \"provider\": \"s3\", \"options\": { \"endpoint\": \"http://minio:9000\", \"region\": \"us-east-1\", \"access_key_id\": \"usertasks\", \"secret_access_key\": $(json_str "$(env_get S3_SECRET_ACCESS_KEY "$ENV_FILE")"), \"force_path_style\": \"true\" } }" ;;
    s3) _st="{ \"provider\": \"s3\", \"options\": { \"endpoint\": $(json_str "$A_S3_ENDPOINT"), \"region\": $(json_str "$A_S3_REGION"), \"access_key_id\": $(json_str "$A_S3_KEY"), \"secret_access_key\": $(json_str "$A_S3_SECRET"), \"force_path_style\": \"$( [ -n "$A_S3_ENDPOINT" ] && echo true || echo false )\" } }" ;;
    supabase) _st='{ "provider": "supabase" }' ;;
  esac
  case "$A_EMAIL" in
    mailpit) _em="{ \"provider\": \"smtp\", \"smtpPreset\": \"mailpit\", \"options\": { \"smtp_host\": \"mailpit\", \"smtp_port\": \"1025\", \"from\": $(json_str "$A_FROM") } }" ;;
    smtp) _em="{ \"provider\": \"smtp\", \"options\": { \"smtp_host\": $(json_str "$A_SMTP_HOST"), \"smtp_port\": $(json_str "$A_SMTP_PORT"), \"from\": $(json_str "$A_FROM")$( [ -n "$A_SMTP_USER" ] && printf ', "smtp_user": %s, "smtp_password": %s' "$(json_str "$A_SMTP_USER")" "$(json_str "$A_SMTP_PASS")" ) } }" ;;
    console) _em='{ "provider": "console" }' ;;
  esac
  if [ "$A_DB" = supabase ]; then
    _auth='{ "provider": "supabase" }'; _rt='{ "provider": "supabase" }'; _sch='{ "provider": "worker", "options": { "in_process": "true" } }'; _cache='{ "provider": "postgres" }'
    _sb=", \"supabase\": { \"url\": $(json_str "$A_SB_URL"), \"anonKey\": $(json_str "$A_SB_ANON"), \"serviceRoleKey\": $(json_str "$A_SB_SERVICE") }"
  else
    _auth='{ "provider": "builtin" }'; _rt='{ "provider": "sse" }'; _sch='{ "provider": "worker", "options": { "in_process": "false" } }'; _sb=""
    _cache="{ \"provider\": \"redis\", \"options\": { \"redis_url\": \"redis://valkey:6379\", \"redis_password\": $(json_str "$(env_get CACHE_REDIS_PASSWORD "$ENV_FILE")") } }"
  fi
  (umask 077; cat > "$DIR/profile.json.tmp") <<JSON
{
  "version": 1,
  "placement": "env",
  "app": { "url": $(json_str "$(env_get APP_URL "$ENV_FILE")"), "port": $(env_get APP_PORT "$ENV_FILE") },
  "database": $_db,
  "auth": $_auth,
  "storage": $_st,
  "email": $_em,
  "scheduler": $_sch,
  "realtime": $_rt,
  "cache": $_cache$_sb
}
JSON
  mv "$DIR/profile.json.tmp" "$DIR/profile.json"
}

# The same mapping for images without the profile command (KEY=value lines).
fallback_env() {
  case "$A_DB" in
    own) for _k in DATABASE_URL MIGRATION_DATABASE_URL REALTIME_DATABASE_URL SCHEDULER_DATABASE_URL; do printf '%s=%s\n' "$_k" "$A_DB_URL"; done ;;
    supabase)
      for _k in DB_PROVIDER AUTH_PROVIDER STORAGE_PROVIDER REALTIME_PROVIDER; do printf '%s=supabase\n' "$_k"; done
      printf 'NEXT_PUBLIC_SUPABASE_URL=%s\nNEXT_PUBLIC_SUPABASE_ANON_KEY=%s\nSUPABASE_SERVICE_ROLE_KEY=%s\n' "$A_SB_URL" "$A_SB_ANON" "$A_SB_SERVICE"
      printf 'MIGRATION_DATABASE_URL=%s\nSCHEDULER_DATABASE_URL=%s\nSCHEDULER_IN_PROCESS=true\nCACHE_PROVIDER=postgres\n' "$A_DB_URL" "$A_DB_URL" ;;
  esac
  if [ "$A_STORAGE" = s3 ]; then
    printf 'S3_ENDPOINT=%s\nS3_REGION=%s\nS3_ACCESS_KEY_ID=%s\nS3_SECRET_ACCESS_KEY=%s\nS3_FORCE_PATH_STYLE=%s\n' "$A_S3_ENDPOINT" "$A_S3_REGION" "$A_S3_KEY" "$A_S3_SECRET" "$( [ -n "$A_S3_ENDPOINT" ] && echo true || echo false )"
  fi
  case "$A_EMAIL" in
    smtp) printf 'SMTP_HOST=%s\nSMTP_PORT=%s\nEMAIL_FROM=%s\nSMTP_STARTTLS=auto\n' "$A_SMTP_HOST" "$A_SMTP_PORT" "$A_FROM"
          [ -z "$A_SMTP_USER" ] || printf 'SMTP_USER=%s\nSMTP_PASSWORD=%s\n' "$A_SMTP_USER" "$A_SMTP_PASS" ;;
    console) printf 'EMAIL_PROVIDER=console\n' ;;
  esac
}

# Areas outside the Compose stack, checked before anything starts.
external_areas() {
  _a=""
  [ "$A_DB" = bundled ] || _a="$_a,database"
  [ "$A_STORAGE" != s3 ] || _a="$_a,storage"
  [ "$A_EMAIL" != smtp ] || _a="$_a,email"
  [ "$A_DB" != supabase ] || _a="$_a,supabase"
  printf '%s' "${_a#,}"
}

# apply_profile <image>: the answers into .env. Secrets already there are kept.
apply_profile() {
  if profile_cli_available "$1"; then
    write_profile_json
    step "Checking the service choices (usertasks-admin install profile)"
    _out=$(docker run --rm -u "$(id -u):$(id -g)" -v "$DIR:/work" --entrypoint node "$1" admin.cjs install profile validate --from /work/profile.json 2>&1) \
      || { printf '%s\n' "$_out" >&2; die "the service choices are not valid (see above); nothing was started"; }
    _areas=$(external_areas)
    if [ -n "$_areas" ]; then
      _out=$(docker run --rm -u "$(id -u):$(id -g)" -v "$DIR:/work" --entrypoint node "$1" admin.cjs install profile check --from /work/profile.json --area "$_areas" 2>&1) \
        || { printf '%s\n' "$_out" >&2; die "a service could not be reached (see above). Fix it and run the installer again."; }
      ok "reached: $_areas"
    fi
    docker run --rm -u "$(id -u):$(id -g)" -v "$DIR:/work" --entrypoint node "$1" admin.cjs install profile write --from /work/profile.json --format env --merge "/work/$(basename "$ENV_FILE")" --out /work/.env.profile >/dev/null \
      || die "could not write the settings from the service choices"
    _updates=$(grep -E '^[A-Z][A-Z0-9_]*=' "$DIR/.env.profile"); rm -f "$DIR/.env.profile"
    ok "settings written by usertasks-admin install profile"
  else
    _updates=$(fallback_env)
  fi
  printf '%s\n' "$_updates" | while IFS= read -r _line; do
    [ -n "$_line" ] || continue
    env_set "${_line%%=*}" "${_line#*=}" "$ENV_FILE"
  done
}

# ── .env with fresh secrets ─────────────────────────────────────────────────

write_env() { # <release dir> <port> <app url>
  if [ -f "$ENV_FILE" ]; then ok ".env exists: keeping its secrets"; fill_missing_env "$1"; return; fi
  step "Generating secrets (.env)"
  _pg=$(rand_hex 18)
  (umask 077; : > "$ENV_FILE.tmp")
  sed -e "s/<POSTGRES_PASSWORD>/$_pg/g" -e "s/^POSTGRES_PASSWORD=<generate>\$/POSTGRES_PASSWORD=$_pg/" "$1/env.template" |
  while IFS= read -r _line; do
    case "$_line" in
      *"<generate>"*) printf '%s%s\n' "${_line%%<generate>*}" "$(rand_hex 32)" ;;
      *) printf '%s\n' "$_line" ;;
    esac
  done > "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  env_set APP_URL "$3" "$ENV_FILE"; env_set NEXT_PUBLIC_APP_URL "$3" "$ENV_FILE"; env_set APP_PORT "$2" "$ENV_FILE"
  env_set USERTASKS_SETUP_CODE "$(gen_setup_code)" "$ENV_FILE"
  env_set MAILPIT_PORT "$(free_port "${USERTASKS_MAILPIT_PORT:-8025}")" "$ENV_FILE"
  env_set MINIO_CONSOLE_PORT "$(free_port "${USERTASKS_MINIO_CONSOLE_PORT:-9001}")" "$ENV_FILE"
  ok "secrets written to $ENV_FILE (only your user can read it)"
}

# New settings a release adds with <generate> get a value; nothing else changes.
fill_missing_env() {
  grep '=<generate>$' "$1/env.template" | cut -d= -f1 | while IFS= read -r _k; do
    env_has "$_k" "$ENV_FILE" || { env_set "$_k" "$(rand_hex 32)" "$ENV_FILE"; ok "added a new secret: $_k"; }
  done
}

free_port() { _p=$1; while port_busy "$_p"; do _p=$((_p + 1)); done; printf '%s' "$_p"; }

# ── PATH ────────────────────────────────────────────────────────────────────

link_command() {
  if [ "$(id -u)" = 0 ]; then _bin=/usr/local/bin; else _bin="$HOME/.local/bin"; fi
  [ -n "${USERTASKS_BIN_DIR:-}" ] && _bin=$USERTASKS_BIN_DIR
  mkdir -p "$_bin"
  _name=usertasks
  if [ -e "$_bin/usertasks" ] && ! grep -q "$WRAPPER_MARK" "$_bin/usertasks" 2>/dev/null; then _name=usertasks-server
  elif [ -L "$_bin/usertasks" ] && [ "$(readlink "$_bin/usertasks")" != "$DIR/bin/usertasks" ] && grep -q "$WRAPPER_MARK" "$_bin/usertasks" 2>/dev/null; then
    warn "$_bin/usertasks points at another UserTasks install; linking this one as usertasks-$PROJECT"; _name="usertasks-$PROJECT"
  fi
  ln -sf "$DIR/bin/usertasks" "$_bin/$_name"
  LINKED="$_bin/$_name"
  case ":$PATH:" in *":$_bin:"*) : ;; *) warn "$_bin is not on your PATH: add it, or run $DIR/bin/usertasks" ;; esac
  [ "$_name" = usertasks-server ] && say "  (an existing $_bin/usertasks, probably the UserTasks CLI, was left alone: this command is usertasks-server)"
  return 0
}

install_wrapper_from() { # <release dir>
  mkdir -p "$DIR/bin"
  cp "$1/usertasks" "$DIR/bin/usertasks.new"; chmod 755 "$DIR/bin/usertasks.new"
  mv "$DIR/bin/usertasks.new" "$DIR/bin/usertasks"
}

open_browser() {
  [ "${USERTASKS_NO_BROWSER:-0}" = 1 ] && return 0
  interactive || return 0
  case "$(uname -s)" in
    Darwin) open "$1" >/dev/null 2>&1 || true ;;
    Linux) if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && have xdg-open; then xdg-open "$1" >/dev/null 2>&1 || true; fi ;;
  esac
}

# ── install (run by install.sh from a verified release) ─────────────────────

cmd_install() {
  # Called as releases/<v>/usertasks install --dir … --version …
  _port=""; _url=""; _v=""; _build=0; _edition=""; _licence=""; _bundle=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) DIR=$2; shift 2 ;; --version) _v=$2; shift 2 ;; --port) _port=$2; shift 2 ;;
      --url) _url=$2; shift 2 ;; --project) USERTASKS_PROJECT=$2; shift 2 ;; --preset) USERTASKS_PRESET_CHOICE=$2; shift 2 ;;
      --build) _build=1; shift ;; --release-base) USERTASKS_RELEASE_BASE=$2; shift 2 ;;
      --edition) _edition=$2; shift 2 ;; --licence|--license) _licence=$2; shift 2 ;; --bundle) _bundle=$2; shift 2 ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  if [ -n "$_edition" ] && [ "$_edition" != core ]; then valid_edition "$_edition" || die "unknown edition: $_edition (editions: sharepoint)"; fi
  if [ -z "$DIR" ] || [ -z "$_v" ]; then die "install: --dir and --version are required"; fi
  STATE="$DIR/state.env"; ENV_FILE="$DIR/.env"; REL="$DIR/releases/$_v"
  [ -f "$REL/manifest.json" ] || die "release $_v is not in $DIR/releases"
  lock
  _existing=0; [ -f "$STATE" ] && _existing=1
  if [ $_existing = 1 ]; then
    load_state
    if [ "$VERSION" != "$_v" ]; then
      say "UserTasks $VERSION is installed in $DIR. To move to $_v run: usertasks upgrade --to $_v"
      _v=$VERSION; REL="$DIR/releases/$VERSION"
    fi
    say "Existing install found: re-checking it (secrets and data are kept)."
    if [ -n "$_edition" ] && [ "$_edition" != "${EDITION:-core}" ] && [ -z "$_bundle" ]; then
      say "This install runs $( [ -n "$EDITION" ] && edition_name "$EDITION" || printf 'the public image' ). To switch it, keeping its data: usertasks upgrade --edition $_edition"
      _edition=""
    fi
  else
    PROJECT=${USERTASKS_PROJECT:-usertasks}
    printf '%s' "$PROJECT" | grep -Eq '^[a-z0-9][a-z0-9_-]*$' || die "project name: lowercase letters, digits, - and _"
    PRESET=""; EDITION=""; EDITION_VERSION=""
  fi
  VERSION=$_v
  _prev_image=${IMAGE:-}
  [ "$_edition" = core ] && _edition=""
  [ -n "$_edition" ] && EDITION=$_edition
  _lic_file=""
  if [ -n "$_bundle" ]; then
    # Offline bundle (unpacked and its release verified by install.sh --bundle).
    bundle_check "$_bundle"
    [ "$BUNDLE_VERSION" = "$VERSION" ] || die "the bundle is for UserTasks $BUNDLE_VERSION, not $VERSION"
    bundle_load "$_bundle"
    EDITION=$ED_EDITION; EDITION_VERSION=$ED_VERSION
    if [ -n "$_licence" ]; then _lic_file=$(edition_licence "$EDITION" "$_licence"); fi
  elif [ -n "$EDITION" ]; then
    # Licence-gated edition image: kept when this install already has it.
    if [ $_existing = 1 ] && [ -n "$_prev_image" ] && [ -z "$_licence" ] && [ -n "$EDITION_VERSION" ] && [ -f "$DIR/editions/$EDITION_VERSION/edition.json" ] \
      && edition_image_ok "$_prev_image" "$DIR/editions/$EDITION_VERSION/edition.json"; then
      IMAGE=$_prev_image
    else
      _lic_file=$(edition_licence "$EDITION" "$_licence")
      edition_fetch "$EDITION" "$_lic_file" "$VERSION" install || die "$EDITION_ERROR. Nothing was installed."
      IMAGE=$EDITION_IMAGE; EDITION_VERSION=$ED_VERSION
    fi
  else
    IMAGE=$(release_image "$REL")
  fi

  # Port and address.
  if [ ! -f "$ENV_FILE" ]; then
    PORT=${_port:-3000}
    if port_busy "$PORT"; then
      _free=$(free_port "$PORT")
      interactive || die "port $PORT is in use: re-run with --port <free port> (for example $_free)"
      PORT=$(ask "Port $PORT is in use. Port for UserTasks" "$_free")
    fi
    APP_URL=${_url:-http://localhost:$PORT}
  fi

  # Image first: the profile check runs in it.
  if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    if ! { step "Pulling $IMAGE"; docker pull "$IMAGE"; }; then
      if [ $_build = 1 ] || confirm "The image could not be downloaded. Build it locally from source instead (needs ~10 GB of memory for Docker, 10-20 minutes)?" n; then
        build_image_from_source "$VERSION"; IMAGE=$BUILT_IMAGE
      else
        die "could not pull $IMAGE (re-run with --build to build it locally)"
      fi
    fi
  fi
  ok "image $IMAGE"

  # Service choices: the first time (or on `usertasks config`).
  if [ ! -f "$ENV_FILE" ]; then
    ask_profile
    # Written to .env.new and moved into place only once the choices check out,
    # so a failed check leaves nothing behind and the next run asks again.
    ENV_FILE="$DIR/.env.new"; rm -f "$ENV_FILE"
    write_env "$REL" "$PORT" "$APP_URL"
    apply_profile "$IMAGE"
    mv "$ENV_FILE" "$DIR/.env"; ENV_FILE="$DIR/.env"
  else
    fill_missing_env "$REL"
  fi
  save_state
  load_state

  start_stack "$IMAGE" 600 || { dc logs --tail 80 app >&2 || true; die "UserTasks did not become healthy. Logs: usertasks logs. Re-run the installer when fixed (it is safe to re-run)."; }
  install_wrapper_from "$REL"
  link_command
  [ -n "$_lic_file" ] && edition_install_licence "$_lic_file"
  finish_message
  open_browser "$APP_URL/setup"
}

save_state() {
  (umask 077; : > "$STATE.tmp")
  {
    echo "# UserTasks install state (written by usertasks; not secret)"
    echo "USERTASKS_VERSION=$VERSION"
    echo "USERTASKS_IMAGE=$IMAGE"
    echo "USERTASKS_PROJECT=$PROJECT"
    echo "USERTASKS_PRESET=${PRESET:-standalone}"
    echo "USERTASKS_COMPOSE_PROFILES=$PROFILES"
    [ -n "${EDITION:-}" ] && echo "USERTASKS_EDITION=$EDITION"
    [ -n "${EDITION:-}" ] && [ -n "${EDITION_VERSION:-}" ] && echo "USERTASKS_EDITION_VERSION=$EDITION_VERSION"
    [ -n "${USERTASKS_RELEASE_BASE:-}" ] && echo "USERTASKS_RELEASE_BASE=$USERTASKS_RELEASE_BASE"
    [ -n "${PREV_VERSION:-}" ] && echo "USERTASKS_PREVIOUS_VERSION=$PREV_VERSION"
    [ -n "${PREV_IMAGE:-}" ] && echo "USERTASKS_PREVIOUS_IMAGE=$PREV_IMAGE"
    echo "USERTASKS_UPDATED=$(now_stamp)"
  } > "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
}

start_stack() { # <image> <timeout seconds>
  step "Starting UserTasks (project $PROJECT)"
  if ! dc_for "$REL" "$1" up -d --wait --wait-timeout "$2" --no-build --pull missing --remove-orphans; then
    # A slow or busy machine can miss the container health check's window:
    # keep waiting for the app itself before calling it a failure.
    [ -n "$(dc_for "$REL" "$1" ps -q app 2>/dev/null)" ] || return 1
    warn "not healthy yet; waiting up to $2 more seconds"
  fi
  step "Waiting for http://127.0.0.1:$PORT"
  wait_healthy "$2" || return 1
  ok "UserTasks answers on port $PORT"
}

finish_message() {
  say ""
  say "${G}${B}UserTasks $VERSION is running.${N}$( [ -n "${EDITION:-}" ] && printf ' (%s %s)' "$(edition_name "$EDITION")" "$EDITION_VERSION")"
  say "  Address:  $APP_URL"
  _code=$(env_get USERTASKS_SETUP_CODE "$ENV_FILE")
  if admin setup-code status 2>/dev/null | grep -q '^Setup is complete'; then
    say "  Sign in:  $APP_URL/login"
  else
    say "  Setup:    open $APP_URL/setup and enter the setup code ${B}${_code}${N}"
  fi
  if uses_bundled_postgres; then say "  Email:    test inbox at http://localhost:$(env_get MAILPIT_PORT "$ENV_FILE") (point SMTP_HOST at your relay for real mail)"; fi
  say "  Files:    $DIR (.env holds the secrets: back it up)"
  say "  Manage:   ${LINKED:-$DIR/bin/usertasks} status | logs | backup | upgrade | config | uninstall"
  say ""
}

# ── status, logs, start/stop ────────────────────────────────────────────────

cmd_status() {
  say "UserTasks $VERSION  ($PRESET, project $PROJECT)$( [ -n "${EDITION:-}" ] && printf '  edition: %s %s' "$EDITION" "$EDITION_VERSION")"
  say "  image:   $IMAGE"
  say "  address: $APP_URL"
  say "  folder:  $DIR"
  dc ps --format 'table {{.Service}}\t{{.Status}}' 2>/dev/null || dc ps
  if http_ok "http://127.0.0.1:$PORT/api/config/public"; then ok "healthy (http://127.0.0.1:$PORT)"; else warn "not answering on port $PORT"; fi
  if app_running; then
    admin setup-code status 2>/dev/null | head -n 1 || true
    admin db status 2>/dev/null | tail -n 3 || true
  fi
}

cmd_logs() { dc logs "$@"; }

# ── backup and restore ──────────────────────────────────────────────────────

db_url() {
  _u=$(env_get MIGRATION_DATABASE_URL "$ENV_FILE"); [ -n "$_u" ] || _u=$(env_get DATABASE_URL "$ENV_FILE"); printf '%s' "$_u"
}

pg_client() { # pg_dump/pg_restore/psql against an external database, on the stack's network
  docker run --rm -i --network "${PROJECT}_default" "$PG_CLIENT_IMAGE" "$@"
}

bundled_db() {
  uses_bundled_postgres || return 1
  _u=$(db_url); case "$_u" in *@postgres:*|"") return 0 ;; *) return 1 ;; esac
}

file_volume() { # the named volume holding files, if any
  if uses_bundled_postgres && [ "$(env_get STORAGE_PROVIDER "$ENV_FILE")" = s3 ] && [ "$(env_get S3_ENDPOINT "$ENV_FILE")" = "http://minio:9000" ]; then
    printf '%s_miniodata' "$PROJECT"
  fi
}

# vol_tar <volume> <dir> <file> create|extract: tar with the app image (no extra image to pull).
vol_tar() {
  if [ "$4" = create ]; then
    docker run --rm --network none -u 0 --entrypoint sh -v "$1:/data:ro" -v "$2:/backup" "$IMAGE" -c "tar -czf /backup/$3 -C /data ."
  else
    docker run --rm --network none -u 0 --entrypoint sh -v "$1:/data" -v "$2:/backup:ro" "$IMAGE" -c "find /data -mindepth 1 -maxdepth 1 -exec rm -rf {} + && tar -xzf /backup/$3 -C /data"
  fi
}

do_backup() { # <dir>: sets BACKUP_DIR
  BACKUP_DIR=$1; mkdir -p "$BACKUP_DIR"; chmod 700 "$BACKUP_DIR"
  step "Backing up to $BACKUP_DIR"
  if bundled_db; then
    # shellcheck disable=SC2016 # expanded inside the container
    dc exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc' > "$BACKUP_DIR/database.dump" || { rm -f "$BACKUP_DIR/database.dump"; die "database dump failed (is the postgres container running? usertasks start)"; }
  elif [ -n "$(db_url)" ]; then
    pg_client pg_dump -Fc "$(db_url)" > "$BACKUP_DIR/database.dump" || { rm -f "$BACKUP_DIR/database.dump"; die "database dump failed"; }
  else
    die "no database connection string in .env (MIGRATION_DATABASE_URL): back up the database with your provider's tools"
  fi
  ok "database ($(du -h "$BACKUP_DIR/database.dump" | cut -f1 | tr -d ' '))"
  _vol=$(file_volume)
  if [ -n "$_vol" ]; then vol_tar "$_vol" "$BACKUP_DIR" files.tar.gz create; ok "files (volume $_vol)"
  else say "  --  files live in your storage provider ($(env_get STORAGE_PROVIDER "$ENV_FILE")): back them up there"; fi
  (umask 077; cp "$ENV_FILE" "$BACKUP_DIR/env"); cp "$STATE" "$BACKUP_DIR/state.env"
  [ -f "$DIR/profile.json" ] && cp "$DIR/profile.json" "$BACKUP_DIR/"
  printf '{ "version": "%s", "image": "%s", "project": "%s", "createdAt": "%s" }\n' "$VERSION" "$IMAGE" "$PROJECT" "$(now_stamp)" > "$BACKUP_DIR/backup.json"
  ok ".env and install state (keep this folder safe: it holds ENCRYPTION_KEY)"
}

cmd_backup() {
  _out=""
  while [ $# -gt 0 ]; do case "$1" in --out) _out=$2; shift 2 ;; *) die "backup: unknown option $1" ;; esac; done
  lock
  do_backup "${_out:-$DIR/backups/$(now_stamp)-$VERSION}"
  say "Backup complete: $BACKUP_DIR"
  say "Restore it with: usertasks restore $BACKUP_DIR"
}

cmd_restore() {
  _b=""
  while [ $# -gt 0 ]; do case "$1" in --yes|-y) ASSUME_YES=1; shift ;; -*) die "restore: unknown option $1" ;; *) _b=$1; shift ;; esac; done
  [ -n "$_b" ] || die "usage: usertasks restore <backup folder | latest> [--yes]"
  if [ "$_b" = latest ]; then
    # shellcheck disable=SC2012
    _b=$(ls -1d "$DIR"/backups/*/ 2>/dev/null | sort | tail -n 1); _b=${_b%/}
    [ -n "$_b" ] || die "no backups in $DIR/backups"
  fi
  [ -f "$_b/database.dump" ] || die "$_b has no database.dump"
  _bv=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$_b/backup.json" 2>/dev/null)
  say "Restore $_b (UserTasks ${_bv:-?}) into this install ($VERSION, project $PROJECT)."
  say "Everything in the database${R} since that backup is lost${N}; files are replaced too."
  confirm "Restore now?" n || die "not restored"
  if [ -n "$_bv" ] && [ "$(version_cmp "$_bv" "$VERSION")" = 1 ]; then warn "the backup is from a newer version ($_bv) than this install ($VERSION): upgrade first (usertasks upgrade --to $_bv)"; confirm "Restore anyway?" n || exit 1; fi
  lock
  do_backup "$DIR/backups/$(now_stamp)-before-restore"
  step "Stopping the app"
  dc stop app worker 2>/dev/null || dc stop app
  if bundled_db; then
    # shellcheck disable=SC2016 # expanded inside the container
    dc exec -T postgres sh -c 'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d postgres -c "DROP DATABASE IF EXISTS \"$POSTGRES_DB\" WITH (FORCE)" -c "CREATE DATABASE \"$POSTGRES_DB\""' >/dev/null
    # shellcheck disable=SC2016 # expanded inside the container
    dc exec -T postgres sh -c 'pg_restore -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner --exit-on-error' < "$_b/database.dump"
  else
    pg_client pg_restore --clean --if-exists --no-owner -d "$(db_url)" < "$_b/database.dump"
  fi
  ok "database restored"
  _vol=$(file_volume)
  if [ -n "$_vol" ] && [ -f "$_b/files.tar.gz" ]; then
    dc stop minio >/dev/null 2>&1 || true
    vol_tar "$_vol" "$(cd "$_b" && pwd)" files.tar.gz extract; ok "files restored"
  fi
  if [ -f "$_b/env" ] && ! cmp -s "$_b/env" "$ENV_FILE"; then
    cp "$ENV_FILE" "$DIR/backups/env.before-restore-$(now_stamp)"
    (umask 077; cp "$_b/env" "$ENV_FILE"); ok ".env restored (the previous one is in backups/)"
  fi
  start_stack "$IMAGE" 600 || die "UserTasks did not become healthy after the restore: usertasks logs"
  say "Restored from $_b."
}

# ── upgrade ─────────────────────────────────────────────────────────────────

run_migrations() { # <release dir> <image>
  step "Applying database migrations (usertasks-admin db migrate)"
  if uses_bundled_postgres; then
    dc_for "$1" "$2" run --rm migrate || return 1
  else
    dc_for "$1" "$2" run --rm --no-deps -T app node admin.cjs db migrate || return 1
  fi
  if ! docker run --rm --network none --entrypoint node "$2" admin.cjs --help 2>/dev/null | grep -q 'usertasks-admin ext migrate'; then
    say "  --  this release has no extension migrations (usertasks-admin ext): skipped"; return 0
  fi
  step "Applying extension migrations (usertasks-admin ext migrate)"
  _ext=$(dc_for "$1" "$2" run --rm --no-deps -T app node admin.cjs ext migrate 2>&1) || { printf '%s\n' "$_ext" >&2; return 1; }
  printf '%s\n' "$_ext" | tail -n 3
}

cmd_upgrade() {
  _to=""; _skip_backup=0; _downgrade=0; _build=0; _force=0; _edition=""; _licence=""; _bundle=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --to) _to=$2; shift 2 ;; --yes|-y) ASSUME_YES=1; shift ;; --skip-backup) _skip_backup=1; shift ;;
      --allow-downgrade) _downgrade=1; shift ;; --build) _build=1; shift ;; --force) _force=1; shift ;;
      --edition) _edition=$2; shift 2 ;; --licence|--license) _licence=$2; shift 2 ;; --bundle) _bundle=$2; shift 2 ;;
      *) die "upgrade: unknown option $1" ;;
    esac
  done
  lock
  _from=$VERSION; _from_img=$IMAGE; _from_rel=$REL; _from_edition=${EDITION:-}
  # The edition to end up on: --edition (core = the public image), else the current one.
  _ed=${_edition:-$_from_edition}; [ "$_ed" = core ] && _ed=""
  if [ -n "$_ed" ]; then valid_edition "$_ed" || die "unknown edition: $_ed (editions: sharepoint, or core for the public image)"; fi
  if [ -n "$_bundle" ]; then
    _bundle=$(cd "$(dirname "$_bundle")" && pwd)/$(basename "$_bundle")
    bundle_open "$_bundle"
    [ -z "$_to" ] || [ "${_to#v}" = "$BUNDLE_VERSION" ] || die "the bundle is for UserTasks $BUNDLE_VERSION, not $_to"
    _to=$BUNDLE_VERSION; _ed=$BUNDLE_EDITION
  fi
  _switch=1; [ "$_ed" != "$_from_edition" ] || _switch=0
  if [ -z "$_to" ]; then
    step "Looking up the latest release"
    [ -n "$_ed" ] && _to=$(edition_latest_core "$_ed")
    [ -n "$_to" ] || _to=$(latest_version)
  fi
  _to=${_to#v}; valid_version "$_to" || die "not a version: $_to"
  _c=$(version_cmp "$_to" "$_from")
  if [ "$_c" = 0 ] && [ $_force = 0 ] && [ "$_switch" = 0 ]; then say "UserTasks $_from is already installed (latest: $_to)."; return 0; fi
  if [ "$_c" = -1 ] && [ $_downgrade = 0 ]; then
    [ -n "$_ed" ] && [ "$_switch" = 1 ] && die "the newest $(edition_name "$_ed") build is for UserTasks $_to, older than the installed $_from. It usually follows a release within a few hours: try again later (or pass --to <version> --allow-downgrade)."
    die "$_to is older than the installed $_from (pass --allow-downgrade to go back on purpose)"
  fi
  _what="UserTasks $_from → $_to"
  if [ "$_switch" = 1 ]; then _what="$_what, switching to $( [ -n "$_ed" ] && edition_name "$_ed" || printf 'the public image (paid extensions removed; their data is kept)')"; fi
  say "Upgrade $_what (project $PROJECT). Release notes: $RELEASE_BASE/tag/v$_to"
  confirm "Continue?" y || die "not upgraded"
  DONE=""
  note() { DONE="${DONE}  - $*
"; }

  # 0. Editions: the licence check comes first, so a refusal changes nothing.
  _lic_file=""
  if [ -n "$_ed" ] && [ -z "$_bundle" ]; then
    _lic_file=$(edition_licence "$_ed" "$_licence")
    _purpose=upgrade; [ "$_switch" = 1 ] && _purpose=switch
    rm -rf "$DIR/editions/.request"
    if ! edition_request "$_ed" "$_lic_file" "$_to" "$_purpose" "$DIR/editions/.request" "$DIR/release-key.pub.pem"; then
      say ""
      case "$EDITION_ERROR_CODE" in
        licence_expired|licence_revoked|licence_not_yet_valid) say "${R}Upgrade refused: the licence is not active.${N}" ;;
        *) say "${R}Upgrade refused.${N}" ;;
      esac
      say "$EDITION_ERROR"
      say "UserTasks $_from keeps running, unchanged. Renewed? Install the new licence (Settings → Licence, or --licence <file>) and run usertasks upgrade again."
      exit 1
    fi
    note "licence checked with usertasks.com: $(edition_name "$_ed") $ED_VERSION"
  elif [ -n "$_licence" ] && [ -n "$_ed" ]; then
    _lic_file=$(edition_licence "$_ed" "$_licence")
  fi

  # 1. Backup.
  if [ $_skip_backup = 1 ]; then warn "no backup (--skip-backup): a failed migration can then only be undone from your own backups"
  else do_backup "$DIR/backups/$(now_stamp)-$_from-before-$_to"; note "backup: $BACKUP_DIR"; fi

  # 2. Download (or take from the bundle) and verify.
  if [ -n "$_bundle" ]; then fetch_release "$_to" "$BUNDLE_DIR/release"; note "release $_to from the offline bundle (signature + checksum)"
  else fetch_release "$_to"; note "downloaded and verified release $_to (signature + checksum)"; fi
  _new_rel="$DIR/releases/$_to"

  # 3. Image.
  _new_ed_version=""
  if [ -n "$_bundle" ]; then
    _keep_img=$IMAGE; bundle_load "$BUNDLE_DIR"; _new_img=$IMAGE; IMAGE=$_keep_img; _new_ed_version=$ED_VERSION
    note "images loaded from the bundle; $(edition_name "$_ed") $ED_VERSION verified against its signed manifest"
  elif [ -n "$_ed" ]; then
    edition_refresh "$_lic_file" "$_to" upgrade || die "$EDITION_ERROR; nothing changed (UserTasks $_from keeps running)."
    _new_img=$EDITION_IMAGE; _new_ed_version=$ED_VERSION
    note "image $_new_img (verified against the signed edition manifest)"
  else
    _new_img=$(release_image "$_new_rel")
    if ! docker image inspect "$_new_img" >/dev/null 2>&1; then
      step "Pulling $_new_img"
      if ! docker pull "$_new_img"; then
        [ $_build = 1 ] || die "could not pull $_new_img; nothing changed (UserTasks $_from keeps running). Re-run with --build to build it locally."
        build_image_from_source "$_to"; _new_img=$BUILT_IMAGE
      fi
    fi
    note "image $_new_img"
  fi
  fill_missing_env "$_new_rel"

  # 4. Migrations, with the new code, while the current version keeps serving (they are additive).
  if ! run_migrations "$_new_rel" "$_new_img"; then
    say ""
    say "${R}The migrations failed.${N} UserTasks $_from is still running, unchanged: no code was switched."
    say "Each migration file runs in its own transaction, so nothing is half-applied. Fix the cause above and run usertasks upgrade again."
    [ -n "${BACKUP_DIR:-}" ] && say "Backup taken before the upgrade: $BACKUP_DIR"
    exit 1
  fi
  note "applied database and extension migrations"

  # 5. Switch and check.
  step "Switching to $_to"
  REL=$_new_rel; IMAGE=$_new_img
  if start_stack "$_new_img" "${USERTASKS_UPGRADE_TIMEOUT:-300}" && running_image_is "$_new_img"; then
    PREV_VERSION=$_from; PREV_IMAGE=$_from_img; VERSION=$_to
    EDITION=$_ed; EDITION_VERSION=$_new_ed_version
    save_state
    install_wrapper_from "$_new_rel"
    note "switched the app and worker to $_to; health check passed"
    if [ -n "$_licence" ] && [ -n "$_lic_file" ]; then edition_install_licence "$_lic_file"; fi
    say ""
    say "${G}${B}Upgraded UserTasks $_from → $_to.${N} What was done:"
    printf '%s' "$DONE"
    _vj=$(curl -fsS --max-time 5 "http://127.0.0.1:$PORT/api/version" 2>/dev/null || true)
    [ -n "$_vj" ] && say "  /api/version: $_vj"
    say "Check it: sign in, open a task, run a test workflow (docs: /docs/self-hosting/upgrade#check-it-worked)."
    return 0
  fi

  # 6. Roll the code back.
  say ""
  say "${R}The new version did not become healthy.${N} Rolling the code back to $_from."
  dc_for "$_new_rel" "$_new_img" logs --tail 60 app >&2 2>/dev/null || true
  REL=$_from_rel; IMAGE=$_from_img
  if start_stack "$_from_img" 300; then
    save_state
    say "Rolled back: UserTasks $_from is running again (image $_from_img)."
    say "The migrations of $_to stay applied: they are additive, so $_from runs on the newer schema."
    [ -n "${BACKUP_DIR:-}" ] && say "If you need the database exactly as before: usertasks restore $BACKUP_DIR"
  else
    say "${R}The rollback did not become healthy either.${N} Check usertasks logs; restore with: usertasks restore ${BACKUP_DIR:-<backup>}"
  fi
  exit 1
}

# ── config ──────────────────────────────────────────────────────────────────

cmd_config() {
  # usertasks config export|apply|diff|new … belongs to the UserTasks CLI.
  case "${1:-}" in export|apply|diff|new) forward_cli config "$@" ;; esac
  _force=0
  while [ $# -gt 0 ]; do
    case "$1" in --preset) USERTASKS_PRESET_CHOICE=$2; shift 2 ;; --force) _force=1; shift ;; --yes|-y) ASSUME_YES=1; shift ;; *) die "config: unknown option $1" ;; esac
  done
  lock
  _old_preset=$PRESET; _old_db=$(db_url); _old_storage=$(env_get STORAGE_PROVIDER "$ENV_FILE")
  ask_profile
  _setup_done=0; admin setup-code status 2>/dev/null | grep -q '^Setup is complete' && _setup_done=1
  _new_db=$A_DB_URL
  if [ $_setup_done = 1 ] && [ $_force = 0 ] && { [ "$PRESET" != "$_old_preset" ] || { [ -n "$_new_db" ] && [ "$_new_db" != "$_old_db" ]; }; }; then
    say "This install already has data. Changing the database or file storage here does not move it."
    say "Move one service at a time with: usertasks admin switch <area> --to <provider> (docs: /docs/self-hosting/switching-providers)"
    say "Or pass --force to point at the new services without moving data (old: database ${_old_db:+set}, storage $_old_storage)."
    exit 1
  fi
  _bk="$DIR/backups/env.$(now_stamp)"; mkdir -p "$DIR/backups"; (umask 077; cp "$ENV_FILE" "$_bk")
  apply_profile "$IMAGE"
  save_state; load_state
  start_stack "$IMAGE" 600 || die "UserTasks did not become healthy with the new choices. The previous .env is $_bk"
  say "Service choices updated (previous .env: $_bk)."
}

# ── uninstall ───────────────────────────────────────────────────────────────

cmd_uninstall() {
  _purge=0
  while [ $# -gt 0 ]; do case "$1" in --purge) _purge=1; shift ;; --yes|-y) ASSUME_YES=1; shift ;; *) die "uninstall: unknown option $1" ;; esac; done
  if [ $_purge = 1 ]; then
    say "${R}${B}This deletes UserTasks and ALL its data${N}: the database and file volumes of project $PROJECT, $DIR (secrets, backups)."
    if [ "${ASSUME_YES:-0}" != 1 ]; then
      interactive || die "uninstall --purge needs --yes when not interactive"
      [ "$(ask "Type the project name ($PROJECT) to confirm" "")" = "$PROJECT" ] || die "not removed"
    fi
    dc down --volumes --remove-orphans
  else
    confirm "Stop and remove the UserTasks containers? Data, .env and backups are kept." y || die "not removed"
    dc down --remove-orphans
  fi
  for _l in /usr/local/bin/usertasks /usr/local/bin/usertasks-server "$HOME/.local/bin/usertasks" "$HOME/.local/bin/usertasks-server" "$HOME/.local/bin/usertasks-$PROJECT" "${USERTASKS_BIN_DIR:-/nonexistent}/usertasks" "${USERTASKS_BIN_DIR:-/nonexistent}/usertasks-server"; do
    if [ -L "$_l" ] && [ "$(readlink "$_l")" = "$DIR/bin/usertasks" ]; then rm -f "$_l"; fi
  done
  if [ $_purge = 1 ]; then
    rm -rf "$DIR"; say "UserTasks and its data were removed."
  else
    env_set USERTASKS_UNINSTALLED "$(now_stamp)" "$STATE"
    say "UserTasks was stopped and removed. Data volumes (project $PROJECT), $ENV_FILE and $DIR/backups are kept."
    say "Install again into $DIR to pick them up, or remove everything with: $DIR/bin/usertasks uninstall --purge"
  fi
}

# ── the UserTasks CLI ───────────────────────────────────────────────────────

forward_cli() {
  _self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
  _old_ifs=$IFS; IFS=:
  for _d in $PATH; do
    _c="$_d/usertasks"
    [ -x "$_c" ] || continue
    grep -q "$WRAPPER_MARK" "$_c" 2>/dev/null && continue
    [ "$_c" = "$_self" ] && continue
    IFS=$_old_ifs
    # shellcheck disable=SC2093 # the first CLI found wins
    exec "$_c" "$@"
  done
  IFS=$_old_ifs
  die "'$1' is not a server command (usertasks help). For the UserTasks CLI: npm install -g @user-tasks/cli"
}

usage() { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  _cmd=${1:-help}; [ $# -gt 0 ] && shift
  case "$_cmd" in
    help|-h|--help) usage; return 0 ;;
    install) DIR=""; BUILT_IMAGE=""; PROFILES=standalone; cmd_install "$@"; return ;;
    bundle-download)
      # Works without an install (install.sh --bundle-download passes --work <folder>).
      _work=""; _prev=""
      for _a in "$@"; do [ "$_prev" = --work ] && _work=$_a; _prev=$_a; done
      if [ -n "$_work" ]; then
        mkdir -p "$_work"; DIR=$(cd "$_work" && pwd); RELEASE_BASE=${USERTASKS_RELEASE_BASE:-$DEFAULT_RELEASE_BASE}; IMAGE=""; PROJECT=""
      else resolve_dir; load_state; fi
      cmd_bundle_download "$@"; return ;;
    cli) forward_cli "$@" ;;
    status|logs|backup|restore|upgrade|config|uninstall|setup-code|admin|start|stop|restart|version|--version) : ;;
    *) forward_cli "$_cmd" "$@" ;;
  esac
  resolve_dir; load_state
  case "$_cmd" in
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    config) cmd_config "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    setup-code) admin setup-code "$@" ;;
    admin) admin "$@" ;;
    start) start_stack "$IMAGE" 600 ;;
    stop) dc stop ;;
    restart) dc restart; wait_healthy 180 && ok "healthy" ;;
    version|--version) say "UserTasks $VERSION ($IMAGE)$( [ -n "${EDITION:-}" ] && printf ', %s %s' "$(edition_name "$EDITION")" "$EDITION_VERSION")" ;;
  esac
}

# Tests source this file with USERTASKS_WRAPPER_NO_MAIN=1 to call its helpers.
[ "${USERTASKS_WRAPPER_NO_MAIN:-0}" = 1 ] || main "$@"
