# UserTasks standalone profile: no Supabase (docker compose --profile standalone).
# `npm run stack -- init` copies this to .env and fills every <generate> value;
# by hand: copy it to .env and replace each <generate> (openssl rand -hex 32).
# Every variable is described in .env.example / docs/infrastructure.md.

DEPLOYMENT_MODE=self_hosted
# The public origin people open (no trailing slash). APP_PORT is the host port.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

ENCRYPTION_KEY=<generate>
CRON_SECRET=<generate>
# Instance administrators (Settings → Infrastructure).
INSTANCE_ADMIN_EMAILS=

# ── Database: PostgreSQL 16 (the `postgres` container) ──
POSTGRES_USER=usertasks
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=usertasks
DB_PROVIDER=postgres
DATABASE_URL=postgresql://usertasks:<POSTGRES_PASSWORD>@postgres:5432/usertasks
# With --profile pgbouncer, send the app's queries through PgBouncer instead
# (the three session connections below stay direct):
# DATABASE_URL=postgresql://usertasks:<POSTGRES_PASSWORD>@pgbouncer:5432/usertasks
MIGRATION_DATABASE_URL=postgresql://usertasks:<POSTGRES_PASSWORD>@postgres:5432/usertasks
REALTIME_DATABASE_URL=postgresql://usertasks:<POSTGRES_PASSWORD>@postgres:5432/usertasks
SCHEDULER_DATABASE_URL=postgresql://usertasks:<POSTGRES_PASSWORD>@postgres:5432/usertasks

# ── Auth: built-in (accounts and bcrypt hashes in PostgreSQL) ──
AUTH_PROVIDER=builtin
# Add OIDC / SAML identity providers with AUTH_SSO_PROVIDERS (docs: Auth).

# ── Realtime: Server-Sent Events over LISTEN/NOTIFY ──
REALTIME_PROVIDER=sse

# ── Storage: MinIO (S3 API); files are served by the app at /files/… ──
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=usertasks
S3_SECRET_ACCESS_KEY=<generate>
S3_FORCE_PATH_STYLE=true

# ── Scheduler: the `worker` container (one leader ticks per minute) ──
SCHEDULER_PROVIDER=worker
SCHEDULER_IN_PROCESS=false

# ── Email: SMTP to Mailpit (http://localhost:8025); point at your relay ──
EMAIL_PROVIDER=smtp
EMAIL_FROM=UserTasks <noreply@usertasks.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=off

# ── Secrets: environment (Docker secrets: <VAR>_FILE or SECRETS_FILES_DIR) ──
SECRETS_PROVIDER=env

# ── Cache: the `valkey` container (rate limits and invalidations shared by
#    every replica and the worker); CACHE_PROVIDER=postgres needs no container ──
CACHE_PROVIDER=redis
CACHE_REDIS_URL=redis://valkey:6379
CACHE_REDIS_PASSWORD=<generate>
