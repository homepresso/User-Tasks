{
  "name": "usertasks",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bootstrap": "npx tsx scripts/bootstrap-tenant.ts",
    "worker": "tsx scripts/worker.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "auth": "tsx scripts/auth.ts",
    "admin": "tsx packages/admin/src/bin.ts",
    "stack": "tsx scripts/stack.ts",
    "helm:gate": "tsx scripts/helm-gate.ts",
    "helm:options": "tsx scripts/helm-options.ts",
    "bundle": "tsx scripts/bundle.ts",
    "bundle:e2e": "tsx scripts/bundle-e2e.ts",
    "openapi:gen": "tsx scripts/generate-openapi.ts && npm run generate -w @usertasks/sdk && npm run generate -w @usertasks/cli",
    "openapi:check": "tsx scripts/generate-openapi.ts --check && npm run generate:check -w @usertasks/sdk && npm run generate:check -w @usertasks/cli",
    "db:types": "npx supabase gen types typescript --linked > lib/database.types.ts",
    "db:types:local": "npx supabase gen types typescript --local > lib/database.types.ts",
    "cli:build": "npm run build -w @usertasks/sdk && npm run build -w @usertasks/cli",
    "cli:dev": "tsx --tsconfig packages/cli/tsconfig.json packages/cli/src/bin.ts",
    "gallery:build": "tsx scripts/gallery-build.ts",
    "gallery:check": "tsx scripts/gallery-build.ts --check",
    "gallery:verify": "tsx scripts/gallery-verify.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "@tanstack/query-sync-storage-persister": "^5.96.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-persist-client": "^5.96.2",
    "@usertasks/pg-query": "0.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docxtemplater": "^3.68.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.13",
    "ldapts": "^8.2.0",
    "lucide-react": "^1.7.0",
    "mssql": "^12.2.1",
    "mysql2": "^3.22.0",
    "next": "16.2.1",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.12.0",
    "pizzip": "^3.2.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mssql": "^9.1.11",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "smtp-server": "^3.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@aws-sdk/client-kms": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@aws-sdk/credential-providers": "^3.1156.0",
    "@aws-sdk/rds-signer": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.32.0",
    "@google-cloud/secret-manager": "^6.3.0",
    "@google-cloud/storage": "^7.22.0",
    "@node-saml/node-saml": "^5.1.0",
    "mongodb": "^7.1.1",
    "nodemailer": "^10.2.1",
    "oracledb": "^6.10.0",
    "snowflake-sdk": "^2.4.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
