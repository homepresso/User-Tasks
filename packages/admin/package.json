{
  "name": "@usertasks/admin",
  "version": "0.1.0",
  "private": true,
  "description": "usertasks-admin: server-side administration for UserTasks installs (provider status, doctor, switch and rollback; database migrations on any PostgreSQL)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
