    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pg-connection-string": "^2.12.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
