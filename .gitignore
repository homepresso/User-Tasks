# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/packages/*/dist
/packages/*/node_modules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
.cron-vault-setup.sql

# local tooling / scratch
.mcp.json
.claude/
backups/
supabase/.temp
.firebase/

# compose reference profiles: generated env files and test state
/deploy/compose/.state/

# Public Amazon RDS CA bundle (certificates only), shipped in the image
!deploy/aws/rds-global-bundle.pem
# Air-gapped bundles (npm run bundle -- create)
/dist/bundle/
