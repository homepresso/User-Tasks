# UserTasks environment variables.
# Copy to .env.local for `npm run dev` (or .env for docker compose) and fill in.
# Never commit real values.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API, or
# the output of `supabase start` for a local stack. Read by the server at
# runtime and handed to the browser through the root layout, so changing them
# needs a restart, not a rebuild.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional runtime-only names; when set they take precedence over the
# NEXT_PUBLIC_* names above (handy for one Docker image across environments).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Service-role key. Server-only: used by API routes, queue processors and
# `npm run bootstrap`. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Application ─────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. Used for links in emails,
# OAuth redirects, robots/sitemap and the queue processor's self-calls.
# APP_URL, when set, takes precedence (runtime-only name).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APP_URL=
# `self_hosted` (default when unset) disables the marketing site, contact form
# and self-signup, and sends `/` straight to the app. `cloud` is the hosted
# usertasks.com edition. Set it at build time as well as at runtime.
DEPLOYMENT_MODE=self_hosted

# ── Secrets ─────────────────────────────────────────────────────────────────
# 32-byte key (base64 or hex) for AES-256-GCM encryption of stored connector
# and integration secrets. Strongly recommended: when unset, secrets are
# stored in plaintext. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Bearer secret for /api/cron/* and the queue processors. pg_cron sends it
# (stored in Supabase Vault as `cron_secret`). Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional. ed25519 private key (PEM; \n escapes allowed) that signs built
# packages (.utpkg). Default: a key generated on first build, stored encrypted
# with ENCRYPTION_KEY. Without either, packages are built unsigned.
# PACKAGE_SIGNING_KEY=
# Optional. Comma-separated signer fingerprints (aa:bb:…) installs show as
# trusted (packages signed by this instance are always recognised).
# PACKAGE_TRUSTED_FINGERPRINTS=
# Optional. Browse gallery (Automations → Packages) shows the Official
# packages this instance ships with plus the Community packages of a public
# gallery index, fetched server-side. Default https://usertasks.com/api/gallery/index;
# set to `off` on air-gapped instances.
# GALLERY_INDEX_URL=
# Optional (usertasks.com runs it). `on` serves the community gallery
# (Share your solution, Settings → Gallery review) on a non-cloud instance;
# `off` turns it off on cloud.
# GALLERY_COMMUNITY=
# Optional. Headless verification of community submissions in a scratch
# workspace: `native` (default: only packages without integrations, and
# without email unless EMAIL_PROVIDER=console), `all` (review instances with
# ALLOW_PRIVATE_EGRESS=true: also the mock-API run) or `off`.
# GALLERY_HEADLESS_VERIFY=
# Optional. The public repository link the website shows once it is launched.
# NEXT_PUBLIC_REPOSITORY_URL=
# Optional. When set, it REPLACES CRON_SECRET as the secret every service
# endpoint accepts (and the Vault `cron_secret` must then hold this value).
# Leave it commented out rather than empty: an empty value disables the
# CRON_SECRET fallback and every cron/processor call is rejected.
# WORKFLOW_PROCESSOR_SECRET=
# Queue tuning (optional): jobs one processor invocation runs at once
# (default 5), how long it keeps starting jobs (ms, default 50000), and days
# finished workflow_queue / agent_queue rows are kept (default 7).
# WORKFLOW_CONCURRENCY=5
# WORKFLOW_PROCESSOR_BUDGET_MS=50000
# QUEUE_RETENTION_DAYS=7
# Scheduler tick (optional): jobs /api/cron/tick runs at once (default 4).
# CRON_TICK_CONCURRENCY=4
# Background jobs (exports, imports, bulk actions): time per invocation before
# a long job hands over the next chunk, and how long results are kept.
# USER_JOB_BUDGET_MS=50000
# USER_JOB_RESULT_TTL_HOURS=168
# USER_JOB_INLINE_WAIT_MS=1500

# Form attachments (Attachments fields): largest file (MB, at most 45), hours
# an upload stays pending before it is deleted, pending uploads per person.
# FORM_ATTACHMENT_MAX_MB=25
# FORM_ATTACHMENT_PENDING_HOURS=24
# FORM_ATTACHMENT_PENDING_LIMIT=200
# Uploads go straight to storage when the provider signs uploads (Supabase,
# S3 / MinIO, Azure Blob, GCS: a signed URL valid this many minutes); local
# disk sends them through the app, whose body limit (MB, build time; capped
# at 4 on Vercel) is FORM_UPLOAD_MAX_BODY_MB. See docs/self-hosting.md.
# FORM_ATTACHMENT_UPLOAD_WINDOW_MINUTES=15
# FORM_UPLOAD_MAX_BODY_MB=50
# Optional virus scanning with clamd (off by default). A scanner outage
# refuses uploads unless FORM_ATTACHMENT_SCAN_FAIL_OPEN=true.
# FORM_ATTACHMENT_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000
# FORM_ATTACHMENT_SCAN_FAIL_OPEN=false

# ── Email (optional) ────────────────────────────────────────────────────────
# Resend API key (the default email provider). Without it, sending email
# (invitations, task notifications, workflow email nodes) fails with "Email
# service not configured". See EMAIL_PROVIDER below for SMTP, SES, Azure
# Communication Services, Microsoft Graph, Gmail and the console sink.
RESEND_API_KEY=
# Sender address, e.g. "UserTasks <noreply@example.com>" (required by every
# provider except resend and console).
EMAIL_FROM=
# Default Reply-To for app email (workflow nodes can set their own).
# EMAIL_REPLY_TO=

# ── Security toggles (optional, all off by default) ─────────────────────────
# Allow workflow activities with custom JavaScript to run. The code runs
# unsandboxed in-process: enable only in trusted environments.
ENABLE_CUSTOM_ACTIVITY_CODE=false
# Allow outbound HTTP (integrations, connectors, webhooks) to private and
# loopback addresses. Cloud metadata endpoints stay blocked.
ALLOW_PRIVATE_EGRESS=false
# Log export: send every Datadog destination to this intake URL instead of
# https://http-intake.logs.<site>/api/v2/logs (an Observability Pipelines
# worker or proxy). Private CAs for self-hosted Splunk HEC / OTLP collectors:
# set NODE_EXTRA_CA_CERTS (certificate checks cannot be turned off).
# LOG_EXPORT_DATADOG_URL=
# Azure Monitor / Event Hubs / Cloud Logging / Pub/Sub / CloudWatch Logs
# destinations use the credentials a workspace supplies; true also lets them
# use this server's managed / workload identity or AWS role (only for single-tenant installs: it reaches
# whatever the operator's identity can).
# LOG_EXPORT_ALLOW_INSTANCE_IDENTITY=false
# Private endpoints (or test doubles) for the cloud destinations.
# LOG_EXPORT_EVENT_HUBS_URL=
# LOG_EXPORT_GCP_LOGGING_URL=
# LOG_EXPORT_GCP_PUBSUB_URL=
# LOG_EXPORT_AZURE_AUTHORITY_URL=
# LOG_EXPORT_GCP_TOKEN_URL=
# LOG_EXPORT_AWS_ENDPOINT_URL=
# Accept API keys in a `?key=` query parameter (for MCP connectors that
# cannot send an Authorization header).
ALLOW_QUERY_KEY_AUTH=false
# Comma-separated browser origins allowed to call /api/mcp (CORS).
MCP_ALLOWED_ORIGINS=

# ── Sign-in (optional) ──────────────────────────────────────────────────────
# Set to 1 to show "Sign in with Microsoft" on /login (requires the Azure
# provider to be configured in Supabase Auth). Read at runtime; SSO_MICROSOFT
# takes precedence when set.
NEXT_PUBLIC_SSO_MICROSOFT=
# SSO_MICROSOFT=

# ── Infrastructure providers (optional) ─────────────────────────────────────
# Provider per area. Unset means today's stack: supabase (DB, auth, storage,
# realtime), pg_cron (scheduler), resend (email), env (secrets). These
# override the `providers.<area>` rows in the instance_settings table.
# DB_PROVIDER=postgres serves server-side queries in-process over DATABASE_URL
# (same RLS, same results as PostgREST) instead of through Supabase's REST API;
# it is read from the environment only. It needs DATABASE_URL (a role that can
# SET ROLE anon/authenticated/service_role, e.g. postgres; PgBouncer
# transaction mode is fine) and, to verify HS256 session tokens without a
# round trip to Supabase Auth, SUPABASE_JWT_SECRET. Pool size: DATABASE_POOL_MAX
# (default 10).
# DB_PROVIDER=supabase
# AUTH_PROVIDER=supabase
# STORAGE_PROVIDER=supabase
# REALTIME_PROVIDER=supabase
# SCHEDULER_PROVIDER=pg_cron
# EMAIL_PROVIDER=resend
# SECRETS_PROVIDER=env
# CACHE_PROVIDER=memory
# KMS_PROVIDER=env
# Direct Postgres connection string, for providers that talk to the
# database without Supabase (not used by the defaults).
# DATABASE_URL=
# SUPABASE_JWT_SECRET=
# DATABASE_POOL_MAX=10
# Row cap per read, as Supabase's API "max rows" setting (0 = none).
# DB_MAX_ROWS=1000
# How the app authenticates its Postgres connections: password (default, the
# URL's password), azure (Microsoft Entra ID token for Azure Database for
# PostgreSQL, via managed identity / DefaultAzureCredential), gcp (IAM
# access token for Cloud SQL / AlloyDB, via Application Default Credentials)
# or aws (RDS / Aurora / RDS Proxy IAM database auth: a 15-minute token from
# the task role / instance profile / IRSA; the URL's user is granted rds_iam).
# Token modes need TLS (sslmode=require) or the Cloud SQL Auth Proxy; aws
# turns TLS on itself and verifies the server with DATABASE_SSL_CA_FILE, else
# the RDS CA bundle shipped in the image (certs/rds-global-bundle.pem).
# DATABASE_AWS_REGION defaults to the region in the RDS host name, then AWS_REGION.
# DATABASE_AUTH=password
# DATABASE_AWS_REGION=
# DATABASE_SSL_CA_FILE=
# Migrations on any PostgreSQL: `usertasks-admin db migrate` (npm run admin --
# db migrate; `node admin.cjs db migrate` in the Docker image). It uses
# MIGRATION_DATABASE_URL, else DATABASE_URL (a direct / session-mode
# connection, not PgBouncer transaction mode), and the files in
# MIGRATIONS_DIR (default ./supabase/migrations).
# MIGRATION_DATABASE_URL=
# MIGRATIONS_DIR=
# REALTIME_PROVIDER=sse pushes live updates (task lists, queue, notification
# bell, live logs) over Server-Sent Events from the app instead of Supabase
# Realtime. Each app instance LISTENs on Postgres (migration
# 20261105000000_realtime_notify.sql) over a session-mode connection:
# REALTIME_DATABASE_URL, else DATABASE_URL, else SUPABASE_DB_URL (the
# project's direct or session-pooler string; not the 6543 transaction pooler).
# With none set it polls the tables every 2 s instead.
# REALTIME_DATABASE_URL=
# SUPABASE_DB_URL=
# STORAGE_PROVIDER=local|s3|azure_blob|gcs stores uploads (logos, fonts,
# data-table files, workflow documents) outside Supabase Storage; the app then
# serves them at /files/<bucket>/<key> unless STORAGE_PUBLIC_BASE_URL points
# at the store or a CDN. Secrets (keys, connection strings, service-account
# JSON) can instead be stored encrypted as storage.<option> instance settings.
# Buckets: task-files, logos, brand-fonts. STORAGE_BUCKET_MAP is JSON
# ({"logos": "acme-logos"}), STORAGE_BUCKET puts everything in one bucket
# under <bucket>/<key>, STORAGE_BUCKET_PREFIX prefixes each bucket name.
# STORAGE_BUCKET_MAP=
# STORAGE_BUCKET=
# STORAGE_BUCKET_PREFIX=
# STORAGE_PUBLIC_BASE_URL=https://{bucket}.s3.eu-west-1.amazonaws.com
# local: a directory (local disk, NFS or SMB mount) the app can write to.
# STORAGE_LOCAL_ROOT=/var/lib/usertasks/storage
# s3: AWS S3 or any S3-compatible store (MinIO, Ceph RGW, R2, …). Without
# keys the AWS SDK's default chain is used (env, IAM role, IRSA).
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# azure_blob: a connection string, or the account name with a key or SAS
# token; the account name alone uses Microsoft Entra ID (managed identity /
# workload identity) via DefaultAzureCredential.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_SAS_TOKEN=
# AZURE_STORAGE_BLOB_ENDPOINT=
# gcs: a service-account key (JSON), or Application Default Credentials
# (workload identity, attached service account, GOOGLE_APPLICATION_CREDENTIALS).
# GCS_PROJECT_ID=
# GCS_CREDENTIALS_JSON=
# GCS_API_ENDPOINT=
# SCHEDULER_PROVIDER=worker runs the scheduled jobs inside the app (or in a
# `usertasks worker` container) instead of pg_cron; replicas elect one leader
# with a Postgres advisory lock on SCHEDULER_DATABASE_URL, else DATABASE_URL
# (a session connection, not a transaction pooler), else the tick lease.
# Set SCHEDULER_IN_PROCESS=false on web replicas when a separate worker runs.
# SCHEDULER_PROVIDER=external: an outside scheduler calls POST /api/cron/tick
# every minute with CRON_SECRET, or with a Google Cloud Scheduler OIDC token
# (SCHEDULER_OIDC_SERVICE_ACCOUNTS, audience SCHEDULER_OIDC_AUDIENCE, default
# <APP_URL>/api/cron/tick) or an Entra ID managed-identity token
# (SCHEDULER_ENTRA_TENANT_ID, SCHEDULER_ENTRA_AUDIENCE,
# SCHEDULER_ENTRA_ALLOWED_PRINCIPALS: object or client ids), or an Amazon
# Cognito access token from an EventBridge API destination whose connection
# uses OAuth client credentials (SCHEDULER_COGNITO_USER_POOL_ID,
# SCHEDULER_COGNITO_ALLOWED_CLIENTS: app client ids, SCHEDULER_COGNITO_SCOPE
# optional, SCHEDULER_COGNITO_REGION default the pool id's prefix).
# SCHEDULER_PG_CRON_BASE_URL is the URL pg_cron calls (default APP_URL).
# SCHEDULER_IN_PROCESS=true
# SCHEDULER_DATABASE_URL=
# SCHEDULER_OIDC_SERVICE_ACCOUNTS=
# SCHEDULER_OIDC_AUDIENCE=
# SCHEDULER_ENTRA_TENANT_ID=
# SCHEDULER_ENTRA_AUDIENCE=
# SCHEDULER_ENTRA_ALLOWED_PRINCIPALS=
# SCHEDULER_COGNITO_USER_POOL_ID=
# SCHEDULER_COGNITO_ALLOWED_CLIENTS=
# SCHEDULER_COGNITO_SCOPE=
# SCHEDULER_COGNITO_REGION=
# SCHEDULER_PG_CRON_BASE_URL=
# EMAIL_PROVIDER=smtp sends through any SMTP relay (Exchange, Postfix,
# Microsoft 365, Workspace SMTP relay, Mailpit). SMTP_SECURE=true is implicit
# TLS (port 465); otherwise SMTP_STARTTLS=required|opportunistic|off
# (default opportunistic). Certificates are verified unless
# SMTP_TLS_REJECT_UNAUTHORIZED=false (prefer NODE_EXTRA_CA_CERTS for a
# private CA). SMTP_NAME is the EHLO host name.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=opportunistic
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_TLS_SERVERNAME=
# SMTP_NAME=
# ses: Amazon SES (SESv2 API). Without keys the AWS default chain is used.
# SES_REGION=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=
# azure_communication: Azure Communication Services Email, by connection
# string, or by endpoint with Entra ID (managed identity).
# ACS_EMAIL_CONNECTION_STRING=
# ACS_EMAIL_ENDPOINT=
# microsoft_graph: Graph sendMail (Mail.Send application permission), with a
# client secret or, without one, a managed identity. GRAPH_SENDER is the
# mailbox to send as (default: the EMAIL_FROM address); GRAPH_ENDPOINT for
# national clouds.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=
# GRAPH_ENDPOINT=https://graph.microsoft.com
# gmail: Gmail API, a service account with domain-wide delegation
# impersonating GMAIL_SENDER (default: the EMAIL_FROM address).
# GMAIL_SERVICE_ACCOUNT_JSON=
# GMAIL_SENDER=
# console: log each message and, with EMAIL_CONSOLE_DIR, write .eml files.
# EMAIL_CONSOLE_DIR=
# SECRETS_PROVIDER: where `secret://<name>[#field]` references in any
# provider option (e.g. SMTP_PASSWORD=secret://smtp#password) are read from:
# env (default; also <VAR>_FILE and SECRETS_FILES_DIR), db (encrypted
# secrets.<name> instance settings), supabase_vault, hashicorp_vault (also
# OpenBao), azure_key_vault, gcp_secret_manager, aws_secrets_manager. Values
# are cached for SECRETS_CACHE_TTL_SECONDS (default 300). ENCRYPTION_KEY may
# itself be a secret:// reference; when it is unset, an external store's
# SECRETS_ENCRYPTION_KEY_NAME (default encryption_key) is used.
# SECRETS_NAME_PREFIX=
# SECRETS_CACHE_TTL_SECONDS=300
# SECRETS_ENCRYPTION_KEY_NAME=encryption_key
# SECRETS_FILES_DIR=/run/secrets
# SECRETS_DATABASE_URL=
# hashicorp_vault: KV v2 at VAULT_KV_MOUNT (default secret). Auth by
# VAULT_TOKEN, AppRole (VAULT_ROLE_ID + VAULT_SECRET_ID) or Kubernetes
# (VAULT_K8S_ROLE); VAULT_AUTH_METHOD picks one explicitly.
# VAULT_ADDR=
# VAULT_NAMESPACE=
# VAULT_KV_MOUNT=secret
# VAULT_AUTH_METHOD=
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_APPROLE_MOUNT=approle
# VAULT_K8S_ROLE=
# VAULT_K8S_MOUNT=kubernetes
# VAULT_K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# azure_key_vault: managed identity / DefaultAzureCredential.
# AZURE_KEY_VAULT_URL=https://my-vault.vault.azure.net
# gcp_secret_manager: Application Default Credentials / workload identity.
# GCP_SECRET_MANAGER_PROJECT=
# GCP_SECRET_MANAGER_CREDENTIALS_JSON=
# Regional or private endpoint, e.g. https://secretmanager.europe-west1.rep.googleapis.com
# GCP_SECRET_MANAGER_ENDPOINT=
# aws_secrets_manager: AWS default credential chain.
# AWS_SECRETS_MANAGER_REGION=
# AWS_SECRETS_MANAGER_ENDPOINT=
# CACHE_PROVIDER: where rate-limit windows (API keys, OAuth tokens, sign-in,
# agent runs, signups), credential / settings cache invalidations and
# idempotency claims live. memory (default): per instance, as before — with
# several replicas every limit multiplies by the replica count. postgres: an
# UNLOGGED table in this database (migration 20261108000000), no extra
# service. redis: Redis / Valkey / KeyDB / Dragonfly, Azure Cache for Redis,
# Memorystore, ElastiCache (rediss:// for TLS). Other processes see a revoked
# credential or a changed instance setting within
# CACHE_INVALIDATION_CHECK_MS (default 1000).
# CACHE_KEY_PREFIX=usertasks:
# CACHE_INVALIDATION_CHECK_MS=1000
# CACHE_REDIS_URL=redis://valkey:6379
# CACHE_REDIS_USERNAME=
# CACHE_REDIS_PASSWORD=
# CACHE_REDIS_DB=
# CACHE_REDIS_AUTH: password (default), entra (Azure: Entra ID token for the
# managed identity whose object id is CACHE_REDIS_USERNAME) or gcp_iam
# (Memorystore IAM auth with Application Default Credentials) or aws_iam
# (ElastiCache / MemoryDB IAM auth: CACHE_REDIS_USERNAME is the IAM-enabled
# user id, CACHE_REDIS_AWS_CACHE_NAME the replication group / serverless cache
# / MemoryDB cluster; tokens are signed with the task role and re-sent every
# 14 minutes; TLS on by default).
# CACHE_REDIS_AUTH=password
# CACHE_REDIS_TLS=
# CACHE_REDIS_TLS_CA_FILE=
# CACHE_REDIS_TLS_SERVERNAME=
# CACHE_REDIS_TLS_REJECT_UNAUTHORIZED=true
# CACHE_REDIS_ENTRA_SCOPE=https://redis.azure.com/.default
# CACHE_REDIS_AWS_CACHE_NAME=
# CACHE_REDIS_AWS_REGION=
# CACHE_REDIS_AWS_SERVICE=elasticache
# CACHE_REDIS_AWS_SERVERLESS=false
# CACHE_REDIS_COMMAND_TIMEOUT_MS=2000
# KMS_PROVIDER: the key-encryption key for envelope encryption of stored
# secrets. env (default): ENCRYPTION_KEY; without data keys (nobody ran
# `usertasks-admin kms rotate`) secrets are enc:v1 with ENCRYPTION_KEY, as
# before. vault_transit (Vault / OpenBao Transit; VAULT_ADDR and Vault auth as
# above), aws_kms, azure_key_vault (Key Vault key / Managed HSM), gcp_kms.
# Data keys are unwrapped at startup (other providers fail closed) and picked
# up by running processes every KMS_REFRESH_SECONDS; a rotated key is used
# for new values KMS_ACTIVATION_SECONDS after `kms rotate`.
# KMS_REFRESH_SECONDS=60
# KMS_ACTIVATION_SECONDS=120
# VAULT_TRANSIT_KEY=usertasks
# VAULT_TRANSIT_MOUNT=transit
# AWS_KMS_KEY_ID=alias/usertasks
# AWS_KMS_REGION=
# AWS_KMS_ENDPOINT=
# AZURE_KMS_KEY_ID=https://my-vault.vault.azure.net/keys/usertasks
# AZURE_KMS_KEY_ALGORITHM=RSA-OAEP-256
# GCP_KMS_KEY_NAME=projects/p/locations/l/keyRings/r/cryptoKeys/k
# GCP_KMS_CREDENTIALS_JSON=
# GCP_KMS_ENDPOINT=
# AUTH_PROVIDER=builtin keeps accounts, bcrypt hashes and sessions in this
# Postgres (schema app_auth; migration 20261106100000_builtin_auth.sql) instead
# of Supabase Auth: email + password, invitations, confirmation and reset
# emails through EMAIL_PROVIDER, plus any OIDC / SAML IdPs in
# AUTH_SSO_PROVIDERS. AUTH_PROVIDER=oidc or saml: SSO only (no passwords).
# Needs DATABASE_URL (or AUTH_DATABASE_URL), APP_URL (links and redirect URIs)
# and, with DB_PROVIDER=supabase or REALTIME_PROVIDER=supabase,
# SUPABASE_JWT_SECRET (the session's database identity is a short-lived token
# signed with it). Migrate existing Supabase users first (docs: Infrastructure
# → Auth); everyone signs in again after the switch.
# AUTH_DATABASE_URL=
# AUTH_DATABASE_POOL_MAX=5
# JSON array of identity providers, e.g.
# [{"id":"entra","type":"oidc","preset":"entra","tenantId":"…","clientId":"…","clientSecret":"secret://entra-client-secret","defaultOrg":"acme"}]
# OIDC redirect URI: <APP_URL>/auth/sso/<id>/callback. SAML ACS:
# <APP_URL>/auth/saml/<id>/acs, SP metadata <APP_URL>/auth/saml/<id>/metadata.
# AUTH_SSO_PROVIDERS=
# Anyone may create a password account (default: invited emails only).
# AUTH_ALLOW_SIGNUP=false
# Confirmation email before the first password sign-in (default true).
# AUTH_REQUIRE_EMAIL_CONFIRMATION=true
# Sessions: rolling idle timeout in hours (default 168) and absolute lifetime
# in days (default 30). Lockout after N wrong passwords for M minutes.
# AUTH_SESSION_IDLE_HOURS=168
# AUTH_SESSION_MAX_DAYS=30
# AUTH_LOCKOUT_THRESHOLD=10
# AUTH_LOCKOUT_MINUTES=15
# AUTH_PASSWORD_MIN_LENGTH=8
# Force the Secure flag on auth cookies on/off (default: on unless APP_URL is http://).
# AUTH_COOKIE_SECURE=

# ── Instance administration (optional) ──────────────────────────────────────
# Instance admins: who may open Settings → Infrastructure (provider
# status, health, switches and settings, the switch log). Comma-separated emails;
# matched against the signed-in account's verified address. Workspace roles
# never grant it. Also settable with `usertasks-admin instance-admins add`.
# INSTANCE_ADMIN_EMAILS=ops@example.com
# usertasks-admin switch: where backups go (default ./backups/switches; keep it
# private — it holds config snapshots and, for auth, password hashes) and the
# pg_dump binary to use (default pg_dump on PATH; must be >= the server version).
# BACKUP_DIR=/var/backups/usertasks
# PG_DUMP=/usr/lib/postgresql/17/bin/pg_dump
# Settings → Infrastructure can change providers and provider settings (the
# same engine as `usertasks-admin switch`; needs DATABASE_URL). On by default;
# set false to keep the page read-only. In the cloud edition it is also locked
# until `usertasks-admin ui-switching on` (instance.allow_ui_switching).
# INFRA_UI_SWITCHING=true
# Data-moving switches started there (storage, auth, database) run in the
# background on this process. Detected automatically (off on Vercel, Lambda,
# Netlify and Cloud Run, where the page shows the usertasks-admin command
# instead); on|off overrides. Mount BACKUP_DIR on a volume in containers.
# INFRA_UI_BACKGROUND_JOBS=on
# On serverless the database switch runs in chunks of this many seconds (one per
# scheduler tick); keep it below the function time limit.
# INFRA_UI_CHUNK_SECONDS=40

# ── Document actions (optional) ─────────────────────────────────────────────
# Limits for the document actions (Read, Compare, Convert, PDF tools, Extract,
# Redact, Inspect): largest input file in MB (default 25, 1–200), total unpacked size
# of a Word / Excel / PowerPoint / OpenDocument file in MB (default 250), PDF
# pages read (default 500) and one step's time for reading in seconds
# (default 60; Convert gets twice this).
# DOCUMENT_MAX_MB=25
# DOCUMENT_MAX_UNPACKED_MB=250
# DOCUMENT_MAX_PDF_PAGES=500
# DOCUMENT_TIMEOUT_SECONDS=60
# OCR for scanned PDFs and images (off in every step unless turned on there):
# tesseract (default; needs the optional package tesseract.js, which the
# Docker image includes only with the build arg INCLUDE_OCR=true),
# azure_document_intelligence or none.
# DOCUMENT_OCR_PROVIDER=tesseract
# tesseract: a local folder or internal URL holding <lang>.traineddata.gz
# (air-gapped installs; otherwise language data is downloaded from the
# jsDelivr CDN on first use), and where downloaded language data is cached
# (default <system temp folder>/usertasks-ocr).
# DOCUMENT_OCR_LANG_PATH=/opt/usertasks/tessdata
# DOCUMENT_OCR_CACHE_DIR=/var/cache/usertasks-ocr
# OCR limits: pages recognised per step (default 20) and seconds for OCR
# (default 120).
# DOCUMENT_OCR_MAX_PAGES=20
# DOCUMENT_OCR_TIMEOUT_SECONDS=120
# With DOCUMENT_OCR_PROVIDER=azure_document_intelligence: an Azure AI
# Document Intelligence resource (https endpoint and key; the prebuilt-read
# model). Page images are sent to it.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://my-resource.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# External converter for high-fidelity Office → PDF (and Word / Excel /
# PowerPoint 97–2003 → PDF): a Gotenberg-compatible service on your own
# network, never a public one (e.g. docker run gotenberg/gotenberg:8). Only
# the file being converted is sent. Optional bearer token (a proxy in front
# of it) and timeout per call in seconds (default 120).
# DOCUMENT_CONVERTER_URL=http://gotenberg:3000
# DOCUMENT_CONVERTER_TOKEN=
# DOCUMENT_CONVERTER_TIMEOUT_SECONDS=120

# ── GitHub sync (optional) ──────────────────────────────────────────────────
# Author email on commits made by GitHub sync.
GITHUB_SYNC_AUTHOR_EMAIL=usertasks-sync@users.noreply.github.com

# ── Cloud edition only ──────────────────────────────────────────────────────
# Contact form delivery (/api/contact) and search-console verification.
CHIRPME_API_KEY=
CHIRPME_CHANNEL_ID=
GOOGLE_SITE_VERIFICATION=
# Public source repository URL (e.g. https://github.com/<org>/<repo>), inlined
# at build time. While unset, the marketing site shows no repository links
# and omits it from structured data. See docs/launch-checklist.md.
NEXT_PUBLIC_REPOSITORY_URL=

# ── Build output (Docker only) ──────────────────────────────────────────────
# Set to true to emit .next/standalone (the Dockerfile sets this itself).
# NEXT_OUTPUT_STANDALONE=true
