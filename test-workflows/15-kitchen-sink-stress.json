{
  "version": 1,
  "nodes": [
    {
      "id": "t1",
      "type": "webhook_received",
      "label": "Webhook Trigger",
      "position": {
        "x": 500,
        "y": 20
      },
      "config": {}
    },
    {
      "id": "n1",
      "type": "set_title",
      "label": "Set Run Title",
      "position": {
        "x": 500,
        "y": 140
      },
      "config": {
        "title": "Kitchen Sink \u2014 {{=FORMAT_DATE(NOW(), 'YYYY-MM-DD HH:mm')}}"
      }
    },
    {
      "id": "n2",
      "type": "json_build_array",
      "label": "Build Product Catalog",
      "position": {
        "x": 500,
        "y": 280
      },
      "config": {
        "items": [
          {
            "value": "{\"sku\": \"WDG-001\", \"name\": \"Alpha Widget\", \"price\": 29.99, \"stock\": 150, \"category\": \"widgets\", \"weight_kg\": 0.5, \"tags\": \"bestseller,new\"}"
          },
          {
            "value": "{\"sku\": \"WDG-002\", \"name\": \"Beta Widget\", \"price\": 49.99, \"stock\": 0, \"category\": \"widgets\", \"weight_kg\": 0.8, \"tags\": \"premium\"}"
          },
          {
            "value": "{\"sku\": \"GAD-001\", \"name\": \"Gamma Gadget\", \"price\": 199.99, \"stock\": 25, \"category\": \"gadgets\", \"weight_kg\": 2.1, \"tags\": \"premium,heavy\"}"
          },
          {
            "value": "{\"sku\": \"GAD-002\", \"name\": \"Delta Gadget\", \"price\": 89.50, \"stock\": 200, \"category\": \"gadgets\", \"weight_kg\": 0.3, \"tags\": \"bestseller\"}"
          },
          {
            "value": "{\"sku\": \"TOL-001\", \"name\": \"Epsilon Tool\", \"price\": 15.00, \"stock\": 500, \"category\": \"tools\", \"weight_kg\": 1.2, \"tags\": \"budget\"}"
          },
          {
            "value": "{\"sku\": \"TOL-002\", \"name\": \"Zeta Tool\", \"price\": 75.00, \"stock\": 42, \"category\": \"tools\", \"weight_kg\": 3.5, \"tags\": \"premium,heavy\"}"
          },
          {
            "value": "{\"sku\": \"ACC-001\", \"name\": \"Eta Accessory\", \"price\": 5.99, \"stock\": 1000, \"category\": \"accessories\", \"weight_kg\": 0.05, \"tags\": \"budget,bestseller\"}"
          },
          {
            "value": "{\"sku\": \"ACC-002\", \"name\": \"Theta Accessory\", \"price\": 12.50, \"stock\": 0, \"category\": \"accessories\", \"weight_kg\": 0.1, \"tags\": \"new\"}"
          }
        ],
        "output_var": "products"
      }
    },
    {
      "id": "n3",
      "type": "collection_count",
      "label": "Count Products",
      "position": {
        "x": 500,
        "y": 420
      },
      "config": {
        "collection": "{{products}}",
        "output_var": "product_count"
      }
    },
    {
      "id": "n4",
      "type": "collection_filter",
      "label": "In-Stock Only",
      "position": {
        "x": 300,
        "y": 560
      },
      "config": {
        "collection": "{{products}}",
        "field": "stock",
        "operator": "gt",
        "value": "0",
        "output_var": "in_stock"
      }
    },
    {
      "id": "n5",
      "type": "collection_filter",
      "label": "Out-of-Stock",
      "position": {
        "x": 700,
        "y": 560
      },
      "config": {
        "collection": "{{products}}",
        "field": "stock",
        "operator": "equals",
        "value": "0",
        "output_var": "out_of_stock"
      }
    },
    {
      "id": "n6",
      "type": "collection_count",
      "label": "Count In-Stock",
      "position": {
        "x": 300,
        "y": 700
      },
      "config": {
        "collection": "{{in_stock}}",
        "output_var": "in_stock_count"
      }
    },
    {
      "id": "n7",
      "type": "collection_count",
      "label": "Count Out-of-Stock",
      "position": {
        "x": 700,
        "y": 700
      },
      "config": {
        "collection": "{{out_of_stock}}",
        "output_var": "oos_count"
      }
    },
    {
      "id": "n8",
      "type": "condition",
      "label": "Any Out of Stock?",
      "position": {
        "x": 700,
        "y": 840
      },
      "config": {
        "branches": [
          {
            "label": "Has OOS Items",
            "logic": "AND",
            "rules": [
              {
                "field": "{{oos_count}}",
                "operator": "greater_than",
                "value": "0"
              }
            ]
          }
        ],
        "has_else": true
      }
    },
    {
      "id": "n9",
      "type": "loop",
      "label": "Alert Each OOS",
      "position": {
        "x": 600,
        "y": 1000
      },
      "config": {
        "items": "{{out_of_stock}}",
        "item_var": "oos_item",
        "index_var": "oos_idx"
      }
    },
    {
      "id": "n10",
      "type": "log",
      "label": "OOS Alert",
      "position": {
        "x": 600,
        "y": 1140
      },
      "config": {
        "message": "OUT OF STOCK: {{oos_item.sku}} \u2014 {{oos_item.name}} ({{oos_item.category}})"
      }
    },
    {
      "id": "n11",
      "type": "log",
      "label": "All In Stock",
      "position": {
        "x": 900,
        "y": 1000
      },
      "config": {
        "message": "All products in stock \u2014 no alerts needed"
      }
    },
    {
      "id": "n12",
      "type": "collection_sort",
      "label": "Sort by Price DESC",
      "position": {
        "x": 300,
        "y": 840
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "price",
        "direction": "desc",
        "output_var": "by_price"
      }
    },
    {
      "id": "n13",
      "type": "collection_get",
      "label": "Most Expensive",
      "position": {
        "x": 150,
        "y": 980
      },
      "config": {
        "collection": "{{by_price}}",
        "by": "index",
        "index": 0,
        "output_var": "most_expensive"
      }
    },
    {
      "id": "n14",
      "type": "collection_get",
      "label": "Cheapest",
      "position": {
        "x": 400,
        "y": 980
      },
      "config": {
        "collection": "{{by_price}}",
        "by": "last",
        "output_var": "cheapest"
      }
    },
    {
      "id": "n15",
      "type": "collection_unique",
      "label": "Unique Categories",
      "position": {
        "x": 300,
        "y": 1140
      },
      "config": {
        "collection": "{{products}}",
        "field": "category",
        "output_var": "categories"
      }
    },
    {
      "id": "n16",
      "type": "collection_join",
      "label": "Join Category Names",
      "position": {
        "x": 300,
        "y": 1280
      },
      "config": {
        "collection": "{{categories}}",
        "field": "category",
        "separator": " | ",
        "output_var": "category_list"
      }
    },
    {
      "id": "n17",
      "type": "loop",
      "label": "Process Each Product",
      "position": {
        "x": 500,
        "y": 1440
      },
      "config": {
        "items": "{{in_stock}}",
        "item_var": "prod",
        "index_var": "prod_idx"
      }
    },
    {
      "id": "n18",
      "type": "switch_case",
      "label": "Route by Category",
      "position": {
        "x": 500,
        "y": 1580
      },
      "config": {
        "field": "{{prod.category}}",
        "cases": [
          "widgets",
          "gadgets",
          "tools",
          "accessories"
        ],
        "has_default": true
      }
    },
    {
      "id": "n19",
      "type": "set_variable",
      "label": "Markup 30%",
      "position": {
        "x": 100,
        "y": 1740
      },
      "config": {
        "name": "markup",
        "expression": "0.30"
      }
    },
    {
      "id": "n20",
      "type": "set_variable",
      "label": "Markup 45%",
      "position": {
        "x": 300,
        "y": 1740
      },
      "config": {
        "name": "markup",
        "expression": "0.45"
      }
    },
    {
      "id": "n21",
      "type": "set_variable",
      "label": "Markup 25%",
      "position": {
        "x": 500,
        "y": 1740
      },
      "config": {
        "name": "markup",
        "expression": "0.25"
      }
    },
    {
      "id": "n22",
      "type": "set_variable",
      "label": "Markup 60%",
      "position": {
        "x": 700,
        "y": 1740
      },
      "config": {
        "name": "markup",
        "expression": "0.60"
      }
    },
    {
      "id": "n23",
      "type": "set_variable",
      "label": "Markup 20%",
      "position": {
        "x": 900,
        "y": 1740
      },
      "config": {
        "name": "markup",
        "expression": "0.20"
      }
    },
    {
      "id": "n24",
      "type": "math",
      "label": "Calc Retail Price",
      "position": {
        "x": 500,
        "y": 1900
      },
      "config": {
        "expression": "{{prod.price}} * (1 + {{markup}})",
        "output_var": "retail_price"
      }
    },
    {
      "id": "n25",
      "type": "set_variable",
      "label": "Round Retail",
      "position": {
        "x": 500,
        "y": 2040
      },
      "config": {
        "name": "retail_rounded",
        "expression": "{{=ROUND(retail_price, 2)}}"
      }
    },
    {
      "id": "n26",
      "type": "math",
      "label": "Calc Stock Value",
      "position": {
        "x": 300,
        "y": 2040
      },
      "config": {
        "expression": "{{prod.stock}} * {{retail_rounded}}",
        "output_var": "stock_value"
      }
    },
    {
      "id": "n27",
      "type": "condition",
      "label": "Is Heavy Item?",
      "position": {
        "x": 500,
        "y": 2180
      },
      "config": {
        "branches": [
          {
            "label": "Heavy (>2kg)",
            "logic": "AND",
            "rules": [
              {
                "field": "{{prod.weight_kg}}",
                "operator": "greater_than",
                "value": "2"
              }
            ]
          },
          {
            "label": "Medium (>1kg)",
            "logic": "AND",
            "rules": [
              {
                "field": "{{prod.weight_kg}}",
                "operator": "greater_than",
                "value": "1"
              }
            ]
          }
        ],
        "has_else": true,
        "match_mode": "first"
      }
    },
    {
      "id": "n28",
      "type": "set_variable",
      "label": "Ship = Freight",
      "position": {
        "x": 200,
        "y": 2340
      },
      "config": {
        "name": "shipping_class",
        "expression": "FREIGHT"
      }
    },
    {
      "id": "n29",
      "type": "set_variable",
      "label": "Ship = Standard",
      "position": {
        "x": 500,
        "y": 2340
      },
      "config": {
        "name": "shipping_class",
        "expression": "STANDARD"
      }
    },
    {
      "id": "n30",
      "type": "set_variable",
      "label": "Ship = Letter",
      "position": {
        "x": 800,
        "y": 2340
      },
      "config": {
        "name": "shipping_class",
        "expression": "LETTER"
      }
    },
    {
      "id": "n31",
      "type": "regex",
      "label": "Check Tags",
      "position": {
        "x": 500,
        "y": 2500
      },
      "config": {
        "input": "{{prod.tags}}",
        "pattern": "bestseller",
        "operation": "test",
        "output_var": "is_bestseller"
      }
    },
    {
      "id": "n32",
      "type": "modify_string",
      "label": "Uppercase SKU",
      "position": {
        "x": 300,
        "y": 2640
      },
      "config": {
        "input": "{{prod.sku}}",
        "operation": "uppercase",
        "output_var": "sku_upper"
      }
    },
    {
      "id": "n33",
      "type": "modify_string",
      "label": "Pad Stock",
      "position": {
        "x": 700,
        "y": 2640
      },
      "config": {
        "input": "{{prod.stock}}",
        "operation": "pad_start",
        "length": 6,
        "pad_char": "0",
        "output_var": "stock_padded"
      }
    },
    {
      "id": "n34",
      "type": "text_template",
      "label": "Product Line",
      "position": {
        "x": 500,
        "y": 2800
      },
      "config": {
        "template": "[{{=ADD(prod_idx, 1)}}] {{sku_upper}} | {{prod.name}} | Cost: ${{prod.price}} \u2192 Retail: ${{retail_rounded}} | Stock: {{stock_padded}} (val: ${{=ROUND(stock_value, 0)}}) | Ship: {{shipping_class}} | Bestseller: {{is_bestseller}}",
        "output_var": "product_line"
      }
    },
    {
      "id": "n35",
      "type": "log",
      "label": "Log Product",
      "position": {
        "x": 500,
        "y": 2940
      },
      "config": {
        "message": "{{product_line}}"
      }
    },
    {
      "id": "n36",
      "type": "collection_filter",
      "label": "Filter Premium",
      "position": {
        "x": 200,
        "y": 3120
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "price",
        "operator": "gt",
        "value": "50",
        "output_var": "premium_products"
      }
    },
    {
      "id": "n37",
      "type": "collection_filter",
      "label": "Filter Budget",
      "position": {
        "x": 500,
        "y": 3120
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "price",
        "operator": "lte",
        "value": "15",
        "output_var": "budget_products"
      }
    },
    {
      "id": "n38",
      "type": "collection_filter",
      "label": "Filter Low Stock",
      "position": {
        "x": 800,
        "y": 3120
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "stock",
        "operator": "lt",
        "value": "50",
        "output_var": "low_stock"
      }
    },
    {
      "id": "n39",
      "type": "collection_count",
      "label": "Count Premium",
      "position": {
        "x": 200,
        "y": 3260
      },
      "config": {
        "collection": "{{premium_products}}",
        "output_var": "premium_count"
      }
    },
    {
      "id": "n40",
      "type": "collection_count",
      "label": "Count Budget",
      "position": {
        "x": 500,
        "y": 3260
      },
      "config": {
        "collection": "{{budget_products}}",
        "output_var": "budget_count"
      }
    },
    {
      "id": "n41",
      "type": "collection_count",
      "label": "Count Low Stock",
      "position": {
        "x": 800,
        "y": 3260
      },
      "config": {
        "collection": "{{low_stock}}",
        "output_var": "low_stock_count"
      }
    },
    {
      "id": "n42",
      "type": "collection_sort",
      "label": "Sort by Weight",
      "position": {
        "x": 200,
        "y": 3400
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "weight_kg",
        "direction": "asc",
        "output_var": "by_weight"
      }
    },
    {
      "id": "n43",
      "type": "collection_join",
      "label": "Join SKUs",
      "position": {
        "x": 500,
        "y": 3400
      },
      "config": {
        "collection": "{{in_stock}}",
        "field": "sku",
        "separator": ", ",
        "output_var": "all_skus"
      }
    },
    {
      "id": "n44",
      "type": "collection_join",
      "label": "Join Low Stock Names",
      "position": {
        "x": 800,
        "y": 3400
      },
      "config": {
        "collection": "{{low_stock}}",
        "field": "name",
        "separator": " / ",
        "output_var": "low_stock_names"
      }
    },
    {
      "id": "n45",
      "type": "loop_n_times",
      "label": "Generate 3 Discounts",
      "position": {
        "x": 500,
        "y": 3560
      },
      "config": {
        "count": "3",
        "index_var": "disc_i"
      }
    },
    {
      "id": "n46",
      "type": "math",
      "label": "Calc Discount %",
      "position": {
        "x": 500,
        "y": 3700
      },
      "config": {
        "expression": "({{disc_i}} + 1) * 10",
        "output_var": "disc_pct"
      }
    },
    {
      "id": "n47",
      "type": "math",
      "label": "Apply to Most Expensive",
      "position": {
        "x": 500,
        "y": 3840
      },
      "config": {
        "expression": "{{most_expensive.price}} * (1 - {{disc_pct}} / 100)",
        "output_var": "discounted_price"
      }
    },
    {
      "id": "n48",
      "type": "log",
      "label": "Log Discount",
      "position": {
        "x": 500,
        "y": 3980
      },
      "config": {
        "message": "Tier {{=ADD(disc_i, 1)}} ({{disc_pct}}% off): {{most_expensive.name}} ${{most_expensive.price}} \u2192 ${{=ROUND(discounted_price, 2)}}"
      }
    },
    {
      "id": "n49",
      "type": "format_date",
      "label": "Format Report Date",
      "position": {
        "x": 300,
        "y": 4160
      },
      "config": {
        "input": "{{=NOW()}}",
        "format": "datetime",
        "output_var": "report_date"
      }
    },
    {
      "id": "n50",
      "type": "date_math",
      "label": "Next Restock Date",
      "position": {
        "x": 700,
        "y": 4160
      },
      "config": {
        "date": "{{=NOW()}}",
        "operation": "add",
        "amount": 14,
        "unit": "days",
        "output_var": "next_restock"
      }
    },
    {
      "id": "n51",
      "type": "regex",
      "label": "Extract All SKU Codes",
      "position": {
        "x": 500,
        "y": 4300
      },
      "config": {
        "input": "{{all_skus}}",
        "pattern": "[A-Z]{3}-\\d{3}",
        "flags": "g",
        "operation": "match",
        "output_var": "sku_codes"
      }
    },
    {
      "id": "n52",
      "type": "regex",
      "label": "Replace SKU Prefix",
      "position": {
        "x": 500,
        "y": 4440
      },
      "config": {
        "input": "{{most_expensive.sku}}",
        "pattern": "^([A-Z]+)",
        "operation": "replace",
        "replace_with": "PREM",
        "output_var": "premium_sku"
      }
    },
    {
      "id": "n53",
      "type": "json_build_object",
      "label": "Build Stats Object",
      "position": {
        "x": 500,
        "y": 4580
      },
      "config": {
        "fields": [
          {
            "key": "total_products",
            "value": "{{product_count}}"
          },
          {
            "key": "in_stock",
            "value": "{{in_stock_count}}"
          },
          {
            "key": "out_of_stock",
            "value": "{{oos_count}}"
          },
          {
            "key": "premium_items",
            "value": "{{premium_count}}"
          },
          {
            "key": "budget_items",
            "value": "{{budget_count}}"
          },
          {
            "key": "low_stock_items",
            "value": "{{low_stock_count}}"
          },
          {
            "key": "most_expensive_sku",
            "value": "{{most_expensive.sku}}"
          },
          {
            "key": "cheapest_sku",
            "value": "{{cheapest.sku}}"
          },
          {
            "key": "categories",
            "value": "{{category_list}}"
          },
          {
            "key": "report_date",
            "value": "{{report_date}}"
          }
        ],
        "output_var": "stats"
      }
    },
    {
      "id": "n54",
      "type": "json_get_value",
      "label": "Read Total from Stats",
      "position": {
        "x": 500,
        "y": 4720
      },
      "config": {
        "source": "{{stats}}",
        "path": "total_products",
        "output_var": "verified_total"
      }
    },
    {
      "id": "n55",
      "type": "text_template",
      "label": "Build Final Report",
      "position": {
        "x": 500,
        "y": 4880
      },
      "config": {
