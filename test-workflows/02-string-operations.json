{
  "version": 1,
  "nodes": [
    {
      "id": "t1",
      "type": "webhook_received",
      "label": "Webhook",
      "position": { "x": 400, "y": 20 },
      "config": {}
    },
    {
      "id": "n1",
      "type": "set_variable",
      "label": "Set Name",
      "position": { "x": 400, "y": 160 },
      "config": { "name": "full_name", "expression": "John Smith" }
    },
    {
      "id": "n2",
      "type": "modify_string",
      "label": "Uppercase",
      "position": { "x": 200, "y": 300 },
      "config": { "operation": "upper", "input": "{{full_name}}", "output_var": "upper_name" }
    },
    {
      "id": "n3",
      "type": "modify_string",
      "label": "Lowercase",
      "position": { "x": 600, "y": 300 },
      "config": { "operation": "lower", "input": "{{full_name}}", "output_var": "lower_name" }
    },
    {
      "id": "n4",
      "type": "text_template",
      "label": "Build Greeting",
      "position": { "x": 400, "y": 440 },
      "config": { "template": "Hello {{upper_name}}! Your lowercase name is {{lower_name}}.", "output_var": "greeting" }
    },
    {
      "id": "n5",
      "type": "regex",
      "label": "Extract First Name",
      "position": { "x": 400, "y": 580 },
      "config": { "input": "{{full_name}}", "pattern": "^(\\w+)", "output_var": "first_name" }
    },
    {
      "id": "n6",
      "type": "log",
      "label": "Log Result",
      "position": { "x": 400, "y": 720 },
      "config": { "message": "Greeting: {{greeting}} | First: {{first_name}}" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "t1", "target": "n1" },
    { "id": "e2", "source": "n1", "target": "n2" },
    { "id": "e3", "source": "n1", "target": "n3" },
    { "id": "e4", "source": "n2", "target": "n4" },
    { "id": "e5", "source": "n3", "target": "n4" },
    { "id": "e6", "source": "n4", "target": "n5" },
    { "id": "e7", "source": "n5", "target": "n6" }
  ],
  "user_variables": [],
  "swimlanes": []
}
