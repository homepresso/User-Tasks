{
  "manifest_version": 1,
  "key": "ut_crypto",
  "name": "Crypto & IDs",
  "version": "1.0.0",
  "description": "Generate UUIDs (v4, v7), ULIDs, random codes and one-time codes; hash and HMAC-sign data with a stored secret; encode and decode base64, hex and URLs; sign and verify HS256 JSON Web Tokens.",
  "icon": "key-round",
  "color": "#475569",
  "category": "Security",
  "entry": "dist/action.js",
  "operations": [
    {
      "id": "uuid",
      "label": "UUID",
      "description": "Generate UUIDs: v4 (random) or v7 (time-ordered: sorts by creation time, good for database keys). v7 IDs from one call are strictly increasing.",
      "inputs": [
        {
          "name": "version",
          "label": "Version",
          "type": "select",
          "description": "v4 random, or v7 time-ordered.",
          "default": "v4",
          "options": [
            {
              "value": "v4",
              "label": "v4 (random)"
            },
            {
              "value": "v7",
              "label": "v7 (time-ordered)"
            }
          ]
        },
        {
          "name": "count",
          "label": "How many",
          "type": "integer",
          "description": "Number of UUIDs to generate (1–1000).",
          "default": 1
        },
        {
          "name": "uppercase",
          "label": "Upper case",
          "type": "boolean",
          "description": "Upper-case hex digits.",
          "default": false
        }
      ],
      "outputs": [
        {
          "name": "uuid",
          "label": "UUID",
          "type": "string",
          "description": "The first (or only) UUID."
        },
        {
          "name": "uuids",
          "label": "UUIDs",
          "type": "array",
          "description": "Every UUID generated.",
          "items": {
            "type": "string"
          }
        }
      ],
      "sample": {
        "version": "v7",
        "count": 3
      }
    },
    {
      "id": "ulid",
      "label": "ULID",
      "description": "Generate ULIDs: 26-character, time-ordered, URL-safe IDs (Crockford base32). ULIDs from one call are strictly increasing.",
      "inputs": [
        {
          "name": "count",
          "label": "How many",
          "type": "integer",
          "description": "Number of ULIDs to generate (1–1000).",
          "default": 1
        }
      ],
      "outputs": [
        {
          "name": "ulid",
          "label": "ULID",
          "type": "string",
          "description": "The first (or only) ULID."
        },
        {
          "name": "ulids",
          "label": "ULIDs",
          "type": "array",
          "description": "Every ULID generated.",
          "items": {
            "type": "string"
          }
        }
      ],
      "sample": {
        "count": 3
      }
    },
    {
      "id": "hash",
      "label": "Hash",
      "description": "The SHA-256, SHA-512, SHA-384 or SHA-1 digest of a text (UTF-8), as hex, base64 or base64url. For fingerprints, de-duplication and integrity checks; do not use plain hashes for passwords.",
      "inputs": [
        {
          "name": "text",
          "label": "Text",
          "type": "text",
          "description": "The text to hash (UTF-8; empty text has a hash too).",
          "example": "abc"
        },
        {
          "name": "algorithm",
          "label": "Algorithm",
          "type": "select",
          "description": "Digest algorithm.",
          "default": "SHA-256",
          "options": [
            {
              "value": "SHA-256",
              "label": "SHA-256"
            },
            {
              "value": "SHA-512",
              "label": "SHA-512"
            },
            {
              "value": "SHA-384",
              "label": "SHA-384"
            },
            {
              "value": "SHA-1",
              "label": "SHA-1 (legacy systems only)"
            }
          ]
        },
        {
          "name": "encoding",
          "label": "Output",
          "type": "select",
          "description": "How the digest is written.",
          "default": "hex",
          "options": [
            {
              "value": "hex",
              "label": "Hex"
            },
            {
              "value": "base64",
              "label": "Base64"
            },
            {
              "value": "base64url",
              "label": "Base64url"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "hash",
          "label": "Hash",
          "type": "string"
        },
        {
          "name": "algorithm",
          "label": "Algorithm",
          "type": "string"
        }
      ],
      "sample": {
        "text": "abc",
        "algorithm": "SHA-256"
      }
    },
    {
      "id": "hmac",
      "label": "HMAC signature",
      "description": "Sign a message with HMAC using the hmac_key secret, or check a received signature (e.g. a webhook's X-Signature header) in constant time. The secret never enters the action's code.",
      "inputs": [
        {
          "name": "message",
          "label": "Message",
          "type": "text",
          "description": "The exact text to sign, e.g. the raw webhook body.",
          "required": true,
          "example": "{\"event\":\"invoice.paid\",\"id\":\"evt_1042\"}"
        },
        {
          "name": "algorithm",
          "label": "Algorithm",
          "type": "select",
          "description": "HMAC hash.",
          "default": "SHA-256",
          "options": [
            {
              "value": "SHA-256",
              "label": "SHA-256"
            },
            {
              "value": "SHA-512",
              "label": "SHA-512"
            },
            {
              "value": "SHA-384",
              "label": "SHA-384"
            },
            {
              "value": "SHA-1",
              "label": "SHA-1 (legacy systems only)"
            }
          ]
        },
        {
          "name": "encoding",
          "label": "Output",
          "type": "select",
          "description": "How the signature is written (match what the sender uses).",
          "default": "hex",
          "options": [
            {
              "value": "hex",
              "label": "Hex"
            },
            {
              "value": "base64",
              "label": "Base64"
            },
            {
              "value": "base64url",
              "label": "Base64url"
            }
          ]
        },
        {
          "name": "expected",
          "label": "Signature to check",
          "type": "string",
          "description": "Optional: a received signature to compare with (a sha256= prefix is ignored).",
          "example": "sha256=1c1b1b59b8b80733797d06dae9234186bd3e41395f81d2773aa87f70daeaa4b3"
        }
      ],
      "outputs": [
        {
          "name": "signature",
          "label": "Signature",
          "type": "string"
        },
        {
          "name": "matches",
          "label": "Matches",
          "type": "boolean",
          "description": "Whether Signature to check equals the computed signature (empty when none was given)."
        }
      ],
      "sample": {
        "message": "{\"event\":\"invoice.paid\",\"id\":\"evt_1042\"}",
        "expected": "sha256=1c1b1b59b8b80733797d06dae9234186bd3e41395f81d2773aa87f70daeaa4b3"
      }
    },
    {
      "id": "encode",
      "label": "Encode",
      "description": "Encode text (UTF-8) as base64, base64url, hex or URL percent-encoding.",
      "inputs": [
        {
          "name": "text",
          "label": "Text",
          "type": "text",
          "description": "The text to encode.",
          "required": true,
          "example": "Hello, Wörld & friends"
        },
        {
          "name": "format",
          "label": "Format",
          "type": "select",
          "description": "Encoding.",
          "default": "base64",
          "options": [
            {
              "value": "base64",
              "label": "Base64"
            },
            {
              "value": "base64url",
              "label": "Base64url"
            },
            {
              "value": "hex",
              "label": "Hex"
            },
            {
              "value": "url",
              "label": "URL (percent-encoding)"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "result",
          "label": "Encoded",
          "type": "text"
        }
      ],
      "sample": {
        "text": "Hello, Wörld & friends",
        "format": "base64"
      }
    },
    {
      "id": "decode",
      "label": "Decode",
      "description": "Decode base64, base64url, hex or URL percent-encoding back to text (UTF-8). Invalid input fails with a clear message.",
      "inputs": [
        {
          "name": "text",
          "label": "Encoded text",
          "type": "text",
          "description": "The text to decode (whitespace is ignored for base64 and hex).",
          "required": true,
          "example": "SGVsbG8sIFfDtnJsZCAmIGZyaWVuZHM="
        },
        {
          "name": "format",
          "label": "Format",
          "type": "select",
          "description": "Encoding.",
          "default": "base64",
          "options": [
            {
              "value": "base64",
              "label": "Base64"
            },
            {
              "value": "base64url",
              "label": "Base64url"
            },
            {
              "value": "hex",
              "label": "Hex"
            },
            {
              "value": "url",
              "label": "URL (percent-encoding)"
            }
          ]
        },
        {
          "name": "plus_as_space",
          "label": "+ means space",
          "type": "boolean",
          "description": "URL format: decode + as a space (HTML form encoding).",
          "default": false
        }
      ],
      "outputs": [
        {
          "name": "result",
          "label": "Decoded",
          "type": "text"
        }
      ],
      "sample": {
        "text": "SGVsbG8sIFfDtnJsZCAmIGZyaWVuZHM=",
        "format": "base64"
      }
    },
    {
      "id": "random_code",
      "label": "Random code",
      "description": "Generate unbiased random codes from an alphabet: digits, letters and digits, hex, or no look-alikes (no 0/O, 1/I/L) for codes people read and type. Optional grouping such as XXXX-XXXX.",
      "inputs": [
        {
          "name": "length",
          "label": "Length",
          "type": "integer",
          "description": "Characters per code, not counting separators (1–256).",
          "default": 8
        },
        {
          "name": "alphabet",
          "label": "Alphabet",
          "type": "select",
          "description": "Which characters to use.",
          "default": "no_lookalikes",
          "options": [
            {
              "value": "no_lookalikes",
              "label": "Letters and digits without look-alikes"
            },
            {
              "value": "digits",
              "label": "Digits"
            },
            {
              "value": "alphanumeric",
              "label": "Letters (both cases) and digits"
            },
            {
              "value": "alphanumeric_upper",
              "label": "Upper-case letters and digits"
            },
            {
              "value": "letters_upper",
              "label": "Upper-case letters"
            },
            {
              "value": "hex",
              "label": "Hex"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ]
        },
        {
          "name": "custom_alphabet",
          "label": "Custom alphabet",
          "type": "string",
          "description": "With Alphabet = Custom: the characters to use (at least 2).",
          "example": "ACDEFHJKMNPRTUVWXY34679"
        },
        {
          "name": "count",
          "label": "How many",
          "type": "integer",
          "description": "Number of codes to generate (1–1000).",
          "default": 1
        },
        {
          "name": "group_size",
          "label": "Group size",
          "type": "integer",
          "description": "Insert the separator every N characters (0 = no grouping).",
          "default": 0,
          "example": 4
        },
        {
          "name": "separator",
          "label": "Separator",
          "type": "string",
          "description": "Placed between groups.",
          "default": "-"
        }
      ],
      "outputs": [
        {
          "name": "code",
          "label": "Code",
          "type": "string",
          "description": "The first (or only) code."
        },
        {
          "name": "codes",
          "label": "Codes",
          "type": "array",
          "description": "Every code generated.",
          "items": {
            "type": "string"
          }
        }
      ],
      "sample": {
        "length": 8,
        "group_size": 4,
        "count": 2
      }
    },
    {
      "id": "otp",
      "label": "One-time code",
      "description": "A numeric one-time code (e.g. for email or SMS verification) with its expiry time and SHA-256 hash: store the hash, not the code, and compare hashes when the user types it.",
      "inputs": [
        {
          "name": "digits",
          "label": "Digits",
          "type": "integer",
          "description": "4–10 digits.",
          "default": 6
        },
        {
          "name": "expires_minutes",
          "label": "Valid for (minutes)",
          "type": "integer",
          "description": "How long the code is valid.",
          "default": 10
        }
      ],
      "outputs": [
        {
          "name": "code",
          "label": "Code",
          "type": "string",
          "description": "The code (keeps leading zeros)."
        },
        {
          "name": "expires_at",
          "label": "Expires at",
          "type": "datetime",
          "description": "UTC instant."
        },
        {
          "name": "code_hash",
          "label": "Code hash",
          "type": "string",
          "description": "SHA-256 hex of the code."
        }
      ],
      "sample": {
        "digits": 6,
        "expires_minutes": 10
      }
    },
    {
      "id": "sign_token",
      "label": "Sign token (JWT)",
      "description": "Create a compact HS256 JSON Web Token signed with the token_secret secret: your claims plus iat, exp (from Expires in), optional iss / aud / sub and a unique jti.",
      "inputs": [
        {
          "name": "claims",
          "label": "Claims",
          "type": "object",
          "description": "The token's data, e.g. { \"role\": \"approver\", \"request_id\": \"REQ-1042\" }.",
          "example": {
            "role": "approver",
            "request_id": "REQ-1042"
          }
        },
        {
          "name": "expires_minutes",
          "label": "Expires in (minutes)",
          "type": "integer",
          "description": "Lifetime of the token; 0 for no expiry.",
          "default": 60
        },
        {
          "name": "issuer",
          "label": "Issuer (iss)",
          "type": "string",
          "description": "Optional issuer claim.",
          "example": "usertasks"
        },
        {
          "name": "audience",
          "label": "Audience (aud)",
          "type": "string",
          "description": "Optional audience claim.",
          "example": "approvals"
        },
        {
          "name": "subject",
          "label": "Subject (sub)",
          "type": "string",
          "description": "Optional subject claim, e.g. a user id.",
          "example": "user-42"
        }
      ],
      "outputs": [
        {
          "name": "jwt",
          "label": "Token (JWT)",
          "type": "string",
          "description": "header.payload.signature"
        },
        {
          "name": "expires_at",
          "label": "Expires at",
          "type": "datetime",
          "description": "UTC instant (empty without expiry)."
        },
        {
          "name": "claims",
          "label": "Claims",
          "type": "object",
          "description": "Every claim in the token."
        }
      ],
      "sample": {
        "claims": {
          "role": "approver",
          "request_id": "REQ-1042"
        },
        "expires_minutes": 60,
        "issuer": "usertasks",
        "audience": "approvals",
        "subject": "user-42"
      }
    },
    {
      "id": "verify_token",
      "label": "Verify token (JWT)",
      "description": "Check an HS256 token signed with token_secret: the signature (constant-time), expiry (exp) and not-before (nbf) with a leeway, and optionally the issuer and audience. Invalid tokens return valid = false and a reason instead of failing the step.",
      "inputs": [
        {
          "name": "jwt",
          "label": "Token (JWT)",
          "type": "string",
          "description": "The token (a \"Bearer \" prefix is ignored).",
          "required": true,
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFwcHJvdmVyIiwiaXNzIjoidXNlcnRhc2tzIiwiYXVkIjoiYXBwcm92YWxzIn0.ViY7aLGdekI4TR6SYbUEvxrBc4VtgmtpczNL4qmy6YU"
        },
        {
          "name": "issuer",
          "label": "Expected issuer",
          "type": "string",
          "description": "Optional: iss must equal this.",
          "example": "usertasks"
        },
        {
          "name": "audience",
          "label": "Expected audience",
          "type": "string",
          "description": "Optional: aud must equal or contain this.",
          "example": "approvals"
        },
        {
          "name": "leeway_seconds",
          "label": "Clock leeway (seconds)",
          "type": "integer",
          "description": "Tolerance for exp and nbf.",
          "default": 30
        }
      ],
      "outputs": [
        {
          "name": "valid",
          "label": "Valid",
          "type": "boolean"
        },
        {
          "name": "reason",
          "label": "Reason",
          "type": "string",
          "description": "Why the token is not valid: malformed, unsupported algorithm, bad signature, expired, not yet valid, issuer or audience does not match (empty when valid)."
        },
        {
          "name": "claims",
          "label": "Claims",
          "type": "object",
          "description": "The token's claims when the signature is valid (also when expired), else empty."
        },
        {
          "name": "expires_at",
          "label": "Expires at",
          "type": "datetime",
          "description": "From exp (empty without expiry)."
        }
      ],
      "sample": {
        "issuer": "usertasks",
        "audience": "approvals",
        "jwt": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTQyIiwicm9sZSI6ImFwcHJvdmVyIiwiaXNzIjoidXNlcnRhc2tzIiwiYXVkIjoiYXBwcm92YWxzIn0.ViY7aLGdekI4TR6SYbUEvxrBc4VtgmtpczNL4qmy6YU"
      }
    }
  ],
  "capabilities": {
    "credentials": [
      {
        "name": "hmac_key",
        "label": "HMAC key",
        "description": "Shared secret for the HMAC operation (e.g. a webhook signing secret)."
      },
      {
        "name": "token_secret",
        "label": "Token signing secret",
        "description": "Secret for signing and verifying HS256 tokens (use at least 32 random characters)."
      }
    ]
  },
  "limits": {
    "timeout_ms": 5000,
    "memory_mb": 32
  },
  "summary": "Identifiers and cryptography for workflows: UUID v4 and time-ordered v7, ULIDs, SHA hashes, HMAC signatures with a secret only administrators see (verify webhook signatures), base64 / hex / URL encoding, unbiased random codes, one-time codes with expiry and compact HS256 JWTs.",
  "purpose": "Create IDs and codes, check webhook signatures and issue or check signed tokens without exposing secrets to workflow builders.",
  "recommended_for": "Integrations and webhooks, reference numbers, voucher and verification codes, signed links and tokens for external systems.",
  "setup_notes": [
    "HMAC and the token operations need secrets: after installing, an administrator sets hmac_key and/or token_secret in Extensibility → Workflow actions. Values are stored encrypted and never shown to workflow builders or to the action code for HMAC (the host signs).",
    "Operations that do not use a secret work without setup. Randomness comes from the server's cryptographic random generator."
  ],
  "author": "UserTasks",
  "license": "Apache-2.0",
  "tags": [
    "uuid",
    "ulid",
    "hash",
    "hmac",
    "jwt",
    "base64",
    "otp",
    "random",
    "webhook",
    "security"
  ]
}
