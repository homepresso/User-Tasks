    {
      "id": "csv_to_json",
      "label": "CSV to JSON",
      "description": "Parse CSV text (RFC 4180: quoted fields, \"\" escapes, line breaks in quotes) into a list of objects, using the header row for field names and inferring numbers and true/false.",
      "inputs": [
        {
          "name": "csv",
          "label": "CSV",
          "type": "text",
          "description": "The CSV text.",
          "required": true,
          "example": "id,name,amount\n1,\"Smith, Jo\",12.50\n2,Ana,7"
        },
        {
          "name": "delimiter",
          "label": "Delimiter",
          "type": "string",
          "description": "auto (detect), comma, semicolon, tab, pipe or the character(s).",
          "default": "auto"
        },
        {
          "name": "header",
          "label": "Header row",
          "type": "boolean",
          "description": "The first row holds the field names (off: column_1, column_2, …).",
          "default": true
        },
        {
          "name": "infer_types",
          "label": "Infer types",
          "type": "boolean",
          "description": "Turn numbers and true/false into numbers and booleans, empty cells into empty values (numbers with leading zeros stay text).",
          "default": true
        },
        {
          "name": "trim",
          "label": "Trim",
          "type": "boolean",
          "description": "Trim spaces around values.",
          "default": true
        }
      ],
      "outputs": [
        {
          "name": "items",
          "label": "Items",
          "type": "array",
          "description": "One object per data row.",
          "items": {
            "type": "object"
          }
        },
        {
          "name": "columns",
          "label": "Columns",
          "type": "array",
          "description": "The field names.",
          "items": {
            "type": "string"
          }
        },
        {
          "name": "count",
          "label": "Count",
          "type": "integer",
          "description": "How many data rows."
        }
      ],
      "sample": {
        "csv": "id,name,amount\n1,\"Smith, Jo\",12.50\n2,Ana,7"
      }
    },
    {
