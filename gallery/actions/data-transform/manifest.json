    {
      "id": "join",
      "label": "Join",
      "description": "Combine two lists on matching keys (inner, left, right or full outer). Right fields whose names clash with left fields get the prefix right_ (or your own prefix on every right field).",
      "inputs": [
        {
          "name": "left",
          "label": "Left list",
          "type": "array",
          "description": "The main list of objects.",
          "required": true,
          "items": {
            "type": "object"
          },
          "example": [
            {
              "id": "SO-1",
              "region": "North",
              "product": "Desk",
              "status": "paid",
              "amount": 1200,
              "qty": 2
            },
            {
              "id": "SO-2",
              "region": "South",
              "product": "Chair",
              "status": "paid",
              "amount": 300,
              "qty": 3
            },
            {
              "id": "SO-3",
              "region": "North",
              "product": "Chair",
              "status": "open",
              "amount": 450,
              "qty": 5
            }
          ]
        },
        {
          "name": "right",
          "label": "Right list",
          "type": "array",
          "description": "The list to look up.",
          "required": true,
          "items": {
            "type": "object"
          },
          "example": [
            {
              "region": "North",
              "manager": "Aroha"
            },
            {
              "region": "South",
              "manager": "Ben"
            }
          ]
        },
        {
          "name": "left_key",
          "label": "Left key",
          "type": "array",
          "description": "Key field(s) in the left list.",
          "required": true,
          "items": {
            "type": "string"
          },
          "example": [
            "region"
          ]
        },
        {
          "name": "right_key",
          "label": "Right key",
          "type": "array",
          "description": "Key field(s) in the right list, in the same order (default: the left key names).",
          "items": {
            "type": "string"
          }
        },
        {
          "name": "type",
          "label": "Join type",
          "type": "select",
          "description": "Which unmatched rows to keep.",
          "default": "inner",
          "options": [
            {
              "value": "inner",
              "label": "Inner (matches only)"
            },
            {
              "value": "left",
              "label": "Left (all left rows)"
            },
            {
              "value": "right",
              "label": "Right (all right rows)"
            },
            {
              "value": "full",
              "label": "Full (all rows)"
            }
          ]
        },
        {
          "name": "right_prefix",
          "label": "Right prefix",
          "type": "string",
          "description": "Optional prefix for every field from the right list.",
