      "outputs": [
        {
          "name": "items",
          "label": "Items",
          "type": "array",
          "description": "The joined rows (one per match).",
          "items": {
            "type": "object"
          }
        },
        {
          "name": "count",
          "label": "Count",
          "type": "integer",
          "description": "How many items were returned."
        },
        {
          "name": "unmatched_left",
          "label": "Unmatched left",
          "type": "integer",
          "description": "Left rows with no match."
        },
