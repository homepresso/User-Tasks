  "capabilities": {},
  "limits": {
    "timeout_ms": 5000,
    "memory_mb": 32
  },
  "summary": "Reshape lists of records inside a workflow: pick values by JSON path, rename and select fields, filter by conditions, multi-key sort, group by with count / sum / avg / min / max, pivot and unpivot, remove duplicates, join two lists on keys and convert between CSV and JSON (RFC 4180).",
  "purpose": "Transform API responses, data table rows and spreadsheets in one step instead of loops and many collection nodes.",
  "recommended_for": "Integrations, reports and exports, reconciliations, imports from CSV, summarising rows before an approval or notification.",
  "setup_notes": [
    "Pure computation: no network, data or secrets. Nothing to configure after installing.",
    "Paths use dots and brackets: customer.name, items[0].sku, items[-1], items[*].price, [\"field with spaces\"].",
    "Lists hold up to 100,000 items; inputs and outputs are limited to 5 MB of JSON each."
  ],
