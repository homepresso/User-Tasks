            "qty": 2
          },
          {
            "id": "SO-2",
            "region": "South",
            "product": "Chair",
            "status": "paid",
            "amount": 300,
            "qty": 3
          },
          {
            "id": "SO-3",
            "region": "North",
            "product": "Chair",
            "status": "open",
            "amount": 450,
            "qty": 5
          }
        ],
        "right": [
          {
            "region": "North",
            "manager": "Aroha"
          },
          {
            "region": "South",
            "manager": "Ben"
          }
        ],
        "left_key": [
          "region"
        ],
        "type": "left"
      }
