    "integration_id": "665fd837-6f7d-46b8-a4fe-697b144b7c88",
    "name": "Places text search (addresses)",
    "description": "Google Places API (New) Text Search: up to five places for a typed address, with the formatted address, address components and coordinates. Used by the Address control's lookup.",
    "tags": [
      "maps",
      "addresses"
    ],
    "request_config": {
      "method": "POST",
      "headers": {
        "X-Goog-FieldMask": "places.id,places.formattedAddress,places.addressComponents,places.location"
      },
      "query_params": {},
      "body_template": "{\"textQuery\":\"{{query}}\",\"maxResultCount\":5}",
      "path_template": "/v1/places:searchText",
      "response_schema": {
        "version": 1,
        "source": "sample",
        "root": {
          "type": "object",
          "fields": [
            {
              "name": "places",
              "type": "array",
              "items": {
                "type": "object",
                "fields": [
                  {
                    "name": "id",
                    "type": "string",
                    "example": "ChIJLWl7ckhIDW0RRhZBrhyJUBE"
                  },
                  {
                    "name": "formattedAddress",
                    "type": "string",
                    "example": "1 Queen Street, Auckland CBD, Auckland 1010, New Zealand"
                  },
                  {
                    "name": "addressComponents",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "fields": [
                        {
                          "name": "longText",
                          "type": "string",
                          "example": "Queen Street"
                        },
                        {
                          "name": "shortText",
                          "type": "string",
                          "example": "Queen St"
                        },
                        {
                          "name": "types",
                          "type": "array",
                          "items": {
                            "type": "string",
                            "example": "route"
                          }
                        },
                        {
                          "name": "languageCode",
                          "type": "string",
                          "example": "en"
                        }
                      ]
                    }
                  },
                  {
                    "name": "location",
                    "type": "object",
                    "fields": [
                      {
                        "name": "latitude",
                        "type": "number",
                        "example": -36.8441486
                      },
                      {
                        "name": "longitude",
                        "type": "number",
                        "example": 174.7671598
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
