        "outputs": {
          "band": "Specialist",
          "estimate_band": "Over 5,000",
          "sla_days": 2,
          "inspection": "yes",
          "note": "Severe damage: book an inspection and check for total loss."
        },
        "id": "cd424201-d4ba-5310-abce-350cced748fe",
        "enabled": true
      },
      {
