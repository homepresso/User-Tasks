      },
      {
        "id": "e-exit-record-declined-by-employee",
        "source": "exit",
        "target": "record",
        "label": "Declined by employee"
      },
      {
        "id": "e-record-notify_leaver",
        "source": "record",
        "target": "notify_leaver"
      },
      {
        "id": "e-notify_leaver-notify_manager",
        "source": "notify_leaver",
        "target": "notify_manager"
      },
      {
        "id": "e-notify_manager-done",
        "source": "notify_manager",
        "target": "done"
      }
    ],
    "user_variables": [
      {
        "id": "v-employee_id",
        "name": "employee_id",
        "type": "string",
        "description": "Employee number in the HR system (E-1042…)",
        "defaultValue": "",
        "required": true,
        "label": "Employee number"
      },
      {
        "id": "v-last_working_day",
        "name": "last_working_day",
        "type": "string",
        "description": "Last working day",
        "defaultValue": "",
        "required": true,
        "label": "Last working day",
        "format": "date"
      },
      {
        "id": "v-reason",
        "name": "reason",
        "type": "string",
        "description": "Reason for leaving",
        "defaultValue": "",
        "required": true,
        "label": "Reason",
        "options": [
          "resignation",
          "redundancy",
          "end of contract",
          "dismissal"
        ]
      },
      {
        "id": "v-rehire_eligible",
        "name": "rehire_eligible",
        "type": "boolean",
        "description": "Would you rehire this person?",
        "defaultValue": "true",
        "label": "Eligible for rehire"
      },
      {
        "id": "v-notes",
        "name": "notes",
        "type": "string",
        "description": "Anything IT, payroll or HR should know (handover, notice period, agreements)",
        "defaultValue": "",
        "label": "Notes"
      },
      {
        "id": "v-it_owner_id",
        "name": "it_owner_id",
        "type": "string",
        "description": "Optional: user id of the IT person who revokes access (overrides the install-time default)",
        "defaultValue": "",
        "label": "IT owner (user id)"
      },
      {
        "id": "v-payroll_owner_id",
        "name": "payroll_owner_id",
        "type": "string",
        "description": "Optional: user id of the payroll officer",
        "defaultValue": "",
        "label": "Payroll (user id)"
      },
      {
        "id": "v-hr_owner_id",
        "name": "hr_owner_id",
        "type": "string",
        "description": "Optional: user id of the HR partner who runs the exit interview",
        "defaultValue": "",
        "label": "HR partner (user id)"
      }
    ],
    "swimlanes": [],
