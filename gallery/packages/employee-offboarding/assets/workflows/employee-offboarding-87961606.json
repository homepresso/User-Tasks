        "target": "notify_equipment",
        "label": "Equipment outstanding"
      },
      {
        "id": "e-notify_equipment-payroll",
        "source": "notify_equipment",
        "target": "payroll"
      },
      {
        "id": "e-payroll-pay_days-final-pay-scheduled",
        "source": "payroll",
        "target": "pay_days",
        "label": "Final pay scheduled"
      },
      {
        "id": "e-pay_days-pay_date",
        "source": "pay_days",
        "target": "pay_date"
      },
      {
        "id": "e-pay_date-needs_exit",
        "source": "pay_date",
        "target": "needs_exit"
      },
      {
        "id": "e-needs_exit-exit-exit-interview",
        "source": "needs_exit",
        "target": "exit",
