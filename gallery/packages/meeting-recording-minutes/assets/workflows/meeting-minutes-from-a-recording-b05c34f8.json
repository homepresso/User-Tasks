          "diarize": true,
          "max_speakers": 10,
          "formats": [
            "srt",
            "vtt",
            "txt"
          ],
          "prompt": "Team meeting recording. Attendees: {{form.attendees}}",
          "output_var": "transcript",
          "run_mode": "auto"
        }
