          "expression": "{{=SUM(IF(task_data.fire_exits_clear, 0, 1), IF(task_data.extinguishers_tagged, 0, 1), IF(task_data.alarm_tested, 0, 1), IF(task_data.evac_plan_posted, 0, 1), IF(task_data.walkways_clear, 0, 1), IF(task_data.spills_clear, 0, 1), IF(task_data.lighting_ok, 0, 1), IF(task_data.storage_safe, 0, 1), IF(task_data.guards_fitted, 0, 1), IF(task_data.electrical_tagged, 0, 1), IF(task_data.ladders_ok, 0, 1), IF(task_data.ppe_available, 0, 1), IF(task_data.first_aid_stocked, 0, 1), IF(task_data.first_aiders_listed, 0, 1), IF(task_data.chemicals_labelled, 0, 1), IF(task_data.noticeboard_current, 0, 1))}}"
