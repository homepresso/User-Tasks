          {
            "inputKey": "days_to_expiry",
            "operator": "less_than",
            "value": 0,
            "id": "1eacd0bd-581c-5c38-9fbc-c2d0ade1147d"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "The document looks expired: ask for a current one.",
          "priority": "high"
        },
        "id": "0baf0b27-59fc-5ca4-9f86-4c6c19038b18",
        "enabled": true
      },
      {
        "label": "Fields unreadable",
        "conditions": [
          {
            "inputKey": "fields_complete",
            "operator": "equals",
            "value": "false",
            "id": "da983918-080a-53f6-87e6-16d9d4e0bb7c"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "Some fields could not be read: check the photo quality.",
          "priority": "medium"
        },
        "id": "46a4a075-90eb-5274-a440-a9b3ac6dd6ab",
        "enabled": true
      },
      {
        "label": "Name differs",
