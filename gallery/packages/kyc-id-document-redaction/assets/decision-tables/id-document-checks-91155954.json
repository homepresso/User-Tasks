        },
        "id": "4f1c1e15-fae0-5c51-bba2-6fc4744eac94",
        "enabled": true
      },
      {
        "label": "Checks passed",
        "conditions": [],
        "outputs": {
          "result": "Checks passed",
          "flag": "Automated checks passed: compare the selfie with the ID photo yourself before verifying.",
          "priority": "medium"
        },
        "id": "5e73f5da-0025-5f44-8a13-351854e37510",
        "enabled": true
      }
    ]
