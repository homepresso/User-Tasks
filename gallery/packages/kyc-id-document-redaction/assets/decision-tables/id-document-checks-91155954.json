          {
            "inputKey": "dob_match",
            "operator": "equals",
            "value": "false",
            "id": "4e89ad10-aa87-5e96-ab3d-97012acef59e"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "The date of birth differs from the form.",
          "priority": "high"
        },
        "id": "026b5d8a-2d52-5b32-b59a-75892393dd16",
        "enabled": true
      },
      {
        "label": "Number format",
        "conditions": [
          {
            "inputKey": "number_format",
            "operator": "equals",
            "value": "false",
            "id": "4c00b2de-a8ab-5d1e-8354-03b6f3464707"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "The document number does not look like the expected format.",
          "priority": "medium"
        },
        "id": "2fe994c7-7c22-5d9b-a3e6-46be85d5ea03",
        "enabled": true
      },
      {
        "label": "No face on the ID",
        "conditions": [
          {
            "inputKey": "id_faces",
            "operator": "less_than",
            "value": 1,
            "id": "35b09299-f67e-5dc2-a5d7-891d6ccdc5b0"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "No photo found on the document.",
          "priority": "high"
        },
        "id": "6376a3d6-fa4e-5c1c-90a2-687f38197752",
        "enabled": true
      },
      {
