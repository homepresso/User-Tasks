          {
            "inputKey": "name_match",
            "operator": "equals",
            "value": "false",
            "id": "7868bac0-87fd-5790-9414-456974dd0334"
          }
        ],
        "outputs": {
          "result": "Needs attention",
          "flag": "The name on the document differs from the form.",
          "priority": "high"
        },
        "id": "35227df1-b53c-528e-a0fc-c892e7c8b8ec",
        "enabled": true
      },
      {
        "label": "Date of birth differs",
