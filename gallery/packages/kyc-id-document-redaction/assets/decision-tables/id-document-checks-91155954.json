        "type": "string",
        "id": "a459b400-54fd-52d3-9d55-d02f14dc0b4c"
      },
      {
        "key": "flag",
        "label": "Flag for the reviewer",
        "type": "string",
        "id": "f6c90b18-2d83-53c6-88ce-e4884bf0db18"
      },
      {
        "key": "priority",
