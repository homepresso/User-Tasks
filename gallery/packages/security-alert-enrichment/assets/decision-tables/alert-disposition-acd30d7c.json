    "name": "Alert disposition",
    "description": "What to do with an enriched alert, from the threat-intel score of the source IP, the asset criticality, whether the user is privileged and the SIEM severity. First matching rule wins.",
    "inputs": [
      {
        "id": "81cfda11-b204-4a5f-bdc4-7dab06458034",
        "key": "intel_score",
        "label": "IP reputation score (0-100)",
        "type": "number"
      },
      {
        "id": "14b467c9-40dd-42e0-b810-38c09b1a3b29",
        "key": "asset_criticality",
        "label": "Asset criticality",
        "type": "text"
      },
      {
        "id": "0bbc3f07-945a-4a15-bff6-dd4bb8c79050",
        "key": "privileged",
        "label": "Privileged user",
        "type": "boolean"
      },
      {
        "id": "6ef58c45-e122-4dee-97c7-e0826044120f",
        "key": "severity",
        "label": "SIEM severity",
        "type": "text"
      }
    ],
    "outputs": [
      {
        "id": "708dfe3e-c0dc-48e2-8b02-015f460fb008",
        "key": "disposition",
        "label": "Disposition",
        "type": "text"
      },
