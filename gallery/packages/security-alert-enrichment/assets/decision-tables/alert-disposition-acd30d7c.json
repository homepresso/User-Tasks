        "key": "reason",
        "label": "Reason",
        "type": "text"
      }
    ],
    "rules": [
      {
        "id": "a8806145-5b3f-4a41-a00f-d5e21bf2b4a2",
        "label": "Known-bad IP on a critical asset",
        "enabled": true,
        "outputs": {
          "disposition": "contain",
          "case_severity": "critical",
          "reason": "High-confidence malicious source against a critical asset"
        },
        "conditions": [
          {
            "id": "ee8bca82-0a02-4cc4-a9c9-6f49b38552ec",
            "inputKey": "intel_score",
            "operator": "greater_than_or_equal",
            "value": "80"
          },
          {
            "id": "375cee3b-4ade-4faf-9b26-a5ec75861a58",
            "inputKey": "asset_criticality",
            "operator": "equals",
            "value": "critical"
          }
        ]
      },
      {
        "id": "776f4d2d-4c10-4ebe-a73c-635b042233ba",
        "label": "Known-bad IP and privileged user",
        "enabled": true,
        "outputs": {
          "disposition": "contain",
          "case_severity": "critical",
          "reason": "High-confidence malicious source and a privileged account"
        },
