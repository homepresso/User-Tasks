          "x": 340,
          "y": 60
        },
        "config": {
          "form_id": "6be0e19d-9c85-5986-a50f-a83c603e4e39",
          "form_name": "Equipment request form"
        }
      },
      {
        "id": "cc_form",
        "type": "set_variable",
        "label": "Cost centre from the form",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "name": "cost_centre",
          "expression": "{{form.cost_centre}}"
        }
      },
      {
        "id": "reference",
        "type": "set_variable",
        "label": "Request reference",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "name": "request_reference",
          "expression": "EQ-{{=FORMAT_DATE(NOW(), \"YYYYMMDD\")}}-{{=UPPER(LEFT(GUID(), 6))}}"
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 540
