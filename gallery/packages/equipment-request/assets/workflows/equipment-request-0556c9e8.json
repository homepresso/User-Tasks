  "asset": {
    "id": "0556c9e8-7cf2-4374-b823-da76cee23bd0",
    "name": "Equipment request",
    "description": "An employee submits the Equipment request form: the item is priced from the catalogue, the approval policy routes it to the manager (and finance), IT fulfils it and the asset is registered.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
