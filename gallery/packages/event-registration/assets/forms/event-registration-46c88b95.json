{
  "format_version": 3,
  "asset_type": "forms",
  "id": "46c88b95-e7b2-5bfc-9b9b-97a4023234a7",
  "asset": {
    "id": "46c88b95-e7b2-5bfc-9b9b-97a4023234a7",
    "name": "Event registration",
    "description": "Register for one of our upcoming events. Pick the event; the date and venue fill in.",
    "tags": [
      "events",
      "registration"
    ],
    "fields": [
      {
        "key": "h_event",
        "label": "Which event?",
        "type": "heading"
      },
      {
        "key": "event",
        "label": "Event",
        "type": "lookup",
        "required": true,
        "lookup": {
          "source": "table",
          "table_id": "0ad60e26-f882-550f-836a-00d5e3270e7d",
          "search_columns": [
            "title",
            "event_code",
            "venue"
          ],
          "display_columns": [
            "title",
            "event_date",
            "venue"
          ],
          "value_column": "event_code",
          "fill": [
            {
              "from": "event_date",
              "to": "event_date"
            },
            {
              "from": "venue",
              "to": "event_venue"
            },
            {
              "from": "start_time",
              "to": "event_time"
            }
          ],
          "filters": [
            {
              "column": "status",
              "operator": "eq",
              "value": "Open"
            }
          ],
          "sort": {
            "column": "event_date",
            "direction": "asc"
          }
        }
      },
      {
        "key": "event_date",
        "label": "Date",
        "type": "date",
        "read_only": true
      },
      {
        "key": "event_time",
        "label": "Starts",
        "type": "text",
        "read_only": true
      },
      {
        "key": "event_venue",
        "label": "Venue",
        "type": "text",
        "read_only": true
      },
      {
        "key": "div1",
        "label": "Divider",
        "type": "divider"
      },
      {
        "key": "h_you",
        "label": "About you",
        "type": "heading"
      },
      {
        "key": "name",
        "label": "Full name",
        "type": "text",
        "required": true
      },
      {
        "key": "email",
        "label": "Email",
        "type": "email",
        "required": true
      },
      {
        "key": "company",
        "label": "Company",
        "type": "text"
      },
      {
        "key": "job_title",
        "label": "Job title",
        "type": "text"
      },
      {
        "key": "dietary",
        "label": "Dietary requirements",
        "type": "choice",
        "required": true,
        "options": [
          "None",
          "Vegetarian",
          "Vegan",
          "Gluten free",
          "Dairy free",
          "Halal",
          "Kosher",
          "Nut allergy",
          "Other (tell us below)"
        ],
        "default": "None"
      },
      {
        "key": "special_request",
        "label": "Accessibility needs or special requests",
        "type": "textarea",
        "help_text": "Wheelchair access, hearing loop, a quiet room, a severe allergy... The organiser will reply to you."
      },
      {
        "key": "consent",
        "label": "I agree to my details being used to manage this event",
        "type": "boolean",
        "required": true
      },
      {
        "key": "updates",
        "label": "Send me news about future events",
        "type": "boolean"
      }
    ],
