              "id": "resolved",
              "label": "Resolved",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Resolved"
            },
            {
              "id": "needs_supervisor",
              "label": "Needs supervisor",
              "kind": "outcome",
              "style": "secondary",
              "outcome": "Needs supervisor"
            }
          ],
