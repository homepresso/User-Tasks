          "expression": "{{task_data.customer_contacted}}"
        }
      },
      {
        "id": "over",
        "type": "set_variable",
        "label": "Over limit?",
        "position": {
          "x": 340,
          "y": 2480
        },
        "config": {
          "name": "needs_approval",
          "expression": "{{=IF(compensation_amount > compensation_limit, true, false)}}"
        }
      },
      {
        "id": "check",
        "type": "condition",
        "label": "Supervisor needed?",
        "position": {
          "x": 340,
          "y": 2640
        },
        "config": {
          "branches": [
            {
              "label": "Over limit",
              "logic": "or",
              "rules": [
                {
                  "field": "{{needs_approval}}",
                  "operator": "equals",
                  "value": "true"
                },
                {
                  "field": "{{outcome}}",
                  "operator": "equals",
                  "value": "Needs supervisor"
                }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "approved_self",
        "type": "set_variable",
        "label": "Within handler limit",
        "position": {
          "x": 660,
          "y": 2820
        },
        "config": {
          "name": "approved_by",
          "expression": "Handler (within limit)"
        }
      },
