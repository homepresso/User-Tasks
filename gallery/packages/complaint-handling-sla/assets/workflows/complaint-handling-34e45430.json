        "config": {
          "reference_id": "3cbf243f-094d-4843-91a2-8f29513afe66",
          "reference_name": "Create case",
          "reference_method": "POST",
          "input_mappings": {
            "customer_id": "{{customer_id}}",
            "order_number": "{{order_number}}",
            "category": "{{category}}",
            "severity": "{{severity}}",
            "channel": "{{channel}}",
            "description": "{{description}}",
            "first_response_due": "{{first_response_due}}",
            "resolution_due": "{{resolution_due}}"
          },
          "output_mappings": {
            "case_id": {
              "enabled": true,
              "variableName": "case_id"
            },
            "case_number": {
              "enabled": true,
              "variableName": "case_number"
            }
          }
        }
      },
      {
        "id": "ack",
        "type": "send_email",
        "label": "Acknowledge customer",
        "position": {
          "x": 340,
          "y": 1500
        },
        "config": {
          "to": "{{customer_email}}",
          "email_template_id": "a9f5de26-457e-42a7-b190-7261ab9dfaa7"
        },
        "onError": "continue"
      },
      {
        "id": "investigate",
        "type": "user_task",
        "label": "Investigate and resolve",
        "position": {
          "x": 340,
          "y": 1660
        },
        "config": {
          "task_title": "{{case_number}}: {{category}} complaint from {{customer_name}} ({{severity}}, {{tier}})",
          "task_description": "<p><strong>{{customer_name}}</strong> ({{tier}} customer, lifetime value {{lifetime_value}}) complained via {{channel}} about <strong>{{category}}</strong>{{=IF(IS_EMPTY(order_number), \"\", CONCAT(\" on order \", order_number))}}.</p><p>{{description}}</p><p>SLA rule “{{rule_label}}”: contact the customer within <strong>{{first_response_hours}} hours</strong>, resolve by <strong>{{resolution_due_date}}</strong>. Handler level: {{handler_level}}. You can offer up to {{compensation_limit}} without approval.</p>",
          "task_priority": "high",
          "outcomes": [
            "Resolved",
            "Needs supervisor"
          ],
          "assignment_type": "individual",
          "assignee_id": "77910c76-ebdc-4e4e-b6aa-1e234883f092",
          "assignee_variable": "{{handler_id}}",
          "due_date_mode": "absolute",
          "due_date": "{{resolution_due}}",
          "reminders": [
            {
              "offset_minutes": 1440
            },
            {
              "offset_minutes": 240
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "individual",
          "escalation_user_id": "319fbc4d-0fa6-4750-b79f-facfa41e98c9",
          "escalate_after_minutes": 1440,
          "fields": [
            {
              "key": "root_cause",
              "label": "Root cause",
              "type": "choice",
              "options": [
                "Carrier delay",
                "Warehouse error",
                "Product defect",
                "Billing error",
                "Process gap",
                "Staff conduct",
                "Customer misunderstanding",
                "Other"
              ],
              "required": true
            },
            {
              "key": "resolution_summary",
              "label": "Resolution summary (sent to the customer)",
              "type": "text",
              "required": true
            },
            {
              "key": "compensation_amount",
              "label": "Compensation amount",
              "type": "number",
              "default": "0"
            },
            {
              "key": "customer_contacted",
              "label": "Customer contacted",
              "type": "boolean",
              "required": true,
              "default": "false"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "root_cause",
                    "span": 1
                  },
                  {
                    "field_key": "compensation_amount",
                    "span": 1
                  },
                  {
                    "field_key": "customer_contacted",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "resolution_summary",
                    "span": 3
                  }
                ]
              }
            ]
          },
          "form_buttons": [
