          "input_mappings": {
            "category": "{{category}}",
            "severity": "{{severity}}",
            "tier": "{{tier}}"
          }
        }
      },
      {
        "id": "resp_due",
        "type": "set_variable",
        "label": "First response due",
        "position": {
          "x": 340,
          "y": 700
        },
        "config": {
          "name": "first_response_due",
          "expression": "{{=ADD_HOURS(NOW(), first_response_hours)}}"
        }
      },
      {
        "id": "res_due",
        "type": "set_variable",
        "label": "Resolution due",
        "position": {
          "x": 340,
          "y": 860
        },
        "config": {
          "name": "resolution_due",
          "expression": "{{=ADD_DAYS(NOW(), resolution_days)}}"
        }
      },
      {
        "id": "res_date",
        "type": "set_variable",
        "label": "Resolution date",
        "position": {
          "x": 340,
          "y": 1020
        },
        "config": {
          "name": "resolution_due_date",
          "expression": "{{=FORMAT_DATE(resolution_due, \"DD/MM/YYYY\")}}"
        }
      },
