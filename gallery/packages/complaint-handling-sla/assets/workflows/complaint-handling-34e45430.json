      },
      {
        "id": "resolve",
        "type": "call_reference",
        "label": "Resolve case",
        "position": {
          "x": 340,
          "y": 3320
        },
        "config": {
          "reference_id": "9905ac80-7523-4db9-9efe-1ccb14c9f947",
          "reference_name": "Resolve case",
          "reference_method": "POST",
          "input_mappings": {
