      {
        "id": "customer",
        "type": "call_reference",
        "label": "Find customer",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "reference_id": "e14c40a6-93ca-4e9b-a178-5e4e9042ade7",
          "reference_name": "Find customer by email",
          "reference_method": "GET",
          "input_mappings": {
            "email": "{{customer_email}}"
          },
          "output_mappings": {
            "customer_id": {
              "enabled": true,
              "variableName": "customer_id"
            },
            "customer_name": {
              "enabled": true,
              "variableName": "customer_name"
            },
            "tier": {
              "enabled": true,
              "variableName": "tier"
            },
            "lifetime_value": {
              "enabled": true,
              "variableName": "lifetime_value"
            }
          }
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "title": "Complaint: {{customer_name}} · {{category}} · {{severity}}"
        }
      },
      {
        "id": "matrix",
        "type": "decision_table",
        "label": "Complaint SLA matrix",
        "position": {
          "x": 340,
          "y": 540
        },
        "config": {
          "decision_table_id": "38b0a730-086f-44bf-8900-4171c3dd70df",
