{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "29ec94af-0175-5c38-8a5e-06e351b3d7d5",
  "asset": {
    "id": "29ec94af-0175-5c38-8a5e-06e351b3d7d5",
    "name": "Contract approval and e-signature",
    "description": "An application posts a contract PDF and its details; an approver approves or rejects it; approved contracts are sent through DocuSign, the run waits for the signature, records the signed PDF in Signed contracts and notifies the owner. Declined, voided, expired and timed-out envelopes go to a follow-up task.",
    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "Contract received",
        "position": { "x": 500, "y": 60 },
        "config": {}
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": { "x": 500, "y": 220 },
        "config": {
          "title": "{{contract_title}} · {{counterparty}}"
        }
      },
      {
        "id": "approve",
        "type": "user_task",
        "label": "Approve contract",
        "position": { "x": 500, "y": 380 },
        "config": {
          "task_title": "Approve contract: {{contract_title}} ({{counterparty}})",
          "task_description": "<p><strong>{{contract_title}}</strong> with <strong>{{counterparty}}</strong>, value <strong>{{=FORMAT_NUMBER(contract_value, 2)}}</strong>.</p><p><a href=\"{{contract_pdf}}\" target=\"_blank\" rel=\"noopener\">Open the contract PDF</a></p><p>Approve to send it to {{signer_name}} ({{signer_email}}) for signature through DocuSign, or reject it.</p>",
          "task_priority": "high",
          "outcomes": ["Approve", "Reject"],
          "assignment_type": "individual",
          "assignee_id": "1836305a-2181-571e-81fc-9a231ea060ad",
          "due_date_mode": "relative",
          "due_offset_amount": 2,
          "due_offset_unit": "days",
          "fields": [
            {
              "key": "comment",
              "label": "Comment",
              "type": "textarea"
            }
          ],
          "form_buttons": [
            { "id": "approve", "label": "Approve", "kind": "outcome", "style": "primary", "outcome": "Approve" },
            { "id": "reject", "label": "Reject", "kind": "outcome", "style": "danger", "outcome": "Reject" }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "Approve contract",
            "align": "left",
            "subtitle": "{{contract_title}} · {{counterparty}}"
          }
        }
      },
      {
        "id": "log_rejected",
        "type": "log",
        "label": "Log rejection",
        "position": { "x": 860, "y": 560 },
        "config": {
          "message": "{{contract_title}} ({{counterparty}}) rejected: {{approve.comment}}",
          "level": "info"
        }
      },
      {
        "id": "end_rejected",
        "type": "end_workflow",
        "label": "Rejected",
        "position": { "x": 860, "y": 720 },
        "config": {
          "reason": "{{contract_title}} rejected by the approver"
        }
      },
      {
        "id": "send",
        "type": "esign_send",
        "label": "Send for signature",
        "position": { "x": 500, "y": 560 },
        "config": {
          "integration_id": "4e72e332-c85b-5fce-8ef9-0a0ffe994072",
          "source": "documents",
          "documents": "{{contract_pdf}}",
          "subject": "Please sign: {{contract_title}}",
          "message": "Hello {{signer_name}}, please review and sign {{contract_title}}. Contact us if anything needs to change before you sign.",
          "recipients": [
            {
              "name": "{{signer_name}}",
              "email": "{{signer_email}}",
              "role": "Signer",
              "routing_order": 1,
              "kind": "signer",
              "anchor": "/sn1/"
            }
          ],
          "reminder_days": 2,
          "expires_in_days": 14,
          "output_var": "envelope"
        }
      },
      {
        "id": "wait",
        "type": "esign_wait",
        "label": "Wait for signature",
        "position": { "x": 500, "y": 720 },
        "config": {
          "integration_id": "4e72e332-c85b-5fce-8ef9-0a0ffe994072",
          "envelope_id": "{{envelope.envelope_id}}",
          "timeout_days": 21,
          "download": true,
          "document": "both",
          "file_name": "{{contract_title}} signed",
          "output_var": "signature"
        }
      },
      {
        "id": "record",
        "type": "update_data_table",
        "label": "Record signed contract",
        "position": { "x": 340, "y": 900 },
        "config": {
          "table_id": "472c13e1-5f2c-585c-8c63-94e10195e4da",
          "table_name": "Signed contracts",
          "operation": "insert",
          "column_values": {
            "title": "{{contract_title}}",
            "counterparty": "{{counterparty}}",
            "value": "{{contract_value}}",
            "envelope_id": "{{envelope.envelope_id}}",
            "signed_pdf_url": "{{signature.signed_document.url}}",
            "signed_at": "{{=COALESCE(signature.completed_at, NOW())}}"
          }
        }
      },
      {
        "id": "has_notify",
        "type": "condition",
        "label": "Notify someone?",
        "position": { "x": 340, "y": 1060 },
        "config": {
          "branches": [
            {
              "label": "Notify",
              "logic": "and",
              "rules": [
                { "field": "{{notify_email}}", "operator": "is_not_empty", "value": "" }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "email",
        "type": "send_email",
        "label": "Email contract owner",
        "position": { "x": 180, "y": 1220 },
        "config": {
          "to": "{{notify_email}}",
          "email_template_id": "9ac18f22-35d5-5063-ab92-b53e36d6dd54"
        },
        "onError": "continue"
      },
      {
        "id": "end_signed",
        "type": "end_workflow",
        "label": "Signed",
        "position": { "x": 340, "y": 1380 },
        "config": {
          "reason": "{{contract_title}} signed (envelope {{envelope.envelope_id}})"
        }
      },
      {
        "id": "follow_up",
        "type": "user_task",
        "label": "Follow up",
        "position": { "x": 760, "y": 900 },
        "config": {
          "task_title": "Follow up: {{contract_title}} was not signed ({{signature.outcome}})",
          "task_description": "<p>The DocuSign envelope for <strong>{{contract_title}}</strong> with <strong>{{counterparty}}</strong> ended as <strong>{{signature.outcome}}</strong> (envelope {{envelope.envelope_id}}).</p><p>Contact {{signer_name}} ({{signer_email}}) to find out why, then close this task. Start a new run to send a revised contract.</p><p><a href=\"{{contract_pdf}}\" target=\"_blank\" rel=\"noopener\">Open the contract PDF</a></p>",
          "task_priority": "high",
          "outcomes": ["Done"],
          "assignment_type": "individual",
          "assignee_id": "aa2bd405-1008-5d5f-928b-b9d9688dfaf8",
          "due_date_mode": "relative",
          "due_offset_amount": 3,
          "due_offset_unit": "days",
          "fields": [
            {
              "key": "notes",
              "label": "What happened",
              "type": "textarea"
            }
          ]
        }
      },
      {
        "id": "log_follow_up",
        "type": "log",
        "label": "Log follow-up",
        "position": { "x": 760, "y": 1060 },
        "config": {
          "message": "{{contract_title}} not signed ({{signature.outcome}}): {{follow_up.notes}}",
          "level": "warn"
        }
      },
      {
        "id": "end_not_signed",
        "type": "end_workflow",
        "label": "Not signed",
        "position": { "x": 760, "y": 1220 },
        "config": {
          "reason": "{{contract_title}} not signed: {{signature.outcome}}"
        }
      }
    ],
    "edges": [
      { "id": "e-trigger-title", "source": "trigger", "target": "title" },
      { "id": "e-title-approve", "source": "title", "target": "approve" },
      { "id": "e-approve-send-approve", "source": "approve", "target": "send", "label": "Approve" },
      { "id": "e-approve-log_rejected-reject", "source": "approve", "target": "log_rejected", "label": "Reject" },
      { "id": "e-log_rejected-end_rejected", "source": "log_rejected", "target": "end_rejected" },
      { "id": "e-send-wait", "source": "send", "target": "wait" },
      { "id": "e-wait-record-completed", "source": "wait", "target": "record", "label": "Completed" },
      { "id": "e-wait-follow_up-declined", "source": "wait", "target": "follow_up", "label": "Declined" },
      { "id": "e-wait-follow_up-voided", "source": "wait", "target": "follow_up", "label": "Voided" },
      { "id": "e-wait-follow_up-expired", "source": "wait", "target": "follow_up", "label": "Expired" },
      { "id": "e-wait-follow_up-timeout", "source": "wait", "target": "follow_up", "label": "Timeout" },
      { "id": "e-record-has_notify", "source": "record", "target": "has_notify" },
      { "id": "e-has_notify-email-notify", "source": "has_notify", "target": "email", "label": "Notify" },
      { "id": "e-has_notify-end_signed-else", "source": "has_notify", "target": "end_signed", "label": "Else" },
      { "id": "e-email-end_signed", "source": "email", "target": "end_signed" },
      { "id": "e-follow_up-log_follow_up-done", "source": "follow_up", "target": "log_follow_up", "label": "Done" },
      { "id": "e-log_follow_up-end_not_signed", "source": "log_follow_up", "target": "end_not_signed" }
    ],
    "user_variables": [
      {
        "id": "v-contract_title",
        "name": "contract_title",
        "type": "string",
        "description": "Contract title as it should appear in the approval task and the DocuSign email",
        "defaultValue": "",
        "required": true,
        "label": "Contract title"
      },
      {
        "id": "v-counterparty",
        "name": "counterparty",
        "type": "string",
        "description": "Legal name of the other party",
        "defaultValue": "",
        "required": true,
        "label": "Counterparty"
      },
      {
        "id": "v-contract_value",
        "name": "contract_value",
        "type": "number",
        "description": "Total contract value",
        "defaultValue": "0",
        "required": true,
        "label": "Contract value"
      },
      {
        "id": "v-signer_name",
        "name": "signer_name",
        "type": "string",
        "description": "Name of the person signing for the counterparty",
        "defaultValue": "",
        "required": true,
        "label": "Signer name"
      },
      {
        "id": "v-signer_email",
        "name": "signer_email",
        "type": "string",
        "description": "Email of the signer: DocuSign sends the signing request here",
        "defaultValue": "",
        "required": true,
        "label": "Signer email",
        "format": "email"
      },
      {
        "id": "v-contract_pdf",
        "name": "contract_pdf",
        "type": "string",
        "description": "URL of the contract PDF to sign. It must contain the anchor text /sn1/ where the signature goes (white text works); remove the anchor on Send for signature to let the signer place it",
        "defaultValue": "",
        "required": true,
        "label": "Contract PDF URL",
        "format": "url"
      },
      {
        "id": "v-notify_email",
        "name": "notify_email",
        "type": "string",
        "description": "Optional: email of the contract owner, who gets a link to the signed PDF",
        "defaultValue": "",
        "label": "Notify email",
        "format": "email"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
