        },
        "conditions": [
          {
            "id": "bda38235-7dd1-4d3d-8239-df2499e65a0f",
            "inputKey": "cyber_score",
            "operator": "less_than",
            "value": "70"
          }
        ]
      },
      {
        "id": "800dac7e-96ae-44c9-8d2b-de29abdedb2c",
        "label": "Everything else",
        "enabled": true,
        "outputs": {
          "risk_tier": "Low",
          "review_months": 12,
          "action": "Standard annual review"
        },
        "conditions": [
          {
            "id": "c34a4258-a03b-4aee-accc-8cf10be5e88c",
            "inputKey": "sanctions_hit",
