    "rules": [
      {
        "id": "83a9ea4b-a90d-4935-87f0-30d86020ff64",
        "label": "Sanctions match",
        "enabled": true,
        "outputs": {
          "risk_tier": "Critical",
          "review_months": 1,
          "action": "Stop new orders and refer to legal; plan exit"
        },
        "conditions": [
          {
            "id": "fa9e6721-4f2d-43f8-a8b0-4a4cb33982aa",
            "inputKey": "sanctions_hit",
            "operator": "equals",
            "value": "true"
          }
        ]
      },
      {
        "id": "d4619c1f-85d9-41f9-bbcf-994d6b5943b9",
        "label": "Weak finances, critical supplier",
        "enabled": true,
        "outputs": {
          "risk_tier": "High",
          "review_months": 3,
          "action": "Find a second source and agree a continuity plan"
        },
        "conditions": [
          {
            "id": "e29eed9c-2078-4fa5-966a-479c1cf5f826",
            "inputKey": "financial_score",
            "operator": "less_than",
            "value": "40"
          },
          {
            "id": "71235fa8-8c66-4c3e-8ced-273d71b70dcb",
            "inputKey": "criticality",
            "operator": "equals",
            "value": "critical"
          }
        ]
      },
      {
        "id": "8a124a1b-8c25-45f0-bdff-750d9bf1d324",
        "label": "Weak finances, high criticality",
        "enabled": true,
        "outputs": {
          "risk_tier": "High",
          "review_months": 3,
          "action": "Ask for current accounts; prepare a second source"
        },
        "conditions": [
          {
            "id": "ce9489ce-7f91-4774-a8c7-63b48a441c94",
            "inputKey": "financial_score",
            "operator": "less_than",
            "value": "40"
          },
          {
            "id": "16a5f466-7361-4066-af90-f91284748830",
            "inputKey": "criticality",
            "operator": "equals",
            "value": "high"
          }
        ]
      },
      {
        "id": "a515cf85-070c-4a8b-bd79-39532d44ba2b",
        "label": "Weak cyber, large spend",
        "enabled": true,
        "outputs": {
          "risk_tier": "High",
          "review_months": 3,
          "action": "Request a security remediation plan with dates"
        },
        "conditions": [
          {
            "id": "09860995-8005-4ca1-8567-657fbd47a6e2",
            "inputKey": "cyber_score",
            "operator": "less_than",
            "value": "50"
          },
          {
            "id": "42aea704-0594-470f-ab6f-8e96988b9b95",
            "inputKey": "annual_spend",
            "operator": "greater_than_or_equal",
            "value": "250000"
          }
        ]
      },
      {
        "id": "557e2dc4-4542-4ad8-a3a7-7723221bf55d",
        "label": "Several ESG concerns",
        "enabled": true,
        "outputs": {
          "risk_tier": "High",
          "review_months": 6,
          "action": "Request evidence against each ESG flag"
        },
        "conditions": [
          {
            "id": "439a01cd-b4cc-414a-af5f-f776f18d1f45",
            "inputKey": "esg_flag_count",
            "operator": "greater_than_or_equal",
            "value": "2"
          },
          {
            "id": "c0a6f436-6131-4133-af32-e9d572d12343",
            "inputKey": "criticality",
            "operator": "not_equals",
            "value": "low"
          }
        ]
      },
      {
        "id": "920bcd64-7b4e-4186-aa6d-044cdbda5f62",
        "label": "Moderate financial risk",
        "enabled": true,
        "outputs": {
          "risk_tier": "Medium",
          "review_months": 6,
          "action": "Monitor; request the latest accounts"
        },
        "conditions": [
          {
            "id": "9a86ddcd-f4ff-441c-a040-5368351ec849",
            "inputKey": "financial_score",
            "operator": "less_than",
            "value": "60"
          }
        ]
      },
      {
        "id": "55fb2f84-be07-46e6-bc1c-90eb5c28c0d3",
        "label": "Moderate cyber risk",
        "enabled": true,
        "outputs": {
          "risk_tier": "Medium",
          "review_months": 6,
