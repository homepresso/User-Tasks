            "value": "3",
            "id": "1cc29368-e689-591d-bcff-17b2238cc3e4"
          }
        ],
        "outputs": {
          "needs_finance": false,
          "needs_gc": true,
          "approval_path": "Legal → General counsel"
        },
        "id": "21f5c0b6-eb54-5b07-be8d-271a7474acc1",
        "enabled": true
      },
      {
        "label": "Standard",
