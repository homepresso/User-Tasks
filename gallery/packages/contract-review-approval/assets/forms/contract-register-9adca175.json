        {
          "id": "r_open_renewal",
          "name": "Renewals: row clicked → details",
          "event": "row_click",
          "then": [
            {
              "type": "copy_values",
              "assign": {
                "d_ref": "{{event.row.contract_ref}}",
                "d_status": "{{event.row.status}} · {{event.row.risk_level}} risk",
                "d_title": "{{event.row.title}}",
                "d_counterparty": "{{event.row.counterparty}} · {{event.row.contract_type}}",
                "d_owner": "{{event.row.owner_name}} ({{event.row.business_unit}}, {{event.row.owner_email}})",
                "d_value": "{{event.row.value}}",
                "d_term": "{{event.row.start_date}} to {{event.row.end_date}}",
                "d_renewal": "Decide by {{event.row.renewal_date}} · notice {{event.row.notice_days}} days · auto-renews: {{event.row.auto_renew}}",
                "d_document": "{{event.row.document_name}} (version {{event.row.version}})",
                "d_deviations": "{{event.row.deviations}}",
