              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "review_back",
                  "span": 1
                },
                {
                  "field_key": "review_submit",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "check-circle",
          "description": "Who approves the spend, then send it."
        }
      ],
      "page_settings": {
        "indicator": "numbered",
        "next_label": "Next",
        "back_label": "Back"
      },
      "application_mode": true,
      "rules": [
        {
          "id": "r_board_hide",
          "name": "Board reference only for NZD 1,000,000 or more",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "field:board_approval_ref"
              ]
            }
          ],
          "if": {
            "match": "any",
            "conditions": [
              {
                "column": "value",
                "operator": "lt",
                "value": "1000000"
              },
              {
                "column": "value",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_board_required",
          "name": "Large contracts need board approval",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "board_approval_ref",
              "text": "Add the board approval reference: contracts of NZD 1,000,000 or more need it."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "value",
                "operator": "gte",
                "value": "1000000"
              },
              {
                "column": "board_approval_ref",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_end_after_start",
          "name": "The contract ends after it starts",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "end_date",
              "text": "The end date must be after the start date."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "end_date",
                "operator": "is_set"
              },
              {
                "column": "end_date",
                "operator": "lte",
                "value": "{{start_date}}"
              }
            ]
          }
        },
        {
          "id": "r_notice_required",
          "name": "Auto-renewing contracts need a notice period",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "notice_days",
              "text": "Add the notice period so the renewal date can be tracked."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "auto_renew",
                "operator": "eq",
                "value": "true"
              },
              {
                "column": "notice_days",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_their_paper",
          "name": "Their paper takes longer",
          "event": "value_change",
          "then": [
            {
              "type": "message",
              "text": "Reviews of the other side’s template take longer: list anything you already know is non-standard."
            }
          ],
          "target": "paper",
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "paper",
                "operator": "eq",
                "value": "Their template"
              }
            ]
          }
        }
      ]
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Send for review",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "success_screen",
            "title": "Sent for review",
            "screen_button": "submit_another",
            "screen_button_label": "Send another contract",
            "text": "\"{{title}}\" with {{counterparty}} is with legal. You will get an email when it is approved or if changes are needed."
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "theme": {
      "source": "custom",
      "overrides": {
        "colors": {
          "light": {
            "accent": "#0F766E",
            "background": "#FFFFFF",
            "text": "#1B1916",
            "page": "#E6F4F1",
            "page_to": "#F5FBFA"
          }
        },
        "radius": 12,
        "density": "comfortable",
        "button_placement": "right",
        "header": {
          "enabled": true,
          "title": "Contract review",
          "subtitle": "Legal checks the draft against our clause playbook, then the right people approve it. It lands in the Contract register with its renewal date."
        }
      }
    },
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "Contract review",
      "align": "left",
      "subtitle": "Legal checks the draft against our clause playbook, then the right people approve it. It lands in the Contract register with its renewal date."
    }
  }
