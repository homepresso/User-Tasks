  "asset": {
    "id": "f477b9c6-0758-5abd-bc77-8eaddc10769e",
    "name": "Contract review",
    "description": "A contract owner submits the Contract review request; the contract is added to the Contract register, legal checks it against the clause playbook and approves, asks for changes (the owner uploads a revision and legal gets a redline against the previous version) or rejects; the approval route sends it to finance and the general counsel when needed, and the register follows every step.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "user_variables": [],
    "swimlanes": [],
    "is_active": true,
    "nodes": [
      {
