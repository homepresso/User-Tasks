      {
        "id": "legal",
        "type": "user_task",
        "label": "Legal review",
        "position": {
          "x": 400,
          "y": 1050
        },
        "config": {
          "task_title": "Legal review: {{form.title}} v{{version}} ({{contract_ref}})",
          "task_description": "<p><strong>{{form.title}}</strong> with {{form.counterparty}}, NZD {{form.value}}, submitted by {{submitted_by_name}}. Version {{version}}: <a href=\"{{current_document[0].url}}\">{{current_document[0].name}}</a>.</p><p>{{changes_note}}</p><p>Tick the clauses that depart from the playbook on <strong>Clause checklist</strong>, set the overall risk and approve, ask for changes or reject.</p>",
          "task_priority": "high",
          "outcomes": [
            "Approve",
            "Request changes",
            "Reject"
          ],
          "assignment_type": "individual",
          "assignee_variable": "{{workflow_owner_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 3,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
            }
          ],
          "fields": [
            {
              "key": "t_contract",
              "label": "Contract",
              "type": "text",
              "read_only": true,
              "default": "{{form.title}} with {{form.counterparty}} ({{form.contract_type}})"
            },
            {
              "key": "t_value",
              "label": "Value and term",
              "type": "text",
              "read_only": true,
              "default": "NZD {{form.value}} · {{form.start_date}} to {{form.end_date}} · auto-renews: {{form.auto_renew}}"
            },
            {
              "key": "t_document",
              "label": "Document",
              "type": "text",
              "read_only": true,
              "default": "{{=FILE_NAMES(current_document)}} (version {{version}}, {{form.paper}})"
            },
            {
              "key": "t_changes",
              "label": "Changes since the last version",
              "type": "textarea",
              "read_only": true,
              "default": "{{changes_note}}"
            },
            {
              "key": "t_known",
              "label": "What the owner already knows differs",
              "type": "textarea",
              "read_only": true,
              "default": "{{form.known_deviations}}"
            },
            {
              "key": "deviations",
              "label": "Clauses that depart from the playbook",
              "type": "data_table",
              "help_text": "Tick every clause where this draft departs from our standard position",
              "data_table": {
                "source": "table",
                "table_id": "92a5d8a3-f48b-5520-bc76-781619fc25ed",
                "mode": "select",
                "multiple": true,
                "key_column": "row_id",
                "columns": [
                  {
                    "key": "clause",
                    "label": "Clause",
                    "type": "text",
                    "sortable": true
                  },
                  {
                    "key": "our_position",
                    "label": "Our position",
                    "type": "text",
                    "format": {
                      "kind": "text",
                      "max_length": 70,
                      "wrap": true
                    }
                  },
                  {
                    "key": "fallback",
                    "label": "Fallback we accept",
                    "type": "text",
                    "format": {
                      "kind": "text",
                      "max_length": 60,
                      "wrap": true
                    }
                  },
                  {
                    "key": "must_have",
                    "label": "Must have",
                    "type": "boolean",
                    "filterable": true,
                    "format": {
                      "kind": "boolean",
                      "boolean_style": "check"
                    }
                  },
                  {
                    "key": "risk_if_missing",
                    "label": "Risk",
                    "type": "choice",
                    "sortable": true,
                    "filterable": true,
                    "options": [
                      "Low",
                      "Medium",
                      "High"
                    ],
                    "format": {
                      "kind": "badge",
                      "badges": [
                        {
                          "value": "Low",
                          "color": "green"
                        },
                        {
                          "value": "Medium",
                          "color": "amber"
                        },
                        {
                          "value": "High",
                          "color": "red"
                        }
                      ],
                      "default_color": "gray"
                    }
                  }
                ],
                "open_access": true,
                "sort": [
                  {
                    "column": "clause",
                    "direction": "asc"
                  }
                ],
                "page_size": 15,
                "searchable": true
              }
            },
            {
              "key": "risk_level",
              "label": "Overall risk",
              "type": "choice",
              "required": true,
              "options": [
                "Low",
                "Medium",
                "High"
              ],
              "display": "radio"
            },
            {
              "key": "redline_notes",
              "label": "Redline notes for the owner",
              "type": "textarea",
              "help_text": "What to change and why: the owner negotiates it with the counterparty"
            }
          ],
          "form_layout": {
            "rows": [],
            "mode": "tabs",
