          "x": 600,
          "y": 1930
        },
        "config": {
          "original": "{{current_document}}",
          "revised": "{{task_data.revised_document}}",
          "mode": "words",
          "ignore_whitespace": true,
          "redline": "pdf",
          "output_name": "{{contract_ref}}-v{{version}}-to-v{{=version + 1}}",
          "output_var": "comparison"
        }
      },
      {
        "id": "changes_n",
        "type": "set_variable",
        "label": "Changes for legal",
        "position": {
          "x": 600,
          "y": 2040
        },
        "config": {
          "name": "changes_note",
          "expression": "Version {{=version + 1}} is {{comparison_similarity}}% similar to version {{version}} ({{comparison.stats.added_words}} words added, {{comparison.stats.removed_words}} removed). Redline: {{comparison_redline_pdf.name}}. Owner's summary: {{task_data.revision_summary}}"
        }
      },
