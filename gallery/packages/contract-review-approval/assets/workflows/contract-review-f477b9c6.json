        "id": "revise",
        "type": "user_task",
        "label": "Upload the revised contract",
        "position": {
          "x": 600,
          "y": 1820
        },
        "config": {
          "task_title": "Revise {{contract_ref}}: {{form.title}}",
          "task_description": "<p>Legal asked for changes to version {{version}} of <strong>{{form.title}}</strong>:</p><blockquote>{{task_data.redline_notes}}</blockquote><p>Playbook deviations: {{deviation_list}}. Negotiate them with {{form.counterparty}}, then upload the revised contract. Legal gets a redline comparing it with version {{version}}.</p>",
          "task_priority": "medium",
          "outcomes": [
            "Upload revision",
            "Withdraw"
          ],
          "assignment_type": "individual",
          "assignee_variable": "{{submitted_by}}",
          "due_date_mode": "relative",
          "due_offset_amount": 10,
          "due_offset_unit": "days",
          "fields": [
            {
              "key": "revised_document",
              "label": "Revised contract",
              "type": "attachments",
              "required": true,
              "attachments": {
                "max_files": 1,
                "max_file_mb": 20,
                "types": [
                  "documents"
                ]
              }
            },
            {
              "key": "revision_summary",
              "label": "What changed",
              "type": "textarea"
            }
          ],
          "form_buttons": [
            {
              "id": "upload",
              "label": "Upload revision",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Upload revision"
            },
            {
              "id": "withdraw",
              "label": "Withdraw",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Withdraw"
            }
          ],
          "form_theme": {
            "source": "custom",
            "overrides": {
              "colors": {
                "light": {
                  "accent": "#0F766E",
                  "background": "#FFFFFF",
                  "text": "#1B1916"
                }
              },
              "radius": 12,
              "density": "comfortable",
              "button_placement": "right"
            }
          }
        }
      },
