        "label": "Add to the Contract register",
        "position": {
          "x": 400,
          "y": 830
        },
        "config": {
          "table_id": "c8df2abe-d6bc-5f28-a3cb-601cfdc7eeef",
          "table_name": "Contract register",
          "operation": "insert",
          "output_row_id_var": "register_row_id",
          "column_values": {
