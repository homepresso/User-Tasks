                "icon": "list"
              }
            ],
            "rules": [
              {
                "id": "r_high_risk_note",
                "name": "A must-have deviation suggests High risk",
                "event": "row_select",
                "then": [
                  {
                    "type": "message",
                    "text": "\"{{event.row.clause}}\" is a must-have clause: consider High risk or ask for changes."
                  }
                ],
                "target": "deviations",
                "if": {
                  "match": "all",
                  "conditions": [
                    {
                      "column": "event.row.must_have",
                      "operator": "eq",
                      "value": "true"
                    }
                  ]
                }
              }
            ]
          },
