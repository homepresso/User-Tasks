          }
        },
        "radius": 12,
        "density": "comfortable",
        "button_placement": "right",
        "header": {
          "enabled": true,
          "title": "Ask legal",
          "subtitle": "NDAs, contract reviews, legal questions and disputes: four short steps, and the right lawyer picks it up."
        }
      }
    },
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "Ask legal",
      "align": "left",
      "subtitle": "NDAs, contract reviews, legal questions and disputes: four short steps, and the right lawyer picks it up."
    }
  }
