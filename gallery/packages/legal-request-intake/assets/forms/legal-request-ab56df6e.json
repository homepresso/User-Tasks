{
  "format_version": 3,
  "asset_type": "forms",
  "id": "ab56df6e-6d2b-5e37-a08d-73073d18f5a4",
  "asset": {
    "id": "ab56df6e-6d2b-5e37-a08d-73073d18f5a4",
    "name": "Legal request",
    "description": "The intake form for legal requests: About you → The request → Urgency → Review & send, with a progress bar and in-form Next / Back / Send to legal buttons (Application mode). The questions change with the request type (NDA, contract review, legal question, dispute), documents can be attached, and rules ask for the contract on a contract review, a reason for High or Critical urgency and a needed-by date that is not in the past. Submitting starts the Legal request workflow through its Form submitted trigger.",
    "tags": [
      "legal",
      "intake",
      "requests"
    ],
    "fields": [
      {
        "key": "requester_name",
        "label": "Your name",
        "type": "text",
        "required": true,
        "autocomplete": "name"
      },
      {
        "key": "requester_email",
        "label": "Your work email",
        "type": "email",
        "required": true,
        "autocomplete": "email"
      },
      {
        "key": "department",
        "label": "Department",
        "type": "choice",
        "required": true,
        "options": [
          "Sales",
          "Procurement",
          "People",
          "Finance",
          "Operations",
          "Product",
          "Marketing",
          "Other"
        ]
      },
      {
        "key": "request_type",
        "label": "What do you need?",
        "type": "choice",
        "required": true,
        "options": [
          "NDA",
          "Contract review",
          "Legal question",
          "Dispute or claim"
        ],
        "display": "radio"
      },
      {
        "key": "title",
        "label": "Short title",
        "type": "text",
        "required": true,
        "placeholder": "Mutual NDA with Kauri Analytics",
        "max_length": 120
      },
      {
        "key": "counterparty",
        "label": "Other party",
        "type": "text",
        "help_text": "The company or person on the other side",
        "visible_when": {
          "field": "request_type",
          "operator": "not_equals",
          "value": "Legal question"
        }
      },
      {
        "key": "h_nda",
        "label": "NDA details",
        "type": "heading"
      },
      {
        "key": "nda_direction",
        "label": "Who shares confidential information?",
        "type": "choice",
        "options": [
          "Both of us (mutual)",
          "Only we do",
          "Only they do"
        ]
      },
      {
        "key": "nda_paper",
        "label": "Whose template?",
        "type": "choice",
        "options": [
          "Ours",
          "Theirs"
        ],
        "display": "radio"
      },
      {
        "key": "h_contract",
        "label": "Contract details",
        "type": "heading"
      },
      {
        "key": "contract_type",
        "label": "Contract type",
        "type": "choice",
        "options": [
          "Customer agreement",
          "Supplier agreement",
          "Partnership",
          "Licence",
          "Other"
        ]
      },
      {
        "key": "contract_value",
        "label": "Total contract value",
        "type": "currency",
        "currency": "NZD",
        "min": 0
      },
      {
        "key": "personal_data",
        "label": "The contract involves personal data",
        "type": "boolean"
      },
      {
        "key": "h_question",
        "label": "Your question",
        "type": "heading"
      },
      {
        "key": "question_area",
        "label": "Area of law",
        "type": "choice",
        "options": [
          "Employment",
          "Privacy",
          "Intellectual property",
          "Regulatory",
          "Commercial",
          "Other"
        ]
      },
      {
        "key": "h_dispute",
        "label": "The dispute",
        "type": "heading"
      },
      {
        "key": "dispute_amount",
        "label": "Amount in dispute",
        "type": "currency",
        "currency": "NZD",
        "min": 0
      },
      {
        "key": "response_deadline",
        "label": "Deadline to respond (if any)",
        "type": "date"
      },
      {
        "key": "h_details",
        "label": "In your words",
        "type": "heading"
      },
      {
        "key": "details",
        "label": "Describe what you need",
        "type": "textarea",
        "required": true,
        "help_text": "Background, what you want to achieve, anything already agreed"
      },
      {
        "key": "documents",
        "label": "Documents",
        "type": "attachments",
        "help_text": "The draft, the other side’s paper, letters or emails (PDF or Word, up to 5 files). Required for a contract review.",
        "attachments": {
          "max_files": 5,
          "max_file_mb": 10,
          "types": [
            "documents"
          ]
        }
      },
      {
        "key": "urgency",
        "label": "Urgency",
        "type": "choice",
        "required": true,
        "options": [
          "Low",
          "Normal",
          "High",
          "Critical"
        ],
        "display": "radio",
        "default": "Normal"
      },
      {
        "key": "needed_by",
        "label": "Needed by",
        "type": "date",
        "required": true
      },
      {
        "key": "urgency_reason",
        "label": "Why is it urgent?",
        "type": "textarea",
        "help_text": "High and Critical requests jump the queue: say what happens if it waits"
      },
      {
        "key": "acknowledge",
        "label": "I understand legal advice is given to the company, not to me personally, and that I should not forward it outside the company",
        "type": "boolean",
        "required": true
      },
      {
        "key": "about_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "request_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "request_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "docs_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "docs_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "review_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "review_submit",
        "label": "Send to legal",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "submit",
              "button": "submit"
            }
          ],
          "icon": "send",
          "align": "right",
          "icon_after": true
        }
      }
    ],
    "layout": {
