      "page_settings": {
        "indicator": "progress",
        "next_label": "Next",
        "back_label": "Back",
        "resume": true
      },
      "application_mode": true,
      "rules": [
        {
          "id": "r_sec_nda",
          "name": "NDA questions only for NDAs",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "section:h_nda"
              ]
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "neq",
                "value": "NDA"
              }
            ]
          }
        },
        {
          "id": "r_sec_contract",
          "name": "Contract questions only for contract reviews",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "section:h_contract"
              ]
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "neq",
                "value": "Contract review"
              }
            ]
          }
        },
        {
          "id": "r_sec_question",
          "name": "The area of law only for legal questions",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "section:h_question"
              ]
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "neq",
                "value": "Legal question"
              }
            ]
          }
        },
        {
          "id": "r_sec_dispute",
          "name": "Dispute questions only for disputes",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "section:h_dispute"
              ]
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "neq",
                "value": "Dispute or claim"
              }
            ]
          }
        },
        {
          "id": "r_nda_required",
          "name": "An NDA needs its direction and template",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "nda_direction",
              "text": "Say who shares confidential information."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "NDA"
              },
              {
                "column": "nda_direction",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_nda_paper",
          "name": "An NDA needs its template",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "nda_paper",
              "text": "Say whose template we use."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "NDA"
              },
              {
                "column": "nda_paper",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_contract_type",
          "name": "A contract review needs the contract type",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "contract_type",
              "text": "Pick the contract type."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "Contract review"
              },
              {
                "column": "contract_type",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_question_area",
          "name": "A legal question needs the area of law",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "question_area",
              "text": "Pick the area of law."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "Legal question"
              },
              {
                "column": "question_area",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_reason_hide",
          "name": "Ask why only for High and Critical",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "field:urgency_reason"
              ]
            }
          ],
          "if": {
            "match": "any",
            "conditions": [
              {
                "column": "urgency",
                "operator": "in",
                "value": "Low,Normal"
              },
              {
                "column": "urgency",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_reason_required",
          "name": "High and Critical need a reason",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "urgency_reason",
              "text": "Say why it is urgent: High and Critical requests jump the queue."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "urgency",
                "operator": "in",
                "value": "High,Critical"
              },
              {
                "column": "urgency_reason",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_contract_docs",
          "name": "A contract review needs the contract",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "documents",
              "text": "Attach the contract you want reviewed."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "Contract review"
              },
              {
                "column": "documents",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_needed_by",
          "name": "Needed by is not in the past",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "needed_by",
              "text": "Pick today or a later date."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "needed_by",
                "operator": "is_set"
              },
              {
                "column": "needed_by",
                "operator": "lt",
                "value": "{{today}}"
              }
            ]
          }
        },
        {
          "id": "r_dispute_urgent",
          "name": "Disputes start as High",
          "event": "value_change",
          "then": [
            {
              "type": "set_values",
              "assign": {
                "urgency": "High"
              }
            },
            {
              "type": "message",
              "text": "Disputes usually have deadlines, so urgency is set to High. Change it if there is no rush."
            }
          ],
          "target": "request_type",
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "request_type",
                "operator": "eq",
                "value": "Dispute or claim"
              }
            ]
          }
        }
      ]
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Send to legal",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "success_screen",
            "title": "Sent to legal",
            "screen_button": "submit_another",
            "screen_button_label": "Send another request",
            "text": "Thanks {{requester_name}}. \"{{title}}\" is being routed now; you will get an email with the reference, the queue and when to expect an answer."
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "theme": {
