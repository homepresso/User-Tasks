              "help_text": "Country risk rating from the Country risk table",
              "lookup": {
                "source": "table",
                "table_id": "d4ab2dcb-4009-4931-98b0-787b42e8c197",
                "search_columns": [
                  "country"
                ],
                "display_columns": [
                  "country",
                  "risk"
                ],
                "value_column": "country",
                "fill": [
                  {
                    "from": "risk",
                    "to": "country_risk"
                  },
                  {
                    "from": "enhanced_due_diligence",
                    "to": "edd_required"
                  }
                ]
              }
            },
            {
              "key": "country_risk",
              "label": "Country risk",
              "type": "text",
              "read_only": true
            },
            {
              "key": "edd_required",
              "label": "Enhanced due diligence",
              "type": "boolean",
              "read_only": true
            },
            {
              "key": "risk_tier",
              "label": "Risk tier",
              "type": "choice",
              "options": [
                "A",
                "B",
                "C"
              ],
              "required": true,
              "default": "{{=IF(CONTAINS(risk_tier, \"Decline\"), \"C\", risk_tier)}}"
            },
            {
              "key": "credit_limit",
              "label": "Approved credit limit",
              "type": "number",
              "required": true,
              "default": "{{credit_limit}}"
            },
            {
              "key": "payment_terms",
              "label": "Payment terms",
              "type": "choice",
              "options": [
                "prepaid",
                "14 days",
                "30 days"
              ],
              "required": true,
              "default": "{{=IF(CONTAINS(payment_terms, \"none\"), \"prepaid\", payment_terms)}}"
            },
            {
              "key": "documents_needed",
              "label": "Documents to request (if requesting documents)",
              "type": "text"
            },
            {
              "key": "review_notes",
              "label": "Review notes",
              "type": "text",
              "required": true
            }
          ],
          "form_layout": {
            "rows": [
