      {
        "id": "review",
        "type": "user_task",
        "label": "Compliance review",
        "position": {
          "x": 340,
          "y": 1840
        },
        "config": {
          "task_title": "KYC review: {{company_name}} ({{country}}) · tier {{risk_tier}}",
          "task_description": "<p><strong>{{company_name}}</strong> ({{registration_number}}, {{country}}, country risk {{country_risk}}) for <strong>{{product}}</strong>, expected volume {{expected_monthly_volume}} a month. Account manager: {{account_manager_email}}.</p><ul><li>KYC result <strong>{{kyc_result}}</strong>: registry {{registry_status}} as “{{registered_name}}”, sanctions hits {{sanctions_hits}}, PEP hits {{pep_hits}}. <a href=\"{{kyc_report_url}}\">Screening report</a></li><li>Credit score {{credit_score}} (rating {{credit_rating}}), {{days_beyond_terms}} days beyond terms, bureau suggests {{bureau_limit}}</li><li>Rating rule “{{rule_label}}”: tier {{risk_tier}}, limit {{credit_limit}}, terms {{payment_terms}}</li></ul>",
          "task_priority": "high",
          "outcomes": [
            "Approve",
            "Request documents",
            "Decline"
          ],
          "assignment_type": "individual",
          "assignee_id": "dc61279b-284f-4fd1-b53d-24ae4cf67ed1",
          "due_date_mode": "relative",
          "due_offset_amount": 2,
          "due_offset_unit": "days",
