    "integration_id": "2aad09dd-6904-4898-859f-b2ed73d5492c",
    "name": "Run KYC checks",
    "description": "Company registry, sanctions and PEP screening for the company and its directors. Returns an overall result: clear, review or fail.",
    "tags": [
      "screening"
    ],
    "request_config": {
      "method": "POST",
      "headers": {},
      "query_params": {},
      "body_template": "{\"entity_type\":\"company\",\"name\":\"{{company_name}}\",\"registration_number\":\"{{registration_number}}\",\"country\":\"{{country}}\",\"checks\":[\"registry\",\"sanctions\",\"pep\"],\"reference\":\"{{reference}}\"}",
      "path_template": "/kyc/checks",
      "response_schema": {
