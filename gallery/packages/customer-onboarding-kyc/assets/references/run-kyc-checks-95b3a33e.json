              "example": "KYC-8F21C4"
            },
            {
              "name": "result",
              "type": "string",
              "example": "review"
            },
            {
              "name": "completed_at",
              "type": "string",
              "example": "2026-10-26T01:02:11Z"
            },
            {
              "name": "registry",
              "type": "object",
              "fields": [
                {
                  "name": "status",
                  "type": "string",
                  "example": "active"
                },
                {
                  "name": "registered_name",
                  "type": "string",
                  "example": "Harbourside Logistics Limited"
                },
                {
                  "name": "incorporated",
                  "type": "string",
                  "example": "2014-03-18"
                },
                {
                  "name": "directors",
                  "type": "integer",
                  "example": 3
                }
              ]
            },
            {
              "name": "sanctions",
              "type": "object",
              "fields": [
                {
                  "name": "hits",
                  "type": "integer",
                  "example": 0
                },
                {
                  "name": "lists_checked",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "example": "UN"
                  }
                }
              ]
            },
            {
              "name": "pep",
              "type": "object",
              "fields": [
                {
                  "name": "hits",
                  "type": "integer",
                  "example": 1
                },
                {
                  "name": "matches",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "fields": [
                      {
                        "name": "name",
                        "type": "string",
                        "example": "Director match"
                      },
                      {
                        "name": "role",
                        "type": "string",
                        "example": "Former municipal councillor"
                      },
                      {
                        "name": "confidence",
                        "type": "number",
                        "example": 0.82
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "report_url",
              "type": "string",
              "example": "https://kyc.example.com/reports/KYC-8F21C4"
            }
          ]
        },
        "sample": {
