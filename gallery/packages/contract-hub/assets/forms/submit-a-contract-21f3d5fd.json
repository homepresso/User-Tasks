{
  "format_version": 3,
  "asset_type": "forms",
  "id": "21f3d5fd-7c35-5437-9fd8-cf517721e729",
  "asset": {
    "id": "21f3d5fd-7c35-5437-9fd8-cf517721e729",
    "name": "Submit a contract",
    "description": "Send a contract for approval: legal reviews every contract, finance reviews contracts over $50,000, then it is signed and added to the register.",
    "tags": [
      "contracts",
      "legal"
    ],
    "fields": [
      {
        "key": "h_what",
        "label": "The contract",
        "type": "heading"
      },
      {
        "key": "title",
        "label": "Title",
        "type": "text",
        "required": true,
        "placeholder": "e.g. \"Cloud hosting services\""
      },
      {
        "key": "counterparty",
        "label": "Counterparty",
        "type": "text",
        "required": true
      },
      {
        "key": "type",
        "label": "Type",
        "type": "choice",
        "options": [
          "NDA",
          "Master services agreement",
          "Statement of work",
          "Supplier agreement",
          "Software licence",
          "Lease"
        ],
        "required": true
      },
      {
        "key": "value",
        "label": "Total value (USD)",
        "type": "currency",
        "currency": "USD",
        "min": 0,
        "required": true,
        "help_text": "Over $50,000 also needs finance review."
      },
      {
        "key": "h_term",
        "label": "Term and renewal",
        "type": "heading"
      },
      {
        "key": "start_date",
        "label": "Start date",
        "type": "date",
        "required": true
      },
      {
        "key": "end_date",
        "label": "End date",
        "type": "date",
        "required": true
      },
      {
        "key": "renewal_date",
        "label": "Renewal decision by",
        "type": "date",
        "required": true,
        "help_text": "The last day to renew or give notice. You get a renewal review task then."
      },
      {
        "key": "auto_renew",
        "label": "Renews automatically unless we give notice",
        "type": "boolean"
      },
      {
        "key": "h_who",
        "label": "Ownership",
        "type": "heading"
      },
      {
        "key": "owner",
        "label": "Business owner",
        "type": "user",
        "required": true
      },
      {
        "key": "summary",
        "label": "Summary and anything unusual",
        "type": "textarea",
        "required": true
      },
      {
        "key": "documents",
        "label": "Contract documents",
        "type": "attachments",
        "attachments": {
          "max_files": 5,
          "max_file_mb": 10,
          "types": [
            "documents",
            "images",
            "pdf"
          ]
        },
        "required": true
      }
    ],
    "layout": {
