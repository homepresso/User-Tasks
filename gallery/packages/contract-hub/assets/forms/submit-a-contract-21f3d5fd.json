              "field_key": "documents",
              "span": 2
            }
          ]
        }
      ]
    },
    "theme": {
      "source": "workspace"
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Submit for approval",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "success_screen",
            "title": "Contract submitted",
            "text": "\"{{title}}\" with {{counterparty}} is with legal for review. Follow it on the Pipeline page.",
            "screen_button": "submit_another",
            "screen_button_label": "Submit another contract"
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
