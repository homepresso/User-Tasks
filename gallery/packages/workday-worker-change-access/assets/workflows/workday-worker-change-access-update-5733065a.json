            "worker_name": "{{worker_name}}",
            "event_type": "{{event_type}}",
            "effective_date": "{{effective_date}}",
            "from_bundle": "{{from_bundle}}",
            "to_bundle": "{{to_bundle}}",
            "status": "pending manager"
          }
        }
      },
      {
        "id": "approve",
        "type": "user_task",
        "label": "Manager approves access change",
        "position": {
          "x": 400,
          "y": 2300
        },
        "config": {
          "task_title": "Approve access change for {{worker_name}}: {{from_bundle}} → {{to_bundle}}",
          "task_description": "<p><strong>{{worker_name}}</strong> ({{employee_id}}) had a <strong>{{change_type}}</strong> ({{change_reason}}) effective <strong>{{effective_date}}</strong>.</p><p>Before: {{previous_job_profile}} in {{previous_org}}.<br>Now: {{job_profile}} in {{supervisory_org}}.</p><p><strong>Remove</strong> {{from_bundle}} ({{from_bundle_row.name}}): {{from_bundle_row.applications}}<br><strong>Add</strong> {{to_bundle}} ({{to_bundle_row.name}}, risk {{to_bundle_row.risk}}): {{to_bundle_row.applications}}</p><p>Review: {{review}}.</p>",
          "task_priority": "high",
          "outcomes": [
            "Approve",
            "Reject"
          ],
          "assignment_type": "individual",
          "assignee_id": "bc4aa9ce-d345-5fd6-af48-caa6419c400b",
          "assignee_variable": "{{manager_user_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 2,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 2880,
          "fields": [
            {
              "key": "remove_bundle",
              "label": "Remove bundle",
              "type": "text",
              "read_only": true,
              "default": "{{from_bundle}}"
            },
            {
              "key": "add_bundle",
              "label": "Add bundle",
              "type": "lookup",
              "required": true,
              "default": "{{to_bundle}}",
              "help_text": "Change it if the mapped bundle is wrong for this person",
              "lookup": {
                "source": "table",
                "table_id": "e392c9de-d0ba-53be-9a1d-c47394c07538",
                "search_columns": [
                  "bundle_code",
                  "name"
                ],
                "display_columns": [
                  "bundle_code",
                  "name",
                  "risk"
                ],
                "value_column": "bundle_code",
                "fill": [
                  {
                    "from": "applications",
                    "to": "add_applications"
                  }
                ]
              }
            },
            {
              "key": "add_applications",
              "label": "Grants",
              "type": "textarea",
              "read_only": true
            },
            {
              "key": "remove_by",
              "label": "Remove old access by",
              "type": "date",
              "required": true,
              "default": "{{effective_date}}"
            },
            {
              "key": "keep_temporarily",
              "label": "Keep old access during handover",
              "type": "boolean"
            },
            {
              "key": "comment",
              "label": "Comment (posted to Workday)",
              "type": "textarea"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "remove_bundle",
                    "span": 1
