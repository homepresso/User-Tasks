        "id": "nothing",
        "type": "log",
        "label": "No access change",
        "position": {
          "x": 720,
          "y": 2140
        },
        "config": {
          "message": "{{worker_name}}: {{event_type}} keeps bundle {{to_bundle}}; nothing to change",
          "level": "info"
        }
      },
