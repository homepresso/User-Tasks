        "config": {
          "branches": [
            {
              "label": "No change",
              "logic": "and",
              "rules": [
                {
                  "field": "{{to_bundle}}",
                  "operator": "equals",
                  "value": "{{from_bundle}}"
                }
              ]
            }
          ],
          "has_else": true
        }
      },
