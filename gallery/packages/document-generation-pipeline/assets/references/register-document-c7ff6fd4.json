    "name": "Register document",
    "description": "Register a generated document in the DMS: the file is fetched from its URL and filed with its metadata and retention period.",
    "tags": [
      "documents"
    ],
    "request_config": {
      "method": "POST",
      "headers": {},
      "query_params": {},
      "body_template": "{\"file_url\":\"{{file_url}}\",\"file_name\":\"{{file_name}}\",\"content_type\":\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\"attachments\":{{attachments}},\"folder\":\"{{folder}}\",\"retention_days\":{{retention_days}},\"metadata\":{\"doc_type\":\"{{doc_type}}\",\"reference\":\"{{reference}}\",\"customer\":\"{{customer}}\"}}",
      "path_template": "/documents",
