            },
            {
              "name": "version",
              "type": "integer",
              "example": 1
            },
            {
              "name": "retain_until",
              "type": "string",
              "example": "2033-10-26"
            },
            {
              "name": "folder",
              "type": "string",
              "example": "Contracts/Fourth Coffee"
            }
          ]
        },
