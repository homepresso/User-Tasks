              "example": "ENV-9F31C2"
            },
            {
              "name": "status",
              "type": "string",
              "example": "sent"
            },
            {
              "name": "expires_at",
              "type": "string",
              "example": "2026-11-09T00:00:00Z"
            },
            {
              "name": "signers",
              "type": "array",
              "items": {
                "type": "object",
                "fields": [
                  {
                    "name": "email",
                    "type": "string",
                    "example": "robin.diaz@fourthcoffee.example.com"
                  },
                  {
                    "name": "status",
                    "type": "string",
                    "example": "sent"
                  },
                  {
                    "name": "signing_url",
                    "type": "string",
                    "example": "https://esign.example.com/sign/ENV-9F31C2"
                  }
                ]
              }
            }
          ]
        },
        "sample": {
