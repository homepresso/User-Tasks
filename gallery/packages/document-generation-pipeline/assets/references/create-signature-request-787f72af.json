    "name": "Create signature request",
    "description": "Send the document for electronic signature to the signer and return the envelope and signing link.",
    "tags": [
      "signature"
    ],
    "request_config": {
      "method": "POST",
      "headers": {},
      "query_params": {},
      "body_template": "{\"document_url\":\"{{document_url}}\",\"document_name\":\"{{document_name}}\",\"signer\":{\"name\":\"{{signer_name}}\",\"email\":\"{{signer_email}}\"},\"subject\":\"{{subject}}\",\"external_id\":\"{{external_id}}\",\"expires_in_days\":14}",
      "path_template": "/signature-requests",
      "response_schema": {
