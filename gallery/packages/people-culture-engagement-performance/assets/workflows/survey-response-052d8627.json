        "label": "Update the participation rate",
        "config": {
          "table_id": "fa87c6c6-2171-5540-9c3e-348f366620ca",
          "table_name": "Survey cycles",
          "operation": "update",
          "match_column": "cycle_code",
          "match_value": "{{cycle_code}}",
          "column_values": {
            "responded": "{{responded_n}}",
            "participation_pct": "{{=ROUND(responded_n * 100 / MAX(1, TO_NUMBER(cycle.invited)), 0)}}"
          }
        },
        "position": {
          "x": 400,
          "y": 2020
        }
      },
      {
        "id": "s_engagement",
        "type": "set_variable",
        "label": "Engagement (% favourable)",
        "config": {
          "name": "score_engagement",
          "expression": "{{=ROUND((IF(TO_NUMBER(form.engagement.eng1) >= 4, 1, 0) + IF(TO_NUMBER(form.engagement.eng2) >= 4, 1, 0) + IF(TO_NUMBER(form.engagement.eng3) >= 4, 1, 0)) * 100 / 3, 0)}}"
        },
        "position": {
          "x": 400,
          "y": 2160
        }
      },
