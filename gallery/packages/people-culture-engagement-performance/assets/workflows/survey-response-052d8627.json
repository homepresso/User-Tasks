  "asset": {
    "id": "052d8627-c304-525a-a16c-4cf03f12b9dd",
    "name": "Survey response",
    "description": "Each Engagement survey answer: marks the person as responded (date only, never the answers), updates the participation rate, works out % favourable per driver and eNPS points, then waits sealed until the survey closes. At close it writes one ballot with no name and no time, with any department, location or tenure group under the minimum size merged into \"Other\".",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
        "label": "Survey answered",
        "config": {
          "form_id": "c9c37320-5b8f-5f73-986e-0619723f0219",
          "form_name": "Engagement survey"
        },
        "position": {
          "x": 400,
          "y": 60
        }
      },
      {
        "id": "code",
        "type": "set_variable",
        "label": "Survey cycle",
        "config": {
          "name": "cycle_code",
          "expression": "{{=IF(IS_EMPTY(form.cycle_code), form.cycle, form.cycle_code)}}"
        },
        "position": {
          "x": 400,
          "y": 200
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "config": {
          "title": "Survey response · {{cycle_code}}"
        },
        "position": {
          "x": 400,
          "y": 340
        }
      },
      {
        "id": "cycle",
        "type": "update_data_table",
        "label": "Find the survey",
        "config": {
          "table_id": "fa87c6c6-2171-5540-9c3e-348f366620ca",
          "table_name": "Survey cycles",
          "operation": "get",
          "match_column": "cycle_code",
          "match_value": "{{cycle_code}}",
          "output_row_var": "cycle"
        },
        "position": {
          "x": 400,
          "y": 480
        }
      },
      {
        "id": "invite",
        "type": "update_data_table",
        "label": "Find the invitation",
        "config": {
          "table_id": "7b85bba9-074a-50c1-b189-15dff41ee5ec",
          "table_name": "Survey participation",
          "operation": "list",
          "filters": [
            {
              "column": "cycle_code",
              "operator": "eq",
              "value": "{{cycle_code}}"
            },
            {
              "column": "employee_email",
              "operator": "eq",
              "value": "{{submitted_by_email}}"
            }
          ],
          "limit": 1,
          "output_rows_var": "invite_rows",
          "output_count_var": "invite_count"
        },
        "position": {
          "x": 400,
          "y": 620
        }
      },
      {
        "id": "inv",
        "type": "set_variable",
        "label": "Invitation",
        "config": {
          "name": "invitation",
          "expression": "{{=FIRST(invite_rows)}}"
        },
        "position": {
          "x": 400,
          "y": 760
        }
      },
      {
        "id": "check",
        "type": "condition",
        "label": "Can this answer count?",
        "config": {
          "branches": [
            {
              "label": "Survey closed",
              "logic": "and",
              "rules": [
                {
                  "field": "{{cycle.status}}",
                  "operator": "not_equals",
                  "value": "Open"
                }
              ]
            },
            {
              "label": "Already answered",
              "logic": "and",
              "rules": [
                {
                  "field": "{{invitation.status}}",
                  "operator": "equals",
                  "value": "Responded"
                }
              ]
            }
          ],
          "has_else": true
        },
        "position": {
          "x": 400,
          "y": 900
        }
      },
      {
        "id": "closed",
        "type": "end_workflow",
        "label": "Not counted: survey closed",
        "config": {
          "reason": "{{cycle_code}} is not open"
        },
        "position": {
          "x": 80,
          "y": 1040
        }
      },
      {
        "id": "dupe",
        "type": "end_workflow",
        "label": "Not counted: already answered",
        "config": {
          "reason": "One answer per person per survey"
        },
        "position": {
          "x": 720,
          "y": 1180
        }
      },
      {
        "id": "person",
        "type": "update_data_table",
        "label": "Directory record",
        "config": {
          "table_id": "dd843f75-566b-550e-a932-995223d44564",
          "table_name": "People directory",
          "operation": "get",
          "match_column": "email",
          "match_value": "{{submitted_by_email}}",
          "output_row_var": "person"
        },
        "position": {
          "x": 400,
          "y": 1320
        }
      },
      {
        "id": "has_inv",
        "type": "condition",
        "label": "Invited?",
        "config": {
          "branches": [
            {
              "label": "Invited",
              "logic": "and",
              "rules": [
                {
                  "field": "{{invite_count}}",
                  "operator": "gt",
                  "value": "0"
                }
              ]
            }
          ],
          "has_else": true
        },
        "position": {
          "x": 400,
          "y": 1460
        }
      },
      {
        "id": "mark",
        "type": "update_data_table",
        "label": "Mark as responded (date only)",
        "config": {
          "table_id": "7b85bba9-074a-50c1-b189-15dff41ee5ec",
          "table_name": "Survey participation",
          "operation": "update",
          "column_values": {
            "status": "Responded",
            "responded_on": "{{=FORMAT_DATE(NOW(), \"YYYY-MM-DD\")}}"
          },
          "row_id": "{{invitation.row_id}}"
        },
        "position": {
          "x": 400,
          "y": 1600
        }
      },
      {
        "id": "add_inv",
        "type": "update_data_table",
        "label": "Add a participation record",
        "config": {
          "table_id": "7b85bba9-074a-50c1-b189-15dff41ee5ec",
          "table_name": "Survey participation",
          "operation": "insert",
          "column_values": {
            "cycle_code": "{{cycle_code}}",
            "cycle_name": "{{cycle.name}}",
            "employee_name": "{{person.name}}",
            "employee_email": "{{submitted_by_email}}",
            "department": "{{person.department}}",
            "location": "{{person.location}}",
            "tenure_band": "{{person.tenure_band}}",
            "status": "Responded",
            "invited_on": "{{=FORMAT_DATE(NOW(), \"YYYY-MM-DD\")}}",
            "responded_on": "{{=FORMAT_DATE(NOW(), \"YYYY-MM-DD\")}}",
            "reminders_sent": "0",
            "closes_on": "{{cycle.closes_on}}"
          }
        },
        "position": {
          "x": 720,
          "y": 1740
        }
      },
      {
        "id": "count",
        "type": "update_data_table",
        "label": "Count responses",
        "config": {
          "table_id": "7b85bba9-074a-50c1-b189-15dff41ee5ec",
          "table_name": "Survey participation",
          "operation": "list",
          "filters": [
            {
              "column": "cycle_code",
              "operator": "eq",
              "value": "{{cycle_code}}"
            },
            {
              "column": "status",
              "operator": "eq",
              "value": "Responded"
            }
          ],
          "limit": 1000,
          "output_rows_var": "responded_rows",
          "output_count_var": "responded_n"
