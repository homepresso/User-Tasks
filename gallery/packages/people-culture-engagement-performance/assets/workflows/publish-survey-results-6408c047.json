        "label": "Done"
      },
      {
        "id": "e-notify-end",
        "source": "notify",
        "target": "end"
      }
    ],
    "user_variables": [
      {
        "id": "v-cycle_code",
        "name": "cycle_code",
        "type": "string",
        "label": "Cycle code",
        "description": "The survey cycle to publish, e.g. ENG-2026-Q4",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "v-survey_name",
        "name": "survey_name",
        "type": "string",
        "label": "Survey name",
        "description": "For the email",
        "defaultValue": ""
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
