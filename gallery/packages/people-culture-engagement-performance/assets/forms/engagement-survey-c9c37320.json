        "key": "cycle_code",
        "label": "Survey",
        "type": "text",
        "read_only": true,
        "default": "{{param.cycle}}",
        "help_text": "Your answers count towards this survey."
      },
      {
        "key": "privacy",
        "label": "Your privacy",
        "type": "label",
        "default": "Your answers are sealed until the survey closes, then counted with everyone else's. Results are only shown for groups of five or more, and nobody can see your individual answers."
