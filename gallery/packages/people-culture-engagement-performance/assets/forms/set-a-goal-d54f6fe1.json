              "field_key": "aligned_to",
              "span": 2
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "quarter",
              "span": 1
            },
            {
              "field_key": "due_date",
              "span": 1
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "key_results",
              "span": 2
            }
