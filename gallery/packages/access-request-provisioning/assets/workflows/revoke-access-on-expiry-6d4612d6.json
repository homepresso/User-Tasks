{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "6d4612d6-dfb9-4be3-9784-ca57a4f7901d",
  "asset": {
    "id": "6d4612d6-dfb9-4be3-9784-ca57a4f7901d",
    "name": "Revoke access on expiry",
    "description": "Waits for the length of a time-boxed grant, then revokes it in the identity platform and tells the requester. Started by the Access request workflow.",
    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "Grant to expire",
        "position": {
          "x": 340,
          "y": 60
        },
        "config": {}
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "title": "Expiry: {{application}} · {{user_name}} · {{grant_id}}"
        }
      },
      {
        "id": "which",
        "type": "switch_case",
        "label": "How long?",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "field": "{{duration}}",
          "cases": [
            {
              "value": "30 days",
              "label": "30 days"
            },
            {
              "value": "90 days",
              "label": "90 days"
            }
          ],
          "has_default": true
        }
      },
      {
        "id": "wait30",
        "type": "delay",
        "label": "Wait 30 days",
        "position": {
          "x": 340,
          "y": 560
        },
        "config": {
          "duration": 30,
          "unit": "days"
        }
      },
      {
        "id": "wait90",
        "type": "delay",
        "label": "Wait 90 days",
        "position": {
          "x": 660,
          "y": 560
        },
        "config": {
          "duration": 90,
          "unit": "days"
        }
      },
      {
        "id": "revoke",
        "type": "call_reference",
        "label": "Revoke grant",
        "position": {
          "x": 340,
          "y": 720
        },
        "config": {
          "reference_id": "41da2eef-359b-4f04-ae79-6cf7e4a913d6",
          "reference_name": "Revoke access grant",
          "reference_method": "POST",
          "input_mappings": {
            "grant_id": "{{grant_id}}",
            "reason": "Time-boxed access ({{duration}}) expired"
          },
          "output_mappings": {
            "status": {
              "enabled": true,
              "variableName": "revoke_status"
            },
            "revoked_at": {
              "enabled": true,
              "variableName": "revoked_at"
            }
          }
        }
      },
      {
        "id": "notify",
        "type": "send_email",
        "label": "Email requester: removed",
        "position": {
          "x": 340,
          "y": 880
        },
        "config": {
          "to": "{{requester_email}}",
          "email_template_id": "e073c3f0-a9e8-4d3f-bced-4442905c4a73"
        },
        "onError": "continue"
      },
      {
        "id": "done",
        "type": "end_workflow",
        "label": "Revoked",
        "position": {
          "x": 340,
          "y": 1040
        },
        "config": {
          "reason": "Grant {{grant_id}} revoked at {{revoked_at}}"
        }
      },
      {
        "id": "no_expiry",
        "type": "log",
        "label": "Nothing to revoke",
        "position": {
          "x": 980,
          "y": 560
        },
        "config": {
          "message": "Grant {{grant_id}} has duration \"{{duration}}\": no automatic expiry",
          "level": "warn"
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-title",
        "source": "trigger",
        "target": "title"
      },
      {
        "id": "e-title-which",
        "source": "title",
        "target": "which"
      },
      {
        "id": "e-which-wait30-30-days",
        "source": "which",
        "target": "wait30",
        "label": "30 days"
      },
      {
        "id": "e-which-wait90-90-days",
        "source": "which",
        "target": "wait90",
        "label": "90 days"
      },
      {
        "id": "e-which-no_expiry-default",
        "source": "which",
        "target": "no_expiry",
        "label": "Default"
      },
      {
        "id": "e-wait30-revoke",
        "source": "wait30",
        "target": "revoke"
      },
      {
        "id": "e-wait90-revoke",
        "source": "wait90",
        "target": "revoke"
      },
      {
        "id": "e-revoke-notify",
        "source": "revoke",
        "target": "notify"
      },
      {
        "id": "e-notify-done",
        "source": "notify",
        "target": "done"
      }
    ],
    "user_variables": [
      {
        "id": "v-grant_id",
        "name": "grant_id",
        "type": "string",
        "description": "Grant id returned by the identity platform",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "v-duration",
        "name": "duration",
        "type": "string",
        "description": "Requested duration: 30 days or 90 days",
        "defaultValue": "",
        "required": true
      },
      {
        "id": "v-application",
        "name": "application",
        "type": "string",
        "description": "Application name",
        "defaultValue": ""
      },
      {
        "id": "v-role",
        "name": "role",
        "type": "string",
        "description": "Role or entitlement",
        "defaultValue": ""
      },
      {
        "id": "v-requester_name",
        "name": "requester_name",
        "type": "string",
        "description": "Requester name for the email",
        "defaultValue": ""
      },
      {
        "id": "v-requester_email",
        "name": "requester_email",
        "type": "string",
        "description": "Requester email",
        "defaultValue": "",
        "format": "email"
      },
      {
        "id": "v-user_name",
        "name": "user_name",
        "type": "string",
        "description": "Name of the person who held the access",
        "defaultValue": ""
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
