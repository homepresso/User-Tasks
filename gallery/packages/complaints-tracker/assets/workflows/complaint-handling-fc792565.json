    "id": "fc792565-c3ba-5cdd-b138-859d59ff84be",
    "name": "Complaint handling",
    "description": "A complaint is logged against a customer: priority and SLA from tier and category, the customer is acknowledged, and the handler resolves or escalates it to the team lead.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
        "label": "Complaint logged",
        "position": {
          "x": 400,
          "y": 60
        },
        "config": {
          "form_id": "15b6898d-104a-5501-821f-f846dd0c15ff",
          "form_name": "Log a complaint"
        }
      },
      {
        "id": "ref",
        "type": "set_variable",
        "label": "Complaint reference",
        "position": {
          "x": 400,
          "y": 180
        },
        "config": {
          "name": "complaint_ref",
          "expression": "CMP-{{=FORMAT_DATE(NOW(), \"YYYYMMDD\")}}-{{=UPPER(LEFT(GUID(), 4))}}"
        }
      },
      {
        "id": "cust",
        "type": "update_data_table",
