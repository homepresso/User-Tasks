          "operation": "get",
          "match_column": "account_no",
          "match_value": "{{form.customer}}",
          "output_row_var": "customer_row"
        }
      },
      {
        "id": "company",
        "type": "set_variable",
        "label": "Company",
        "position": {
          "x": 400,
          "y": 420
        },
        "config": {
          "name": "company",
          "expression": "{{=COALESCE(customer_row.company, form.customer_item.company)}}"
        }
      },
      {
        "id": "tier",
        "type": "set_variable",
        "label": "Tier",
        "position": {
          "x": 400,
          "y": 540
        },
        "config": {
          "name": "tier",
          "expression": "{{=COALESCE(customer_row.tier, \"Standard\")}}"
        }
      },
      {
        "id": "contact",
        "type": "set_variable",
