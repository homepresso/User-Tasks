        "config": {
          "task_title": "{{priority}} complaint: {{company}} · {{form.summary}}",
          "task_description": "<p><strong>{{company}}</strong> ({{tier}} · account {{form.customer}}) complained via {{form.channel}} about <strong>{{form.category}}</strong>{{=IF(IS_EMPTY(form.order_ref), \"\", CONCAT(\" (order \", form.order_ref, \")\"))}}:</p><p><strong>{{form.summary}}</strong><br>{{form.details}}</p><p>The customer wants: {{form.desired_outcome}}. Contact: {{contact_name}}, {{contact_email}}.</p><p>Priority <strong>{{priority}}</strong> (rule \"{{rule_label}}\"): call the customer within {{ack_hours}} hours and resolve by <strong>{{=FORMAT_DATE(resolve_by, \"DD/MM/YYYY HH:mm\")}} UTC</strong>.</p>",
          "task_priority": "high",
          "outcomes": [
            "Resolve",
            "Escalate"
          ],
          "assignment_type": "individual",
          "assignee_variable": "{{form.handler}}",
          "due_date_mode": "absolute",
          "due_date": "{{resolve_by}}",
          "reminders": [
            {
              "offset_minutes": 240
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 1440,
          "fields": [
            {
              "key": "root_cause",
              "label": "Root cause",
              "type": "choice",
              "required": true,
              "options": [
                "Carrier delay",
                "Warehouse error",
                "Product defect",
                "Billing error",
                "Process gap",
                "Staff conduct",
                "Customer misunderstanding",
                "Other"
              ]
            },
            {
              "key": "customer_contacted",
              "label": "I spoke to the customer",
              "type": "boolean",
              "required": true
            },
            {
              "key": "resolution",
              "label": "Resolution (sent to the customer)",
              "type": "textarea",
              "required": true
            },
            {
              "key": "goodwill",
              "label": "Goodwill credit",
              "type": "currency",
              "min": 0,
              "default": "0"
            },
            {
              "key": "internal_note",
              "label": "Internal note",
              "type": "textarea",
              "help_text": "Not sent to the customer. With Escalate, say why."
            }
