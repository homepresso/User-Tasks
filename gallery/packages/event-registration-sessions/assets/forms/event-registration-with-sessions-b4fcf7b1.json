{
  "format_version": 3,
  "asset_type": "forms",
  "id": "b4fcf7b1-50c9-592e-8c78-9c33b0ccea5a",
  "asset": {
    "id": "b4fcf7b1-50c9-592e-8c78-9c33b0ccea5a",
    "name": "Event registration with sessions",
    "description": "Register one or more people for an event: pick the event (date and venue fill in), list the attendees with their dietary and accessibility needs, choose a first and second session, and send questions for the speakers.",
    "tags": [
      "events",
      "registration",
      "sessions"
    ],
    "fields": [
      {
        "key": "event",
        "label": "Event",
        "type": "lookup",
        "required": true,
        "help_text": "Start typing the event name.",
        "lookup": {
          "source": "table",
          "table_id": "9981e824-0cd7-5fd4-834a-a20a2b81b2cf",
          "search_columns": [
            "title",
            "event_code"
          ],
          "display_columns": [
            "title",
            "event_date",
            "venue"
          ],
          "value_column": "event_code",
          "fill": [
            {
              "from": "title",
              "to": "event_title"
            },
            {
              "from": "event_date",
              "to": "event_date"
            },
            {
              "from": "venue",
              "to": "event_venue"
            }
          ],
          "filters": [
            {
              "column": "status",
              "operator": "eq",
              "value": "Open"
            }
          ],
          "sort": {
            "column": "event_date",
            "direction": "asc"
          }
        }
      },
      {
        "key": "event_title",
        "label": "Event name",
        "type": "text",
        "read_only": true
      },
      {
        "key": "event_date",
        "label": "Date",
        "type": "date",
        "read_only": true
      },
      {
        "key": "event_venue",
        "label": "Venue",
        "type": "text",
        "read_only": true
      },
      {
        "key": "contact_name",
        "label": "Your name",
        "type": "text",
        "required": true
      },
      {
        "key": "contact_email",
        "label": "Your email",
        "type": "email",
        "required": true,
        "help_text": "We send the booking summary here."
      },
      {
        "key": "organisation",
        "label": "Organisation",
        "type": "text"
      },
      {
        "key": "attendees",
        "type": "custom",
        "label": "Attendees",
        "custom": {
          "tag": "ut-table",
          "version": "1.1.0",
          "name": "Table",
          "value_type": "array",
          "icon": "table",
          "value_schema": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          },
          "props": {
            "columns": [
              {
                "key": "name",
                "label": "Name",
                "type": "text",
                "required": true,
                "width": 200
              },
              {
                "key": "email",
                "label": "Email",
                "type": "text",
                "required": true,
                "width": 220
              },
              {
                "key": "dietary",
                "label": "Dietary needs",
                "type": "select",
                "options": [
                  "None",
                  "Vegetarian",
                  "Vegan",
                  "Gluten free",
                  "Halal",
                  "Other"
                ],
                "width": 140
              },
              {
                "key": "accessibility",
                "label": "Accessibility needs",
                "type": "text",
                "width": 220
              }
            ],
            "min_rows": 1,
            "max_rows": 10,
            "allow_add": true,
            "allow_delete": true,
            "show_totals": false,
            "currency": "USD",
            "default_rows": [
              {
                "name": "",
                "email": "",
                "dietary": "None",
                "accessibility": ""
              }
            ]
          },
          "display": {
            "format": "json"
          },
          "accessibility": {
            "role": "grid",
            "keyboard": "Tab into the table (one stop). Arrow keys move between cells, Home / End to the row's ends (Ctrl+Home / End to the table's), Enter, F2 or typing edits a cell; Enter saves and moves down, Shift+Enter up, Escape cancels; Tab / Shift+Tab move cell by cell and leave the table at its ends. Delete clears a cell, Space or Enter toggles a tick box, Ctrl+Enter adds a row; each row's Delete row button is the last cell of the row.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 240,
            "min_height": 120,
            "max_height": 1200,
            "full_width": true
          },
          "output": {
            "type": "array",
            "description": "The rows entered"
          }
        },
        "required": true,
        "help_text": "One row per person (up to 10). Each attendee gets their own confirmation email."
      },
      {
        "key": "first_choice",
        "label": "First choice session",
        "type": "lookup",
        "required": true,
        "lookup": {
          "source": "table",
          "table_id": "e5d16899-81fd-5816-98cc-bf6005ae8cdc",
          "search_columns": [
            "title",
            "speaker",
            "session_label"
          ],
          "display_columns": [
            "session_label",
            "starts",
            "room",
            "speaker"
          ],
          "value_column": "session_label",
          "filters": [
            {
              "column": "event_code",
              "operator": "eq",
              "value": "{{task_data.event}}"
            }
          ],
          "sort": {
            "column": "starts",
            "direction": "asc"
          },
          "min_chars": 0,
          "max_results": 50
        },
        "help_text": "The sessions of the event you picked, with their time and room."
      },
      {
        "key": "second_choice",
        "label": "Second choice session",
        "type": "lookup",
        "required": true,
        "lookup": {
          "source": "table",
          "table_id": "e5d16899-81fd-5816-98cc-bf6005ae8cdc",
          "search_columns": [
            "title",
            "speaker",
            "session_label"
          ],
          "display_columns": [
            "session_label",
            "starts",
            "room",
            "speaker"
          ],
          "value_column": "session_label",
          "filters": [
            {
              "column": "event_code",
              "operator": "eq",
              "value": "{{task_data.event}}"
            }
          ],
          "sort": {
            "column": "starts",
            "direction": "asc"
          },
          "min_chars": 0,
          "max_results": 50
        },
        "help_text": "Used if your first choice is full."
      },
      {
        "key": "sessions_planned",
        "type": "custom",
        "label": "How many sessions do you plan to attend?",
        "custom": {
          "tag": "ut-slider",
          "version": "1.1.0",
          "name": "Slider",
          "value_type": "number",
          "icon": "sliders",
          "value_schema": {
            "type": "number"
          },
          "props": {
            "min": 1,
            "max": 5,
            "step": 1,
            "show_value": true,
            "marks": [
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            "show_input": false,
            "default_value": 2
          },
          "display": {
            "template": "{{value}}",
            "format": "text"
          },
          "accessibility": {
            "role": "slider",
            "keyboard": "Tab to the slider; Left / Right (or Up / Down) move one step, Page Up / Page Down move further, Home / End jump to the minimum / maximum. Enter or Space accepts the starting position while the field is still empty. With the number box, Tab again to type an exact value.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 87,
            "min_height": 48,
            "max_height": 120
          },
          "output": {
            "type": "number",
            "description": "The value chosen"
          }
        }
      },
      {
        "key": "networking",
        "type": "custom",
        "label": "How interested are you in the networking breaks?",
        "custom": {
          "tag": "ut-rating",
          "version": "1.1.0",
          "name": "Rating",
          "value_type": "number",
          "icon": "star",
          "value_schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "props": {
            "max": 5,
            "symbol": "heart",
            "size": "medium",
            "labels": [
              "Not at all",
              "A little",
              "Somewhat",
              "Quite",
              "Very"
            ],
            "allow_clear": true
          },
          "display": {
            "template": "{{value}} of {{props.max}}",
            "format": "text"
          },
          "accessibility": {
            "role": "radiogroup",
            "keyboard": "Tab to the rating; Left / Right (or Up / Down) change it; Home / End jump to the lowest / highest; Delete or Backspace clears it when clearing is allowed.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 52,
            "min_height": 36,
            "max_height": 120
          },
          "output": {
            "type": "number",
            "description": "The rating (1 to the maximum)"
          }
        }
      },
      {
        "key": "questions",
        "type": "custom",
        "label": "Questions for the speakers",
        "custom": {
          "tag": "ut-rich-text",
          "version": "1.1.0",
          "name": "Rich text",
          "value_type": "json",
          "icon": "type",
          "value_schema": {
            "type": "object",
            "properties": {
              "html": {
                "type": "string",
                "maxLength": 100000
              },
              "text": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "html",
              "text"
            ],
            "additionalProperties": false
          },
          "props": {
            "placeholder": "What would you like the speakers to cover?",
            "max_length": 3000,
            "toolbar": "basic",
            "min_height": 140
          },
          "display": {
            "template": "{{value.text}}",
            "format": "text"
          },
          "accessibility": {
            "role": "textbox",
            "keyboard": "Tab to the formatting toolbar (Left / Right / Home / End move between buttons, Enter or Space applies one), Tab again to the text. In the text: Ctrl/Cmd+B, I, U for bold, italic, underline; Ctrl/Cmd+K adds a link (Enter applies, Escape cancels); Ctrl/Cmd+Z undoes, Ctrl/Cmd+Shift+Z redoes.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 216,
            "min_height": 120,
            "max_height": 900,
            "full_width": true
          },
          "output": {
            "type": "string",
            "primary": "html",
            "html": true,
            "extras": {
              "text": "text"
            },
            "choices": [
              {
                "value": "html",
                "label": "HTML (formatted, sanitised)",
                "primary": "html",
                "html": true
              },
              {
                "value": "text",
                "label": "Plain text",
                "primary": "text"
              }
            ],
            "description": "The text as sanitised HTML (or plain text, as the form chooses); <key>_text is always the plain text"
          }
        }
      },
      {
        "key": "consent",
        "label": "I agree to these details being used to run the event",
        "type": "boolean",
        "required": true
      }
    ],
