    "user_variables": [
      {
        "id": "v-requester_name",
        "name": "requester_name",
        "type": "string",
        "description": "Your name (the person driving)",
        "defaultValue": "",
        "required": true,
        "label": "Driver"
      },
      {
        "id": "v-requester_email",
        "name": "requester_email",
        "type": "string",
        "description": "Where the confirmation goes",
        "defaultValue": "",
        "required": true,
        "label": "Email",
        "format": "email"
      },
      {
