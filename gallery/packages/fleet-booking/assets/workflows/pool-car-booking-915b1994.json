        "name": "rego",
        "type": "string",
        "description": "Which pool vehicle you would like",
        "defaultValue": "",
        "required": true,
        "label": "Vehicle",
        "options": [
          {
            "value": "EVA101",
            "label": "Hyundai Kona Electric · 5 seats · EV · EVA101"
          },
          {
            "value": "EVB202",
            "label": "Tesla Model Y · 5 seats · EV · EVB202"
          },
          {
            "value": "HYB303",
            "label": "Toyota Corolla Hybrid wagon · 5 seats · HYB303"
          },
          {
            "value": "VAN404",
            "label": "Toyota Hiace van · 3 seats · VAN404"
          },
          {
            "value": "PEO505",
            "label": "Kia Carnival people mover · 8 seats · PEO505"
          },
          {
            "value": "EVC606",
            "label": "MG4 Electric · 5 seats · EV · EVC606"
          }
        ]
      },
      {
        "id": "v-passengers",
        "name": "passengers",
        "type": "number",
        "description": "Including the driver",
        "defaultValue": "1",
        "required": true,
        "label": "People travelling"
      },
      {
        "id": "v-pickup_at",
        "name": "pickup_at",
        "type": "string",
        "description": "When you collect the car",
        "defaultValue": "",
        "required": true,
        "label": "Pick up",
        "format": "datetime"
      },
      {
        "id": "v-return_at",
        "name": "return_at",
        "type": "string",
        "description": "When the car is back in its bay",
        "defaultValue": "",
        "required": true,
        "label": "Return",
        "format": "datetime"
      },
      {
        "id": "v-destination",
        "name": "destination",
        "type": "string",
        "description": "Where you are going",
        "defaultValue": "",
        "required": true,
        "label": "Destination"
      },
      {
        "id": "v-distance_km",
        "name": "distance_km",
        "type": "number",
        "description": "Rough total distance; 300 km or more needs approval",
        "defaultValue": "50",
        "required": true,
        "label": "Return distance (km)"
      },
      {
        "id": "v-purpose",
        "name": "purpose",
        "type": "string",
        "description": "What the trip is for",
        "defaultValue": "",
