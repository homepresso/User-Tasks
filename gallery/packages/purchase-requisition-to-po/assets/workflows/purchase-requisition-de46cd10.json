      {
        "id": "approve",
        "type": "user_task",
        "label": "Approve requisition",
        "position": {
          "x": 900,
          "y": 1340
        },
        "config": {
          "task_title": "Approve {{requisition_ref}}: {{item_description}} ({{currency}} {{amount}})",
          "task_description": "<p><strong>{{quantity}} × {{item_description}}</strong> at {{currency}} {{unit_price}} = <strong>{{currency}} {{amount}}</strong> from {{supplier}} ({{category}}).</p><p>Needed by {{needed_by}}. Cost centre {{cost_centre}}. Requested by {{requester_email}}.</p><p>Justification: {{justification}}</p><p>Policy rule “{{rule_label}}”: <strong>{{approver_level}}</strong> approval, {{quotes_required}} quote(s) required. Preferred supplier: {{preferred_supplier}}.</p>",
          "task_priority": "medium",
          "outcomes": [
            "Approve",
            "Reject"
          ],
          "assignment_type": "individual",
          "assignee_id": "d2986bb6-c21e-40e0-a721-613ce3849e15",
          "assignee_variable": "{{manager_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 2,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
