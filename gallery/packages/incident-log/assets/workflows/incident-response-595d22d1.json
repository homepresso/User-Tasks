        "position": {
          "x": 360,
          "y": 2360
        },
        "config": {
          "task_title": "Senior review of escalated incident {{incident_ref}}",
          "task_description": "<p>The investigation of the {{form.incident_type}} at {{site_name}} was escalated: {{task_data.escalation_reason}}</p><p>Root cause: {{task_data.root_cause}}</p><p>Proposed actions: {{task_data.corrective_actions}}</p>",
          "task_priority": "urgent",
          "outcomes": [
            "Close"
