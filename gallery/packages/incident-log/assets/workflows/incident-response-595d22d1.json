          "form_buttons": [
            {
              "id": "close",
              "label": "Close incident",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Close"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "Escalated incident",
            "align": "left",
            "subtitle": "{{incident_ref}} · {{site_name}}"
          },
          "due_date_mode": "relative",
          "due_offset_amount": 2,
          "due_offset_unit": "days",
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 1440
        }
      },
      {
        "id": "close2",
        "type": "update_data_table",
        "label": "Close after review",
        "position": {
          "x": 360,
          "y": 2520
        },
        "config": {
          "table_id": "87911136-89dc-51e8-b9d8-b7af1780b37c",
          "table_name": "Incidents",
          "operation": "update",
          "match_column": "incident_ref",
          "match_value": "{{incident_ref}}",
          "column_values": {
            "status": "Closed",
