{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "595d22d1-3b8b-53cc-879e-fbb6c9b97f84",
  "asset": {
    "id": "595d22d1-3b8b-53cc-879e-fbb6c9b97f84",
    "name": "Incident response",
    "description": "An incident report from the form: rated by the severity decision table, logged in the register under a 7-year retention policy, the site manager emailed, and investigated against an SLA when needed.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
        "label": "Incident reported",
        "position": {
          "x": 400,
          "y": 60
        },
        "config": {
          "form_id": "35fe982c-2df3-5325-bfd9-d8eb8ef711ee",
          "form_name": "Report a workplace incident"
        }
      },
      {
        "id": "ref",
        "type": "set_variable",
        "label": "Incident reference",
        "position": {
          "x": 400,
          "y": 200
        },
        "config": {
          "name": "incident_ref",
          "expression": "INC-{{=FORMAT_DATE(NOW(), \"YYYYMMDD\")}}-{{=UPPER(LEFT(GUID(), 4))}}"
        }
      },
      {
        "id": "site",
        "type": "update_data_table",
        "label": "Read the site",
        "position": {
          "x": 400,
          "y": 340
        },
        "config": {
          "table_id": "6e0dcd36-3cbf-5554-84c6-106e05a4fb99",
          "table_name": "Incident sites",
          "operation": "get",
          "match_column": "site_code",
          "match_value": "{{form.site}}",
          "output_row_var": "site_row"
        }
      },
      {
        "id": "sname",
        "type": "set_variable",
        "label": "Site name",
        "position": {
          "x": 400,
          "y": 480
        },
        "config": {
          "name": "site_name",
          "expression": "{{site_row.name}}"
        }
      },
      {
        "id": "smgr",
        "type": "set_variable",
        "label": "Site manager",
        "position": {
          "x": 400,
          "y": 620
        },
        "config": {
          "name": "site_manager",
          "expression": "{{site_row.site_manager}}"
        }
      },
      {
        "id": "rate",
        "type": "decision_table",
        "label": "Rate the incident",
        "position": {
          "x": 400,
          "y": 760
        },
        "config": {
          "decision_table_id": "d569c815-a21d-5360-b730-fc2a34bd946b",
          "decision_table_name": "Incident severity",
          "input_mappings": {
            "injury_level": "{{form.injury_level}}",
            "incident_type": "{{form.incident_type}}"
          }
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 400,
          "y": 900
        },
        "config": {
          "title": "[{{severity}}] {{form.incident_type}} at {{site_name}} ({{incident_ref}})"
        }
      },
      {
        "id": "sla",
        "type": "set_sla",
        "label": "Response SLA",
        "position": {
          "x": 400,
          "y": 1040
        },
        "config": {
          "sla_label": "Incident response",
          "mode": "relative",
          "amount": "{{sla_hours}}",
          "unit": "hours",
          "warning_amount": "{{=ROUND(sla_hours * 0.75, 0)}}",
          "warning_unit": "hours"
        }
      },
      {
        "id": "due",
        "type": "set_variable",
        "label": "Respond by",
        "position": {
          "x": 400,
          "y": 1180
        },
        "config": {
          "name": "respond_by",
          "expression": "{{=ADD_HOURS(NOW(), sla_hours)}}"
        }
      },
      {
        "id": "log",
        "type": "update_data_table",
        "label": "Add to the register",
        "position": {
          "x": 400,
          "y": 1320
        },
        "config": {
          "table_id": "87911136-89dc-51e8-b9d8-b7af1780b37c",
          "table_name": "Incidents",
          "operation": "insert",
          "apply_retention_policy": true,
          "retention_policy_id": "b8085040-da62-5024-945f-becf2e47c72c",
          "column_values": {
            "incident_ref": "{{incident_ref}}",
            "reported_on": "{{=TODAY()}}",
            "occurred_at": "{{form.occurred_at}}",
            "site_code": "{{form.site}}",
            "site_name": "{{site_name}}",
            "location_detail": "{{form.location_detail}}",
            "incident_type": "{{form.incident_type}}",
            "injury_level": "{{form.injury_level}}",
            "severity": "{{severity}}",
            "sla_hours": "{{sla_hours}}",
            "investigation_required": "{{investigation_required}}",
            "notifiable": "{{notifiable}}",
            "reporter_name": "{{form.reporter_name}}",
            "reporter_email": "{{form.reporter_email}}",
            "description": "{{form.description}}",
            "immediate_action": "{{form.immediate_action}}",
            "status": "Open"
          }
        }
      },
      {
        "id": "tell",
        "type": "send_email",
        "label": "Email the site manager",
        "position": {
          "x": 400,
          "y": 1460
        },
        "config": {
          "to": "{{site_row.site_manager_email}}",
          "email_template_id": "b0d2deb8-6737-563e-b289-3aca4afa074a"
        },
        "onError": "continue"
      },
      {
        "id": "need",
        "type": "condition",
        "label": "Investigation needed?",
        "position": {
          "x": 400,
          "y": 1600
        },
        "config": {
          "branches": [
            {
              "label": "Investigate",
              "logic": "and",
              "rules": [
                {
                  "field": "{{investigation_required}}",
                  "operator": "is_true",
                  "value": ""
                }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "inv_status",
        "type": "update_data_table",
        "label": "Mark investigating",
        "position": {
          "x": 200,
          "y": 1740
        },
        "config": {
          "table_id": "87911136-89dc-51e8-b9d8-b7af1780b37c",
          "table_name": "Incidents",
          "operation": "update",
          "match_column": "incident_ref",
          "match_value": "{{incident_ref}}",
          "column_values": {
            "status": "Investigating"
          }
        }
      },
      {
        "id": "investigate",
        "type": "user_task",
        "label": "Investigate the incident",
        "position": {
          "x": 200,
          "y": 1880
        },
        "config": {
          "task_title": "Investigate {{incident_ref}}: {{form.incident_type}} at {{site_name}} [{{severity}}]",
          "task_description": "<p><strong>{{form.incident_type}}</strong> ({{form.injury_level}} injury) at <strong>{{site_name}}</strong>, {{form.location_detail}}, on {{form.occurred_at}}. Reported by {{form.reporter_name}}; people involved: {{form.people_involved}}; witnesses: {{form.witnesses}}.</p><p>{{form.description}}</p><p>Immediate action: {{form.immediate_action}}</p><p>Severity <strong>{{severity}}</strong>, respond within {{sla_hours}} hours.{{=IF(notifiable, \" This may be notifiable to the regulator: check and notify without delay.\", \"\")}}</p>",
          "task_priority": "high",
          "outcomes": [
            "Close",
            "Escalate"
          ],
          "assignment_type": "individual",
          "assignee_variable": "{{workflow_owner_id}}",
          "fields": [
            {
              "key": "h",
              "label": "Findings",
              "type": "heading"
            },
            {
              "key": "root_cause",
              "label": "Root cause",
              "type": "textarea",
              "required": true
            },
            {
              "key": "contributing",
              "label": "Contributing factors",
              "type": "multi_choice",
              "options": [
                "Procedure",
                "Training",
                "Equipment",
                "Environment",
                "Supervision",
                "Fatigue",
                "Other"
              ]
            },
            {
              "key": "corrective_actions",
              "label": "Corrective actions",
              "type": "textarea",
              "required": true
            },
            {
              "key": "action_owner",
              "label": "Action owner",
              "type": "text"
            },
            {
              "key": "action_due",
              "label": "Actions due",
              "type": "date"
            },
            {
              "key": "regulator_notified",
              "label": "Regulator notified (if required)",
              "type": "boolean"
            },
            {
              "key": "escalation_reason",
              "label": "Why escalate? (for Escalate)",
              "type": "textarea"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "h",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "root_cause",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "contributing",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "corrective_actions",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "action_owner",
                    "span": 1
                  },
                  {
                    "field_key": "action_due",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "regulator_notified",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "escalation_reason",
                    "span": 2
                  }
                ]
              }
            ]
          },
          "form_buttons": [
            {
              "id": "close",
              "label": "Close investigation",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Close"
            },
            {
              "id": "escalate",
              "label": "Escalate",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Escalate"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "Incident investigation",
            "align": "left",
            "subtitle": "{{incident_ref}} · {{severity}} · {{site_name}}"
          },
          "due_date_mode": "absolute",
          "due_date": "{{respond_by}}",
          "reminders": [
            {
              "offset_minutes": 240
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 1440,
          "form_theme": {
            "source": "custom",
            "overrides": {
              "colors": {
                "light": {
                  "accent": "#C2410C",
                  "background": "#FFFFFF",
                  "text": "#1B1916"
                }
              },
              "radius": 8,
              "density": "comfortable",
              "button_placement": "right"
            }
          }
        }
