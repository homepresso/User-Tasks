    "name": "Report a workplace incident",
    "description": "Report an injury, near miss, property damage or environmental incident. Anyone can use it; it takes about two minutes.",
    "tags": [
      "health and safety",
      "incidents"
    ],
    "fields": [
      {
        "key": "h_where",
        "label": "Where and when",
        "type": "heading"
      },
      {
        "key": "site",
        "label": "Site",
        "type": "lookup",
        "required": true,
        "lookup": {
          "source": "table",
          "table_id": "6e0dcd36-3cbf-5554-84c6-106e05a4fb99",
          "search_columns": [
            "name",
            "site_code",
            "region"
          ],
          "display_columns": [
            "name",
            "region"
          ],
          "value_column": "site_code",
          "fill": [
            {
              "from": "site_manager",
              "to": "site_manager"
            },
            {
              "from": "site_manager_email",
              "to": "site_manager_email"
            }
          ],
          "filters": [
            {
              "column": "active",
              "operator": "eq",
              "value": "true"
            }
          ],
          "sort": {
            "column": "name",
            "direction": "asc"
          }
        }
      },
      {
        "key": "occurred_at",
        "label": "When did it happen?",
        "type": "datetime",
        "required": true
      },
      {
        "key": "location_detail",
        "label": "Exact location",
        "type": "text",
        "required": true,
        "placeholder": "e.g. Loading bay 3, kitchen on level 2"
      },
      {
        "key": "site_manager",
        "label": "Site manager",
        "type": "text",
        "read_only": true
      },
      {
        "key": "site_manager_email",
        "label": "Site manager email",
        "type": "email",
        "read_only": true
      },
      {
        "key": "div1",
        "label": "Divider",
        "type": "divider"
      },
      {
        "key": "h_what",
        "label": "What happened",
        "type": "heading"
      },
      {
        "key": "incident_type",
        "label": "Type of incident",
        "type": "choice",
        "required": true,
        "options": [
          "Injury",
          "Near miss",
          "Property damage",
          "Environmental",
          "Vehicle",
          "Security",
          "Other"
        ]
      },
      {
        "key": "injury_level",
        "label": "Worst injury",
        "type": "choice",
        "required": true,
        "options": [
          "None",
          "First aid",
          "Medical treatment",
          "Lost time",
          "Serious / hospital"
        ],
        "help_text": "Choose None for near misses and damage only."
      },
      {
        "key": "people_involved",
        "label": "People involved",
        "type": "text",
        "placeholder": "Names, or \"contractor\", \"member of the public\""
      },
      {
        "key": "witnesses",
        "label": "Witnesses",
        "type": "text"
      },
      {
        "key": "description",
        "label": "Describe what happened",
        "type": "textarea",
        "required": true,
        "help_text": "Facts only: what, how, the equipment involved."
      },
      {
        "key": "immediate_action",
        "label": "What was done straight away?",
        "type": "textarea",
        "required": true
      },
      {
        "key": "div2",
        "label": "Divider",
        "type": "divider"
      },
      {
        "key": "h_you",
        "label": "About you",
        "type": "heading"
      },
      {
        "key": "reporter_name",
