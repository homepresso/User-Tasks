        "key": "about",
        "type": "custom",
        "label": "About these results",
        "custom": {
          "tag": "ut-info-card",
          "version": "1.1.0",
          "name": "Info card",
          "value_type": "string",
          "icon": "info",
          "props": {
            "variant": "info",
            "card_title": "Pass, retake or session",
            "body": "A score at or above the course pass mark passes and gets a PDF certificate. Up to 20 points below means a retake; more than that and the training coordinator books a session.",
            "layout": "callout",
            "format": "auto",
            "show_icon": true
          },
          "display": {
            "template": "{{props.card_title}}",
            "format": "text"
          },
          "accessibility": {
            "role": "note",
            "keyboard": "Display only: nothing to operate. A note (warning and error cards are a polite status region) named by its title, with the variant read first (\"Warning: …\"); the icon is decorative.",
