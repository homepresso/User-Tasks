              "label": "Claimed",
              "type": "date",
              "sortable": true,
              "filterable": true,
              "format": {
                "kind": "date",
                "style": "medium"
              }
            },
            {
              "key": "claimant_name",
              "label": "Claimant",
              "type": "text",
