      "application_mode": true,
      "rules": [
        {
          "id": "r_open_mine",
          "name": "My claims: row clicked → details",
          "event": "row_click",
          "then": [
            {
              "type": "copy_values",
              "assign": {
                "d_ref": "{{event.row.claim_ref}}",
                "d_status": "{{event.row.status}}",
                "d_amount": "{{event.row.amount}}",
                "d_claimant": "{{event.row.claimant_name}}",
                "d_cost": "{{event.row.cost_centre}} · {{event.row.gl_code}}",
                "d_dates": "Bought {{event.row.spent_on}} · claimed {{event.row.claimed_on}} · paid {{event.row.paid_on}}",
                "d_what": "{{event.row.description}} ({{event.row.category}})",
                "d_rule": "{{event.row.route}}",
                "d_comment": "{{event.row.approver_comment}}",
                "d_receipt": "{{event.row.receipt_url}}"
              }
            },
            {
              "type": "go_to_page",
              "page": "details"
            }
          ],
          "target": "my_claims"
        },
        {
          "id": "r_open_month",
          "name": "This month: row clicked → details",
          "event": "row_click",
          "then": [
            {
              "type": "copy_values",
              "assign": {
                "d_ref": "{{event.row.claim_ref}}",
                "d_status": "{{event.row.status}}",
                "d_amount": "{{event.row.amount}}",
                "d_claimant": "{{event.row.claimant_name}}",
                "d_cost": "{{event.row.cost_centre}} · {{event.row.gl_code}}",
                "d_dates": "Bought {{event.row.spent_on}} · claimed {{event.row.claimed_on}} · paid {{event.row.paid_on}}",
                "d_what": "{{event.row.description}} ({{event.row.category}})",
                "d_rule": "{{event.row.route}}",
                "d_comment": "{{event.row.approver_comment}}",
                "d_receipt": "{{event.row.receipt_url}}"
              }
            },
            {
              "type": "go_to_page",
              "page": "details"
            }
          ],
          "target": "month_claims"
        },
        {
          "id": "r_details_read_only",
          "name": "Details are read-only",
          "event": "always",
          "then": [
            {
              "type": "enable_disable",
              "mode": "disable",
              "targets": [
                "field:d_ref",
                "field:d_status",
                "field:d_amount",
                "field:d_claimant",
                "field:d_cost",
                "field:d_dates",
                "field:d_what",
                "field:d_rule",
                "field:d_comment",
                "field:d_receipt"
              ]
            }
          ]
        }
      ]
