  "asset": {
    "id": "3cc667b1-535a-5bd4-87a0-dae9c8b368a3",
    "name": "Petty cash claims",
    "description": "Claims from the Petty cash ledger in two Data tables: My claims (base filter: the claimant is you) and This month (base filter: claimed since the start of the month), with NZD amounts, dates, status badges and receipt links, search, filters and sorting on the server. Click a claim to open its details tab.",
    "tags": [
      "petty cash",
      "expenses",
      "register"
    ],
    "fields": [
      {
        "key": "mine_intro",
        "label": "Your claims, newest first. Click one for the details.",
        "type": "heading"
      },
      {
        "key": "my_claims",
        "label": "My claims",
        "type": "data_table",
