              "sortable": true,
              "filterable": true,
              "format": {
                "kind": "currency",
                "currency": "NZD",
                "decimals": 2
              }
            },
            {
              "key": "status",
              "label": "Status",
              "type": "choice",
              "sortable": true,
              "filterable": true,
              "options": [
                "Awaiting approval",
                "Approved",
                "Paid",
                "Rejected"
              ],
              "format": {
                "kind": "badge",
                "badges": [
                  {
                    "value": "Awaiting approval",
                    "color": "amber"
                  },
                  {
                    "value": "Approved",
                    "color": "blue"
                  },
                  {
                    "value": "Paid",
                    "color": "green"
                  },
                  {
                    "value": "Rejected",
                    "color": "red"
                  }
                ],
                "default_color": "gray"
