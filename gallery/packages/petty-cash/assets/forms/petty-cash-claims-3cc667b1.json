            {
              "key": "paid_on",
              "label": "Paid",
              "type": "date",
              "hidden": true
            },
            {
              "key": "spent_on",
              "label": "Bought",
              "type": "date",
              "hidden": true
            }
          ],
          "base_filter": {
            "match": "all",
            "conditions": [
              {
                "column": "claimant_email",
                "operator": "eq",
                "value": "{{user.email}}"
              }
            ]
          },
          "sort": [
            {
              "column": "claimed_on",
              "direction": "desc"
            }
          ],
          "page_size": 10
