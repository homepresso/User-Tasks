{
  "format_version": 3,
  "asset_type": "forms",
  "id": "6755460d-7e72-57f6-be5b-f4eb5afd67b8",
  "asset": {
    "id": "6755460d-7e72-57f6-be5b-f4eb5afd67b8",
    "name": "Petty cash claim",
    "description": "The claim form employees open from Forms (or its /f/ link): two steps with a numbered stepper (You & cost centre → The purchase & receipt) in Application mode, with in-form Next / Back / Submit claim buttons. The cost centre autocomplete stores the code and shows \"Name (code)\", and fills the budget holder and GL account; rules ask for a receipt over NZD 20 and refuse a future purchase date. Submit claim starts the Petty cash claim workflow and shows a success screen.",
    "tags": [
      "finance",
      "petty cash"
    ],
    "fields": [
      {
        "key": "h_you",
        "label": "Who is claiming",
        "type": "heading"
      },
      {
        "key": "claimant_name",
        "label": "Your name",
        "type": "text",
        "required": true
      },
      {
        "key": "claimant_email",
        "label": "Work email",
        "type": "email",
        "required": true
      },
      {
        "key": "h_cost",
        "label": "Charge it to",
        "type": "heading"
      },
      {
        "key": "cost_centre",
        "label": "Cost centre",
        "type": "lookup",
        "required": true,
        "help_text": "Search by name or code",
        "lookup": {
          "source": "table",
          "table_id": "c05c6b36-1d8e-5009-8968-9eb90f252379",
          "search_columns": [
            "name",
            "code"
          ],
          "display_columns": [
            "name",
            "code",
            "budget_holder"
          ],
          "value_column": "code",
          "fill": [
            {
              "from": "budget_holder",
              "to": "budget_holder_name"
            },
            {
              "from": "gl_code",
              "to": "gl_code"
            }
          ],
          "filters": [
            {
              "column": "active",
              "operator": "eq",
              "value": "true"
            }
          ],
          "sort": {
            "column": "code",
            "direction": "asc"
          },
          "label_template": "{{name}} ({{code}})",
          "description_template": "Budget holder: {{budget_holder}}",
          "search_value": true
        }
      },
      {
        "key": "budget_holder_name",
        "label": "Budget holder",
        "type": "text",
        "read_only": true
      },
      {
        "key": "gl_code",
        "label": "GL account",
        "type": "text",
        "read_only": true
      },
      {
        "key": "approver",
        "label": "Approver",
        "type": "user",
        "required": true,
        "help_text": "Pick the budget holder shown above; they approve the claim."
      },
      {
        "key": "h_what",
        "label": "The purchase",
        "type": "heading"
      },
      {
        "key": "amount",
        "label": "Amount",
        "type": "currency",
        "required": true,
        "currency": "NZD",
        "min": 0.5,
        "max": 250,
        "help_text": "Up to NZD 250. Larger amounts go through expense claims."
      },
      {
        "key": "spent_on",
        "label": "Date of purchase",
        "type": "date",
        "required": true
      },
      {
        "key": "category",
        "label": "Category",
        "type": "choice",
        "required": true,
        "options": [
          "Office supplies",
          "Kitchen & hospitality",
          "Postage & courier",
          "Taxi & parking",
          "Small equipment",
          "Staff welfare",
          "Other"
        ]
      },
      {
        "key": "description",
        "label": "What did you buy and why?",
        "type": "textarea",
        "required": true
      },
      {
        "key": "receipt_url",
        "label": "Receipt",
        "type": "url",
        "help_text": "Link to a photo or scan of the receipt. Needed for anything over NZD 20."
      },
      {
        "key": "who_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "purchase_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "receipt_submit",
        "label": "Submit claim",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "submit",
              "button": "submit"
            }
          ],
          "icon": "send",
          "align": "right",
          "icon_after": true
        }
      }
    ],
    "layout": {
      "rows": [],
      "mode": "steps",
      "pages": [
        {
          "id": "who",
          "title": "You & cost centre",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "h_you",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "claimant_name",
                  "span": 1
                },
                {
                  "field_key": "claimant_email",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "h_cost",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "cost_centre",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "budget_holder_name",
                  "span": 1
                },
                {
                  "field_key": "gl_code",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "approver",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "who_next",
                  "span": 2
                }
              ]
            }
          ],
          "icon": "user",
          "description": "Who is claiming and which budget pays."
        },
        {
          "id": "purchase",
          "title": "The purchase & receipt",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "h_what",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "amount",
                  "span": 1
                },
                {
                  "field_key": "spent_on",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "category",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "description",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "receipt_url",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "purchase_back",
                  "span": 1
                },
                {
                  "field_key": "receipt_submit",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "shopping-cart",
          "description": "What you bought, when, how much, and the receipt."
        }
      ],
      "page_settings": {
        "indicator": "numbered",
        "next_label": "Next",
        "back_label": "Back"
      },
      "application_mode": true,
      "rules": [
        {
          "id": "r_receipt",
          "name": "A receipt for anything over NZD 20",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "receipt_url",
              "text": "Add the receipt: claims over NZD 20 need one."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "amount",
                "operator": "gt",
                "value": "20"
              },
              {
                "column": "receipt_url",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_not_future",
          "name": "The purchase is not in the future",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "spent_on",
              "text": "The date of purchase cannot be in the future."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "spent_on",
                "operator": "is_set"
              },
              {
                "column": "spent_on",
                "operator": "gt",
                "value": "{{today}}"
              }
            ]
          }
        },
        {
          "id": "r_holder",
          "name": "Suggest the budget holder as approver",
          "event": "item_select",
          "then": [
            {
              "type": "message",
              "text": "Pick {{event.item.fields.budget_holder}} as the approver: they hold this budget."
            }
          ],
          "target": "cost_centre"
        }
      ]
    },
    "theme": {
      "source": "custom",
      "overrides": {
        "colors": {
          "light": {
            "accent": "#15803D",
            "background": "#FFFFFF",
            "text": "#0F2A1A",
            "page": "#ECFDF3",
            "page_to": "#F7FEF9"
          }
        },
        "radius": 12,
        "density": "comfortable",
        "button_placement": "right",
        "font": {
          "source": "google",
          "family": "Inter"
        }
      }
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Submit claim",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "start_workflow",
            "workflow_id": "e4361734-9d71-5aba-ab8a-6e3fefe6af77",
            "workflow_name": "Petty cash claim",
            "inputs": {
              "claimant_name": "{{claimant_name}}",
              "claimant_email": "{{claimant_email}}",
              "cost_centre": "{{cost_centre}}",
              "approver": "{{approver}}",
              "amount": "{{amount}}",
              "category": "{{category}}",
              "spent_on": "{{spent_on}}",
              "description": "{{description}}",
              "receipt_url": "{{receipt_url}}"
            }
          },
          {
            "type": "success_screen",
            "title": "Claim submitted",
            "screen_button": "submit_another",
            "text": "Thanks {{claimant_name}}. Your claim of NZD {{amount}} is on its way to {{budget_holder_name}}. Reference: {{run_reference}}.",
            "screen_button_label": "Submit another claim"
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "Petty cash claim",
      "align": "left",
      "subtitle": "Small purchases paid from your own pocket, back to you within a few days."
    }
  }
}
