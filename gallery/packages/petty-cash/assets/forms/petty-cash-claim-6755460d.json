  "asset": {
    "id": "6755460d-7e72-57f6-be5b-f4eb5afd67b8",
    "name": "Petty cash claim",
    "description": "Claim back small purchases (up to NZD 250) paid from your own pocket. Attach a link to the receipt.",
    "tags": [
      "finance",
      "petty cash"
    ],
    "fields": [
      {
        "key": "h_you",
        "label": "Who is claiming",
        "type": "heading"
      },
      {
        "key": "claimant_name",
        "label": "Your name",
        "type": "text",
        "required": true
      },
      {
        "key": "claimant_email",
        "label": "Work email",
        "type": "email",
        "required": true
      },
      {
        "key": "div1",
        "label": "Divider",
        "type": "divider"
      },
      {
        "key": "h_cost",
        "label": "Charge it to",
        "type": "heading"
      },
      {
        "key": "cost_centre",
        "label": "Cost centre",
        "type": "lookup",
        "required": true,
        "help_text": "Search by name or code",
        "lookup": {
          "source": "table",
          "table_id": "c05c6b36-1d8e-5009-8968-9eb90f252379",
          "search_columns": [
            "name",
            "code"
          ],
          "display_columns": [
            "name",
            "code",
            "budget_holder"
          ],
          "value_column": "code",
          "fill": [
            {
              "from": "budget_holder",
              "to": "budget_holder_name"
            },
            {
              "from": "gl_code",
              "to": "gl_code"
            }
          ],
          "filters": [
            {
              "column": "active",
              "operator": "eq",
              "value": "true"
            }
          ],
          "sort": {
            "column": "code",
            "direction": "asc"
          }
        }
      },
      {
        "key": "budget_holder_name",
        "label": "Budget holder",
        "type": "text",
        "read_only": true
      },
      {
        "key": "gl_code",
        "label": "GL account",
        "type": "text",
        "read_only": true
      },
      {
        "key": "approver",
        "label": "Approver",
        "type": "user",
        "required": true,
        "help_text": "Pick the budget holder shown above; they approve the claim."
      },
      {
        "key": "div2",
        "label": "Divider",
        "type": "divider"
      },
      {
        "key": "h_what",
        "label": "The purchase",
        "type": "heading"
      },
      {
        "key": "amount",
        "label": "Amount",
        "type": "currency",
        "required": true,
        "currency": "NZD",
        "min": 0.5,
        "max": 250,
        "help_text": "Up to NZD 250. Larger amounts go through expense claims."
      },
      {
        "key": "spent_on",
        "label": "Date of purchase",
        "type": "date",
        "required": true
      },
      {
        "key": "category",
        "label": "Category",
        "type": "choice",
        "required": true,
        "options": [
          "Office supplies",
          "Kitchen & hospitality",
          "Postage & courier",
          "Taxi & parking",
          "Small equipment",
          "Staff welfare",
          "Other"
        ]
      },
      {
        "key": "description",
        "label": "What did you buy and why?",
        "type": "textarea",
        "required": true
      },
      {
        "key": "receipt_url",
        "label": "Receipt",
        "type": "url",
        "help_text": "Link to a photo or scan of the receipt. Needed for anything over NZD 20."
      }
    ],
