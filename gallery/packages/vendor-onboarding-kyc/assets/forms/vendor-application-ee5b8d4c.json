              ]
            },
            {
              "columns": 3,
              "cells": [
                {
                  "field_key": "declaration",
                  "span": 3
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "review_back",
                  "span": 1
                },
                {
                  "field_key": "review_submit",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "check-circle",
          "description": "Confirm and send the application."
        }
      ],
      "page_settings": {
        "indicator": "progress",
        "next_label": "Next",
        "back_label": "Back",
        "resume": true
      },
      "application_mode": true,
      "rules": [
        {
          "id": "r_spend_hide",
          "name": "Justification only for NZD 100,000 or more",
          "event": "always",
          "then": [
            {
              "type": "show_hide",
              "mode": "hide",
              "targets": [
                "field:spend_justification"
              ]
            }
          ],
          "if": {
            "match": "any",
            "conditions": [
              {
                "column": "expected_annual_spend",
                "operator": "lt",
                "value": "100000"
              },
              {
                "column": "expected_annual_spend",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_spend_required",
          "name": "Large spend needs a justification",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "spend_justification",
              "text": "Explain why this vendor: spend of NZD 100,000 or more needs a justification."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "expected_annual_spend",
                "operator": "gte",
                "value": "100000"
              },
              {
                "column": "spend_justification",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_conflict_required",
          "name": "A declared interest needs details",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "conflict_details",
              "text": "Describe the interest so compliance can assess it."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "conflict_of_interest",
                "operator": "eq",
                "value": "true"
              },
              {
                "column": "conflict_details",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_contact_not_requester",
          "name": "The vendor contact is not you",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "contact_email",
              "text": "Use the vendor's own accounts contact, not your email."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "contact_email",
                "operator": "is_set"
              },
              {
                "column": "contact_email",
                "operator": "eq",
                "value": "{{requester_email}}"
              }
            ]
          }
        },
        {
          "id": "r_country_note",
          "name": "Tell people when compliance review is likely",
          "event": "item_select",
          "then": [
            {
              "type": "message",
              "text": "Vendors registered in medium or high risk countries go to a compliance review before the bank check."
            }
          ],
          "target": "country",
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "event.item.fields.risk_rating",
                "operator": "neq",
                "value": "low"
              }
            ]
          }
        }
      ]
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Submit application",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "start_workflow",
            "workflow_id": "633cff3d-656f-4eb7-85a8-ca74f2b6e1d2",
            "workflow_name": "Vendor onboarding",
            "inputs": {
              "legal_name": "{{legal_name}}",
              "registration_number": "{{registration_number}}",
              "country": "{{country}}",
              "website": "{{website}}",
              "iban": "{{iban}}",
              "contact_email": "{{contact_email}}",
              "contact_phone": "{{contact_phone}}",
              "spend_category": "{{spend_category}}",
              "expected_annual_spend": "{{expected_annual_spend}}",
              "requester_email": "{{requester_email}}",
              "spend_justification": "{{spend_justification}}",
              "conflict_of_interest": "{{conflict_of_interest}}",
              "conflict_details": "{{conflict_details}}",
              "declaration": "{{declaration}}"
            }
          },
          {
            "type": "success_screen",
            "title": "Application sent",
            "screen_button": "submit_another",
            "screen_button_label": "Onboard another vendor",
            "text": "{{legal_name}} is being screened (reference {{run_reference}}). Compliance and finance pick it up from here; the outcome goes to {{requester_email}}."
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "theme": {
