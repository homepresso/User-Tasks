            "text": "#1B1916",
            "page": "#ECF6EF",
            "page_to": "#F7FBF8"
          }
        },
        "radius": 12,
        "density": "comfortable",
        "button_placement": "right",
        "header": {
          "enabled": true,
          "title": "Vendor application",
          "subtitle": "Four short steps. Bank details are always verified by a call-back before the vendor is created."
        }
      }
    },
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "Vendor application",
      "align": "left",
      "subtitle": "Four short steps. Bank details are always verified by a call-back before the vendor is created."
    }
  }
}
