                "display": {
                  "format": "json"
                },
                "accessibility": {
                  "role": "grid",
                  "keyboard": "Tab into the table (one stop). Arrow keys move between cells, Home / End to the row's ends (Ctrl+Home / End to the table's), Enter, F2 or typing edits a cell; Enter saves and moves down, Shift+Enter up, Escape cancels; Tab / Shift+Tab move cell by cell and leave the table at its ends. Delete clears a cell, Space or Enter toggles a tick box, Ctrl+Enter adds a row; each row's Delete row button is the last cell of the row.",
                  "labelled_by_host": true
                },
                "size": {
                  "default_height": 240,
                  "min_height": 120,
                  "max_height": 1200,
                  "full_width": true
                },
                "output": {
                  "type": "array",
                  "description": "The rows entered"
                }
              },
              "help_text": "Two or three concrete actions you agreed together."
            },
            {
              "key": "conversation_notes",
              "type": "custom",
              "label": "Conversation notes (shared with the employee)",
              "custom": {
                "tag": "ut-rich-text",
                "version": "1.1.0",
                "name": "Rich text",
                "value_type": "json",
                "icon": "type",
                "value_schema": {
                  "type": "object",
                  "properties": {
                    "html": {
                      "type": "string",
                      "maxLength": 100000
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 100000
                    }
                  },
                  "required": [
                    "html",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "props": {
                  "placeholder": "What did you talk about?",
                  "max_length": 4000,
                  "toolbar": "basic",
                  "min_height": 120
                },
