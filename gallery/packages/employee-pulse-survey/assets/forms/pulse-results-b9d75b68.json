    "fields": [
      {
        "key": "about",
        "type": "custom",
        "label": "How to read this page",
        "custom": {
          "tag": "ut-info-card",
          "version": "1.1.0",
          "name": "Info card",
          "value_type": "string",
          "icon": "info",
          "props": {
            "variant": "info",
            "card_title": "Engagement and eNPS",
            "body": "Engagement is the average of all Likert answers (N/A ignored) on a 0-100 scale: 1 = 0, 5 = 100. Below 50 is at risk. eNPS = % who answered 9-10 minus % who answered 0-6. Anonymous answers count in every chart but never create a personal follow-up.",
            "layout": "callout",
            "format": "auto",
            "show_icon": true
          },
          "display": {
            "template": "{{props.card_title}}",
            "format": "text"
          },
          "accessibility": {
            "role": "note",
            "keyboard": "Display only: nothing to operate. A note (warning and error cards are a polite status region) named by its title, with the variant read first (\"Warning: …\"); the icon is decorative.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 72,
            "min_height": 32,
            "max_height": 800,
            "full_width": true
          },
          "output": {
            "type": "string",
            "description": "Display only: stays empty"
          }
        }
