  "asset": {
    "id": "2c34a291-69d5-5afc-8877-9972dc60ca63",
    "name": "Employee pulse survey",
    "description": "The monthly pulse survey page: four short Likert sections (wellbeing, manager & team, growth, workload), an eNPS slider, a mood rating, the department, an anonymous option and one thing to change. Each answer starts the Pulse response workflow.",
    "tags": [
      "survey",
      "engagement",
      "pulse"
    ],
    "fields": [
      {
        "key": "wellbeing",
        "type": "custom",
        "label": "Wellbeing: how much do you agree?",
        "custom": {
          "tag": "ut-likert",
          "version": "1.1.0",
          "name": "Likert scale",
          "value_type": "json",
          "icon": "list-checks",
          "value_schema": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "props": {
            "statements": [
              "I feel energised by my work most days",
              "I can switch off from work when I need to",
              "I feel supported when things get stressful",
              "I feel valued for the work I do"
            ],
            "scale": "agree5",
            "show_na": true,
            "all_required": true
          },
          "display": {
            "format": "json"
          },
          "accessibility": {
            "role": "radiogroup",
            "keyboard": "Each statement is a radio group with one Tab stop: Tab / Shift+Tab move between statements, the arrow keys choose within a statement (Home / End jump to the ends), Space or Enter chooses the focused point, Delete clears the statement's answer.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 246,
            "min_height": 80,
            "max_height": 2000,
            "full_width": true
          },
          "output": {
            "type": "object",
            "description": "One number per statement (0 = N/A), keyed by the statement"
          }
        },
        "required": true
      },
