      {
        "key": "enps",
        "type": "custom",
        "label": "How likely are you to recommend working here to a friend?",
        "custom": {
          "tag": "ut-slider",
          "version": "1.1.0",
          "name": "Slider",
          "value_type": "number",
          "icon": "sliders",
          "value_schema": {
            "type": "number"
          },
          "props": {
            "min": 0,
            "max": 10,
            "step": 1,
            "show_value": true,
            "marks": [
              "0 Not at all likely",
              "5",
              "10 Extremely likely"
            ],
            "show_input": false
          },
          "display": {
            "template": "{{value}}",
            "format": "text"
          },
          "accessibility": {
            "role": "slider",
            "keyboard": "Tab to the slider; Left / Right (or Up / Down) move one step, Page Up / Page Down move further, Home / End jump to the minimum / maximum. Enter or Space accepts the starting position while the field is still empty. With the number box, Tab again to type an exact value.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 87,
            "min_height": 48,
            "max_height": 120
          },
          "output": {
            "type": "number",
            "description": "The value chosen"
          }
        },
        "required": true,
        "help_text": "0 = not at all likely, 10 = extremely likely."
      },
      {
        "key": "mood",
        "type": "custom",
        "label": "Overall, how are you feeling about work this month?",
        "custom": {
          "tag": "ut-rating",
          "version": "1.1.0",
          "name": "Rating",
          "value_type": "number",
          "icon": "star",
          "value_schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "props": {
            "max": 5,
            "symbol": "heart",
            "size": "large",
            "labels": [
              "Really low",
              "Low",
              "OK",
              "Good",
              "Great"
            ],
            "allow_clear": false
          },
          "display": {
            "template": "{{value}} of {{props.max}}",
            "format": "text"
          },
          "accessibility": {
            "role": "radiogroup",
            "keyboard": "Tab to the rating; Left / Right (or Up / Down) change it; Home / End jump to the lowest / highest; Delete or Backspace clears it when clearing is allowed.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 52,
            "min_height": 36,
            "max_height": 120
          },
          "output": {
            "type": "number",
            "description": "The rating (1 to the maximum)"
          }
        },
        "required": true
      },
      {
        "key": "department",
        "label": "Your department",
        "type": "choice",
        "required": true,
        "options": [
          "Operations",
          "Sales",
          "Engineering",
          "Customer support",
          "Finance",
          "People & culture"
        ]
      },
      {
        "key": "anonymous",
        "label": "Answer anonymously",
        "type": "boolean",
        "help_text": "Your name is not stored with your answers and nobody is asked to follow up with you. Results are only shown by department."
      },
      {
        "key": "manager",
        "label": "Your manager",
        "type": "user",
        "visible_when": {
          "field": "anonymous",
          "operator": "not_equals",
          "value": "true"
        },
        "help_text": "Optional. If your answers show you are struggling, your manager gets a private follow-up task."
      },
      {
        "key": "change",
        "type": "custom",
        "label": "One thing we should change",
        "custom": {
          "tag": "ut-rich-text",
          "version": "1.1.0",
          "name": "Rich text",
          "value_type": "json",
          "icon": "type",
          "value_schema": {
            "type": "object",
            "properties": {
              "html": {
                "type": "string",
                "maxLength": 100000
              },
              "text": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "html",
              "text"
            ],
            "additionalProperties": false
          },
          "props": {
            "placeholder": "If you could change one thing about working here, what would it be?",
            "max_length": 2000,
            "toolbar": "basic",
            "min_height": 140
          },
          "display": {
            "template": "{{value.text}}",
            "format": "text"
          },
          "accessibility": {
            "role": "textbox",
            "keyboard": "Tab to the formatting toolbar (Left / Right / Home / End move between buttons, Enter or Space applies one), Tab again to the text. In the text: Ctrl/Cmd+B, I, U for bold, italic, underline; Ctrl/Cmd+K adds a link (Enter applies, Escape cancels); Ctrl/Cmd+Z undoes, Ctrl/Cmd+Shift+Z redoes.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 216,
            "min_height": 120,
            "max_height": 900,
            "full_width": true
          },
          "output": {
            "type": "string",
            "primary": "html",
            "html": true,
            "extras": {
              "text": "text"
            },
            "choices": [
              {
                "value": "html",
                "label": "HTML (formatted, sanitised)",
                "primary": "html",
                "html": true
              },
              {
                "value": "text",
                "label": "Plain text",
                "primary": "text"
              }
            ],
            "description": "The text as sanitised HTML (or plain text, as the form chooses); <key>_text is always the plain text"
          }
        }
      }
    ],
