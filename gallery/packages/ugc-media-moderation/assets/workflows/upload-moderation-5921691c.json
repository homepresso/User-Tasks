      }
    ],
    "user_variables": [
      {
        "id": "v-upload_id",
        "name": "upload_id",
        "type": "string",
        "description": "The id of the upload in your platform",
        "defaultValue": "",
        "required": true,
        "label": "Upload id"
      },
      {
        "id": "v-media_url",
        "name": "media_url",
        "type": "string",
        "description": "Where the image or video can be downloaded (signed URL)",
        "defaultValue": "",
        "required": true,
        "label": "Media URL",
        "format": "url"
      },
      {
        "id": "v-media_type",
        "name": "media_type",
        "type": "string",
        "description": "image or video",
        "defaultValue": "",
        "required": true,
        "label": "Media type",
        "options": [
          "image",
          "video"
        ]
      },
      {
        "id": "v-uploader_email",
        "name": "uploader_email",
        "type": "string",
        "description": "Who to tell about the decision",
        "defaultValue": "",
        "required": false,
        "label": "Uploader email",
        "format": "email"
      },
      {
        "id": "v-uploader_name",
        "name": "uploader_name",
        "type": "string",
        "description": "Shown in the emails",
        "defaultValue": "",
        "required": false,
        "label": "Uploader name"
      },
      {
        "id": "v-caption",
        "name": "caption",
        "type": "string",
        "description": "The caption or title the uploader gave",
        "defaultValue": "",
        "required": false,
        "label": "Caption"
      },
      {
        "id": "v-channel",
        "name": "channel",
        "type": "string",
        "description": "Where it was uploaded (community, reviews, profile …)",
        "defaultValue": "",
        "required": false,
        "label": "Channel"
      }
