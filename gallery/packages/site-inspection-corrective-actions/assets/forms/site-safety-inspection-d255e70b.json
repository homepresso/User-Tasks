  "id": "d255e70b-9ea0-5d64-a2a6-c429ba3f40a5",
  "asset": {
    "id": "d255e70b-9ea0-5d64-a2a6-c429ba3f40a5",
    "name": "Site safety inspection",
    "description": "The inspector's form: pick the site (the manager, address and risk class fill in), work through the checklist table (Pass / Fail / N/A with a severity for each failure), rate the site, add photos and sign. Each submission starts the Site inspection workflow.",
    "tags": [
      "inspection",
      "health and safety",
      "checklist"
    ],
    "fields": [
      {
        "key": "site",
        "label": "Site",
        "type": "lookup",
        "required": true,
        "help_text": "Start typing a site name or code.",
        "lookup": {
          "source": "table",
          "table_id": "61e0ee2e-2884-53bb-8a02-221ea58ac3a0",
          "search_columns": [
            "name",
            "site_code",
            "address"
          ],
          "display_columns": [
            "name",
            "address",
            "risk_class"
          ],
          "value_column": "site_code",
          "fill": [
            {
              "from": "name",
              "to": "site_name"
            },
            {
              "from": "site_manager",
              "to": "site_manager"
            },
            {
              "from": "site_manager_email",
              "to": "site_manager_email"
            },
            {
              "from": "address",
              "to": "site_address"
            },
            {
              "from": "risk_class",
              "to": "risk_class"
            }
          ],
          "sort": {
            "column": "name",
            "direction": "asc"
          }
        }
      },
      {
        "key": "site_name",
        "label": "Site name",
        "type": "text",
        "read_only": true
      },
      {
        "key": "site_address",
        "label": "Address",
        "type": "text",
        "read_only": true
      },
      {
        "key": "site_manager",
        "label": "Site manager",
        "type": "text",
        "read_only": true
      },
      {
        "key": "site_manager_email",
        "label": "Site manager email",
        "type": "email",
        "read_only": true
      },
      {
        "key": "risk_class",
        "label": "Risk class",
        "type": "text",
        "read_only": true
      },
      {
