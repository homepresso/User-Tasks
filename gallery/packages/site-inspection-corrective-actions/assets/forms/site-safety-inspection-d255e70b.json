                "area": "Electrical",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "Machine guards fitted and working",
                "area": "Equipment",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "Required PPE available and worn",
                "area": "PPE",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "Chemicals labelled, safety data sheets on hand",
                "area": "Hazardous substances",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "First aid kit stocked, first aiders listed",
                "area": "First aid",
                "status": "",
                "severity": "",
                "notes": ""
              }
            ]
          },
          "display": {
            "format": "json"
          },
          "accessibility": {
            "role": "grid",
            "keyboard": "Tab into the table (one stop). Arrow keys move between cells, Home / End to the row's ends (Ctrl+Home / End to the table's), Enter, F2 or typing edits a cell; Enter saves and moves down, Shift+Enter up, Escape cancels; Tab / Shift+Tab move cell by cell and leave the table at its ends. Delete clears a cell, Space or Enter toggles a tick box, Ctrl+Enter adds a row; each row's Delete row button is the last cell of the row.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 240,
            "min_height": 120,
            "max_height": 1200,
            "full_width": true
          },
          "output": {
            "type": "array",
            "description": "The rows entered"
          }
        },
        "required": true,
        "help_text": "Mark every item Pass, Fail or N/A. For a failure, pick a severity and note what you found: each one becomes a corrective action. Add rows for site-specific checks."
      },
      {
        "key": "site_condition",
        "type": "custom",
        "label": "Overall site condition",
        "custom": {
          "tag": "ut-rating",
          "version": "1.1.0",
          "name": "Rating",
          "value_type": "number",
          "icon": "star",
          "value_schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "props": {
            "max": 5,
            "symbol": "star",
            "size": "large",
            "labels": [
              "Unsafe",
              "Poor",
              "Acceptable",
              "Good",
              "Excellent"
            ],
            "allow_clear": false
          },
          "display": {
            "template": "{{value}} of {{props.max}}",
            "format": "text"
          },
          "accessibility": {
            "role": "radiogroup",
            "keyboard": "Tab to the rating; Left / Right (or Up / Down) change it; Home / End jump to the lowest / highest; Delete or Backspace clears it when clearing is allowed.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 52,
            "min_height": 36,
            "max_height": 120
          },
          "output": {
            "type": "number",
            "description": "The rating (1 to the maximum)"
          }
        },
        "required": true
      },
