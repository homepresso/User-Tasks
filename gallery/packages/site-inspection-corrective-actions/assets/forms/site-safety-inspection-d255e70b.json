          "accessibility": {
            "role": "group",
            "keyboard": "Tab to the drawing area and the buttons. Keyboard users choose \"Type your name instead\", type their name and press Enter (or \"Use this signature\"). Undo removes the last stroke, Clear empties the pad, \"Sign again\" replaces a saved signature.",
            "labelled_by_host": true
          },
          "size": {
            "default_height": 222,
            "min_height": 140,
            "max_height": 640,
            "full_width": true
