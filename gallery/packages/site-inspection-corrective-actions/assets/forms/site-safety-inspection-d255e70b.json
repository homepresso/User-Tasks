      {
        "key": "observations",
        "type": "custom",
        "label": "General observations",
        "custom": {
          "tag": "ut-rich-text",
          "version": "1.1.0",
          "name": "Rich text",
          "value_type": "json",
          "icon": "type",
          "value_schema": {
            "type": "object",
            "properties": {
              "html": {
                "type": "string",
                "maxLength": 100000
