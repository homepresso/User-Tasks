        "key": "inspection_type",
        "label": "Inspection type",
        "type": "choice",
        "required": true,
        "options": [
          "Routine",
          "Follow-up",
          "Incident",
          "Pre-start"
        ],
        "default": "Routine",
        "display": "radio"
      },
      {
        "key": "checklist",
        "type": "custom",
        "label": "Checklist",
        "custom": {
          "tag": "ut-table",
          "version": "1.1.0",
          "name": "Table",
          "value_type": "array",
          "icon": "table",
          "value_schema": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          },
          "props": {
            "columns": [
              {
                "key": "item",
                "label": "Item",
                "type": "text",
                "required": true,
                "width": 260
              },
              {
                "key": "area",
                "label": "Area",
                "type": "select",
                "options": [
                  "Fire safety",
                  "Housekeeping",
                  "Electrical",
                  "Equipment",
                  "PPE",
                  "Hazardous substances",
                  "First aid",
                  "Other"
                ],
                "width": 150
              },
              {
                "key": "status",
                "label": "Status",
                "type": "select",
                "options": [
                  "Pass",
                  "Fail",
                  "N/A"
                ],
                "required": true,
                "width": 100
              },
              {
                "key": "severity",
                "label": "Severity",
                "type": "select",
                "options": [
                  "Low",
                  "Medium",
                  "High"
                ],
                "width": 110
              },
              {
                "key": "notes",
                "label": "Notes (what you found)",
                "type": "text",
                "width": 240
              }
            ],
            "min_rows": 1,
            "max_rows": 40,
            "allow_add": true,
            "allow_delete": true,
            "show_totals": false,
            "currency": "USD",
            "default_rows": [
              {
                "item": "Fire exits and escape routes clear and signed",
                "area": "Fire safety",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "Fire extinguishers in place, tagged and in date",
                "area": "Fire safety",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
                "item": "Walkways and stairs free of trip hazards",
                "area": "Housekeeping",
                "status": "",
                "severity": "",
                "notes": ""
              },
              {
