              "field_key": "name",
              "span": 1
            },
            {
              "field_key": "type",
              "span": 1
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "stage",
              "span": 1
            },
            {
              "field_key": "amount",
              "span": 1
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "close_date",
              "span": 1
            },
            {
              "field_key": "owner",
              "span": 1
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "contact",
              "span": 1
            },
            {
              "field_key": "source",
              "span": 1
            }
          ]
        },
        {
          "columns": 2,
          "cells": [
            {
              "field_key": "next_step",
              "span": 2
            }
          ]
        }
      ],
      "params": [
        {
          "name": "account",
          "label": "Account",
          "type": "text",
          "source": "context"
        }
      ]
    },
    "theme": {
      "source": "workspace"
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Create deal",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "success_screen",
            "title": "Deal created",
            "text": "{{name}} is on the pipeline board in {{stage}}.",
            "screen_button": "submit_another",
            "screen_button_label": "Submit another"
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "New deal",
      "subtitle": "Amounts in USD.",
      "align": "left"
    }
