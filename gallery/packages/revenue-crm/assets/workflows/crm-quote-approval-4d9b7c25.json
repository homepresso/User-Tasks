        "config": {
          "task_title": "VP approval {{quote_id}}: {{form.account}} at {{discount}}% off (${{net_total}})",
          "task_description": "<p><strong>{{form.account}}</strong> · {{form.deal_name}}. Net <strong>${{net_total}}</strong> at <strong>{{discount}}%</strong> off list (${{list_total}}).</p><p>The sales manager approved: {{=COALESCE(task_data.comment, \"no comment\")}}</p><p>Why: {{form.justification}}</p>",
          "task_priority": "high",
          "outcomes": [
            "Approve",
            "Reject"
          ],
          "assignment_type": "individual",
          "assignee_id": "a53a38b7-e5f1-5921-90b4-a4106ea7da90",
          "fields": [
            {
              "key": "comment",
              "label": "Comment for the rep",
