      {
        "id": "quote_doc",
        "type": "text_template",
        "label": "Quote document",
        "config": {
          "output_var": "quote_html",
          "template": "<h1>Quote {{quote_id}}</h1><p><strong>Brightwater Labs</strong> for <strong>{{form.account}}</strong><br>{{form.deal_name}} · valid until {{form.valid_until}}</p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" width=\"100%\"><tr><th align=\"left\">Product</th><th align=\"right\">Quantity</th><th align=\"right\">Unit price</th><th align=\"right\">Discount</th><th align=\"right\">Line total</th></tr>{{quote_rows}}<tr><th align=\"left\" colspan=\"4\">List total</th><td align=\"right\">{{=FORMAT_CURRENCY(list_total, \"USD\")}}</td></tr><tr><th align=\"left\" colspan=\"4\">Discount</th><td align=\"right\">{{discount}}%</td></tr><tr><th align=\"left\" colspan=\"4\">Total (USD)</th><td align=\"right\"><strong>{{=FORMAT_CURRENCY(net_total, \"USD\")}}</strong></td></tr></table><p>Prices in US dollars, excluding taxes. Approved on {{=FORMAT_DATE(NOW(), \"YYYY-MM-DD\")}}.</p>"
        },
        "position": {
          "x": 400,
          "y": 2440
        }
      },
      {
        "id": "quote_pdf",
        "type": "doc_convert",
        "label": "Quote PDF",
        "config": {
          "source": "{{quote_html}}",
          "target": "pdf",
          "title": "Quote {{quote_id}}",
          "output_name": "{{quote_id}}-{{form.account}}",
          "output_var": "quote_pdf",
          "page_size": "Letter"
