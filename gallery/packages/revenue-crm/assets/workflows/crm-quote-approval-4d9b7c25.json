{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "4d9b7c25-d4c0-5bac-bfa3-969d96e41808",
  "asset": {
    "id": "4d9b7c25-d4c0-5bac-bfa3-969d96e41808",
    "name": "CRM quote approval",
    "description": "A quote request: each product line is priced and added to the deal, the effective discount and net total go through the CRM discount authority table, then the sales manager (over 10% or $100,000) and the VP of sales (over 20% or $100,000) approve within a 3-day SLA, with escalation; the rep is emailed the decision. An approved quote becomes a PDF (the products, discount and total in USD) attached to the rep’s email, ready to send to the customer.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
        "label": "Quote requested",
        "config": {
          "form_id": "5d446d07-f2ee-5da5-9e0e-3d2aef25aaf0",
          "form_name": "Quote and discount request"
        },
        "position": {
          "x": 400,
          "y": 60
        }
      },
      {
        "id": "ref",
        "type": "set_variable",
        "label": "Quote ID",
        "config": {
          "name": "quote_id",
          "expression": "Q-{{=UPPER(LEFT(GUID(), 6))}}"
        },
        "position": {
          "x": 400,
          "y": 200
        }
      },
      {
        "id": "list0",
        "type": "set_variable",
        "label": "Start the list total",
        "config": {
          "name": "list_total",
          "expression": "{{=0}}"
        },
        "position": {
          "x": 400,
          "y": 480
        }
      },
      {
        "id": "net0",
        "type": "set_variable",
        "label": "Start the net total",
        "config": {
          "name": "net_total",
          "expression": "{{=0}}"
        },
        "position": {
          "x": 400,
          "y": 620
        }
      },
      {
        "id": "rows0",
        "type": "set_variable",
        "label": "Start the quote lines",
        "config": {
          "name": "quote_rows",
          "expression": ""
        },
        "position": {
          "x": 400,
          "y": 620
        }
      },
      {
        "id": "each",
        "type": "loop",
        "label": "Each product",
        "config": {
          "items": "{{form.lines}}",
          "item_var": "line"
        },
        "position": {
          "x": 400,
          "y": 760
        }
      },
      {
        "id": "list",
        "type": "set_variable",
        "label": "Add to list total",
        "config": {
          "name": "list_total",
          "expression": "{{=list_total + TO_NUMBER(line.qty) * TO_NUMBER(line.unit_price)}}"
        },
        "position": {
          "x": 720,
          "y": 760
        }
      },
      {
        "id": "lt",
        "type": "set_variable",
        "label": "Line total",
        "config": {
          "name": "line_total",
          "expression": "{{=ROUND(TO_NUMBER(line.qty) * TO_NUMBER(line.unit_price) * (1 - TO_NUMBER(COALESCE(line.discount_pct, 0)) / 100), 0)}}"
        },
        "position": {
          "x": 720,
          "y": 900
        }
      },
      {
        "id": "row_html",
        "type": "set_variable",
        "label": "Add the quote line",
        "config": {
          "name": "quote_rows",
          "expression": "{{=CONCAT(quote_rows, \"<tr><td>\", line.product, \"</td><td align=\\\"right\\\">\", line.qty, \"</td><td align=\\\"right\\\">\", FORMAT_CURRENCY(TO_NUMBER(line.unit_price), \"USD\"), \"</td><td align=\\\"right\\\">\", COALESCE(line.discount_pct, 0), \"%</td><td align=\\\"right\\\">\", FORMAT_CURRENCY(line_total, \"USD\"), \"</td></tr>\")}}"
        },
        "position": {
          "x": 720,
          "y": 1040
        }
      },
      {
        "id": "net",
        "type": "set_variable",
        "label": "Add to net total",
        "config": {
          "name": "net_total",
          "expression": "{{=net_total + line_total}}"
        },
        "position": {
          "x": 720,
          "y": 1180
        }
      },
      {
        "id": "line",
        "type": "update_data_table",
        "label": "Add the line to the deal",
        "config": {
          "table_id": "a6eb6ba9-2f7e-5f76-8ffa-f6379178705a",
          "table_name": "CRM deal line items",
          "operation": "insert",
          "column_values": {
            "line_id": "{{quote_id}}-{{=UPPER(LEFT(GUID(), 4))}}",
            "deal_id": "{{form.deal_id}}",
            "product": "{{line.product}}",
            "qty": "{{line.qty}}",
            "unit_price": "{{line.unit_price}}",
            "discount_pct": "{{=COALESCE(line.discount_pct, 0)}}",
            "line_total": "{{line_total}}"
          }
        },
        "position": {
          "x": 720,
          "y": 1320
        }
      },
      {
        "id": "disc",
        "type": "set_variable",
        "label": "Effective discount",
        "config": {
          "name": "discount",
          "expression": "{{=IF(list_total > 0, ROUND((1 - net_total / list_total) * 100, 1), 0)}}"
        },
        "position": {
          "x": 400,
          "y": 900
        }
      },
      {
        "id": "authority",
        "type": "decision_table",
        "label": "Discount authority",
        "config": {
          "decision_table_id": "cbb9b0e6-f433-595d-a55f-5c62000a58ff",
          "decision_table_name": "CRM discount authority",
          "input_mappings": {
            "discount_pct": "{{discount}}",
            "amount": "{{net_total}}"
          }
        },
        "position": {
          "x": 400,
          "y": 1040
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "config": {
          "title": "{{quote_id}} · {{form.account}} · ${{net_total}} at {{discount}}% off"
        },
        "position": {
          "x": 400,
          "y": 1180
        }
      },
      {
        "id": "log",
        "type": "update_data_table",
        "label": "Log the quote",
        "config": {
          "table_id": "48a9e89f-0d34-592d-b289-9d49ddb43e3e",
          "table_name": "CRM quotes",
          "operation": "insert",
          "column_values": {
            "quote_id": "{{quote_id}}",
            "deal_id": "{{form.deal_id}}",
            "deal": "{{form.deal_name}}",
            "account": "{{form.account}}",
            "list_total": "{{list_total}}",
            "discount_pct": "{{discount}}",
            "amount": "{{net_total}}",
            "status": "Pending approval",
            "approval_path": "{{approval_path}}",
            "requested_by": "{{submitted_by_name}}",
            "valid_until": "{{form.valid_until}}",
            "created_on": "{{=FORMAT_DATE(TODAY(), \"YYYY-MM-DD\")}}"
          }
        },
        "position": {
          "x": 400,
          "y": 1320
        }
      },
      {
        "id": "sla",
        "type": "set_sla",
        "label": "Approval SLA",
        "config": {
          "sla_label": "Quote approval",
          "mode": "relative",
          "amount": 3,
          "unit": "days",
          "warning_amount": 2,
          "warning_unit": "days"
        },
        "position": {
          "x": 400,
          "y": 1460
        }
      },
      {
        "id": "g_m",
        "type": "condition",
        "label": "Manager approval?",
        "config": {
          "branches": [
            {
              "label": "Sales manager",
              "logic": "and",
              "rules": [
                {
                  "field": "{{needs_manager}}",
                  "operator": "equals",
                  "value": "true"
                }
              ]
            }
          ],
          "has_else": true
        },
        "position": {
          "x": 400,
          "y": 1600
        }
      },
      {
        "id": "t_m",
        "type": "user_task",
        "label": "Sales manager approval",
        "config": {
          "task_title": "Approve {{quote_id}}: {{form.account}} at {{discount}}% off (${{net_total}})",
          "task_description": "<p><strong>{{form.account}}</strong> · {{form.deal_name}} ({{form.deal_id}}).</p><p>List ${{list_total}}, net <strong>${{net_total}}</strong>, effective discount <strong>{{discount}}%</strong>. Path: {{approval_path}}.</p><p>Why: {{form.justification}}</p><p>Requested by {{submitted_by_name}}.</p>",
          "task_priority": "high",
          "outcomes": [
            "Approve",
            "Reject"
          ],
          "assignment_type": "individual",
          "assignee_variable": "{{form.manager}}",
          "fields": [
            {
              "key": "comment",
              "label": "Comment for the rep",
              "type": "textarea"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 1,
                "cells": [
                  {
                    "field_key": "comment",
                    "span": 1
                  }
                ]
              }
            ]
          },
          "form_buttons": [
            {
              "id": "approve",
              "label": "Approve",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Approve"
            },
            {
              "id": "reject",
              "label": "Reject",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Reject"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "Quote approval",
            "align": "left",
            "subtitle": "{{quote_id}} · {{approval_path}}"
          },
          "due_date_mode": "relative",
          "due_offset_amount": 1,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 240
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 1440
        },
        "position": {
          "x": 400,
          "y": 1740
        }
      },
