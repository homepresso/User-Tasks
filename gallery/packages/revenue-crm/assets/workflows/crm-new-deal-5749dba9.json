{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "5749dba9-df85-5e76-8220-168906d38294",
  "asset": {
    "id": "5749dba9-df85-5e76-8220-168906d38294",
    "name": "CRM new deal",
    "description": "Adds a deal from the New deal form to CRM deals; the stage automation sets its probability, forecast and first task.",
    "trigger_type": "form_submitted",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "form_submitted",
        "label": "New deal submitted",
        "config": {
          "form_id": "545de91e-3499-5bdb-9f8e-e28919d7e562",
          "form_name": "New deal"
        },
        "position": {
          "x": 400,
          "y": 60
        }
      },
      {
        "id": "ref",
        "type": "set_variable",
        "label": "Deal ID",
        "config": {
          "name": "deal_id",
          "expression": "DL-{{=UPPER(LEFT(GUID(), 6))}}"
        },
        "position": {
          "x": 400,
          "y": 200
        }
      },
      {
        "id": "insert",
        "type": "update_data_table",
        "label": "Add the deal",
        "config": {
          "table_id": "19470d3d-a413-5e76-b842-f922ef50d2df",
          "table_name": "CRM deals",
          "operation": "insert",
          "column_values": {
            "deal_id": "{{deal_id}}",
            "name": "{{form.name}}",
            "account": "{{form.account}}",
            "account_id": "{{form.account_id}}",
            "contact": "{{form.contact}}",
            "owner": "{{form.owner}}",
            "region": "{{form.region}}",
            "type": "{{form.type}}",
            "stage": "{{form.stage}}",
            "amount": "{{form.amount}}",
            "close_date": "{{form.close_date}}",
            "next_step": "{{form.next_step}}",
            "source": "{{form.source}}",
            "created_on": "{{=FORMAT_DATE(TODAY(), \"YYYY-MM-DD\")}}",
            "discount_pct": "0"
          }
        },
        "position": {
          "x": 400,
          "y": 340
        }
      },
      {
        "id": "end",
        "type": "end_workflow",
        "label": "Added",
        "config": {
          "reason": "{{deal_id}} {{form.name}} added in {{form.stage}}"
        },
        "position": {
          "x": 400,
          "y": 480
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-ref",
        "source": "trigger",
        "target": "ref"
      },
      {
        "id": "e-ref-insert",
        "source": "ref",
        "target": "insert"
      },
      {
        "id": "e-insert-end",
        "source": "insert",
        "target": "end"
      }
    ],
    "user_variables": [],
    "swimlanes": [],
    "is_active": true
  }
}
