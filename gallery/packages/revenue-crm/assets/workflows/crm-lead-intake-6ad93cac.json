      },
      {
        "id": "e-title-log",
        "source": "title",
        "target": "log"
      },
      {
        "id": "e-log-thanks",
        "source": "log",
        "target": "thanks"
      },
      {
        "id": "e-thanks-qualify",
        "source": "thanks",
