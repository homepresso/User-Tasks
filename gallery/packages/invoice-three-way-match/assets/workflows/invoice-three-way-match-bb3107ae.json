      },
      {
        "id": "e-price_var-abs_var",
        "source": "price_var",
        "target": "abs_var"
      },
      {
        "id": "e-abs_var-pct_var",
        "source": "abs_var",
        "target": "pct_var"
      },
      {
        "id": "e-pct_var-decide",
