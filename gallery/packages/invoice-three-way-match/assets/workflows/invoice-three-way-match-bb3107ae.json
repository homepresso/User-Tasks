      },
      {
        "id": "e-route-auto_amount-else",
        "source": "route",
        "target": "auto_amount",
        "label": "Else"
      },
      {
        "id": "e-sla-resolve",
        "source": "sla",
        "target": "resolve"
      },
      {
        "id": "e-resolve-manual_amount-approve-variance",
        "source": "resolve",
        "target": "manual_amount",
