    "user_variables": [
      {
        "id": "v-invoice_number",
        "name": "invoice_number",
        "type": "string",
        "description": "Vendor invoice number as captured by the AP / OCR system",
        "defaultValue": "",
        "required": true,
        "label": "Invoice number"
      },
      {
        "id": "v-vendor_id",
        "name": "vendor_id",
        "type": "string",
        "description": "Vendor id in the ERP (V-2001…)",
        "defaultValue": "",
        "required": true,
        "label": "Vendor id"
      },
      {
        "id": "v-po_number",
        "name": "po_number",
        "type": "string",
        "description": "Purchase order number quoted on the invoice",
        "defaultValue": "",
        "required": true,
        "label": "PO number"
      },
      {
        "id": "v-invoice_total",
        "name": "invoice_total",
        "type": "number",
        "description": "Invoice total excluding tax, in the invoice currency",
        "defaultValue": "0",
        "required": true,
        "label": "Invoice total"
      },
      {
        "id": "v-currency",
        "name": "currency",
        "type": "string",
        "description": "ISO currency code",
        "defaultValue": "NZD",
        "label": "Currency"
      },
      {
        "id": "v-invoice_date",
        "name": "invoice_date",
        "type": "string",
        "description": "Invoice date (YYYY-MM-DD); payment terms count from here",
        "defaultValue": "",
        "label": "Invoice date",
        "format": "date"
      },
      {
        "id": "v-lines",
        "name": "lines",
        "type": "object",
        "description": "Invoice lines: [{ line, sku, description, quantity, unit_price, amount }]",
        "defaultValue": "",
        "label": "Lines"
      },
      {
        "id": "v-document_url",
        "name": "document_url",
        "type": "string",
        "description": "Link to the invoice image or PDF in the AP system",
        "defaultValue": "",
        "label": "Invoice document",
        "format": "url"
      },
      {
        "id": "v-ap_clerk_id",
        "name": "ap_clerk_id",
        "type": "string",
        "description": "Optional: user id of the AP clerk who resolves exceptions (overrides the install-time default)",
        "defaultValue": "",
        "label": "AP clerk (user id)"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
