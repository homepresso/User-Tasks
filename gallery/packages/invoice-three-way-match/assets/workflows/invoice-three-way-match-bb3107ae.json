      },
      {
        "id": "e-manual_amount-due",
        "source": "manual_amount",
        "target": "due"
      },
      {
        "id": "e-due-pay",
        "source": "due",
        "target": "pay"
      },
      {
        "id": "e-pay-mark_matched",
        "source": "pay",
        "target": "mark_matched"
      },
      {
        "id": "e-mark_matched-log_paid",
        "source": "mark_matched",
        "target": "log_paid"
      },
      {
        "id": "e-log_paid-done",
        "source": "log_paid",
        "target": "done"
      },
      {
        "id": "e-hold-email_cn",
        "source": "hold",
        "target": "email_cn"
      },
      {
        "id": "e-email_cn-end_hold",
        "source": "email_cn",
        "target": "end_hold"
      },
      {
        "id": "e-reject-email_rej",
