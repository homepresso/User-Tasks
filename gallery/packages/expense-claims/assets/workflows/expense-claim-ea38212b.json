    "user_variables": [
      {
        "id": "v-employee_id",
        "name": "employee_id",
        "type": "string",
        "description": "Employee number in the finance system (E-1001…)",
        "defaultValue": "",
        "required": true,
        "label": "Employee number"
      },
      {
        "id": "v-claim_title",
        "name": "claim_title",
        "type": "string",
        "description": "Short description, e.g. \"Client visit Wellington\"",
        "defaultValue": "",
        "required": true,
        "label": "What is the claim for?"
      },
      {
        "id": "v-category",
        "name": "category",
        "type": "string",
        "description": "Expense category (see the Expense categories table)",
        "defaultValue": "",
        "required": true,
        "label": "Category",
        "options": [
          "travel",
          "accommodation",
          "meals",
          "equipment",
          "training",
          "other"
        ]
      },
      {
        "id": "v-amount",
        "name": "amount",
        "type": "number",
        "description": "Total including tax",
        "defaultValue": "0",
        "required": true,
        "label": "Amount"
      },
      {
        "id": "v-currency",
        "name": "currency",
        "type": "string",
        "description": "ISO currency code",
        "defaultValue": "NZD",
        "label": "Currency",
        "options": [
          "NZD",
          "AUD",
          "USD",
          "EUR",
          "GBP"
        ]
      },
      {
        "id": "v-expense_date",
        "name": "expense_date",
        "type": "string",
        "description": "Date of the expense",
        "defaultValue": "",
        "label": "Expense date",
        "format": "date"
      },
      {
        "id": "v-receipt_url",
        "name": "receipt_url",
        "type": "string",
        "description": "Link to the receipt (PDF or photo)",
        "defaultValue": "",
        "label": "Receipt",
        "format": "url"
      },
      {
        "id": "v-business_purpose",
        "name": "business_purpose",
        "type": "string",
        "description": "Why the expense was needed",
        "defaultValue": "",
        "label": "Business purpose"
      },
      {
        "id": "v-approver_id",
        "name": "approver_id",
        "type": "string",
        "description": "Optional: user id of the approver for this claim (overrides the default approver chosen on install)",
        "defaultValue": "",
        "label": "Approver (user id)"
      }
