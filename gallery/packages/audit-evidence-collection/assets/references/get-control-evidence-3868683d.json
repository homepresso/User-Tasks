    "integration_id": "625aa13c-9c62-44c8-91e2-0b37d0e6865b",
    "name": "Get control evidence",
    "description": "Generates or fetches the evidence export for one control and period from the system that runs the control (access reviews, backups, vulnerability scans, change tickets).",
    "tags": [
      "evidence"
    ],
    "request_config": {
      "method": "GET",
      "headers": {},
      "query_params": {},
      "body_template": "",
      "path_template": "/evidence/{{evidence_source}}",
      "response_schema": {
        "version": 1,
        "source": "sample",
        "root": {
          "type": "object",
          "fields": [
            {
              "name": "control_id",
              "type": "string",
              "example": "AC-01"
            },
            {
              "name": "source",
              "type": "string",
              "example": "access-reviews"
            },
            {
              "name": "period",
              "type": "string",
              "example": "2026-10"
            },
            {
              "name": "status",
              "type": "string",
              "example": "complete"
            },
            {
              "name": "generated_at",
              "type": "string",
              "example": "2026-10-01T06:02:11Z"
            },
            {
              "name": "record_count",
              "type": "integer",
              "example": 214
            },
            {
              "name": "exceptions",
              "type": "integer",
              "example": 2
            },
            {
              "name": "summary",
              "type": "string",
              "example": "214 accounts reviewed, 2 revoked after review"
            },
            {
              "name": "evidence_url",
              "type": "string",
              "example": "https://evidence.example.com/exports/ac-01/2026-10.pdf"
            },
            {
              "name": "checksum",
              "type": "string",
              "example": "sha256:9f2c4e7a1b03d5e6"
            },
            {
              "name": "system",
              "type": "object",
              "fields": [
                {
                  "name": "name",
                  "type": "string",
                  "example": "Identity provider"
                },
                {
                  "name": "environment",
                  "type": "string",
                  "example": "production"
                }
              ]
            }
          ]
        },
        "sample": {
          "control_id": "AC-01",
