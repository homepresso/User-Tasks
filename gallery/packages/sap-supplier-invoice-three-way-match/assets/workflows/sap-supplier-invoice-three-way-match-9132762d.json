{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "9132762d-a9cc-5e15-9da3-57a3f0b951c3",
  "asset": {
    "id": "9132762d-a9cc-5e15-9da3-57a3f0b951c3",
    "name": "SAP supplier invoice three-way match",
    "description": "A captured supplier invoice is matched to the SAP PO item and goods receipts; within tolerance it is posted, otherwise AP decides on a task form.",
    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "Invoice captured",
        "position": {
          "x": 400,
          "y": 60
        },
        "config": {}
      },
      {
        "id": "ref",
        "type": "set_variable",
        "label": "Match reference",
        "position": {
          "x": 400,
          "y": 220
        },
        "config": {
          "name": "match_ref",
          "expression": "IM-{{=FORMAT_DATE(NOW(), \"YYYYMMDD\")}}-{{=UPPER(LEFT(GUID(), 4))}}"
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 400,
          "y": 380
        },
        "config": {
          "title": "Invoice {{invoice_reference}} · supplier {{supplier}} · PO {{purchase_order}}/{{po_item}}"
        }
      },
      {
        "id": "log",
        "type": "update_data_table",
        "label": "Log captured invoice",
        "position": {
          "x": 400,
          "y": 540
        },
        "config": {
          "table_id": "f5375358-ee8e-5b70-a163-32e44c6e520f",
          "table_name": "Invoice match log",
          "operation": "insert",
          "column_values": {
            "match_ref": "{{match_ref}}",
            "invoice_reference": "{{invoice_reference}}",
            "supplier": "{{supplier}}",
            "purchase_order": "{{purchase_order}}",
            "po_item": "{{po_item}}",
            "invoiced_quantity": "{{invoiced_quantity}}",
            "invoiced_price": "{{invoiced_unit_price}}",
            "status": "matching"
          }
        }
      },
      {
        "id": "poi",
        "type": "call_reference",
        "label": "Get purchase order item",
        "position": {
          "x": 400,
          "y": 700
        },
        "config": {
          "reference_id": "7d8ae65c-912c-5704-b719-7709864c4df0",
          "reference_name": "Get purchase order item",
          "reference_method": "GET",
          "input_mappings": {
            "purchase_order": "{{purchase_order}}",
            "po_item": "{{po_item}}"
          },
          "output_mappings": {
            "po_quantity": {
              "enabled": true,
              "variableName": "po_quantity"
            },
            "po_unit": {
              "enabled": true,
              "variableName": "po_unit"
            },
            "po_net_price": {
              "enabled": true,
              "variableName": "po_net_price"
            },
            "po_price_unit": {
              "enabled": true,
              "variableName": "po_price_unit"
            },
            "po_currency": {
              "enabled": true,
              "variableName": "po_currency"
            },
            "po_tax_code": {
              "enabled": true,
              "variableName": "po_tax_code"
            },
            "po_item_text": {
              "enabled": true,
              "variableName": "po_item_text"
            },
            "material": {
              "enabled": true,
              "variableName": "material"
            },
            "plant": {
              "enabled": true,
              "variableName": "plant"
            },
            "finally_invoiced": {
              "enabled": true,
              "variableName": "finally_invoiced"
            }
          }
        }
      },
      {
        "id": "gr",
        "type": "call_reference",
        "label": "Get goods receipts",
        "position": {
          "x": 400,
          "y": 860
        },
        "config": {
          "reference_id": "59398871-ad1a-5e15-ac44-22599cb28793",
          "reference_name": "Get goods receipts",
          "reference_method": "GET",
          "input_mappings": {
            "purchase_order": "{{purchase_order}}",
            "po_item": "{{po_item}}"
          },
          "output_mappings": {
            "receipts": {
              "enabled": true,
              "variableName": "receipts"
            },
            "gr_document": {
              "enabled": true,
              "variableName": "gr_document"
            },
            "gr_year": {
              "enabled": true,
              "variableName": "gr_year"
            },
            "gr_doc_item": {
              "enabled": true,
              "variableName": "gr_doc_item"
            }
          }
        }
      },
      {
        "id": "r0",
        "type": "set_variable",
        "label": "Received = 0",
        "position": {
          "x": 400,
          "y": 1020
        },
        "config": {
          "name": "received_quantity",
          "expression": "0"
        }
      },
      {
        "id": "loop",
        "type": "loop",
        "label": "Each goods receipt",
        "position": {
          "x": 400,
          "y": 1180
        },
        "config": {
          "items": "{{receipts}}",
          "item_var": "receipt"
        }
      },
      {
        "id": "add",
        "type": "math",
        "label": "Add received quantity",
        "position": {
          "x": 720,
          "y": 1340
        },
        "config": {
          "expression": "{{received_quantity}} + {{receipt.QuantityInEntryUnit}}",
          "output_var": "received_quantity"
        }
      },
      {
        "id": "unit_price",
        "type": "math",
        "label": "PO unit price",
        "position": {
          "x": 400,
          "y": 1500
        },
        "config": {
          "expression": "{{po_net_price}} / {{po_price_unit}}",
          "output_var": "po_price"
        }
      },
      {
        "id": "qty_over",
        "type": "math",
        "label": "Quantity over receipt",
        "position": {
          "x": 400,
          "y": 1660
        },
        "config": {
          "expression": "{{invoiced_quantity}} - {{received_quantity}}",
          "output_var": "qty_over_received"
        }
      },
      {
        "id": "pct",
        "type": "set_variable",
        "label": "Price variance %",
        "position": {
          "x": 400,
          "y": 1820
        },
        "config": {
          "name": "price_variance_pct",
          "expression": "{{=ROUND((TO_NUMBER(invoiced_unit_price) - TO_NUMBER(po_price)) / TO_NUMBER(po_price) * 100, 2)}}"
        }
      },
      {
        "id": "amt",
        "type": "set_variable",
        "label": "Amount variance",
        "position": {
          "x": 400,
          "y": 1980
        },
        "config": {
          "name": "amount_variance",
          "expression": "{{=ROUND(TO_NUMBER(invoiced_quantity) * TO_NUMBER(invoiced_unit_price) - MIN(TO_NUMBER(invoiced_quantity), TO_NUMBER(received_quantity)) * TO_NUMBER(po_price), 2)}}"
        }
      },
      {
        "id": "net",
        "type": "set_variable",
        "label": "Invoice net amount",
        "position": {
          "x": 400,
          "y": 2140
        },
        "config": {
          "name": "item_amount",
          "expression": "{{=ROUND(TO_NUMBER(invoiced_quantity) * TO_NUMBER(invoiced_unit_price), 2)}}"
        }
      },
      {
        "id": "tol",
        "type": "decision_table",
        "label": "Invoice tolerance",
        "position": {
          "x": 400,
          "y": 2300
        },
        "config": {
          "decision_table_id": "206dbd62-ea72-5170-93d2-ddace201ad87",
          "decision_table_name": "Invoice tolerance",
          "input_mappings": {
            "qty_over_received": "{{qty_over_received}}",
            "price_variance_pct": "{{price_variance_pct}}",
            "amount_variance": "{{amount_variance}}"
          }
        }
      },
      {
        "id": "log2",
        "type": "update_data_table",
        "label": "Record variances",
        "position": {
          "x": 400,
          "y": 2460
        },
        "config": {
          "table_id": "f5375358-ee8e-5b70-a163-32e44c6e520f",
          "table_name": "Invoice match log",
          "operation": "update",
          "match_column": "match_ref",
          "match_value": "{{match_ref}}",
          "column_values": {
            "received_quantity": "{{received_quantity}}",
            "po_price": "{{po_price}}",
            "price_variance_pct": "{{price_variance_pct}}",
            "amount_variance": "{{amount_variance}}",
            "result": "{{=IF(within_tolerance, \"Within tolerance\", exception_reason)}}"
          }
        }
      },
      {
        "id": "block0",
        "type": "set_variable",
        "label": "No payment block",
        "position": {
          "x": 400,
          "y": 2620
        },
        "config": {
          "name": "payment_block",
          "expression": ""
        }
      },
      {
        "id": "ok",
        "type": "condition",
        "label": "Within tolerance?",
        "position": {
          "x": 400,
          "y": 2780
        },
        "config": {
          "branches": [
            {
              "label": "Within tolerance",
              "logic": "and",
              "rules": [
                {
                  "field": "{{within_tolerance}}",
                  "operator": "is_true",
                  "value": ""
                }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "exception",
        "type": "user_task",
        "label": "Invoice exception",
        "position": {
          "x": 720,
          "y": 2940
        },
        "config": {
          "task_title": "Invoice {{invoice_reference}} outside tolerance: {{exception_reason}}",
          "task_description": "<p>Supplier <strong>{{supplier}}</strong> invoice <strong>{{invoice_reference}}</strong> ({{document_date}}) for PO {{purchase_order}}/{{po_item}}: {{po_item_text}} ({{material}}, plant {{plant}}).</p><table style=\"border-collapse:collapse\"><tr><th></th><th align=\"left\">PO</th><th align=\"left\">Received</th><th align=\"left\">Invoiced</th></tr><tr><td>Quantity</td><td>{{po_quantity}} {{po_unit}}</td><td>{{received_quantity}} {{po_unit}}</td><td><strong>{{invoiced_quantity}}</strong></td></tr><tr><td>Unit price</td><td>{{po_price}} {{po_currency}}</td><td></td><td><strong>{{invoiced_unit_price}} {{currency}}</strong></td></tr></table><p>Price variance <strong>{{price_variance_pct}}%</strong>, amount variance <strong>{{currency}} {{amount_variance}}</strong>. Rule “{{rule_label}}”.</p>",
          "task_priority": "high",
          "outcomes": [
            "Approve variance",
            "Reject",
            "Hold"
          ],
          "assignment_type": "individual",
          "assignee_id": "0cc21c7d-aedf-592b-8f81-4bbab7e9ec77",
          "assignee_variable": "{{ap_user_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 3,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
            }
          ],
          "escalation_enabled": true,
          "escalation_type": "manager",
          "escalate_after_minutes": 4320,
          "fields": [
            {
              "key": "reason_code",
              "label": "Reason code",
              "type": "lookup",
              "required": true,
              "default": "{{suggested_code}}",
              "lookup": {
                "source": "table",
                "table_id": "d14f8ee8-b8f1-5481-8ba8-0e55adf6617d",
                "search_columns": [
                  "code",
                  "description"
                ],
                "display_columns": [
