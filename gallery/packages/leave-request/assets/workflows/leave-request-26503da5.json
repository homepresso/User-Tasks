      {
        "id": "after",
        "type": "set_variable",
        "label": "Balance after",
        "position": {
          "x": 1060,
          "y": 860
        },
        "config": {
          "name": "balance_after",
          "expression": "{{=IF(leave_rule.deducts_balance, SUBTRACT(balance_days, days), balance_days)}}"
        }
      },
      {
        "id": "notice",
        "type": "set_variable",
        "label": "Notice given",
        "position": {
          "x": 1060,
          "y": 1020
        },
        "config": {
          "name": "notice_given_days",
          "expression": "{{=DAY_DIFF(TODAY(), start_date)}}"
        }
      },
      {
        "id": "short",
        "type": "set_variable",
        "label": "Short notice?",
        "position": {
          "x": 1060,
          "y": 1180
        },
        "config": {
          "name": "short_notice",
          "expression": "{{=IF(notice_given_days < leave_rule.notice_days, true, false)}}"
        }
      },
      {
        "id": "within",
        "type": "set_variable",
        "label": "Within auto limit?",
        "position": {
          "x": 1060,
          "y": 1340
        },
        "config": {
          "name": "within_auto_limit",
          "expression": "{{=IF(days <= leave_rule.auto_approve_up_to, true, false)}}"
