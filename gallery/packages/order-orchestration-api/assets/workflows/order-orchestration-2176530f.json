      },
      {
        "id": "add_line",
        "type": "math",
        "label": "Add line",
        "position": {
          "x": 1220,
          "y": 1060
        },
        "config": {
          "expression": "{{subtotal}} + {{line.qty}} * {{line.price}}",
          "output_var": "subtotal"
        }
      },
      {
        "id": "shipping",
        "type": "set_variable",
        "label": "Shipping",
        "position": {
          "x": 900,
          "y": 1220
        },
        "config": {
          "name": "shipping",
          "expression": "{{=IF(subtotal >= free_shipping_over, 0, shipping_fee)}}"
        }
      },
      {
        "id": "tax",
        "type": "math",
        "label": "Tax",
        "position": {
          "x": 900,
          "y": 1380
        },
        "config": {
          "expression": "({{subtotal}} + {{shipping}}) * {{tax_rate}}",
