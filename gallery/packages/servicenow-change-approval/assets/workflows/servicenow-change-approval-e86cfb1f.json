      },
      {
        "id": "e-reject-lbl_r",
        "source": "reject",
        "target": "lbl_r"
      },
      {
        "id": "e-info-lbl_i",
        "source": "info",
        "target": "lbl_i"
      },
      {
        "id": "e-lbl_a-notify",
        "source": "lbl_a",
        "target": "notify"
      },
      {
        "id": "e-lbl_r-notify",
        "source": "lbl_r",
        "target": "notify"
      },
      {
        "id": "e-lbl_i-notify",
        "source": "lbl_i",
        "target": "notify"
      },
      {
        "id": "e-notify-done",
        "source": "notify",
        "target": "done"
      }
    ],
    "user_variables": [
      {
        "id": "v-sys_id",
        "name": "sys_id",
        "type": "string",
        "description": "The change_request sys_id (current.sys_id when the change reaches Authorize / an approval is requested)",
        "defaultValue": "",
        "required": true,
        "label": "Change sys_id"
      },
      {
        "id": "v-number",
        "name": "number",
        "type": "string",
        "description": "Optional: the change number (current.number)",
        "defaultValue": "",
        "required": false,
        "label": "Change number"
      },
      {
        "id": "v-notify_email",
        "name": "notify_email",
        "type": "string",
        "description": "Optional: where the decision email goes (the change team or requester)",
        "defaultValue": "change-management@example.com",
        "required": false,
        "label": "Notify",
        "format": "email"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
