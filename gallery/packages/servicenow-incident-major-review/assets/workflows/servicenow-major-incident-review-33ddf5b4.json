    ],
    "user_variables": [
      {
        "id": "v-sys_id",
        "name": "sys_id",
        "type": "string",
        "description": "The incident sys_id from ServiceNow (current.sys_id in the business rule)",
        "defaultValue": "",
        "required": true,
        "label": "Incident sys_id"
      },
      {
        "id": "v-number",
        "name": "number",
        "type": "string",
        "description": "Optional: the incident number, for logs before the incident is read (current.number)",
        "defaultValue": "",
        "required": false,
        "label": "Incident number"
      },
      {
        "id": "v-event",
        "name": "event",
        "type": "string",
        "description": "Why ServiceNow sent it: inserted or priority_changed",
        "defaultValue": "inserted",
        "required": false,
        "label": "Event"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
