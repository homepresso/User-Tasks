          "task_priority": "high",
          "outcomes": [
            "Provisioned",
            "Blocked"
          ],
          "assignment_type": "individual",
          "assignee_id": "2b2870a1-e6aa-530a-bfb7-a314d485aed9",
          "due_date_mode": "relative",
          "due_offset_amount": 3,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
            }
          ],
          "fields": [
            {
              "key": "asset_tag",
              "label": "Laptop asset tag",
              "type": "text",
              "required": true
            },
            {
              "key": "accounts_created",
              "label": "Accounts created",
              "type": "boolean",
              "required": true
            },
            {
              "key": "mfa_enrolled",
              "label": "MFA enrolment sent",
              "type": "boolean"
            },
            {
              "key": "notes",
              "label": "Notes",
              "type": "textarea"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "asset_tag",
                    "span": 1
                  },
                  {
                    "field_key": "accounts_created",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "mfa_enrolled",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "notes",
                    "span": 2
                  }
                ]
              }
            ]
          },
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "IT provisioning",
            "align": "left",
            "subtitle": "{{worker_name}} · starts {{hire_date}}"
          },
          "form_buttons": [
            {
              "id": "done",
              "label": "Provisioned",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Provisioned"
            },
            {
              "id": "blocked",
              "label": "Blocked",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Blocked"
            }
          ]
        }
      },
      {
        "id": "done_row",
        "type": "update_data_table",
        "label": "Mark provisioned",
        "position": {
          "x": 240,
          "y": 720
        },
        "config": {
          "table_id": "739169cc-e1e9-5bd8-805f-fcd3f0b5bd7e",
          "table_name": "New hire log",
          "operation": "update",
          "match_column": "worker_id",
          "match_value": "{{worker_id}}",
          "column_values": {
            "status": "IT provisioned"
          }
        }
      },
      {
        "id": "blocked_log",
        "type": "log",
        "label": "Provisioning blocked",
        "position": {
          "x": 560,
          "y": 720
        },
        "config": {
          "message": "IT provisioning for {{worker_name}} blocked: {{task_data.notes}}",
          "level": "warn"
        }
      },
      {
        "id": "end_ok",
        "type": "end_workflow",
        "label": "Provisioned",
        "position": {
          "x": 240,
          "y": 880
        },
        "config": {
          "reason": "{{worker_name}} provisioned ({{task_data.asset_tag}})"
        }
      },
      {
        "id": "end_blocked",
        "type": "end_workflow",
        "label": "Blocked",
        "position": {
          "x": 560,
          "y": 880
        },
        "config": {
          "reason": "IT provisioning blocked for {{worker_name}}"
        }
      }
    ],
    "edges": [
