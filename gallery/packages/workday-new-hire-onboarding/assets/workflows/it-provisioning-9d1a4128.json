        "position": {
          "x": 400,
          "y": 60
        },
        "config": {}
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 400,
          "y": 220
        },
        "config": {
          "title": "IT provisioning: {{worker_name}} · ready by {{ready_by}}"
        }
      },
      {
        "id": "sla",
        "type": "set_sla",
        "label": "Ready-by SLA",
        "position": {
          "x": 400,
          "y": 380
        },
        "config": {
          "sla_label": "IT ready",
          "mode": "exact",
          "due_at": "{{ready_by}}",
          "warning_amount": 2,
          "warning_unit": "days"
        }
      },
      {
        "id": "it_task",
        "type": "user_task",
        "label": "Provision equipment and accounts",
        "position": {
          "x": 400,
          "y": 540
        },
        "config": {
          "task_title": "Provision {{worker_name}} ({{business_title}}) by {{ready_by}}",
