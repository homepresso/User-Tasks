{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "0ba34cf5-1661-4442-9733-e5f3941c2008",
  "asset": {
    "id": "0ba34cf5-1661-4442-9733-e5f3941c2008",
    "name": "Lead routing",
    "description": "An inbound lead from the website or forms tool is enriched, scored and routed: it is created in the CRM with its territory owner; sales-ready leads are emailed to the owner, the rest join a nurture list.",
    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "Lead received",
        "position": {
          "x": 340,
          "y": 60
        },
        "config": {}
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "title": "Lead: {{first_name}} {{last_name}} · {{company}} ({{source}})"
        }
      },
      {
        "id": "domain",
        "type": "set_variable",
        "label": "Email domain",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "name": "domain",
          "expression": "{{=LOWER(LAST(SPLIT(email, \"@\")))}}"
        }
      },
      {
        "id": "enrich",
        "type": "call_reference",
        "label": "Enrich company",
        "position": {
          "x": 340,
          "y": 540
        },
        "config": {
          "reference_id": "542c404b-2fe9-48e8-9df7-32f8a4362237",
          "reference_name": "Enrich company",
          "reference_method": "POST",
          "input_mappings": {
            "domain": "{{domain}}",
            "company": "{{company}}"
          },
          "output_mappings": {
            "industry": {
              "enabled": true,
              "variableName": "industry"
            },
            "size_band": {
              "enabled": true,
              "variableName": "size_band"
            },
            "employees": {
              "enabled": true,
              "variableName": "enriched_employees"
            },
            "annual_revenue": {
              "enabled": true,
              "variableName": "annual_revenue"
            },
            "linkedin_url": {
              "enabled": true,
              "variableName": "linkedin_url"
            }
          }
        },
        "onError": "continue"
      },
      {
        "id": "employees",
        "type": "set_variable",
        "label": "Best employee count",
        "position": {
          "x": 340,
          "y": 700
        },
        "config": {
          "name": "employees",
          "expression": "{{=COALESCE(enriched_employees, employees)}}"
        }
      },
      {
        "id": "territory",
        "type": "update_data_table",
        "label": "Find territory",
        "position": {
          "x": 340,
          "y": 860
        },
        "config": {
          "table_id": "b10bb1ea-c7fc-4437-b2f5-39ba3b4fdee7",
          "table_name": "Territories",
          "operation": "get",
          "match_column": "country_code",
          "match_value": "{{=UPPER(country)}}",
          "output_row_var": "territory"
        }
      },
      {
        "id": "has_territory",
        "type": "condition",
        "label": "Territory found?",
        "position": {
          "x": 340,
          "y": 1020
        },
        "config": {
          "branches": [
            {
              "label": "Found",
              "logic": "and",
              "rules": [
                {
                  "field": "{{territory.owner_email}}",
                  "operator": "is_not_empty",
                  "value": ""
                }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "fallback",
        "type": "update_data_table",
        "label": "Rest of world territory",
        "position": {
          "x": 580,
          "y": 1200
        },
        "config": {
          "table_id": "b10bb1ea-c7fc-4437-b2f5-39ba3b4fdee7",
          "table_name": "Territories",
          "operation": "get",
          "match_column": "country_code",
          "match_value": "*",
          "output_row_var": "territory"
        }
      },
      {
        "id": "owner",
        "type": "set_variable",
        "label": "Owner",
        "position": {
          "x": 340,
          "y": 1360
        },
        "config": {
          "name": "owner_email",
          "expression": "{{territory.owner_email}}"
        }
      },
      {
        "id": "owner_name",
        "type": "set_variable",
        "label": "Owner name",
        "position": {
          "x": 340,
          "y": 1520
        },
        "config": {
          "name": "owner_name",
          "expression": "{{territory.owner_name}}"
        }
      },
      {
        "id": "score",
        "type": "decision_table",
        "label": "Lead score & routing",
        "position": {
          "x": 340,
          "y": 1680
        },
        "config": {
          "decision_table_id": "6eb095a2-fef0-450d-a7a8-c4e8091c29c6",
          "decision_table_name": "Lead score & routing",
          "input_mappings": {
            "employees": "{{employees}}",
            "industry": "{{=COALESCE(industry, \"Unknown\")}}",
            "region": "{{territory.region}}",
            "source": "{{source}}"
          }
        }
      },
      {
        "id": "crm",
        "type": "call_reference",
        "label": "Create lead in CRM",
        "position": {
          "x": 340,
          "y": 1840
        },
        "config": {
          "reference_id": "1aa0dd73-3a66-47a1-97da-f4944e24f85a",
          "reference_name": "Create lead",
          "reference_method": "POST",
          "input_mappings": {
            "email": "{{email}}",
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "company": "{{company}}",
            "country": "{{country}}",
            "industry": "{{industry}}",
            "employees": "{{employees}}",
            "segment": "{{segment}}",
            "score": "{{score}}",
            "priority": "{{priority}}",
            "owner_email": "{{owner_email}}",
            "queue": "{{territory.queue}}",
            "source": "{{source}}",
            "message": "{{message}}"
          },
          "output_mappings": {
            "lead_id": {
              "enabled": true,
              "variableName": "lead_id"
            },
            "lead_url": {
              "enabled": true,
              "variableName": "lead_url"
            }
          }
        }
      },
      {
        "id": "route",
        "type": "condition",
        "label": "Sales-ready?",
        "position": {
          "x": 340,
          "y": 2000
        },
        "config": {
          "branches": [
            {
              "label": "Sales-ready",
              "logic": "and",
              "rules": [
                {
                  "field": "{{score}}",
                  "operator": "gte",
                  "value": "{{sales_ready_score}}"
                }
              ]
            }
          ],
          "has_else": true
        }
      },
      {
        "id": "email_owner",
        "type": "send_email",
        "label": "Email owner",
        "position": {
          "x": 340,
          "y": 2180
        },
        "config": {
          "to": "{{owner_email}}",
          "email_template_id": "e5d45c13-0f1c-4522-b949-f9e7a0fb9ab9"
        },
        "onError": "continue"
      },
      {
        "id": "log_sales",
        "type": "log",
        "label": "Log assignment",
        "position": {
          "x": 340,
          "y": 2340
        },
        "config": {
          "message": "Lead {{lead_id}} ({{segment}}, score {{score}}) assigned to {{owner_email}} in {{territory.queue}}",
          "level": "info"
        }
      },
      {
        "id": "done_sales",
        "type": "end_workflow",
        "label": "Routed to sales",
        "position": {
          "x": 340,
          "y": 2500
        },
        "config": {
          "reason": "{{lead_id}} → {{owner_email}} ({{priority}})"
        }
      },
      {
        "id": "nurture",
        "type": "call_reference",
        "label": "Add to nurture list",
        "position": {
          "x": 660,
          "y": 2180
        },
        "config": {
          "reference_id": "137ca81b-fe66-4aa1-8ad9-0bb7322e9447",
          "reference_name": "Add to nurture list",
          "reference_method": "POST",
          "input_mappings": {
            "list_id": "{{=COALESCE(territory.nurture_list_id, \"nurture-general\")}}",
            "email": "{{email}}",
            "first_name": "{{first_name}}",
            "company": "{{company}}",
            "segment": "{{segment}}",
            "score": "{{score}}",
            "source": "{{source}}"
          },
          "output_mappings": {
            "member_id": {
              "enabled": true,
              "variableName": "nurture_member_id"
            }
          }
        }
      },
      {
        "id": "log_nurture",
        "type": "log",
        "label": "Log nurture",
        "position": {
          "x": 660,
          "y": 2340
        },
        "config": {
          "message": "Lead {{lead_id}} ({{segment}}, score {{score}}) added to nurture as {{nurture_member_id}}",
          "level": "info"
        }
      },
      {
        "id": "done_nurture",
        "type": "end_workflow",
        "label": "Nurture",
        "position": {
          "x": 660,
          "y": 2500
        },
        "config": {
          "reason": "{{lead_id}} added to nurture ({{score}})"
        }
      }
    ],
    "edges": [
      {
        "id": "e-trigger-title",
        "source": "trigger",
        "target": "title"
      },
      {
        "id": "e-title-domain",
        "source": "title",
        "target": "domain"
      },
      {
        "id": "e-domain-enrich",
        "source": "domain",
        "target": "enrich"
      },
      {
        "id": "e-enrich-employees",
        "source": "enrich",
        "target": "employees"
      },
      {
        "id": "e-employees-territory",
        "source": "employees",
        "target": "territory"
      },
      {
        "id": "e-territory-has_territory",
        "source": "territory",
        "target": "has_territory"
      },
      {
        "id": "e-has_territory-owner-found",
        "source": "has_territory",
        "target": "owner",
        "label": "Found"
      },
      {
        "id": "e-has_territory-fallback-else",
        "source": "has_territory",
        "target": "fallback",
        "label": "Else"
      },
      {
        "id": "e-fallback-owner",
        "source": "fallback",
        "target": "owner"
      },
      {
        "id": "e-owner-owner_name",
        "source": "owner",
        "target": "owner_name"
      },
      {
        "id": "e-owner_name-score",
        "source": "owner_name",
        "target": "score"
      },
      {
        "id": "e-score-crm",
        "source": "score",
        "target": "crm"
      },
      {
        "id": "e-crm-route",
        "source": "crm",
        "target": "route"
      },
      {
        "id": "e-route-email_owner-sales-ready",
        "source": "route",
        "target": "email_owner",
        "label": "Sales-ready"
      },
      {
        "id": "e-route-nurture-else",
        "source": "route",
        "target": "nurture",
        "label": "Else"
      },
      {
        "id": "e-email_owner-log_sales",
        "source": "email_owner",
        "target": "log_sales"
      },
      {
        "id": "e-log_sales-done_sales",
        "source": "log_sales",
        "target": "done_sales"
      },
      {
        "id": "e-nurture-log_nurture",
        "source": "nurture",
        "target": "log_nurture"
      },
      {
        "id": "e-log_nurture-done_nurture",
        "source": "log_nurture",
        "target": "done_nurture"
      }
    ],
    "user_variables": [
      {
        "id": "v-email",
        "name": "email",
        "type": "string",
        "description": "Work email of the lead",
        "defaultValue": "",
        "required": true,
        "label": "Email",
        "format": "email"
      },
      {
        "id": "v-first_name",
        "name": "first_name",
        "type": "string",
        "description": "First name",
        "defaultValue": "",
        "label": "First name"
      },
      {
        "id": "v-last_name",
        "name": "last_name",
        "type": "string",
        "description": "Last name",
        "defaultValue": "",
        "label": "Last name"
      },
      {
        "id": "v-job_title",
        "name": "job_title",
        "type": "string",
        "description": "Job title as entered on the form",
        "defaultValue": "",
        "label": "Job title"
      },
      {
        "id": "v-company",
        "name": "company",
        "type": "string",
        "description": "Company name as entered on the form",
        "defaultValue": "",
        "required": true,
        "label": "Company"
      },
      {
        "id": "v-country",
        "name": "country",
        "type": "string",
        "description": "Country (ISO code, e.g. NZ, US)",
        "defaultValue": "",
        "required": true,
        "label": "Country"
      },
      {
        "id": "v-employees",
        "name": "employees",
        "type": "number",
        "description": "Company size from the form; replaced by the enriched value when available",
        "defaultValue": "0",
        "label": "Employees"
      },
      {
        "id": "v-source",
        "name": "source",
        "type": "string",
        "description": "Lead source: demo_request, contact_form, webinar, content_download, event",
        "defaultValue": "",
        "required": true,
        "label": "Source"
      },
      {
        "id": "v-message",
        "name": "message",
        "type": "string",
        "description": "Free-text message from the form",
        "defaultValue": "",
        "label": "Message"
      },
      {
        "id": "v-utm_campaign",
        "name": "utm_campaign",
        "type": "string",
        "description": "Campaign tag from the landing page",
        "defaultValue": "",
        "label": "Campaign"
      },
      {
        "id": "v-sales_ready_score",
        "name": "sales_ready_score",
        "type": "number",
        "description": "Score at or above which a lead goes straight to sales",
        "defaultValue": "60",
        "label": "Sales-ready score"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
