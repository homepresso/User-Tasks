      },
      {
        "id": "e-chase_task-log_round-close-round-close",
        "source": "chase_task",
        "target": "log_round",
        "label": "Close round"
      },
      {
        "id": "e-log_round-end_round",
        "source": "log_round",
        "target": "end_round"
      }
    ],
    "user_variables": [
      {
        "id": "v-policy_code",
        "name": "policy_code",
        "type": "string",
        "description": "Optional: the policy to track (e.g. POL-HR-03). Leave empty for the most recently effective current policy that needs acknowledging.",
        "defaultValue": "",
        "required": false,
        "label": "Policy code"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
