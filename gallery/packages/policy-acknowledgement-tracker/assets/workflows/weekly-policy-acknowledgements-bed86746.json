      },
      {
        "id": "e-vars_name-insert",
        "source": "vars_name",
        "target": "insert"
      },
      {
        "id": "e-insert-ask",
        "source": "insert",
        "target": "ask"
      },
      {
        "id": "e-ask-issue",
        "source": "ask",
        "target": "issue"
      },
      {
        "id": "e-which-chase-outstanding",
        "source": "which",
        "target": "chase",
        "label": "Outstanding"
      },
      {
        "id": "e-chase-count",
        "source": "chase",
        "target": "count"
      },
      {
        "id": "e-which-skip-else",
        "source": "which",
