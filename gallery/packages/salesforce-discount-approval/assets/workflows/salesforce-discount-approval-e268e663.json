          "output_mappings": {
            "line_items": {
              "enabled": true,
              "variableName": "line_items"
            },
            "line_count": {
              "enabled": true,
              "variableName": "line_count"
            }
          }
        }
      },
      {
        "id": "discount",
        "type": "set_variable",
        "label": "Effective discount",
        "position": {
          "x": 400,
          "y": 540
        },
        "config": {
          "name": "discount",
          "expression": "{{=COALESCE(requested_discount, MAX(PLUCK(line_items, \"Discount\")), 0)}}"
        }
      },
      {
        "id": "max_line",
        "type": "set_variable",
