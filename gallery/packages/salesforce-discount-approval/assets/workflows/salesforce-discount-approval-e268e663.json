        "config": {
          "reference_id": "4aefd7d0-a385-5283-bdae-959b76f77b04",
          "reference_name": "Query opportunity products",
          "reference_method": "GET",
          "input_mappings": {
            "q": "SELECT Id, ProductCode, Product2.Name, Product2.Family, Quantity, ListPrice, UnitPrice, Discount, TotalPrice FROM OpportunityLineItem WHERE OpportunityId = '{{opportunity_id}}'"
