              "enabled": true,
              "variableName": "discount_reason"
            },
            "term_months": {
              "enabled": true,
              "variableName": "term_months"
            }
          }
        }
      },
      {
        "id": "lines",
        "type": "call_reference",
        "label": "Query opportunity products",
        "position": {
          "x": 400,
          "y": 380
