                "source": "table",
                "table_id": "fc80acc4-7337-462f-9ecd-91499b9bc8dc",
                "search_columns": [
                  "department"
                ],
                "display_columns": [
                  "department",
                  "laptop_model"
                ],
                "value_column": "department",
                "fill": [
                  {
                    "from": "laptop_model",
                    "to": "kit_laptop"
                  },
                  {
                    "from": "systems",
                    "to": "kit_systems"
                  }
                ]
              }
            },
            {
              "key": "kit_laptop",
              "label": "Laptop",
              "type": "text",
              "read_only": true,
              "default": "{{laptop_model}}"
            },
            {
              "key": "kit_systems",
              "label": "Systems to set up",
              "type": "text",
              "read_only": true,
              "default": "{{systems}}"
            },
            {
              "key": "asset_tag",
              "label": "Laptop asset tag",
              "type": "text",
              "required": true
            },
            {
              "key": "accounts_created",
              "label": "Accounts created",
              "type": "boolean",
              "required": true,
              "default": "false"
            },
            {
              "key": "laptop_shipped_date",
              "label": "Laptop shipped / handed over on",
              "type": "date"
            },
            {
              "key": "notes",
              "label": "Notes",
              "type": "text"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "kit_profile",
                    "span": 1
                  },
                  {
                    "field_key": "kit_laptop",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "kit_systems",
                    "span": 3
                  }
                ]
              },
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "asset_tag",
                    "span": 1
                  },
                  {
                    "field_key": "laptop_shipped_date",
                    "span": 1
                  },
                  {
                    "field_key": "accounts_created",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 3,
                "cells": [
                  {
                    "field_key": "notes",
                    "span": 3
                  }
                ]
              }
            ]
          },
          "form_buttons": [
            {
              "id": "ready",
              "label": "Ready",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Ready"
            },
            {
              "id": "blocked",
              "label": "Blocked",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Blocked"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "IT setup: {{new_hire_name}}",
            "align": "left",
            "subtitle": "{{department}} · {{location}} · ready by {{it_ready_by}}"
          }
        }
      },
      {
        "id": "record",
        "type": "call_reference",
        "label": "Record provisioning request",
        "position": {
          "x": 340,
          "y": 720
        },
        "config": {
          "reference_id": "c43a54ad-c5c8-4105-b707-ad48fa68d0bf",
          "reference_name": "Create provisioning request",
          "reference_method": "POST",
          "input_mappings": {
            "employee_id": "{{employee_id}}",
            "full_name": "{{new_hire_name}}",
            "asset_tag": "{{task_data.asset_tag}}",
            "laptop_model": "{{laptop_model}}",
            "systems": "{{systems}}",
            "accounts_created": "{{task_data.accounts_created}}",
            "shipped_date": "{{task_data.laptop_shipped_date}}",
            "ready_by": "{{it_ready_by}}"
          },
          "output_mappings": {
            "request_id": {
              "enabled": true,
              "variableName": "provisioning_request_id"
            }
          }
        }
      },
      {
        "id": "log_done",
        "type": "log",
        "label": "Setup recorded",
        "position": {
          "x": 340,
          "y": 880
        },
        "config": {
          "message": "IT setup for {{new_hire_name}} recorded as {{provisioning_request_id}} (asset {{task_data.asset_tag}})",
          "level": "info"
        }
      },
      {
        "id": "notify_blocked",
        "type": "send_email",
        "label": "Email manager: blocked",
        "position": {
          "x": 660,
          "y": 720
        },
        "config": {
          "to": "{{manager_email}}",
          "email_template_id": "6cef2483-7c8f-41a9-93ca-d9bcc6f5f634"
        },
        "onError": "continue"
      },
      {
        "id": "log_blocked",
        "type": "log",
        "label": "Setup blocked",
        "position": {
          "x": 660,
          "y": 880
        },
        "config": {
          "message": "IT setup for {{new_hire_name}} blocked: {{task_data.notes}}",
          "level": "warn"
        }
      },
      {
        "id": "done",
        "type": "end_workflow",
        "label": "Ready",
        "position": {
          "x": 340,
          "y": 1040
        },
        "config": {
          "reason": "IT setup complete for {{new_hire_name}}"
        }
      },
      {
        "id": "blocked_end",
        "type": "end_workflow",
        "label": "Blocked",
        "position": {
          "x": 660,
          "y": 1040
        },
        "config": {
          "reason": "IT setup blocked for {{new_hire_name}}"
        }
      }
