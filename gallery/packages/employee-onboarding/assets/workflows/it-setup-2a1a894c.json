    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "Setup requested",
        "position": {
          "x": 340,
          "y": 60
        },
        "config": {}
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "title": "IT setup: {{new_hire_name}} · ready by {{it_ready_by}}"
        }
      },
      {
        "id": "sla",
        "type": "set_sla",
        "label": "Ready-by SLA",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "sla_label": "IT setup",
          "mode": "exact",
          "due_at": "{{it_ready_by}}",
          "warning_amount": 2,
          "warning_unit": "days"
        }
      },
      {
        "id": "it_task",
        "type": "user_task",
        "label": "Prepare equipment and accounts",
        "position": {
          "x": 340,
          "y": 540
        },
        "config": {
          "task_title": "IT setup for {{new_hire_name}} ({{department}}), ready by {{it_ready_by}}",
          "task_description": "<p><strong>{{new_hire_name}}</strong> starts as {{job_title}} on {{start_date}} ({{location}}).</p><p>Laptop: <strong>{{laptop_model}}</strong></p><p>Systems: {{systems}}</p><p>Remote starters need the laptop shipped so it arrives before day one.</p>",
          "task_priority": "high",
          "outcomes": [
            "Ready",
            "Blocked"
          ],
          "assignment_type": "individual",
          "assignee_id": "5fc34ce6-9edd-45ad-af2d-4315ece6f0ed",
          "assignee_variable": "{{it_owner_id}}",
          "due_date_mode": "absolute",
          "due_date": "{{it_ready_by}}",
          "reminders": [
            {
              "offset_minutes": 2880
            }
          ],
          "fields": [
            {
              "key": "kit_profile",
              "label": "Department kit",
              "type": "lookup",
              "default": "{{department}}",
              "help_text": "Standard kit from the Onboarding checklist",
