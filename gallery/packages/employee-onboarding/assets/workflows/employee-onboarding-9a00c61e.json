      },
      {
        "id": "e-title-sla",
        "source": "title",
        "target": "sla"
      },
      {
        "id": "e-sla-create",
        "source": "sla",
        "target": "create"
      },
      {
        "id": "e-create-kit",
        "source": "create",
        "target": "kit"
      },
      {
        "id": "e-kit-track",
        "source": "kit",
        "target": "track"
      },
      {
        "id": "e-track-ready_by",
        "source": "track",
        "target": "ready_by"
      },
      {
        "id": "e-ready_by-log_track",
        "source": "ready_by",
        "target": "log_track"
      },
      {
        "id": "e-log_track-it",
        "source": "log_track",
        "target": "it"
      },
      {
        "id": "e-it-manager",
        "source": "it",
        "target": "manager"
      },
      {
        "id": "e-manager-welcome-ready",
        "source": "manager",
        "target": "welcome",
        "label": "Ready"
      },
      {
        "id": "e-manager-withdrawn-hire-withdrawn",
        "source": "manager",
