{
  "format_version": 3,
  "asset_type": "workflows",
  "id": "9a00c61e-8525-4c32-82c6-0621f9e3c7ce",
  "asset": {
    "id": "9a00c61e-8525-4c32-82c6-0621f9e3c7ce",
    "name": "Employee onboarding",
    "description": "HR enters a new hire; the employee is created in the HR system, the department checklist and onboarding track decide the kit and timing, IT setup runs in parallel and the manager prepares the first week.",
    "trigger_type": "webhook_received",
    "trigger_config": {},
    "nodes": [
      {
        "id": "trigger",
        "type": "webhook_received",
        "label": "New hire submitted",
        "position": {
          "x": 340,
          "y": 60
        },
        "config": {
          "start_form": {
            "layout": {
              "rows": [
                {
                  "columns": 3,
                  "cells": [
                    {
                      "field_key": "new_hire_name",
                      "span": 1
                    },
                    {
                      "field_key": "personal_email",
                      "span": 2
                    }
                  ]
                },
                {
                  "columns": 3,
                  "cells": [
                    {
                      "field_key": "job_title",
                      "span": 2
                    },
                    {
                      "field_key": "department",
                      "span": 1
                    }
                  ]
                },
                {
                  "columns": 3,
                  "cells": [
                    {
                      "field_key": "start_date",
                      "span": 1
                    },
                    {
                      "field_key": "location",
                      "span": 1
                    },
                    {
                      "field_key": "employment_type",
                      "span": 1
                    }
                  ]
                },
                {
                  "columns": 3,
                  "cells": [
                    {
                      "field_key": "manager_name",
                      "span": 1
                    },
                    {
                      "field_key": "manager_email",
                      "span": 2
                    }
                  ]
                },
                {
                  "columns": 3,
                  "cells": [
                    {
                      "field_key": "manager_id",
                      "span": 1
                    },
                    {
                      "field_key": "it_owner_id",
                      "span": 2
                    }
                  ]
                }
              ]
            },
            "theme": {
              "source": "custom",
              "overrides": {
                "colors": {
                  "light": {
                    "accent": "#0D9488",
                    "background": "#FFFFFF",
                    "text": "#1B1916",
                    "page": "#E8F5F3"
                  }
                },
                "radius": 10,
                "density": "comfortable",
                "button_placement": "right",
                "header": {
                  "enabled": true,
                  "title": "Onboard a new hire",
                  "subtitle": "IT, the manager and HR get their tasks from this one form."
                }
              }
            }
          }
        }
      },
      {
        "id": "title",
        "type": "set_title",
        "label": "Set title",
        "position": {
          "x": 340,
          "y": 220
        },
        "config": {
          "title": "Onboarding: {{new_hire_name}} · {{job_title}} · starts {{start_date}}"
        }
      },
      {
        "id": "sla",
        "type": "set_sla",
        "label": "Ready by start date",
        "position": {
          "x": 340,
          "y": 380
        },
        "config": {
          "sla_label": "Onboarding ready",
          "mode": "exact",
          "due_at": "{{start_date}}",
          "warning_amount": 3,
          "warning_unit": "days"
        }
      },
      {
        "id": "create",
        "type": "call_reference",
        "label": "Create employee",
        "position": {
          "x": 340,
          "y": 540
        },
        "config": {
          "reference_id": "0c25073e-b1cb-47b8-9f6e-76c8a40825d9",
          "reference_name": "Create employee",
          "reference_method": "POST",
          "input_mappings": {
            "full_name": "{{new_hire_name}}",
            "personal_email": "{{personal_email}}",
            "job_title": "{{job_title}}",
            "department": "{{department}}",
            "start_date": "{{start_date}}",
            "manager_name": "{{manager_name}}",
            "location": "{{location}}",
            "employment_type": "{{employment_type}}"
          },
          "output_mappings": {
            "employee_id": {
              "enabled": true,
              "variableName": "employee_id"
            },
            "employee_number": {
              "enabled": true,
              "variableName": "employee_number"
            },
            "work_email": {
              "enabled": true,
              "variableName": "work_email"
            }
          }
        }
      },
      {
        "id": "kit",
        "type": "update_data_table",
        "label": "Department checklist",
        "position": {
          "x": 340,
          "y": 700
        },
        "config": {
          "table_id": "fc80acc4-7337-462f-9ecd-91499b9bc8dc",
          "table_name": "Onboarding checklist",
          "operation": "get",
          "match_column": "department",
          "match_value": "{{department}}",
          "output_row_var": "onboarding_kit"
        }
      },
      {
        "id": "track",
        "type": "decision_table",
        "label": "Onboarding track",
        "position": {
          "x": 340,
          "y": 860
        },
        "config": {
          "decision_table_id": "db62fc26-732a-47a8-b2bd-6fb4559f7fde",
          "decision_table_name": "Onboarding track",
          "input_mappings": {
            "employment_type": "{{employment_type}}",
            "location": "{{location}}"
          }
        }
      },
      {
        "id": "ready_by",
        "type": "set_variable",
        "label": "IT ready-by date",
        "position": {
          "x": 340,
          "y": 1020
        },
        "config": {
          "name": "it_ready_by",
          "expression": "{{=FORMAT_DATE(SUBTRACT_DAYS(start_date, it_lead_days), \"YYYY-MM-DD\")}}"
        }
      },
      {
        "id": "log_track",
        "type": "log",
        "label": "Log track",
        "position": {
          "x": 340,
          "y": 1180
        },
        "config": {
          "message": "{{new_hire_name}} ({{employee_id}}): track {{track}}, IT ready by {{it_ready_by}}, orientation {{orientation_needed}}",
          "level": "info"
        }
      },
      {
        "id": "it",
        "type": "call_sub_workflow",
        "label": "Start IT setup",
        "position": {
          "x": 340,
          "y": 1340
        },
        "config": {
          "sub_workflow_id": "2a1a894c-f5b3-4c3e-ae9d-c35c09533364",
          "sub_workflow_name": "IT setup",
          "input_mappings": {
            "employee_id": "{{employee_id}}",
            "new_hire_name": "{{new_hire_name}}",
            "job_title": "{{job_title}}",
            "department": "{{department}}",
            "location": "{{location}}",
            "start_date": "{{start_date}}",
            "it_ready_by": "{{it_ready_by}}",
            "laptop_model": "{{onboarding_kit.laptop_model}}",
            "systems": "{{onboarding_kit.systems}}",
            "manager_name": "{{manager_name}}",
            "manager_email": "{{manager_email}}",
            "it_owner_id": "{{it_owner_id}}"
          }
        },
        "executionMode": "async"
      },
      {
        "id": "manager",
        "type": "user_task",
        "label": "Prepare first week",
        "position": {
          "x": 340,
          "y": 1500
        },
        "config": {
          "task_title": "Prepare the first week for {{new_hire_name}} (starts {{start_date}})",
          "task_description": "<p><strong>{{new_hire_name}}</strong> joins as {{job_title}} in {{department}} on {{start_date}} ({{location}}, {{employment_type}}). Track: <strong>{{track}}</strong>.</p><p>Suggested buddy team: {{onboarding_kit.buddy_team}}. Focus for week one: {{onboarding_kit.first_week_focus}}.</p><p>IT is preparing {{onboarding_kit.laptop_model}} for {{it_ready_by}}. Pick a buddy and write the first-week plan; it goes into the welcome email.</p>",
          "task_priority": "medium",
          "outcomes": [
            "Ready",
            "Hire withdrawn"
          ],
          "assignment_type": "individual",
          "assignee_id": "f6658c16-3731-4f58-ab6d-864d09ff1962",
          "assignee_variable": "{{manager_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 5,
          "due_offset_unit": "days",
          "reminders": [
            {
              "offset_minutes": 1440
            }
          ],
          "fields": [
            {
              "key": "buddy",
              "label": "Buddy (name)",
              "type": "text",
              "required": true
            },
            {
              "key": "first_week_plan",
              "label": "First-week plan",
              "type": "text",
              "required": true,
              "default": "{{onboarding_kit.first_week_focus}}"
            },
            {
              "key": "desk_needed",
              "label": "Desk needed",
              "type": "boolean",
              "default": "{{=IF(CONTAINS(location, \"office\"), true, false)}}"
            },
            {
              "key": "notes",
              "label": "Notes for HR",
              "type": "text"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "buddy",
                    "span": 1
                  },
                  {
                    "field_key": "desk_needed",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "first_week_plan",
                    "span": 2
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "notes",
                    "span": 2
                  }
                ]
              }
            ]
          },
          "form_buttons": [
            {
              "id": "ready",
              "label": "Ready",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Ready"
            },
            {
              "id": "hire_withdrawn",
              "label": "Hire withdrawn",
              "kind": "outcome",
              "style": "danger",
              "outcome": "Hire withdrawn"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "First week: {{new_hire_name}}",
            "align": "left",
            "subtitle": "{{job_title}} · {{department}} · starts {{start_date}}"
          }
        }
      },
      {
        "id": "welcome",
        "type": "send_email",
        "label": "Welcome email",
        "position": {
          "x": 340,
          "y": 1680
        },
        "config": {
          "to": "{{personal_email}}",
          "email_template_id": "d85badf5-4ab2-4d21-bf33-81a72e3fcef3"
        },
        "onError": "continue"
      },
      {
        "id": "log_ready",
        "type": "log",
        "label": "First week ready",
        "position": {
          "x": 340,
          "y": 1840
        },
        "config": {
          "message": "First week ready for {{new_hire_name}}: buddy {{task_data.buddy}}, desk {{task_data.desk_needed}}",
          "level": "info"
        }
      },
      {
        "id": "wait",
        "type": "delay",
        "label": "Wait 30 days",
        "position": {
          "x": 340,
          "y": 2000
        },
        "config": {
          "duration": 30,
          "unit": "days"
        }
      },
      {
        "id": "checkin",
        "type": "user_task",
        "label": "Day-30 check-in",
        "position": {
          "x": 340,
          "y": 2160
        },
        "config": {
          "task_title": "30-day check-in with {{new_hire_name}}",
          "task_description": "<p>{{new_hire_name}} has been with the team for about a month. Have a short check-in and record how it is going.</p>",
          "task_priority": "low",
          "outcomes": [
            "Done"
          ],
          "assignment_type": "individual",
          "assignee_id": "f6658c16-3731-4f58-ab6d-864d09ff1962",
          "assignee_variable": "{{manager_id}}",
          "due_date_mode": "relative",
          "due_offset_amount": 5,
          "due_offset_unit": "days",
          "fields": [
            {
              "key": "settling_in",
              "label": "Settling in",
              "type": "choice",
              "options": [
                "Going well",
                "Some concerns",
                "Needs support"
              ],
              "required": true
            },
            {
              "key": "checkin_notes",
              "label": "Notes",
              "type": "text"
            },
            {
              "key": "hr_follow_up",
              "label": "HR follow-up needed",
              "type": "boolean",
              "default": "false"
            }
          ],
          "form_layout": {
            "rows": [
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "settling_in",
                    "span": 1
                  },
                  {
                    "field_key": "hr_follow_up",
                    "span": 1
                  }
                ]
              },
              {
                "columns": 2,
                "cells": [
                  {
                    "field_key": "checkin_notes",
                    "span": 2
                  }
                ]
              }
            ]
          },
          "form_buttons": [
            {
              "id": "done",
              "label": "Done",
              "kind": "outcome",
              "style": "primary",
              "outcome": "Done"
            }
          ],
          "form_header": {
            "enabled": true,
            "image": "default",
            "title": "30-day check-in: {{new_hire_name}}",
            "align": "left",
            "subtitle": "{{job_title}} · {{department}}"
          }
        }
      },
      {
        "id": "log_checkin",
        "type": "log",
        "label": "Log check-in",
        "position": {
          "x": 340,
          "y": 2340
        },
        "config": {
          "message": "Day-30 check-in for {{new_hire_name}}: {{task_data.settling_in}} (HR follow-up {{task_data.hr_follow_up}})",
          "level": "info"
        }
      },
      {
        "id": "withdrawn",
        "type": "log",
        "label": "Hire withdrawn",
        "position": {
          "x": 660,
          "y": 1680
        },
        "config": {
          "message": "Onboarding for {{new_hire_name}} ({{employee_id}}) stopped: hire withdrawn. Cancel the IT setup task and the HR record.",
          "level": "warn"
        }
      },
      {
        "id": "done",
        "type": "end_workflow",
        "label": "Onboarded",
        "position": {
          "x": 340,
          "y": 2500
        },
        "config": {
          "reason": "{{new_hire_name}} onboarded ({{employee_id}})"
        }
      },
      {
        "id": "cancelled",
        "type": "end_workflow",
        "label": "Cancelled",
        "position": {
          "x": 660,
          "y": 1840
        },
        "config": {
          "reason": "Hire withdrawn"
        }
      }
    ],
    "edges": [
      {
