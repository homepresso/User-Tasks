      }
    ],
    "user_variables": [
      {
        "id": "v-new_hire_name",
        "name": "new_hire_name",
        "type": "string",
        "description": "Full name as it should appear in the HR system",
        "defaultValue": "",
        "required": true,
        "label": "New hire name"
      },
      {
        "id": "v-personal_email",
        "name": "personal_email",
        "type": "string",
        "description": "Personal email for the welcome message (the work email does not exist yet)",
        "defaultValue": "",
        "required": true,
        "label": "Personal email",
        "format": "email"
      },
      {
        "id": "v-job_title",
        "name": "job_title",
        "type": "string",
        "description": "Job title, e.g. \"Software Engineer\"",
        "defaultValue": "",
        "required": true,
        "label": "Job title"
      },
      {
        "id": "v-department",
        "name": "department",
        "type": "string",
        "description": "Department (one row of the Onboarding checklist table)",
        "defaultValue": "",
        "required": true,
        "label": "Department",
        "options": [
          "engineering",
          "sales",
          "marketing",
          "finance",
          "operations",
          "people"
        ]
      },
      {
        "id": "v-start_date",
        "name": "start_date",
        "type": "string",
        "description": "First working day",
        "defaultValue": "",
        "required": true,
        "label": "Start date",
        "format": "date"
      },
      {
        "id": "v-manager_name",
        "name": "manager_name",
        "type": "string",
        "description": "Hiring manager's name",
        "defaultValue": "",
        "required": true,
        "label": "Manager"
      },
      {
        "id": "v-manager_email",
        "name": "manager_email",
        "type": "string",
        "description": "Hiring manager's email (told if IT setup is blocked)",
        "defaultValue": "",
        "label": "Manager email",
        "format": "email"
      },
      {
        "id": "v-location",
        "name": "location",
        "type": "string",
        "description": "Where the new hire works",
        "defaultValue": "office",
        "required": true,
        "label": "Location",
        "options": [
          "office",
          "remote"
        ]
      },
      {
        "id": "v-employment_type",
        "name": "employment_type",
        "type": "string",
        "description": "Contract type",
        "defaultValue": "permanent",
        "required": true,
        "label": "Employment type",
        "options": [
          "permanent",
          "fixed-term",
          "contractor"
        ]
      },
      {
        "id": "v-manager_id",
        "name": "manager_id",
        "type": "string",
        "description": "Optional: user id of the hiring manager in UserTasks (overrides the install-time default)",
        "defaultValue": "",
        "label": "Manager (user id)"
      },
      {
        "id": "v-it_owner_id",
        "name": "it_owner_id",
        "type": "string",
        "description": "Optional: user id of the IT person who prepares the equipment",
        "defaultValue": "",
        "label": "IT owner (user id)"
      }
    ],
    "swimlanes": [],
    "is_active": true
  }
}
