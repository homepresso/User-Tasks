            "page": "#E8F5F3",
            "page_to": "#F6FBFA"
          }
        },
        "radius": 12,
        "density": "comfortable",
        "button_placement": "right",
        "header": {
          "enabled": true,
          "title": "New starter",
          "subtitle": "Four steps: the role, the contract, the manager, then start onboarding. IT, the manager and HR get their tasks from this one form."
        }
      }
    },
    "header": {
      "enabled": true,
      "image": "workspace_logo",
      "title": "New starter",
      "align": "left",
      "subtitle": "Four steps: the role, the contract, the manager, then start onboarding. IT, the manager and HR get their tasks from this one form."
    }
  }
