                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "contract_back",
                  "span": 1
                },
                {
                  "field_key": "contract_next",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "calendar",
          "description": "When they start and on what terms."
        },
        {
          "id": "manager",
          "title": "Manager",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "manager_name",
                  "span": 1
                },
                {
                  "field_key": "manager_email",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "manager_id",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "manager_back",
                  "span": 1
                },
                {
                  "field_key": "manager_next",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "users",
          "description": "Who prepares the first week."
        },
        {
          "id": "review",
          "title": "Review & submit",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "hr_notes",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "offer_signed",
                  "span": 2
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "review_back",
                  "span": 1
                },
                {
                  "field_key": "review_submit",
                  "span": 1
                }
              ]
            }
          ],
          "icon": "check-circle",
          "description": "Anything the team should know, then start onboarding."
        }
      ],
      "page_settings": {
        "indicator": "progress",
        "next_label": "Next",
        "back_label": "Back"
      },
      "application_mode": true,
      "rules": [
        {
          "id": "r_start_future",
          "name": "The start date is not in the past",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "start_date",
              "text": "The start date cannot be in the past."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "start_date",
                "operator": "is_set"
              },
              {
                "column": "start_date",
                "operator": "lt",
                "value": "{{today}}"
              }
            ]
          }
        },
        {
          "id": "r_fixed_term_end",
          "name": "Fixed-term contracts need an end date",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "contract_end_date",
              "text": "Add the end date of the fixed-term contract."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "employment_type",
                "operator": "eq",
                "value": "fixed-term"
              },
              {
                "column": "contract_end_date",
                "operator": "is_not_set"
              }
            ]
          }
        },
        {
          "id": "r_end_after_start",
          "name": "The contract ends after it starts",
          "event": "before_submit",
          "then": [
            {
              "type": "field_error",
              "field": "contract_end_date",
              "text": "The contract must end after the start date."
            }
          ],
          "if": {
            "match": "all",
            "conditions": [
              {
                "column": "contract_end_date",
                "operator": "is_set"
              },
              {
                "column": "contract_end_date",
                "operator": "lte",
                "value": "{{start_date}}"
              }
            ]
          }
        },
        {
          "id": "r_type_changed",
          "name": "Changing the employment type clears the contract details",
          "event": "value_change",
          "then": [
            {
              "type": "clear_values",
              "fields": [
                "contract_end_date",
                "agency_name"
              ]
            }
          ],
          "target": "employment_type"
        }
      ]
    },
    "buttons": [
      {
        "id": "submit",
        "label": "Start onboarding",
        "kind": "submit",
        "style": "primary",
        "actions": [
          {
            "type": "start_workflow",
            "workflow_id": "9a00c61e-8525-4c32-82c6-0621f9e3c7ce",
            "workflow_name": "Employee onboarding",
            "inputs": {
              "new_hire_name": "{{new_hire_name}}",
              "personal_email": "{{personal_email}}",
              "job_title": "{{job_title}}",
              "department": "{{department}}",
              "start_date": "{{start_date}}",
              "manager_name": "{{manager_name}}",
              "manager_email": "{{manager_email}}",
              "location": "{{location}}",
              "employment_type": "{{employment_type}}",
              "manager_id": "{{manager_id}}",
              "contract_end_date": "{{contract_end_date}}",
              "agency_name": "{{agency_name}}",
              "hr_notes": "{{hr_notes}}",
              "offer_signed": "{{offer_signed}}"
            }
          },
          {
            "type": "success_screen",
            "title": "Onboarding started",
            "screen_button": "submit_another",
            "screen_button_label": "Add another new starter",
            "text": "{{new_hire_name}} starts on {{start_date}}. The HR record, IT setup and the first-week plan are on their way (reference {{run_reference}})."
          }
        ]
      },
      {
        "id": "cancel",
        "label": "Cancel",
        "kind": "cancel",
        "style": "secondary",
        "hidden": true
      }
    ],
    "theme": {
