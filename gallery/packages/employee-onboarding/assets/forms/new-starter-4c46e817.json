{
  "format_version": 3,
  "asset_type": "forms",
  "id": "4c46e817-3405-5d5b-b9da-7930b88a6dc5",
  "asset": {
    "id": "4c46e817-3405-5d5b-b9da-7930b88a6dc5",
    "name": "New starter",
    "description": "The stepped form HR fills in for each new hire: The role → Contract & start → Manager → Review & submit, with a progress bar and in-form Next / Back / Start onboarding buttons (Application mode). The department autocomplete stores the checklist key and shows the buddy team; fixed-term end dates and agency names appear only when they apply, and rules check the dates before it is sent. Submitting starts the Employee onboarding workflow.",
    "tags": [
      "onboarding",
      "new hire",
      "hr"
    ],
    "fields": [
      {
        "key": "new_hire_name",
        "label": "New hire name",
        "type": "text",
        "required": true,
        "help_text": "Full name as it should appear in the HR system",
        "autocomplete": "off"
      },
      {
        "key": "personal_email",
        "label": "Personal email",
        "type": "email",
        "required": true,
        "help_text": "The welcome email goes here (their work email does not exist yet)"
      },
      {
        "key": "job_title",
        "label": "Job title",
        "type": "text",
        "required": true,
        "placeholder": "Software Engineer"
      },
      {
        "key": "department",
        "label": "Department",
        "type": "lookup",
        "required": true,
        "help_text": "Pick from the Onboarding checklist: it decides the kit, systems and buddy team",
        "lookup": {
          "source": "table",
          "table_id": "fc80acc4-7337-462f-9ecd-91499b9bc8dc",
          "search_columns": [
            "department",
            "buddy_team"
          ],
          "display_columns": [
            "department",
            "buddy_team",
            "laptop_model"
          ],
          "value_column": "department",
          "label_template": "{{department}} · {{buddy_team}}",
          "description_template": "{{laptop_model}} · {{welcome_pack}}",
          "search_value": true,
          "fill": [
            {
              "from": "laptop_model",
              "to": "kit_laptop"
            },
            {
              "from": "buddy_team",
              "to": "kit_buddy"
            }
          ],
          "sort": {
            "column": "department",
            "direction": "asc"
          }
        }
      },
      {
        "key": "kit_laptop",
        "label": "Laptop",
        "type": "text",
        "read_only": true,
        "help_text": "From the Onboarding checklist"
      },
      {
        "key": "kit_buddy",
        "label": "Buddy team",
        "type": "text",
        "read_only": true
      },
      {
        "key": "employment_type",
        "label": "Employment type",
        "type": "choice",
        "required": true,
        "options": [
          "permanent",
          "fixed-term",
          "contractor"
        ],
        "display": "radio",
        "default": "permanent"
      },
      {
        "key": "start_date",
        "label": "Start date",
        "type": "date",
        "required": true,
        "help_text": "First working day"
      },
      {
        "key": "contract_end_date",
        "label": "Contract end date",
        "type": "date",
        "visible_when": {
          "field": "employment_type",
          "operator": "equals",
          "value": "fixed-term"
        }
      },
      {
        "key": "agency_name",
        "label": "Agency (if through an agency)",
        "type": "text",
        "visible_when": {
          "field": "employment_type",
          "operator": "equals",
          "value": "contractor"
        }
      },
      {
        "key": "location",
        "label": "Location",
        "type": "choice",
        "required": true,
        "options": [
          "office",
          "remote"
        ],
        "display": "radio",
        "default": "office"
      },
      {
        "key": "manager_name",
        "label": "Hiring manager's name",
        "type": "text",
        "required": true
      },
      {
        "key": "manager_email",
        "label": "Hiring manager's email",
        "type": "email",
        "required": true,
        "help_text": "Told if IT setup is blocked"
      },
      {
        "key": "manager_id",
        "label": "Hiring manager in UserTasks",
        "type": "user",
        "help_text": "Optional: gets the Prepare first week and Day-30 check-in tasks (otherwise the default manager)"
      },
      {
        "key": "hr_notes",
        "label": "Notes for the manager and IT",
        "type": "textarea",
        "help_text": "Accessibility needs, equipment preferences, anything the team should know"
      },
      {
        "key": "offer_signed",
        "label": "The offer is signed and the right-to-work check is done",
        "type": "boolean",
        "required": true
      },
      {
        "key": "role_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "contract_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "contract_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "manager_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "manager_next",
        "label": "Next",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "next_page"
            }
          ],
          "icon": "chevron-right",
          "align": "right",
          "icon_after": true
        }
      },
      {
        "key": "review_back",
        "label": "Back",
        "type": "button",
        "button": {
          "style": "outline",
          "actions": [
            {
              "type": "previous_page"
            }
          ],
          "icon": "chevron-left"
        }
      },
      {
        "key": "review_submit",
        "label": "Start onboarding",
        "type": "button",
        "button": {
          "style": "primary",
          "actions": [
            {
              "type": "submit",
              "button": "submit"
            }
          ],
          "icon": "send",
          "align": "right",
          "icon_after": true
        }
      }
    ],
    "layout": {
      "rows": [],
      "mode": "steps",
      "pages": [
        {
          "id": "role",
          "title": "The role",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "new_hire_name",
                  "span": 1
                },
                {
                  "field_key": "personal_email",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "job_title",
                  "span": 1
                },
                {
                  "field_key": "department",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "kit_laptop",
                  "span": 1
                },
                {
                  "field_key": "kit_buddy",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "role_next",
                  "span": 2
                }
              ]
            }
          ],
          "icon": "briefcase",
          "description": "Who is joining and where."
        },
        {
          "id": "contract",
          "title": "Contract & start",
          "rows": [
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "employment_type",
                  "span": 1
                },
                {
                  "field_key": "location",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "start_date",
                  "span": 1
                },
                {
                  "field_key": "contract_end_date",
                  "span": 1
                }
              ]
            },
            {
              "columns": 2,
              "cells": [
                {
                  "field_key": "agency_name",
